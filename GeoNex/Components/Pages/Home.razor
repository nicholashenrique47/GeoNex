    private long _ultimaRequisicaoCamera;

    [JSInvokable]
    public void AtualizarCameraJS(
        double deltaX,
        double deltaY,
        double scaleMultiplier,
        bool interacaoRapida = false,
        long requisicaoCamera = 0,
        double basePanX = double.NaN,
        double basePanY = double.NaN,
        double baseZoom = double.NaN)
    {
        if (!double.IsFinite(deltaX) || !double.IsFinite(deltaY) ||
            !double.IsFinite(scaleMultiplier) || scaleMultiplier <= 0)
            return;

        if (requisicaoCamera > 0 && requisicaoCamera <= _ultimaRequisicaoCamera)
        {
            if (requisicaoCamera == _ultimaRequisicaoCamera)
                SolicitarNovoFrame(interacaoRapida, requisicaoCamera);
            return;
        }
        // Every request is based on the image actually presented in the browser,
        // not on a previously submitted camera whose render may be canceled.
        var cameraAtual = double.IsFinite(basePanX) && double.IsFinite(basePanY) &&
            double.IsFinite(baseZoom) && baseZoom > 0
            ? new MapCameraState(basePanX, basePanY, baseZoom)
            : new MapCameraState(MapService.CameraPanX, MapService.CameraPanY, MapService.CameraZoom);
        if (!MapCoordinateSpace.TryApplyCssCameraDelta(
            cameraAtual,
            deltaX,
            deltaY,
            scaleMultiplier,
            out MapCameraState novaCamera))
            return;

        _ultimaRequisicaoCamera = requisicaoCamera;
        MapService.CameraPanX = novaCamera.PanX;
        MapService.CameraPanY = novaCamera.PanY;
        MapService.CameraZoom = novaCamera.Zoom;

        _ = SincronizarOverlay(true); // Envia para a sala de espera antes da imagem carregar
        SolicitarNovoFrame(interacaoRapida, requisicaoCamera);
    }
    // Variável que controla a física do íman de desenho
    // Variáveis que controlam os ímanes de desenho simultaneamente
    private bool _snapAquisicaoVertice = true;
    private bool _snapAquisicaoAresta = false; 
    private void ReceberMovimentoFerramentasLegado(double pixelX, double pixelY)
    {
        if (_ferramentaAtiva == ModoFerramenta.Medicao && _medicaoConcluida) return;
        if (exibirModalAtributos) return; // <-- ADICIONE ESTA LINHA AQUI
        if (_ferramentaAtiva == ModoFerramenta.Medicao || _ferramentaAtiva == ModoFerramenta.AquisicaoPoligono || _ferramentaAtiva == ModoFerramenta.AquisicaoLinha || _ferramentaAtiva == ModoFerramenta.AquisicaoPonto)
        {
            var matrizCompleta = ObterMatrizMatematica();

            if (matrizCompleta.TryInvert(out var matrizInversa))
            {
                var ptMundo = matrizInversa.MapPoint(new SkiaSharp.SKPoint((float)pixelX, (float)pixelY));

                if (_coordenadaAbsolutaTravada && FerramentaDesenhoAtiva &&
                    MapService.PontoRestricaoAbsoluta is { } absolutePoint)
                {
                    MapService.PontoCursorMundo = absolutePoint;
                    MapService.PontoCursorSnap = null;
                    MapService.PontoCursorSnapTipo = null;
                    return;
                }

                MapService.PontoCursorMundo = ptMundo;

                // --- ISOLAMENTO MAGNÉTICO (Vértices e Arestas 100% Independentes) ---
                bool usarSnap = false;
                bool checarVertices = false;
                bool checarArestas = false;

                if (_ferramentaAtiva == ModoFerramenta.Medicao && _snapMedicaoAtivo)
                {
                    usarSnap = true;
                    checarVertices = true;
                    checarArestas = false; // A correção da Medição: Nunca usa arestas!
                }
                else if (_ferramentaAtiva == ModoFerramenta.AquisicaoPoligono || _ferramentaAtiva == ModoFerramenta.AquisicaoLinha || _ferramentaAtiva == ModoFerramenta.AquisicaoPonto)
                {
                    if (_snapAquisicaoVertice || _snapAquisicaoAresta)
                    {
                        usarSnap = true;
                        checarVertices = _snapAquisicaoVertice;
                        checarArestas = _snapAquisicaoAresta;
                    }
                }

                if (usarSnap)
                {
                    var ptMagnetico = MapService.EncontrarVerticeProximo(ptMundo, 15.0f / matrizCompleta.ScaleX, checarVertices, checarArestas);
                    if (ptMagnetico.HasValue)
                    {
                        MapService.PontoCursorSnap = ptMagnetico.Value;
                        MapService.PontoCursorMundo = ptMagnetico.Value;
                    }
                    else { MapService.PontoCursorSnap = null; MapService.PontoCursorSnapTipo = null; }
                }
                else { MapService.PontoCursorSnap = null; MapService.PontoCursorSnapTipo = null; }

                if ((DateTime.Now - _ultimoMovimentoMouse).TotalMilliseconds >= 33)
                {
                    _ultimoMovimentoMouse = DateTime.Now;
                    bool precisaRedesenhar = false;
                    bool precisaAtualizarHTML = false;

                    if (_ferramentaAtiva == ModoFerramenta.Medicao && MapService.PontosMedicao.Count > 0)
                    {
                        RecalcularMedicoes();
                        precisaRedesenhar = true;
                        precisaAtualizarHTML = true;
                    }

                    if ((_ferramentaAtiva == ModoFerramenta.AquisicaoPoligono || _ferramentaAtiva == ModoFerramenta.AquisicaoLinha || _ferramentaAtiva == ModoFerramenta.AquisicaoPonto) && MapService.PontosAquisicao.Count > 0)
                    {
                        precisaRedesenhar = true; 
                    }

                    if (!Nullable.Equals(MapService.PontoCursorSnap, _ultimoSnapRenderizado))
                    {
                        precisaRedesenhar = true;
                        _ultimoSnapRenderizado = MapService.PontoCursorSnap;
                    }

                    if (precisaRedesenhar)
                    {
                        SolicitarNovoFrame();
                        if (precisaAtualizarHTML) StateHasChanged();
                    }
                }
            }
        }
    }
