    private async Task ConfirmarCriacaoNovaCamada()
    {
        string caminhoFinal = CaminhoAbsolutoGerado;

        if (string.IsNullOrEmpty(caminhoFinal)) return;

        // Limpeza de string para garantir nome de ficheiro válido no Windows/Linux
        string nomeFicheiroLimpo = novaCamadaNome.Trim().Replace(" ", "_");

        try
        {
            // =====================================================================
            // >>> 1. O MOTOR FÍSICO DO GDAL/OGR ENTRA EM AÇÃO
            // =====================================================================
            OSGeo.OGR.Ogr.RegisterAll();

            // Escolhe o compilador certo baseado no dropdown do HTML
            string driverName = novaCamadaFormato switch
            {
                "SHP" => "ESRI Shapefile",
                "GEOJSON" => "GeoJSON",
                "GPKG" => "GPKG",
                _ => "ESRI Shapefile"
            };

            OSGeo.OGR.Driver driver = OSGeo.OGR.Ogr.GetDriverByName(driverName);
            if (driver == null)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Driver GDAL '{driverName}' não encontrado no sistema.");
                return;
            }

            // =====================================================================
            // >>> 2. CRIAÇÃO DO DATASET FÍSICO NO DISCO (Ex: lote.shp, lote.dbf...)
            // =====================================================================
            OSGeo.OGR.DataSource ds = driver.CreateDataSource(caminhoFinal, null);
            if (ds == null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Falha de Permissão I/O: Não foi possível gravar o arquivo na pasta de destino.");
                return;
            }

            // 3. Configura a Matriz Espacial (O ficheiro .prj)
            OSGeo.OSR.SpatialReference srs = new OSGeo.OSR.SpatialReference("");
            if (novaCamadaCrs.Contains("31982")) srs.ImportFromEPSG(31982); // UTM 22S
            else srs.ImportFromEPSG(4326); // Decimal Geográfico
            srs.MorphToESRI();
            // 4. Mapeia a Arquitetura da Geometria do OGR
            OSGeo.OGR.wkbGeometryType wkbTipo = novaCamadaGeometria switch
            {
                "POLIGONO" => OSGeo.OGR.wkbGeometryType.wkbPolygon,
                "LINHA" => OSGeo.OGR.wkbGeometryType.wkbLineString,
                "PONTO" => OSGeo.OGR.wkbGeometryType.wkbPoint,
                _ => OSGeo.OGR.wkbGeometryType.wkbUnknown
            };

            // 5. Injeta a Layer e gera a Tabela de Atributos (.dbf) PADRÃO!
            OSGeo.OGR.Layer layer = ds.CreateLayer(nomeFicheiroLimpo, srs, wkbTipo, null);

            // --- COLUNAS AUTOMÁTICAS DE ENGENHARIA (Adaptação Inteligente por Geometria) ---
            using (var campoId = new OSGeo.OGR.FieldDefn("ID", OSGeo.OGR.FieldType.OFTInteger)) { layer.CreateField(campoId, 1); }
            using (var campoNome = new OSGeo.OGR.FieldDefn("NOME", OSGeo.OGR.FieldType.OFTString)) { campoNome.SetWidth(50); layer.CreateField(campoNome, 1); }

            if (novaCamadaGeometria == "POLIGONO")
            {
                using (var campoArea = new OSGeo.OGR.FieldDefn("AREA_M2", OSGeo.OGR.FieldType.OFTReal)) { campoArea.SetPrecision(2); layer.CreateField(campoArea, 1); }
            }
            else if (novaCamadaGeometria == "LINHA")
            {
                using (var campoComp = new OSGeo.OGR.FieldDefn("COMPRIM_M", OSGeo.OGR.FieldType.OFTReal)) { campoComp.SetPrecision(2); layer.CreateField(campoComp, 1); }
            }
            else if (novaCamadaGeometria == "PONTO")
            {
                using (var campoCoordX = new OSGeo.OGR.FieldDefn("COORD_X", OSGeo.OGR.FieldType.OFTReal)) { campoCoordX.SetPrecision(6); layer.CreateField(campoCoordX, 1); }
                using (var campoCoordY = new OSGeo.OGR.FieldDefn("COORD_Y", OSGeo.OGR.FieldType.OFTReal)) { campoCoordY.SetPrecision(6); layer.CreateField(campoCoordY, 1); }
            }

            using (var campoData = new OSGeo.OGR.FieldDefn("DATA_CRIAC", OSGeo.OGR.FieldType.OFTString)) { campoData.SetWidth(15); layer.CreateField(campoData, 1); }

            // 6. Fecha o bloqueio do Windows (Liberta os ficheiros criados)
            layer.Dispose();
            ds.Dispose();

            // =====================================================================
            // >>> 3. ALOCAÇÃO NA MEMÓRIA DA INTERFACE DO GEONEX
            // =====================================================================

            // Pede ao sistema para carregar o ficheiro que acabou de nascer físico para a memória do mapa
            await Task.Run(() =>
            {
                ProjetoService.CarregarShapefileParaMotorMapas(caminhoFinal, nomeFicheiroLimpo, MapService);
            });

            // Impede duplicatas e expande o painel ao importar a primeira camada.
            RegistrarNovaCamada(new Camada
            {
                Nome = nomeFicheiroLimpo,
                Tipo = "Vetor",
                Visivel = true,
                CaminhoArquivo = caminhoFinal,
                Geometria = novaCamadaGeometria
            }, inserirNoInicio: true);

            // Aplica o Estilo Verde/Esmeralda automático para novas camadas de aquisição
            MapService.EstilosPorCamada[nomeFicheiroLimpo] = new GeoNex.Services.EstiloCamada
            { CorPreenchimento = "#10b981", CorBorda = "#047857", Tamanho = 2, TipoSimbologia = "UNICA", Opacidade = 0.5f };

            // Diz ao menu flutuante para focar na camada nova!
            _camadaDestinoAquisicao = nomeFicheiroLimpo;

            // =====================================================================
            // >>> O ELO PERDIDO DO FLUXOGRAMA (MÁQUINA DE ESTADOS) <<<
            // Força a mudança da ferramenta de desenho para bater com a geometria!
            // =====================================================================
            if (novaCamadaGeometria == "PONTO") TrocarFerramenta(ModoFerramenta.AquisicaoPonto);
            else if (novaCamadaGeometria == "LINHA") TrocarFerramenta(ModoFerramenta.AquisicaoLinha);
            else TrocarFerramenta(ModoFerramenta.AquisicaoPoligono);

            exibirModalNovaCamada = false;
            novaCamadaNome = "";

            SincronizarHierarquia();
            SolicitarNovoFrame();
            StateHasChanged();

           

            // Alerta de sucesso silencioso via consola para auditoria
            await JSRuntime.InvokeVoidAsync("console.log", $"Shapefile criado com sucesso: {caminhoFinal}");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"ERRO FATAL DE I/O FÍSICO:\n{ex.Message}");
        }
    }

