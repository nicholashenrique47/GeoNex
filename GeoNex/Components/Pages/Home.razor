        <div style="display: flex; align-items: center; gap: 15px;">

            <button class="tool-btn"
                    style="@(temEdicoesPendentes || MapService.PontosAquisicao.Count > 0 ? "color: #facc15; border: 1px solid #facc15; font-weight: bold; background: rgba(250, 204, 21, 0.1);" : "opacity: 0.3; cursor: not-allowed; border: 1px solid rgba(255,255,255,0.1);")"
                    @onclick="ConfirmarTodasEdicoes"
                    disabled="@((!temEdicoesPendentes && MapService.PontosAquisicao.Count == 0) || _salvandoEdicoes)"
                    title="@(MapService.PontosAquisicao.Count >= MinimoPontosAquisicao && MapService.PontosAquisicao.Count > 0 ? "Finalizar o desenho atual e gravar as edições da camada." : MapService.PontosAquisicao.Count > 0 ? "Complete os vértices do desenho para gravá-lo." : temEdicoesPendentes ? "Gravar as feições concluídas no arquivo da camada." : "Nenhuma edição pendente.")">
                @(_salvandoEdicoes ? "SALVANDO…" : "SALVAR EDIÇÕES")
            </button>

