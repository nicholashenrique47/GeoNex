    }
    .project-start-screen { position: fixed; inset: 0; z-index: 30000; display: grid; box-sizing: border-box; grid-template-columns: minmax(0,1fr); grid-template-rows: minmax(0,1fr); place-items: center; overflow: hidden; padding: 96px clamp(12px,4vw,60px) 50px; color: #dbe5ef; background: rgba(4,9,15,.2); backdrop-filter: blur(2px); font-family: 'Segoe UI',Inter,sans-serif; }
    .project-start-screen::before { content: none; }
    .project-start-workspace { display: flex; box-sizing: border-box; width: min(960px,100%); height: min(610px,calc(100vh - 146px)); min-height: 370px; min-width: 0; flex-direction: column; overflow: hidden; border: 1px solid #3a4a58; border-radius: 7px; background: rgba(14,21,29,.98); box-shadow: 0 24px 90px rgba(0,0,0,.62),0 4px 16px rgba(0,0,0,.28); }
    .project-start-topbar { height: 65px; flex: 0 0 65px; justify-content: flex-start; gap: 18px; padding: 0 21px; border-bottom: 1px solid #2a3946; background: #111a23; }
    .project-start-brand { flex: 0 0 auto; gap: 10px; margin: 0; padding: 0 18px 0 0; border: 0; border-right: 1px solid #2a3946; }
    .project-start-logo { flex: 0 0 33px; width: 33px; height: 33px; border-radius: 5px; }
    .project-start-brand-name { font-size: 12px; letter-spacing: 1.1px; }
    .project-start-brand-subtitle { margin-top: 2px; font-size: 8px; letter-spacing: .65px; }
    .project-start-dialog-title { display: grid; gap: 3px; }
    .project-start-dialog-title > span { color: #7ca0b0; font-size: 8px; font-weight: 750; letter-spacing: 1px; }
    .project-start-dialog-title h1 { margin: 0; color: #eff5f8; font-size: 16px; font-weight: 700; }
    .project-start-topbar-meta { margin-left: auto; color: #8294a5; font-size: 8px; letter-spacing: .6px; }
    .project-start-content { display: flex; width: auto; min-height: 0; flex: 1; flex-direction: column; overflow: hidden; margin: 0; padding: 18px 23px 15px; }
    .project-start-page-heading { flex: 0 0 auto; margin: 0 0 14px; }
    .project-start-eyebrow { color: #76bfd0; font-size: 8px; letter-spacing: .9px; }
    .project-start-description { margin-top: 5px; color: #9aabba; font-size: 10px; }
    .project-start-body { display: grid; min-width: 0; min-height: 0; flex: 1; grid-template-columns: minmax(0,1.2fr) minmax(0,.8fr); gap: 18px; }
    .project-start-recent-panel { display: flex; min-width: 0; min-height: 0; flex-direction: column; padding: 0; border: 0; background: transparent; box-shadow: none; }
    .project-start-recent-heading { flex: 0 0 auto; padding: 0 0 9px; }
    .project-start-recent-heading h2 { color: #e4edf3; font-size: 12px; }
    .project-start-recent-heading h2 span { margin-left: 5px; font-size: 9px; }
    .project-start-view-toggle { flex: 0 0 auto; }
    .project-start-recent-search-row { flex: 0 0 auto; padding: 0 0 8px; }
    .project-start-search { width: 100%; }
    .project-start-recent-list { display: grid; grid-auto-rows: min-content; align-content: start; min-height: 0; flex: 1; max-height: none; border-top: 1px solid #263541; }
    .project-start-recent-item { min-height: 51px; padding: 7px 5px; }
    .project-start-recent-grid { min-height: 0; flex: 1; max-height: none; overflow-y: auto; align-content: start; border-top: 1px solid #263541; }
    .project-start-empty { min-height: 0; flex: 1; border-top: 1px solid #263541; }
    .project-start-launcher { display: flex; min-width: 0; flex-direction: column; padding-left: 18px; border-left: 1px solid #2a3946; }
    .project-start-launcher > h2 { margin: 5px 0 11px; color: #e4edf3; font-size: 12px; }
    .project-start-template-tile { display: grid; width: 100%; grid-template-columns: minmax(0,1fr) auto; gap: 8px; padding: 8px; border: 1px solid #30414e; border-radius: 4px; color: inherit; background: #131e28; text-align: left; cursor: pointer; transition: border-color .15s,background .15s; }
    .project-start-template-tile:hover { border-color: #43899a; background: #192a35; }
    .project-start-map-preview { position: relative; display: block; height: 110px; grid-column: 1 / -1; overflow: hidden; border: 1px solid #344a56; border-radius: 3px; background: linear-gradient(135deg,#1b3138 0%,#223a3b 36%,#1b343d 37%,#233b3e 67%,#1b3038 68%); }
    .project-start-map-preview::before { position: absolute; top: 38%; left: -8%; width: 120%; height: 27px; border-top: 3px solid rgba(94,202,213,.73); border-bottom: 1px solid rgba(127,215,220,.38); content: ''; transform: rotate(-13deg); }
    .project-start-map-preview > span { position: absolute; inset: 0; background-image: linear-gradient(24deg,transparent 42%,rgba(213,195,142,.36) 42.5%,rgba(213,195,142,.36) 43.5%,transparent 44%),linear-gradient(146deg,transparent 26%,rgba(213,195,142,.24) 26.5%,rgba(213,195,142,.24) 27.2%,transparent 27.7%),linear-gradient(0deg,transparent 72%,rgba(162,194,156,.16) 72.5%,rgba(162,194,156,.16) 82%,transparent 82.5%); }
    .project-start-template-copy { display: grid; align-content: center; gap: 4px; }
    .project-start-template-copy strong { color: #e5edf2; font-size: 10px; }
    .project-start-template-copy small { color: #879aa8; font-size: 8px; line-height: 1.4; }
    .project-start-template-tile .project-start-action-arrow { align-self: center; }
    .project-start-launcher-divider { display: flex; align-items: center; gap: 9px; margin: 14px 0 10px; color: #748797; font-size: 9px; }
    .project-start-launcher-divider::before,.project-start-launcher-divider::after { height: 1px; flex: 1; background: #283742; content: ''; }
    .project-start-open-button { width: 100%; min-height: 34px; }
    .project-start-launcher-note { margin: auto 0 0; padding-top: 18px; color: #748797; font-size: 9px; line-height: 1.55; }
    .project-start-loading { display: flex; min-height: 40px; align-items: center; gap: 10px; margin: 0 0 12px; padding: 8px 11px; border: 1px solid #315564; border-radius: 4px; color: #cfeaf0; background: #142b36; font-size: 9px; }
    .project-start-loading strong { display: block; margin-bottom: 2px; color: #e6f8fb; font-size: 10px; }
    .project-start-loading-spinner { width: 16px; height: 16px; flex: 0 0 16px; border: 2px solid rgba(129,202,218,.26); border-top-color: #70c6d8; border-radius: 50%; animation: project-start-spin .8s linear infinite; }
    @@keyframes project-start-spin { to { transform: rotate(360deg); } }
    .project-start-recent-open:disabled,.project-start-recent-remove:disabled,.project-start-template-tile:disabled,.project-start-open-button:disabled,.project-start-button:disabled { opacity: .5; cursor: wait; }
    .project-start-footer { min-height: 30px; flex: 0 0 30px; padding: 0 21px; color: #748798; font-size: 8px; }
    .project-start-footer span:first-child { color: #91a4b3; font-weight: 750; letter-spacing: .7px; }
    @@media (max-width: 760px) {
        .project-start-screen { padding: 54px 10px 12px; }
        .project-start-workspace { width: 100%; height: min(700px,calc(100vh - 124px)); min-height: 0; }
        .project-start-topbar { gap: 10px; padding: 0 12px; }
        .project-start-brand { gap: 7px; margin-right: 0; padding-right: 10px; }
        .project-start-brand-subtitle,.project-start-topbar-meta { display: none; }
        .project-start-content { overflow: auto; padding: 15px; }
        .project-start-body { flex: none; grid-template-columns: 1fr; gap: 15px; }
        .project-start-recent-panel { min-height: 185px; }
        .project-start-recent-list,.project-start-recent-grid { min-height: 140px; max-height: 220px; }
        .project-start-launcher { padding: 14px 0 0; border-top: 1px solid #2a3946; border-left: 0; }
        .project-start-map-preview { height: 82px; }
        .project-start-launcher-note { margin-top: 10px; padding-top: 0; }
        .project-start-footer { padding: 0 12px; }
        .project-start-footer span:last-child { max-width: 65%; text-align: right; }
    }
    @@media (max-width: 820px) {
        .tool-panels-toggle { display: inline-flex; }
        .geonex-ui:has(.digitizing-toolbar) > div.glass-panel { display: none; }
