        .digitizing-toolbar .btn-clean { padding: 7px 9px; font-size: 11px; }
        .measurement-units { grid-template-columns: 1fr; }
    }
</style>

@if (_mostrarTelaInicialProjeto && !ProjetoService.TemProjetoAberto)
{
    <main class="project-start-screen" aria-label="Tela inicial de projetos do GeoNex">
        <section class="project-start-workspace" aria-labelledby="project-start-title">
            <header class="project-start-topbar">
            <div class="project-start-brand">
                <div class="project-start-logo" aria-hidden="true">GN</div>
                <div>
                    <div class="project-start-brand-name">GEONEX</div>
                    <div class="project-start-brand-subtitle">PRO · DESKTOP GIS</div>
                </div>
            </div>
                <div class="project-start-dialog-title">
                    <span>INICIAR TRABALHO</span>
                    <h1 id="project-start-title">Projetos</h1>
                </div>
                <span class="project-start-topbar-meta">PROJETO LOCAL · .GNX</span>
            </header>
            <div class="project-start-content">
                <div class="project-start-page-heading">
                    <div>
                        <span class="project-start-eyebrow">Bem-vindo ao GeoNex</span>
                        <p class="project-start-description">Abra um projeto recente ou comece um novo mapa.</p>
                    </div>
                </div>
                @if (_abrindoProjeto)
                {
                    <div class="project-start-loading" role="status" aria-live="polite">
                        <span class="project-start-loading-spinner" aria-hidden="true"></span>
                        <span><strong>Abrindo projeto</strong>@_statusAberturaProjeto</span>
                    </div>
                }

                <div class="project-start-body">
                    <section class="project-start-recent-panel" aria-labelledby="project-start-recent-title">
                        <div class="project-start-recent-heading">
                            <h2 id="project-start-recent-title">Projetos recentes <span>@ProjetosRecentesFiltrados.Count() de @_projetosRecentes.Count</span></h2>
                            <div class="project-start-view-toggle" role="group" aria-label="Modo de exibição">
                                <button type="button" aria-label="Exibir em lista" title="Lista" aria-pressed="@(!_projetosRecentesEmGrade)" @onclick="() => _projetosRecentesEmGrade = false">☷</button>
                                <button type="button" aria-label="Exibir em blocos" title="Blocos" aria-pressed="@_projetosRecentesEmGrade" @onclick="() => _projetosRecentesEmGrade = true">▦</button>
                            </div>
                        </div>
                        <div class="project-start-recent-search-row">
                            <input class="project-start-search" aria-label="Pesquisar projetos recentes" placeholder="Pesquisar projetos recentes…" @bind="_filtroProjetosRecentes" @bind:event="oninput" />
                        </div>
                        @if (!ProjetosRecentesFiltrados.Any())
                        {
                            <div class="project-start-empty">
                                <div class="project-start-empty-mark" aria-hidden="true">⌕</div>
                                <strong>@(_projetosRecentes.Count == 0 ? "Nenhum projeto recente" : "Nenhum projeto encontrado")</strong>
                                <span>@(_projetosRecentes.Count == 0 ? "Os projetos que você abrir ou criar aparecerão aqui, com acesso rápido ao arquivo salvo." : "Tente outro nome ou caminho para localizar um projeto recente.")</span>
                                @if (_projetosRecentes.Count == 0)
                                {
                                    <button type="button" class="project-start-button project-start-button-secondary" @onclick="AbrirProjeto">Abrir projeto…</button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="@(_projetosRecentesEmGrade ? "project-start-recent-grid" : "project-start-recent-list")">
                                @foreach (string caminhoProjetoRecente in ProjetosRecentesFiltrados)
                                {
                                    <div class="project-start-recent-item" @key="caminhoProjetoRecente">
                                        <button type="button" class="project-start-recent-open" disabled="@_abrindoProjeto" title="Abrir @caminhoProjetoRecente" @onclick="() => AbrirProjetoRecenteAsync(caminhoProjetoRecente)">
                                            <span class="project-start-file-icon" aria-hidden="true">GNX</span>
                                            <span class="project-start-recent-copy">
                                                <span class="project-start-recent-name">@Path.GetFileNameWithoutExtension(caminhoProjetoRecente)</span>
                                                <span class="project-start-recent-path">@caminhoProjetoRecente</span>
                                            </span>
                                        </button>
                                        <span class="project-start-recent-date">@ObterUltimaModificacaoProjeto(caminhoProjetoRecente)</span>
                                        @if (TemAutosaveRecuperavel(caminhoProjetoRecente))
                                        {
                                            <button type="button" class="project-start-recent-recovery project-start-recent-recovery-autosave" disabled="@_abrindoProjeto" title="Recuperar a sessão automática mais recente; a versão salva será preservada como ponto de restauração" aria-label="Recuperar sessão automática de @Path.GetFileName(caminhoProjetoRecente)" @onclick="() => RecuperarAutosaveProjetoAsync(caminhoProjetoRecente)">⟳</button>
                                        }
                                        @if (TemPontoRestauracaoProjeto(caminhoProjetoRecente))
                                        {
                                            <button type="button" class="project-start-recent-recovery" disabled="@_abrindoProjeto" title="Abrir a versão anterior salva como uma cópia; o projeto original será preservado" aria-label="Abrir ponto de recuperação de @Path.GetFileName(caminhoProjetoRecente)" @onclick="() => AbrirPontoRestauracaoAsync(caminhoProjetoRecente)">↶</button>
                                        }
                                        <button type="button" class="project-start-recent-remove" disabled="@_abrindoProjeto" title="Remover da lista de recentes" aria-label="Remover @Path.GetFileName(caminhoProjetoRecente) da lista" @onclick="() => RemoverProjetoRecente(caminhoProjetoRecente)">×</button>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    <aside class="project-start-launcher" aria-label="Criar ou abrir projeto">
                        <span class="project-start-eyebrow">Começar</span>
                        <h2>Novo mapa</h2>
                        <button type="button" class="project-start-template-tile" disabled="@_abrindoProjeto" @onclick="AbrirDialogoNovoProjeto">
                            <span class="project-start-map-preview" aria-hidden="true"><span></span></span>
                            <span class="project-start-template-copy"><strong>Mapa 2D em branco</strong><small>Crie um projeto e adicione seus dados geográficos.</small></span>
                            <span class="project-start-action-arrow" aria-hidden="true">›</span>
                        </button>
                        <div class="project-start-launcher-divider"><span>ou</span></div>
                        <button type="button" class="project-start-button project-start-open-button" disabled="@_abrindoProjeto" @onclick="AbrirProjeto">Abrir outro projeto…</button>
                        <p class="project-start-launcher-note">Projetos recentes e novos projetos são salvos no formato GeoNex (.gnx).</p>
                    </aside>
                </div>
            </div>
            <footer class="project-start-footer">
                <span>GEONEX PRO</span>
                <span>O mapa vazio ao fundo será substituído quando você abrir ou criar um projeto.</span>
            </footer>
        </section>
    </main>

    @if (_mostrarDialogoNovoProjeto)
    {
        <div class="project-create-backdrop" role="dialog" aria-modal="true" aria-labelledby="project-create-title" @onclick="FecharDialogoNovoProjeto">
            <section class="project-create-dialog" @onclick:stopPropagation="true">
                <h2 id="project-create-title">Criar projeto em branco</h2>
                <p>O GeoNex cria um arquivo de projeto vazio. Você poderá adicionar camadas e configurar o mapa depois.</p>
                <label class="project-create-field">
                    <span>Nome do projeto</span>
                    <input class="project-create-input" maxlength="120" autofocus @bind="_nomeNovoProjetoInicial" @bind:event="oninput" />
                </label>
                <label class="project-create-field">
                    <span>Pasta onde o projeto será salvo</span>
                    <span class="project-create-path-row">
                        <input class="project-create-input" @bind="_pastaNovoProjetoInicial" @bind:event="oninput" />
                        <button type="button" class="project-create-browse" @onclick="EscolherPastaNovoProjetoAsync">Escolher…</button>
                    </span>
                </label>
                <footer class="project-create-actions">
                    <button type="button" class="project-start-button project-start-button-secondary" @onclick="FecharDialogoNovoProjeto">Cancelar</button>
                    <button type="button" class="project-start-button" @onclick="CriarProjetoEmBrancoDaTelaInicialAsync">Criar projeto</button>
                </footer>
            </section>
        </div>
    }
}

@if (_mostrarDialogoTransicaoProjeto)
{
    <div class="project-create-backdrop" role="dialog" aria-modal="true" aria-labelledby="project-transition-title" @onclick="() => ResponderTransicaoProjeto(DecisaoTransicaoProjeto.Cancelar)">
        <section class="project-create-dialog project-transition-dialog" @onclick:stopPropagation="true">
            <h2 id="project-transition-title">Há alterações não salvas</h2>
            <p>Escolha como tratar as alterações antes de @(_destinoTransicaoProjeto).</p>
            <div class="project-transition-copy">
                <strong>@_nomeProjetoTransicao</strong>
                <span>Salvar atualiza o arquivo do projeto. Descartar mantém a última versão salva. Cancelar retorna ao projeto sem trocar de arquivo.</span>
            </div>
            <footer class="project-transition-actions">
                <button type="button" @onclick="() => ResponderTransicaoProjeto(DecisaoTransicaoProjeto.Cancelar)">Cancelar</button>
                <button type="button" class="project-transition-discard" @onclick="() => ResponderTransicaoProjeto(DecisaoTransicaoProjeto.Descartar)">Descartar alterações</button>
                <button type="button" class="project-transition-save" @onclick="() => ResponderTransicaoProjeto(DecisaoTransicaoProjeto.Salvar)">Salvar</button>
            </footer>
        </section>
    </div>
}

<!-- A INTERFACE FLUTUANTE -->
<div class="geonex-ui @(FerramentaDesenhoAtiva ? "is-digitizing" : _ferramentaAtiva == ModoFerramenta.Medicao ? "is-measuring" : "") @(_painelCamadasAberto ? "layers-panel-open" : "") @(_painelIdentificarAberto ? "identify-panel-open" : "") @(_mostrarMenuPrincipal ? "show-app-menu" : "") @(!string.IsNullOrEmpty(_menuSuperiorAberto) ? "app-dropdown-open" : "") @(FerramentaDesenhoAtiva ? (_modoAvancadoVetorizacao ? "digitizing-advanced" : "digitizing-simple") : "")">
    
    <!-- HUD DE TELEMETRIA DE HARDWARE -->
    <div class="glass-panel" style="position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); z-index: 1000; padding: 10px 20px; display: flex; gap: 20px; font-family: 'Consolas', monospace; font-size: 0.85rem; color: #00ffcc; pointer-events: none; border-radius: 8px;">
        <div style="display: flex; flex-direction: column; align-items: center;">
            <span style="font-size: 0.6rem; color: #888;">MOTOR GRÁFICO</span>
            <strong>@GeoNex.Services.LocalMapServer.RenderEngine</strong>
        </div>
        <div style="width: 1px; background: #333;"></div>
        <div style="display: flex; flex-direction: column; align-items: center;">
            <span style="font-size: 0.6rem; color: #888;">LATÊNCIA DA REDE/JS</span>
            <strong>@(_jsLatency.ToString("F1")) ms</strong>
        </div>
        <div style="width: 1px; background: #333;"></div>
        <div style="display: flex; flex-direction: column; align-items: center;">
            <span style="font-size: 0.6rem; color: #888;">NÚCLEOS ATIVOS</span>
            <strong>@Environment.ProcessorCount Threads</strong>
        </div>
        <div style="width: 1px; background: #333;"></div>
        <div style="display: flex; flex-direction: column; align-items: center;">
            <span style="font-size: 0.6rem; color: #888;">RAM (USO / MAX GDAL)</span>
            <strong>@(_ramEmUsoMB) MB / @(_gdalLimitMB) MB</strong>
        </div>
    </div>

    <!-- BARRA SUPERIOR (HEADER & RIBBON) -->
    @if (_mostrarMenuPrincipal || _menuSuperiorAberto is not null)
    {
        <button type="button" class="menu-dismiss-layer" aria-label="Fechar menu e voltar ao mapa" tabindex="-1" @onclick="FecharMenusSuperiores"></button>
    }

    <header class="glass-panel top-bar" @onclick="FecharMenusSuperiores" style="display: flex; align-items: center; justify-content: flex-start; padding: 0 20px; gap: 15px;">

        <div class="brand-group" style="margin-right: 15px;">
            <h1>GEONEX</h1>
            <span class="sub-brand">PRO</span>
        </div>

        <button class="app-menu-toggle workbench-button" aria-controls="geonex-main-menu" aria-expanded="@_mostrarMenuPrincipal" @onclick="AlternarMenuPrincipal" @onclick:stopPropagation="true">Menu</button>
        <nav id="geonex-main-menu" class="main-menu" aria-label="Comandos do aplicativo" @onkeydown="TecladoMenuSuperior" style="display: flex; height: 100%; align-items: stretch; margin-right: auto;">
            <div class="dropdown @(_menuSuperiorAberto == "arquivo" ? "is-open" : "")" style="display:flex;align-items:center;height:100%">
                <button class="menu-btn" aria-haspopup="true" aria-expanded="@(_menuSuperiorAberto == "arquivo")" @onclick='() => AlternarMenuSuperior("arquivo")' @onclick:stopPropagation="true">Arquivo ▾</button>
                <div class="dropdown-content file-menu-popover">
                    <span class="file-menu-section-label">Projeto</span>
                    <button type="button" @onclick="CriarNovoProjeto">Novo Projeto…</button>
                    <button type="button" @onclick="AbrirProjeto">Abrir Projeto…</button>
                    <span class="file-menu-section-label recent-project-heading">Projetos recentes</span>
                    @if (_projetosRecentes.Count == 0)
                    {
                        <div class="file-menu-empty">Os projetos abertos aparecerão aqui.</div>
                    }
                    else
                    {
                        @foreach (string caminhoRecente in _projetosRecentes)
                        {
