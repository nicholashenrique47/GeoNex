    public void TrocarFerramenta(ModoFerramenta novaFerramenta)
    {
        if (_ferramentaAtiva == novaFerramenta) return;
        if ((_ferramentaAtiva is ModoFerramenta.AquisicaoPoligono or ModoFerramenta.AquisicaoLinha or ModoFerramenta.AquisicaoPonto) &&
            MapService.PontosAquisicao.Count > 0)
        {
            mensagemVetorizacao = "Conclua ou cancele o desenho antes de trocar de ferramenta. Os pontos foram preservados.";
            StateHasChanged();
            return;
        }
        FecharEntradaPrecisa();

        // 1. Limpeza Estrita de Memória
        if (_ferramentaAtiva == ModoFerramenta.Medicao)
        {
            HistoricoMedicao.Clear();
            LimparCursorDesenho();
            _medicaoConcluida = false;
            RecalcularMedicoes(false);
            _distanciaTotalMetros = 0;
            _areaTotalM2 = 0;
        }
        else if (_ferramentaAtiva == ModoFerramenta.Identificacao)
        {
            MapService.DestacarFeicao(null);
            camadaSelecionadaPainel = string.Empty;
            atributosFeicaoSelecionada?.Clear();
            _geometriaDestacada = null;
        }
        // A CORREÇÃO: Limpa a memória independentemente se era Polígono, Linha ou Ponto
        else if (_ferramentaAtiva == ModoFerramenta.AquisicaoPoligono ||
                 _ferramentaAtiva == ModoFerramenta.AquisicaoLinha ||
                 _ferramentaAtiva == ModoFerramenta.AquisicaoPonto)
        {
            HistoricoAquisicao.Clear();
            LimparCursorDesenho();
            LimparMetricasAquisicao();
        }
        else if (_ferramentaAtiva == ModoFerramenta.EdicaoVertice)
        {
            modoEdicaoVerticeLigado = false;
        }

        if (novaFerramenta is ModoFerramenta.Medicao or ModoFerramenta.Identificacao)
            _painelIdentificarAberto = true;
        else if (_ferramentaAtiva == ModoFerramenta.Medicao && atributosFeicaoSelecionada.Count == 0)
            _painelIdentificarAberto = false;

        _ferramentaAtiva = novaFerramenta;
        MapService.ClientRenderedMeasurementPreview = novaFerramenta == ModoFerramenta.Medicao;
        JSRuntime.InvokeVoidAsyncSafe("GeoNexGraphics.definirCursorMedicaoAtivo", novaFerramenta == ModoFerramenta.Medicao);
        if (novaFerramenta == ModoFerramenta.Medicao)
        {
            if (!_measurementPanelPositionInitialized)
            {
                _measurementPanelX = Math.Max(8, _larguraTela - 376);
                _measurementPanelY = 72;
                _measurementPanelPositionInitialized = true;
            }
            JSRuntime.InvokeVoidAsyncSafe("GeoNexGraphics.definirMouseESnap", null, null, null, null, null, 0);
        }
        if (novaFerramenta != ModoFerramenta.AquisicaoPoligono)
            MapService.ConstrucaoAtiva = ConstructionMode.Vertices;
        mensagemVetorizacao = "";

        // AVISAR A PLACA GRÁFICA: Transmite o tipo de geometria para o LocalMapServer
        if (novaFerramenta == ModoFerramenta.AquisicaoLinha) MapService.TipoGeometriaAtiva = "LINHA";
        else if (novaFerramenta == ModoFerramenta.AquisicaoPonto) MapService.TipoGeometriaAtiva = "PONTO";
        else MapService.TipoGeometriaAtiva = "POLIGONO";
        SincronizarPreviaVetorizacaoCliente();

        if (_ferramentaAtiva == ModoFerramenta.EdicaoVertice)
        {
            modoEdicaoVerticeLigado = true;
        }

        InvokeAsync(StateHasChanged);

        try
        {
            JSRuntime.InvokeVoidAsyncSafe("mapEngine.setFerramenta", novaFerramenta.ToString());
            _ = SincronizarOverlay(false);
            SolicitarNovoFrame();
        }
        catch (Exception ex) { Console.WriteLine($"Aviso JS/Interop: {ex.Message}"); }
    }
