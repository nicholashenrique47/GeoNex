    private void AplicarVetorRestritoCogo()
    {
        if (MapService.PontosAquisicao.Count == 0 || !_cogoAzimute.HasValue) return;
        try
        {
            var point = MapService.Measurements.ProjectGridVector(MapService.PontosAquisicao[^1],
                _cogoDistancia ?? 0, _cogoAzimute.Value, MapService.ProjetoSRS);
            if (!AdicionarControleAquisicao(point)) return;
            RecalcularMetricasAquisicao(true);
            if (!PreviaVetorizacaoClienteAtiva) SolicitarNovoFrame();
            _focoCogoPendente = true;
        }
        catch (ArgumentException ex) { mensagemVetorizacao = ex.Message; }
        StateHasChanged();
    }

    private void TravarCoordenadaAbsoluta()
    {
        if (_absolutoX is not { } x || _absolutoY is not { } y || !double.IsFinite(x) || !double.IsFinite(y))
        {
            mensagemVetorizacao = "Informe valores X e Y válidos.";
            return;
        }

        string srsEntrada = ObterSrsEntradaAbsoluta();
        try
        {
            string srsProjeto = string.IsNullOrWhiteSpace(MapService.ProjetoSRS)
                ? "EPSG:4326"
                : MapService.ProjetoSRS;
            SkiaSharp.SKPoint point = GeoNex.Services.DigitizingCoordinateProjection.ToMapLocal(
                x, y, srsEntrada, srsProjeto, MapService.OffsetMundoX, MapService.OffsetMundoY);
            MapService.PontoRestricaoAbsoluta = point;
            MapService.PontoCursorMundo = point;
            MapService.PontoCursorSnap = null;
            MapService.PontoCursorSnapTipo = null;
            _ultimoSnapRenderizado = null;
            _coordenadaAbsolutaTravada = true;
            JSRuntime.InvokeVoidAsyncSafe(
                "GeoNexGraphics.definirCoordenadaAbsolutaAquisicao", true, point.X, point.Y);
            mensagemVetorizacao = "Posição fixada. Clique no mapa para inserir o vértice.";
            SolicitarNovoFrame();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Falha ao transformar coordenada F6 de '{srsEntrada}' para '{MapService.ProjetoSRS}': {ex.Message}");
            mensagemVetorizacao = "Não foi possível fixar esse ponto. Confira o SRC e os valores X/Y.";
            return;
        }
    }
    public double ConverterAzimuteParaGrausDecimais(string entrada)
    {
        if (string.IsNullOrWhiteSpace(entrada)) return 0;

        // Limpa símbolos clássicos e transforma tudo num padrão separado por espaços
        entrada = entrada.Replace("°", " ").Replace("'", " ").Replace("\"", " ").Trim();

        // Divide os números (Ex: "90 30 00" vira um array com [90, 30, 00])
        var partes = entrada.Split(new[] { ' ', ',', ';' }, StringSplitOptions.RemoveEmptyEntries);

        double grausDecimais = 0;

        // Converte os Graus
        if (partes.Length > 0 && double.TryParse(partes[0].Replace(".", ","), out double graus))
            grausDecimais += graus;

        // Converte os Minutos
        if (partes.Length > 1 && double.TryParse(partes[1].Replace(".", ","), out double minutos))
            grausDecimais += minutos / 60.0;

        // Converte os Segundos
        if (partes.Length > 2 && double.TryParse(partes[2].Replace(".", ","), out double segundos))
            grausDecimais += segundos / 3600.0;

        return grausDecimais;
    }
