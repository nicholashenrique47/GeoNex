@page "/"
@inject IJSRuntime JSRuntime
@implements IDisposable
@inject GeoNex.Services.ProjetoService ProjetoService
@inject GeoNex.Services.RasterService RasterService
@inject GeoNex.Services.MapRenderingService MapService
@inject GeoNex.Services.ExportService ExportService
@inject GeoNex.Services.WindowCloseCoordinator WindowCloseCoordinator
@using SkiaSharp
@using SkiaSharp.Views.Blazor
@using ProjNet.CoordinateSystems
@using ProjNet.CoordinateSystems.Transformations
@using GeoNex.Services
<PageTitle>GeoNex - Professional GIS</PageTitle>

@if (exibirResumoCarregamentoVetor || exibirNotificacaoSalvamento)
{
    <div class="map-notification-stack @(_mostrarTelaInicialProjeto ? "map-notification-stack-over-start" : "")">
        @if (exibirResumoCarregamentoVetor)
        {
            <div class="vector-load-toast" role="status" aria-live="polite">
                <div class="vector-load-toast-title">VETOR</div>
                <div class="vector-load-toast-name" title="@nomeVetorCarregando">@nomeVetorCarregando</div>
                <div class="vector-load-toast-data">
                    <span>Feições <strong>@(numeroFeicoesCarregamento < 0 ? "carregando..." : numeroFeicoesCarregamento.ToString("N0"))</strong></span>
                    <span>Tempo <strong>@tempoCarregamentoVetor</strong></span>
                </div>
                @if (carregamentoVetorEmAndamento)
                {
                    <div class="vector-load-progress" aria-label="Carregando vetor">
                        <div class="vector-load-progress-bar"></div>
                    </div>
                }
            </div>
        }
        @if (exibirNotificacaoSalvamento)
        {
            <div class="vector-load-toast save-feedback-toast @(notificacaoSalvamentoErro ? "is-error" : "")" role="status" aria-live="@(notificacaoSalvamentoErro ? "assertive" : "polite")">
                <span class="save-feedback-mark" aria-hidden="true">@(notificacaoSalvamentoErro ? "!" : "✓")</span>
                <div class="save-feedback-copy">
                    <div class="vector-load-toast-title">@tituloNotificacaoSalvamento</div>
                    <div class="vector-load-toast-name">@mensagemNotificacaoSalvamento</div>
                </div>
            </div>
        }
    </div>
}

<style>
    .map-notification-stack {
        position: fixed;
        right: 22px;
        bottom: 74px;
        z-index: 10000;
        display: grid;
        gap: 9px;
        width: min(330px, calc(100vw - 32px));
        pointer-events: none;
    }
    .map-notification-stack-over-start { z-index: 30050; }

    .vector-load-toast {
        width: 100%;
        box-sizing: border-box;
        padding: 11px 14px;
        color: #e2e8f0;
        background: rgba(15, 23, 42, 0.94);
        border: 1px solid rgba(16, 185, 129, 0.45);
        border-left: 3px solid #10b981;
        border-radius: 7px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(8px);
        font: 12px 'Inter', 'Segoe UI', sans-serif;
        pointer-events: none;
    }

    .save-feedback-toast { display: flex; align-items: flex-start; gap: 11px; border-color: rgba(16,185,129,.42); }
    .save-feedback-toast.is-error { border-color: rgba(248,113,113,.48); border-left-color: #f87171; }
    .save-feedback-mark { display: grid; flex: 0 0 22px; width: 22px; height: 22px; place-items: center; border-radius: 50%; color: #8ff0ce; background: rgba(16,185,129,.16); font-size: 13px; font-weight: 800; }
    .save-feedback-toast.is-error .save-feedback-mark { color: #fecaca; background: rgba(248,113,113,.16); }
    .save-feedback-copy { min-width: 0; }
    .save-feedback-toast .vector-load-toast-name { max-height: 170px; overflow: auto; white-space: pre-line; overflow-wrap: anywhere; line-height: 1.45; }
    .save-feedback-toast.is-error .vector-load-toast-title { color: #fca5a5; }

    .geonex-alert-stack {
        position: fixed;
        top: 78px;
        right: 22px;
        z-index: 20000;
        display: grid;
        gap: 9px;
        width: min(420px, calc(100vw - 32px));
        max-height: calc(100vh - 100px);
        overflow: auto;
        pointer-events: none;
    }
    .geonex-alert-toast {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        padding: 13px 14px;
        color: #e2e8f0;
        background: rgba(15, 23, 42, .97);
        border: 1px solid rgba(56, 189, 248, .38);
        border-left: 3px solid #38bdf8;
        border-radius: 9px;
        box-shadow: 0 12px 32px rgba(0, 0, 0, .42);
        backdrop-filter: blur(12px);
        font: 12px 'Inter', 'Segoe UI', sans-serif;
        pointer-events: auto;
        animation: geonex-alert-enter .18s ease-out;
    }
    .geonex-alert-toast.is-warning { border-color: rgba(251, 191, 36, .42); border-left-color: #fbbf24; }
    .geonex-alert-toast.is-error { border-color: rgba(248, 113, 113, .48); border-left-color: #f87171; }
    .geonex-alert-mark {
        display: grid;
        flex: 0 0 22px;
        width: 22px;
        height: 22px;
        place-items: center;
        border-radius: 50%;
        color: #bae6fd;
        background: rgba(56, 189, 248, .16);
        font-weight: 800;
    }
    .is-warning .geonex-alert-mark { color: #fde68a; background: rgba(251, 191, 36, .16); }
    .is-error .geonex-alert-mark { color: #fecaca; background: rgba(248, 113, 113, .16); }
    .geonex-alert-copy { flex: 1; min-width: 0; }
    .geonex-alert-title { margin: 1px 0 4px; color: #bae6fd; font-size: 10px; font-weight: 800; letter-spacing: .9px; }
    .is-warning .geonex-alert-title { color: #fde68a; }
    .is-error .geonex-alert-title { color: #fca5a5; }
    .geonex-alert-message { max-height: 220px; overflow: auto; color: #e2e8f0; line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; }
    .geonex-alert-dismiss { flex: 0 0 24px; width: 24px; height: 24px; padding: 0; border: 0; border-radius: 5px; color: #94a3b8; background: transparent; cursor: pointer; }
    .geonex-alert-dismiss:hover { color: #fff; background: rgba(148, 163, 184, .15); }
    @@keyframes geonex-alert-enter { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }

    .vector-load-toast-title { color: #6ee7b7; font-size: 10px; font-weight: 800; letter-spacing: 1px; }
    .vector-load-toast-name { margin-top: 3px; overflow: hidden; color: #fff; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
    .vector-load-toast-data { display: flex; gap: 14px; margin-top: 8px; color: #94a3b8; }
    .vector-load-toast-data strong { color: #f8fafc; font-variant-numeric: tabular-nums; }
    .vector-load-progress { height: 2px; margin-top: 9px; overflow: hidden; background: rgba(255,255,255,0.12); border-radius: 2px; }
    .vector-load-progress-bar { width: 38%; height: 100%; background: #10b981; animation: vector-load-progress 1.1s ease-in-out infinite; }
    @@keyframes vector-load-progress { 0% { transform: translateX(-110%); } 100% { transform: translateX(290%); } }

    .digitizing-toolbar { font-family: 'Segoe UI', sans-serif; }
    .digitizing-toolbar .snap-tolerance { display: grid; gap: 5px; padding: 8px 12px; color: #94a3b8; font-size: 11px; }
    .digitizing-toolbar .snap-tolerance select { width: 100%; }
    .snap-options { position: relative; pointer-events: auto; }
    .snap-options summary { list-style: none; padding: 8px; border-radius: 6px; }
    .snap-options summary:focus-visible { outline: 2px solid #38bdf8; outline-offset: 2px; }
    .snap-options .snap-menu { position: absolute; top: 100%; left: 0; z-index: 1;
        display: grid; width: min(260px, calc(100vw - 40px)); padding: 6px;
        background: #142030; border: 1px solid #36536b; border-radius: 8px;
        box-shadow: 0 10px 28px #0008; }
    .snap-menu .drop-item { width: 100%; box-sizing: border-box; min-height: 36px; }
    .snap-legend { display: flex; flex-wrap: wrap; gap: 6px 10px; padding: 7px 10px 2px; color: #94a3b8; font-size: 10px; border-top: 1px solid rgba(148,163,184,.15); }
    .snap-legend span { display: inline-flex; align-items: center; gap: 4px; }
    .snap-key { width: 8px; height: 8px; display: inline-block; border: 1px solid currentColor; }
    .snap-key.vertex { color: #fde047; }
    .snap-key.midpoint { color: #22d3ee; border-radius: 50%; }
    .snap-key.edge { color: #fb923c; transform: rotate(45deg); }
    .snap-key.intersection { color: #f0abfc; border-radius: 50%; }
    .construction-row { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; border-top: 1px solid #36536b; padding-top: 10px; }
    .sketch-metrics { flex: 1 1 250px; min-width: 220px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 10px; color: #67e8f9; font-size: 12px; }
    .sketch-metrics small { color: #94a3b8; font-size: 10px; }
    .sketch-metrics-error { color: #fca5a5 !important; }
    .measurement-units { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px; color: #94a3b8; font-size: 0.7rem; }
    .measurement-units label { display: grid; gap: 6px; }
    .measurement-units .gis-select { min-width: 0; width: 100%; }
    .measurement-feedback { display: block; margin-top: 7px; color: #67e8f9; text-align: center; font-size: 0.72rem; }
    .tool-panels-toggle { display: none; }
    .construction-row label { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 12px; }
    .construction-hint { flex: 1 1 200px; color: #b9cce0; font-size: 12px; }
    .project-start-screen { position: fixed; inset: 0; z-index: 30000; display: grid; grid-template-columns: 238px minmax(0,1fr); overflow: hidden; color: #dbe5ef; background: #0e151d; font-family: 'Segoe UI',Inter,sans-serif; }
    .project-start-sidebar { display: flex; flex-direction: column; min-width: 0; padding: 21px 15px 14px; border-right: 1px solid #263340; background: #111b25; }
    .project-start-brand { display: flex; align-items: center; gap: 11px; padding: 1px 9px 22px; border-bottom: 1px solid #263340; }
    .project-start-logo { display: grid; flex: 0 0 36px; width: 36px; height: 36px; place-items: center; border: 1px solid #28748a; border-radius: 7px; color: #84def0; background: #173646; font-size: 12px; font-weight: 900; letter-spacing: -1px; }
    .project-start-brand-name { color: #edf4f8; font-size: 14px; font-weight: 850; letter-spacing: 1.3px; }
    .project-start-brand-subtitle { margin-top: 3px; color: #8194a6; font-size: 9px; letter-spacing: .8px; text-transform: uppercase; }
    .project-start-nav-label { margin: 22px 9px 7px; color: #718497; font-size: 9px; font-weight: 750; letter-spacing: 1px; text-transform: uppercase; }
    .project-start-nav-item { display: flex; width: 100%; min-height: 38px; align-items: center; gap: 11px; margin: 2px 0; padding: 0 10px; border: 1px solid transparent; border-radius: 5px; color: #aebdca; background: transparent; text-align: left; font-size: 11px; cursor: pointer; }
    .project-start-nav-item:hover { color: #edf6fb; background: #1b2a37; }
    .project-start-nav-item-active { border-color: #274655; color: #dcf7fc; background: #193544; }
    .project-start-nav-icon { width: 17px; color: #7fc9dc; text-align: center; font-size: 14px; }
    .project-start-sidebar-spacer { flex: 1; }
    .project-start-sidebar-note { padding: 12px 10px 1px; border-top: 1px solid #263340; color: #788b9e; font-size: 9px; line-height: 1.65; }
    .project-start-sidebar-note strong { display: block; color: #a9bac9; font-size: 9px; font-weight: 700; letter-spacing: .7px; }
    .project-start-workspace { display: flex; min-width: 0; min-height: 0; flex-direction: column; background: #0e151d; }
    .project-start-topbar { display: flex; height: 53px; flex: 0 0 53px; align-items: center; justify-content: space-between; gap: 16px; padding: 0 27px; border-bottom: 1px solid #263340; background: #111a23; }
    .project-start-breadcrumb { color: #eef4f7; font-size: 11px; font-weight: 700; }
    .project-start-breadcrumb span { margin: 0 9px; color: #5d7183; font-weight: 400; }
    .project-start-topbar-meta { color: #8294a5; font-size: 9px; letter-spacing: .35px; }
    .project-start-content { width: min(1280px,100%); min-height: 0; flex: 1; overflow: auto; margin: 0 auto; padding: 30px clamp(22px,4vw,58px) 24px; }
    .project-start-page-heading { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 19px; }
    .project-start-eyebrow { color: #75cde0; font-size: 9px; font-weight: 750; letter-spacing: 1px; text-transform: uppercase; }
    .project-start-title { margin: 6px 0 0; color: #f0f5f8; font-size: 24px; font-weight: 650; letter-spacing: -.4px; line-height: 1.2; }
    .project-start-description { margin: 6px 0 0; color: #8fa1b1; font-size: 11px; }
    .project-start-action-section { display: grid; grid-template-columns: minmax(0,1.55fr) minmax(220px,.85fr); gap: 12px; margin-bottom: 27px; }
    .project-start-action { display: flex; min-width: 0; min-height: 126px; align-items: center; gap: 17px; padding: 18px; border: 1px solid #2b3a48; border-radius: 6px; color: inherit; background: #141f2a; text-align: left; cursor: pointer; transition: border-color .15s,background .15s; }
    .project-start-action:hover { border-color: #3b8091; background: #182834; }
    .project-start-action-primary { border-color: #2b6475; background: #142936; }
    .project-start-action-icon { display: grid; flex: 0 0 49px; width: 49px; height: 49px; place-items: center; border: 1px solid #315363; border-radius: 5px; color: #8ed8e8; background: #1a3947; font-size: 23px; }
    .project-start-action-copy { min-width: 0; flex: 1; }
    .project-start-action-copy strong { display: block; color: #e9f1f5; font-size: 13px; font-weight: 700; }
    .project-start-action-copy span { display: block; margin-top: 6px; color: #91a3b2; font-size: 10px; line-height: 1.5; }
    .project-start-action-arrow { color: #81c8d8; font-size: 18px; }
    .project-start-recent-panel { min-height: 250px; border-top: 1px solid #293846; }
    .project-start-recent-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 0 11px; }
    .project-start-recent-heading h2 { margin: 0; color: #e4edf3; font-size: 14px; font-weight: 700; }
    .project-start-recent-heading span { margin-left: 8px; color: #788b9d; font-size: 10px; font-weight: 400; }
    .project-start-recent-tools { display: flex; align-items: center; gap: 7px; }
    .project-start-view-toggle { display: inline-flex; gap: 2px; padding: 2px; border: 1px solid #2a3946; border-radius: 4px; background: #121c26; }
    .project-start-view-toggle button { width: 27px; height: 25px; border: 0; border-radius: 3px; color: #8798a7; background: transparent; font-size: 12px; cursor: pointer; }
    .project-start-view-toggle button[aria-pressed="true"] { color: #d9f7fc; background: #254554; }
    .project-start-button { display: inline-flex; min-height: 33px; align-items: center; justify-content: center; gap: 7px; padding: 0 12px; border: 1px solid #34768a; border-radius: 4px; color: #e2f5f8; background: #1b5262; font-size: 10px; font-weight: 700; cursor: pointer; transition: background .15s,border-color .15s; }
    .project-start-button:hover { border-color: #5aafc2; background: #24677a; }
    .project-start-button-secondary { border-color: #344351; color: #c5d2dc; background: #18232e; }
    .project-start-button-secondary:hover { border-color: #547283; color: #edf7fb; background: #202e3b; }
    .project-start-recent-search-row { display: flex; align-items: center; gap: 9px; padding: 0 0 10px; }
    .project-start-search { width: min(360px,100%); height: 32px; padding: 0 10px; border: 1px solid #293945; border-radius: 4px; outline: 0; color: #e0e8ee; background: #111a23; font-size: 10px; }
    .project-start-search:focus { border-color: #38849a; }
    .project-start-search::placeholder { color: #708394; }
    .project-start-recent-list { display: grid; max-height: 360px; overflow-y: auto; }
    .project-start-recent-item { display: flex; min-width: 0; min-height: 56px; align-items: center; gap: 13px; padding: 8px 9px; border-top: 1px solid #22313d; transition: background .15s; }
    .project-start-recent-item:hover { background: #15212b; }
    .project-start-recent-open { display: flex; flex: 1; min-width: 0; align-items: center; gap: 11px; padding: 0; border: 0; color: inherit; background: transparent; text-align: left; cursor: pointer; }
    .project-start-file-icon { display: grid; flex: 0 0 34px; width: 34px; height: 34px; place-items: center; border: 1px solid #315363; border-radius: 4px; color: #90d9e8; background: #193441; font-size: 9px; font-weight: 800; }
    .project-start-recent-copy { display: grid; min-width: 0; gap: 4px; }
    .project-start-recent-name { overflow: hidden; color: #dce6ec; font-size: 11px; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
    .project-start-recent-path { overflow: hidden; color: #8294a3; font-size: 9px; text-overflow: ellipsis; white-space: nowrap; }
    .project-start-recent-date { flex: 0 0 auto; color: #8293a2; font-size: 9px; }
    .project-start-recent-remove { flex: 0 0 26px; width: 26px; height: 26px; border: 0; border-radius: 4px; color: #708392; background: transparent; font-size: 15px; cursor: pointer; }
    .project-start-recent-remove:hover { color: #ffc3c3; background: #39252a; }
    .project-start-recent-recovery { flex: 0 0 26px; width: 26px; height: 26px; border: 1px solid #344b58; border-radius: 4px; color: #8fd5e2; background: #142630; font-size: 14px; cursor: pointer; }
    .project-start-recent-recovery:hover { border-color: #43899a; color: #d9f7fc; background: #1b3945; }
    .project-start-recent-recovery-autosave { border-color: #36715b; color: #a4e6c2; background: #142a22; }
    .project-start-recent-recovery-autosave:hover { border-color: #48a47e; color: #e3fff0; background: #1b3a2e; }
    .project-start-recent-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(210px,1fr)); gap: 10px; max-height: 360px; overflow-y: auto; padding-top: 2px; }
    .project-start-recent-grid .project-start-recent-item { position: relative; min-height: 112px; align-items: flex-start; padding: 13px 10px; border: 1px solid #293946; border-radius: 5px; }
    .project-start-recent-grid .project-start-recent-open { align-items: flex-start; }
    .project-start-recent-grid .project-start-recent-copy { padding-top: 2px; }
    .project-start-recent-grid .project-start-recent-date { position: absolute; right: 38px; bottom: 12px; }
    .project-start-empty { display: grid; min-height: 170px; place-content: center; justify-items: center; gap: 8px; border-top: 1px solid #22313d; color: #8194a4; text-align: center; }
    .project-start-empty-mark { display: grid; width: 38px; height: 38px; place-items: center; border: 1px solid #344957; border-radius: 5px; color: #87cfe0; background: #172732; font-size: 17px; }
    .project-start-empty strong { color: #d3dfe7; font-size: 11px; }
    .project-start-empty span { max-width: 330px; font-size: 10px; line-height: 1.5; }
    .project-start-empty .project-start-button { margin-top: 5px; }
    .project-start-footer { display: flex; min-height: 32px; align-items: center; justify-content: space-between; gap: 15px; padding: 0 27px; border-top: 1px solid #263340; color: #748798; background: #111a23; font-size: 9px; }
    .project-create-backdrop { position: fixed; inset: 0; z-index: 30100; display: grid; place-items: center; padding: 20px; background: rgba(3,8,14,.76); backdrop-filter: blur(9px); }
    .project-create-dialog { width: min(500px,100%); padding: 24px; border: 1px solid rgba(125,211,252,.24); border-radius: 15px; background: linear-gradient(145deg,#172636,#101a26); box-shadow: 0 26px 90px rgba(0,0,0,.55); }
    .project-create-dialog h2 { margin: 0; color: #f1f5f9; font-size: 18px; }
    .project-create-dialog > p { margin: 7px 0 20px; color: #91a2b5; font-size: 11px; line-height: 1.55; }
    .project-create-field { display: grid; gap: 7px; margin-top: 14px; color: #b9c8d8; font-size: 10px; font-weight: 650; }
    .project-create-input { width: 100%; min-width: 0; box-sizing: border-box; height: 39px; padding: 0 11px; border: 1px solid rgba(148,163,184,.23); border-radius: 8px; outline: 0; color: #e2e8f0; background: rgba(8,15,24,.72); font-size: 11px; }
    .project-create-input:focus { border-color: rgba(56,189,248,.7); box-shadow: 0 0 0 3px rgba(56,189,248,.1); }
    .project-create-path-row { display: flex; gap: 8px; }
    .project-create-path-row .project-create-input { flex: 1; }
    .project-create-browse { flex: 0 0 auto; padding: 0 12px; border: 1px solid rgba(148,163,184,.25); border-radius: 8px; color: #cbd5e1; background: rgba(30,41,59,.7); font-size: 10px; cursor: pointer; }
    .project-create-browse:hover { border-color: rgba(56,189,248,.45); color: #e0f2fe; }
    .project-create-actions { display: flex; justify-content: flex-end; gap: 9px; margin-top: 24px; }
    .project-create-actions .project-start-button { margin-top: 0; }
    .project-transition-dialog { width: min(460px,100%); }
    .project-transition-copy { display: grid; gap: 8px; padding: 13px; border: 1px solid rgba(148,163,184,.16); border-radius: 9px; color: #aebdcb; background: rgba(7,14,22,.48); font-size: 11px; line-height: 1.55; }
    .project-transition-copy strong { color: #e6eef4; overflow-wrap: anywhere; }
    .project-transition-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; margin-top: 19px; }
    .project-transition-actions button { min-height: 36px; padding: 0 12px; border: 1px solid #33495b; border-radius: 7px; color: #cbd5e1; background: #172534; font-size: 10px; font-weight: 650; cursor: pointer; }
    .project-transition-actions button:hover { border-color: #4f768e; color: #f1f5f9; }
    .project-transition-actions .project-transition-save { border-color: #28788b; color: #dff8fc; background: #155166; }
    .project-transition-actions .project-transition-discard { color: #fca5a5; }
    .project-dirty-indicator { display: inline-flex; align-items: center; gap: 6px; margin-left: 12px; color: #fbbf24; font-size: 10px; }
    .project-dirty-indicator::before { width: 7px; height: 7px; border-radius: 50%; background: currentColor; content: ""; }
    @@media (max-width: 760px) {
