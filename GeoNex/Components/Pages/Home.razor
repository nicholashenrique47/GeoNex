@code {
    private async Task CarregarMapaBaseOnline(string tipo)
    {
        if (!GeoNex.Services.OnlineBasemapPolicy.TryResolve(tipo, out var basemap)) return;
        GeoNex.Services.GdalRuntimeConfiguration.Apply();
        string nome = basemap.LayerName;
        if (_nomesCamadasCarregando.ContainsKey(nome)) return;
        Camada? existente = CamadasAtivas.FirstOrDefault(camada =>
            string.Equals(camada.Nome, nome, StringComparison.OrdinalIgnoreCase));
        if (existente is not null && !existente.PendenteReconexao) return;

        using IDisposable? renderPause = _server is null ? null : await _server.PauseRenderingAsync();
        if (!_nomesCamadasCarregando.TryAdd(nome, 0)) return;
        OSGeo.GDAL.Dataset? datasetAberto = null;
        Camada? offlineAnterior = null;
        int indiceOfflineAnterior = -1;
        int ordemRenderAnterior = MapService.OrdemCamadas.FindIndex(item =>
            string.Equals(item, nome, StringComparison.OrdinalIgnoreCase));
        bool invisivelAnterior = MapService.CamadasInvisiveis.Contains(nome);
        bool haviaLimitesRasterAnterior = MapService.LimitesRasters.TryGetValue(nome, out SkiaSharp.SKRect limitesRasterAnterior);
        string crsAnterior = MapService.ProjetoSRS;
        double offsetXAnterior = MapService.OffsetMundoX;
        double offsetYAnterior = MapService.OffsetMundoY;
        bool offsetDefinidoAnterior = MapService.OffsetMundoDefinido;
        double panXAnterior = MapService.CameraPanX;
        double panYAnterior = MapService.CameraPanY;
        double zoomAnterior = MapService.CameraZoom;
        string? camadaBaseAnterior = _camadaBaseProjeto;
        try
        {
            existente = CamadasAtivas.FirstOrDefault(camada =>
                string.Equals(camada.Nome, nome, StringComparison.OrdinalIgnoreCase));
            if (existente is not null && !existente.PendenteReconexao) return;
            offlineAnterior = existente;
            indiceOfflineAnterior = existente is null ? -1 : CamadasAtivas.IndexOf(existente);

            string xmlTMS = GeoNex.Services.OnlineBasemapPolicy.BuildGdalTmsXml(
                basemap,
                GeoNex.Services.GdalRuntimeConfiguration.BasemapCache);
            string vsiPath = $"/vsimem/basemap_{basemap.Key}.xml";
            byte[] xmlBytes = System.Text.Encoding.UTF8.GetBytes(xmlTMS);
            lock (MapService.GdalRasterLock)
            {
                OSGeo.GDAL.Gdal.FileFromMemBuffer(vsiPath, xmlBytes);
                datasetAberto = OSGeo.GDAL.Gdal.Open(vsiPath, OSGeo.GDAL.Access.GA_ReadOnly);
            }

            // O dataset TMS representa uma pirâmide online, não uma ortofoto monolítica.
            if (datasetAberto is null) return;
            MapService.RemoveWarpedRaster(nome);
            MapService.RemoveRasterCache(nome);
            MapService.PublishRaster(nome, datasetAberto, xmlTMS);
            datasetAberto = null;
            if (!MapService.OffsetMundoDefinido)
            {
                // Centro inicial: Paraná, Brasil (-48.5747, -25.8828) em EPSG:3857
                double lon = -48.5747;
                double lat = -25.8828;
                double x = lon * 20037508.34 / 180.0;
                double y = Math.Log(Math.Tan((90.0 + lat) * Math.PI / 360.0)) / (Math.PI / 180.0);
                y = y * 20037508.34 / 180.0;
                MapService.DefinirOffset(x, x, y, y);
                MapService.ProjetoSRS = "EPSG:3857";
            }

            bool isFirstLayer = !CamadasAtivas.Any(camada =>
                !camada.PendenteReconexao && !ReferenceEquals(camada, offlineAnterior));
            if (offlineAnterior is not null && offlineAnterior.PendenteReconexao)
            {
                CamadasAtivas[indiceOfflineAnterior] = new Camada
                {
                    Nome = nome,
                    Tipo = "Raster",
                    Visivel = offlineAnterior.Visivel,
                    FonteJson = offlineAnterior.FonteJson
                };
                if (offlineAnterior.Visivel) MapService.CamadasInvisiveis.Remove(nome);
                else MapService.CamadasInvisiveis.Add(nome);
            }
            else if (!RegistrarNovaCamada(new Camada { Nome = nome, Tipo = "Raster", Visivel = true }, reservaDoChamador: true))
            {
                throw new InvalidOperationException($"Já existe uma camada chamada '{nome}' no mapa.");
            }
            _camadaBaseProjeto ??= nome;
            if (offlineAnterior is null || offlineAnterior.Visivel) MapService.CamadasInvisiveis.Remove(nome);
            else MapService.CamadasInvisiveis.Add(nome);

            if (isFirstLayer)
            {
                MapService.CameraZoom = 1.0f;
                MapService.CameraPanX = 0;
                MapService.CameraPanY = 0;
                MapService.OffsetMundoX = 0;
                MapService.OffsetMundoY = 0;
            }

            MapService.LimitesRasters[nome] = SrsFactory.IsSame(
                MapService.ProjetoSRS, GeoNex.Services.OnlineBasemapPolicy.WebMercatorSrs)
                ? new SkiaSharp.SKRect(-20037508.34f, -20037508.34f, 20037508.34f, 20037508.34f)
                : SkiaSharp.SKRect.Empty;
            SincronizarHierarquia();
            MapService.RequestRedraw();
            SolicitarNovoFrame();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            datasetAberto?.Dispose();
            RemoverRecursosRaster(nome, null);
            if (haviaLimitesRasterAnterior) MapService.LimitesRasters[nome] = limitesRasterAnterior;
            if (ordemRenderAnterior >= 0)
                MapService.OrdemCamadas.Insert(Math.Clamp(ordemRenderAnterior, 0, MapService.OrdemCamadas.Count), nome);
            if (invisivelAnterior) MapService.CamadasInvisiveis.Add(nome);
            else MapService.CamadasInvisiveis.Remove(nome);
            if (offlineAnterior is not null && indiceOfflineAnterior >= 0 && indiceOfflineAnterior < CamadasAtivas.Count)
            {
                CamadasAtivas.RemoveAll(camada => string.Equals(camada.Nome, nome, StringComparison.OrdinalIgnoreCase));
                CamadasAtivas.Insert(Math.Clamp(indiceOfflineAnterior, 0, CamadasAtivas.Count), offlineAnterior);
            }
            else if (offlineAnterior is null)
            {
                CamadasAtivas.RemoveAll(camada => string.Equals(camada.Nome, nome, StringComparison.OrdinalIgnoreCase));
            }
            MapService.ProjetoSRS = crsAnterior;
            MapService.OffsetMundoX = offsetXAnterior;
            MapService.OffsetMundoY = offsetYAnterior;
            MapService.OffsetMundoDefinido = offsetDefinidoAnterior;
            MapService.CameraPanX = panXAnterior;
            MapService.CameraPanY = panYAnterior;
            MapService.CameraZoom = zoomAnterior;
            _camadaBaseProjeto = camadaBaseAnterior;
            SincronizarHierarquia();
            MapService.RequestRedraw();
            Console.WriteLine("Erro ao carregar Basemap: " + ex.Message);
        }
        finally
        {
            _nomesCamadasCarregando.TryRemove(nome, out _);
        }
    }
