    // =========================================================================
    private double _medicaoComprimentoMetros = 0;
    private double _medicaoAreaM2 = 0;
    private string _medicaoMetodo = "";
    private string? _medicaoAreaErro;
    private double? _medicaoAzimuteGraus;
    private string _medicaoMensagem = "";
    private string _unidadeComprimentoMedicao = "m";
    private string _unidadeAreaMedicao = "m2";

    private double ComprimentoMedicaoExibido => _unidadeComprimentoMedicao switch
    {
        "km" => _medicaoComprimentoMetros / 1000d,
        "ft" => _medicaoComprimentoMetros * 3.280839895013123d,
        "mi" => _medicaoComprimentoMetros / 1609.344d,
        _ => _medicaoComprimentoMetros
    };

    private string RotuloComprimentoMedicao => _unidadeComprimentoMedicao switch
    {
        "km" => "km",
        "ft" => "ft",
        "mi" => "mi",
        _ => "m"
    };

    private double AreaMedicaoExibida => _unidadeAreaMedicao switch
    {
        "ha" => _medicaoAreaM2 / 10000d,
        "km2" => _medicaoAreaM2 / 1_000_000d,
        "ac" => _medicaoAreaM2 * 0.00024710538146716534d,
        _ => _medicaoAreaM2
    };

    private string RotuloAreaMedicao => _unidadeAreaMedicao switch
    {
        "ha" => "ha",
        "km2" => "km²",
        "ac" => "ac",
        _ => "m²"
    };

    private string ResumoMedicao => string.Join(Environment.NewLine,
        new[]
        {
            $"Comprimento: {ComprimentoMedicaoExibido:N2} {RotuloComprimentoMedicao}",
            _medicaoAreaM2 > 0 ? $"Área: {AreaMedicaoExibida:N2} {RotuloAreaMedicao}" : null,
            MapService.MostrarAreaMedicao && MapService.PontosMedicao.Count < 3 ? "Área: indisponível — adicione pelo menos três pontos." : _medicaoAreaErro,
            _medicaoAzimuteGraus is { } azimute ? $"Azimute da última perna: {azimute:N1}°" : null,
            $"SRC: {MapService.ProjetoSRS}",
            $"Pontos confirmados: {MapService.PontosMedicao.Count} (cursor excluído)",
            !string.IsNullOrWhiteSpace(_medicaoMetodo) ? $"Método: {_medicaoMetodo}" : null
        }.Where(linha => linha != null)!);

    private async Task CopiarResumoMedicao()
    {
        if (MapService.PontosMedicao.Count < 2) return;
        // Export a snapshot of committed vertices; moving the cursor must not change it.
        RecalcularMedicoes(false);
        bool falhou = _medicaoFalhou;
        string resumo = ResumoMedicao;
        string erro = _medicaoMetodo;
        RecalcularMedicoes();
        if (falhou)
        {
            _medicaoMensagem = $"Não foi possível copiar: {erro}";
            return;
        }
        try
        {
            await JSRuntime.InvokeVoidAsync("geonexCopiarTexto", resumo);
            _medicaoMensagem = "Resultado dos pontos confirmados copiado. Cursor excluído.";
        }
        catch (JSException ex)
        {
            _medicaoMensagem = $"Não foi possível copiar: {ex.Message}";
        }
        await InvokeAsync(StateHasChanged);
    }

    private void RecalcularMedicoes(bool incluirCursor = true)
    {
        _medicaoFalhou = false;
        _medicaoComprimentoMetros = 0;
        _medicaoAreaM2 = 0;
        _medicaoMetodo = "";
        _medicaoAreaErro = null;
        _medicaoAzimuteGraus = null;
        _medicaoMensagem = "";

        // Cria uma lista temporária unindo os cliques REAIS com a posição flutuante do RATO
        var ptsMapeados = new List<SkiaSharp.SKPoint>(MapService.PontosMedicao);

        if (incluirCursor && !_medicaoConcluida && _ferramentaAtiva == ModoFerramenta.Medicao && ptsMapeados.Count > 0 && MapService.PontoCursorMundo.HasValue)
        {
            ptsMapeados.Add(MapService.PontoCursorMundo.Value);
        }

        if (ptsMapeados.Count < 2) return;

        try
        {
            var resultado = MapService.Measurements.Measure(
                ptsMapeados,
                MapService.ProjetoSRS,
                MapService.OffsetMundoX,
                MapService.OffsetMundoY,
                MapService.MostrarAreaMedicao);
            _medicaoComprimentoMetros = resultado.LengthMetres;
            _medicaoAreaM2 = resultado.AreaSquareMetres ?? 0;
            _medicaoMetodo = resultado.Method;
            _medicaoAreaErro = resultado.AreaError;
            _medicaoAzimuteGraus = MapMeasurementService.GridAzimuth(ptsMapeados[^2], ptsMapeados[^1]);
        }
        catch (ArgumentException ex)
        {
            _medicaoFalhou = true;
            _medicaoMetodo = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _medicaoFalhou = true;
            _medicaoMetodo = ex.Message;
        }
    }

