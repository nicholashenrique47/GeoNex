    private void SincronizarHierarquia(bool solicitarFrame = true)
    {
        var novaOrdem = new List<string>();

        // O Filtro Absoluto: Só injeta na Placa Gráfica se o ícone do olho estiver ligado
        for (int i = CamadasAtivas.Count - 1; i >= 0; i--)
        {
            if (CamadasAtivas[i].Visivel && !CamadasAtivas[i].PendenteReconexao)
            {
                novaOrdem.Add(CamadasAtivas[i].Nome);
            }
        }

        // Publish a complete hierarchy: the online worker must not observe the
        // temporary empty list while the UI is rebuilding visibility/order.
        MapService.OrdemCamadas = novaOrdem;
        _server?.DiscardObsoleteOnlineWork();

        // Proteção contra Seleção Fantasma:
        // Apaga o lote amarelo e limpa o painel se a camada que o contém for ocultada
        if (!string.IsNullOrEmpty(camadaSelecionadaPainel))
        {
            var camadaSel = CamadasAtivas.FirstOrDefault(c => c.Nome == camadaSelecionadaPainel);
            if (camadaSel != null && !camadaSel.Visivel)
            {
                MapService.DestacarFeicao(null);
                camadaSelecionadaPainel = string.Empty;
                atributosFeicaoSelecionada?.Clear();
            }
        }

        if (solicitarFrame) SolicitarNovoFrame();
    }
    [JSInvokable]
    public async Task ProcessarCliqueRaycast(double telaX, double telaY, double[]? displayedMatrix = null)
    {
        var matriz = UsarMatrizApresentada(displayedMatrix, ObterMatrizMatematica());
        if (TentarMapearPontoTelaParaLocal(telaX, telaY, displayedMatrix, matriz, out var ptMundo))
        {
            double xMundo = ptMundo.X + MapService.OffsetMundoX;
            double yMundo = (-ptMundo.Y) + MapService.OffsetMundoY;

            switch (_ferramentaAtiva)
            {
                case ModoFerramenta.Identificacao:
                    float escalaMatriz = matriz.ScaleX;
                    double tolerancia = 5.0 / escalaMatriz;
                    var feicao = MapService.DispararRaycast(yMundo, xMundo, tolerancia, out string camadaAtingida);
                    MapService.DestacarFeicao(feicao);

                    if (feicao != null)
                    {
                        _painelIdentificarAberto = true;
                        camadaSelecionadaPainel = camadaAtingida;
                        atributosFeicaoSelecionada = new Dictionary<string, string>();
                        
                        using var shapefileLease = MapService.AcquireShapefile(feicao.LayerName);
                        if (shapefileLease != null)
                        {
                            atributosFeicaoSelecionada = shapefileLease.Resource.LerAtributos((int)feicao.FID);
                        }
                    }
                    else
                    {
                        camadaSelecionadaPainel = string.Empty;
                        atributosFeicaoSelecionada?.Clear();
                        _geometriaDestacada = null;
                    }
                    _ = SincronizarOverlay(false);
                    break;

                case ModoFerramenta.Medicao:
                    if (_medicaoConcluida) return;
                    var ptFinalMed = ResolverCursorFerramenta(ptMundo, matriz).Position;
                    HistoricoMedicao.Add(ptFinalMed);
                    LimparCursorDesenho();
                    _ultimaAtualizacaoPreviewMedicao = 0;
                    RecalcularMedicoes();
                    _ = SincronizarOverlay(false);
                    break;
                case ModoFerramenta.AquisicaoPonto:
                case ModoFerramenta.AquisicaoLinha:
                case ModoFerramenta.AquisicaoPoligono:
                    if (string.IsNullOrEmpty(_camadaDestinoAquisicao))
                    {
                        JSRuntime.InvokeVoidAsync("alert", "⚠️ SELECIONE UM DESTINO!\n\nPor favor, selecione uma camada no menu superior ou conclua a criação do Novo Ficheiro antes de vetorizar.");
                        return; // Aborta o clique imediatamente! A linha não é desenhada.
                    }

                    bool usarCoordenadaAbsoluta = _coordenadaAbsolutaTravada &&
                        MapService.PontoRestricaoAbsoluta is SkiaSharp.SKPoint;
                    var ptFinalAq = usarCoordenadaAbsoluta
                        ? MapService.PontoRestricaoAbsoluta!.Value
                        : ResolverCursorFerramenta(ptMundo, matriz).Position;
                    var posicaoFechamento = usarCoordenadaAbsoluta
                        ? MapearPontoLocalParaTela(ptFinalAq, displayedMatrix, matriz)
                        : new SkiaSharp.SKPoint((float)telaX, (float)telaY);
                    if (CliqueFechaPoligono(posicaoFechamento, matriz, displayedMatrix))
                    {
                        if (usarCoordenadaAbsoluta) DestravarCoordenadaAbsoluta(solicitarRedesenho: false);
                        ConcluirAquisicaoGeometrica();
                        return;
                    }

                    // ==========================================================
                    // >>> TRAVA TOPOLÓGICA ANTI-DUPLO-CLIQUE E SANGRAMENTO <<<
                    // ==========================================================
                    if (MapService.PontosAquisicao.Count > 0)
                    {
                        var ultimoGravado = MapService.PontosAquisicao.Last();

                        // Sem epsilon em unidades do projeto: 0,001 grau não é 1 mm.
                        if (ptFinalAq == ultimoGravado)
                        {
                            return; // Aborta silenciosamente. Não grava e protege o banco de dados.
                        }
                    }

                    // 3. INJETA O VÉRTICE BLINDADO NA MEMÓRIA
                    if (!AdicionarControleAquisicao(ptFinalAq)) return;
                    if (usarCoordenadaAbsoluta)
                    {
                        DestravarCoordenadaAbsoluta(solicitarRedesenho: false);
                        _focoMapaPendente = true;
                    }
                    RecalcularMetricasAquisicao(true);
                    mensagemVetorizacao = "";
                    if (_ferramentaAtiva == ModoFerramenta.AquisicaoPonto)
                    {
                        ConcluirAquisicaoGeometrica();
                        return; // Aborta o resto, o modal já vai abrir!
                    }
                    if (usarCoordenadaAbsoluta || !PreviaVetorizacaoClienteAtiva) SolicitarNovoFrame();
                    break;
            }
            await InvokeAsync(StateHasChanged);
        }
    }
   
