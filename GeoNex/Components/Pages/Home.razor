    [JSInvokable]
    public void ProcessarTecladoGlobal(string tecla, double clientX = double.NaN, double clientY = double.NaN)
    {
        // A MÁGICA: Transfere o sinal do JavaScript para a Thread Visual do Blazor
        InvokeAsync(async () =>
        {
            tecla = tecla.ToLower();

            // 1. ATALHOS ABSOLUTOS GLOBAIS
            if (tecla == "m") { TrocarFerramenta(ModoFerramenta.Medicao); return; }
            if (tecla == "i") { TrocarFerramenta(ModoFerramenta.Identificacao); return; }
            if (tecla == "d" || tecla == "p") { AtivarModoVetorizacao(); return; }

            // 2. ATALHOS EXCLUSIVOS DA FERRAMENTA DE DESENHO
            if (_ferramentaAtiva is ModoFerramenta.AquisicaoPoligono or ModoFerramenta.AquisicaoLinha or ModoFerramenta.AquisicaoPonto)
            {
                if (tecla == "tab")
                {
                    AbrirEntradaPrecisa(true, clientX, clientY);
                    return;
                }

                if (tecla == "f6")
                {
                    AbrirEntradaPrecisa(false, clientX, clientY);
                    return;
                }

                if (tecla == "escape" && _coordenadaAbsolutaTravada)
                {
                    DestravarCoordenadaAbsoluta();
                    mensagemVetorizacao = "Posição liberada.";
                    StateHasChanged();
                    return;
                }
                if (tecla == "escape") { CancelarAquisicao(); return; }
                if (tecla == "ctrl+y" || tecla == "ctrl+shift+z") { RefazerUltimoPontoAquisicao(); return; }
                if (tecla == "z" || tecla == "ctrl+z" || tecla == "backspace") { DesfazerUltimoPontoAquisicao(); return; }
                if (tecla == "enter" || tecla == "c") { ConcluirAquisicaoGeometrica(); return; }
            }

            if (_ferramentaAtiva == ModoFerramenta.Medicao)
            {
                if (tecla == "enter") { ConcluirMedicao(); return; }
                if (tecla is "ctrl+z" or "z" or "backspace") { AlterarHistoricoMedicao(false); return; }
                if (tecla is "ctrl+y" or "ctrl+shift+z") { AlterarHistoricoMedicao(true); return; }
            }

            // 3. ATALHOS GLOBAIS DE CANCELAMENTO (ESC)
            if (tecla == "escape")
            {
                if (_ferramentaAtiva == ModoFerramenta.Medicao)
                {
                    LimparMedicao();
                }
                else if (_ferramentaAtiva == ModoFerramenta.Identificacao)
                {
                    MapService.DestacarFeicao(null);
                    camadaSelecionadaPainel = string.Empty;
                    atributosFeicaoSelecionada?.Clear();
                    _geometriaDestacada = null;

                    _ = SincronizarOverlay(false);
                    SolicitarNovoFrame();
                    StateHasChanged();
                }
            }
        });
    }
    private void LimparMedicao()
    {
        _medicaoConcluida = false;
        _medicaoFalhou = false;
        _medicaoMensagem = "";
        _ultimaAtualizacaoPreviewMedicao = 0;
        HistoricoMedicao.Clear();
        LimparCursorDesenho();
        _medicaoComprimentoMetros = 0;
        _medicaoAreaM2 = 0;
        _medicaoMetodo = "";
        _medicaoAreaErro = null;
        _medicaoAzimuteGraus = null;

        JSRuntime.InvokeVoidAsyncSafe("GeoNexGraphics.definirCursorMedicaoAtivo", true);
        JSRuntime.InvokeVoidAsyncSafe("GeoNexGraphics.definirMouseESnap", null, null, null, null, null, 0);
        _ = SincronizarOverlay(false);

        StateHasChanged();
    }
