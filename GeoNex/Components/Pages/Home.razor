    private void AbrirPropriedadesSincronizadas(string nomeCamada)
    {
        camadaEmEdicao = nomeCamada;
        abaAtivaPropriedades = "Simbologia";

        // Tenta ir buscar o estilo à Placa Gráfica, ou cria um novo se a camada for virgem
        var estilo = MapService.EstilosPorCamada.TryGetValue(nomeCamada, out var est)
                     ? est : new GeoNex.Services.EstiloCamada();

        // 1. SINCRONIZA A MEMÓRIA DA SIMBOLOGIA E CORES
        tipoSimbologia = string.IsNullOrEmpty(estilo.TipoSimbologia) ? "UNICA" : estilo.TipoSimbologia;
        colunaSimbologiaCategorizada = estilo.ColunaSimbologia ?? "";
        opacidadePreenchimento = (int)(estilo.Opacidade * 100f);
        espessuraLinha = estilo.EspessuraLinha;
        espessuraBorda = estilo.EspessuraBorda;
        tipoLinha = estilo.TipoLinha ?? "Solid";
        tamanhoPonto = estilo.Tamanho;

        // O SEGREDO: Força a interface a ler as cores exatas da camada que acabou de clicar!
        // Se a cor for vazia (camada nova), assume o Ciano Padrão do GeoNex
        semCorPreenchimento = (estilo.CorPreenchimento == "transparent");
        corPreenchimento = string.IsNullOrEmpty(estilo.CorPreenchimento) ? "#38bdf8" : (semCorPreenchimento ? "#38bdf8" : estilo.CorPreenchimento);

        semCorBorda = (estilo.CorBorda == "transparent");
        corBorda = string.IsNullOrEmpty(estilo.CorBorda) ? "#0ea5e9" : (semCorBorda ? "#0ea5e9" : estilo.CorBorda);

        // 2. SINCRONIZA A MEMÓRIA DOS RÓTULOS
        exibirRotulos = estilo.ExibirRotulos;
        colunaRotuloSelecionada = estilo.ColunaRotulo ?? "";
        tamanhoFonteRotulo = (int)(estilo.TamanhoTextoRotulo > 0 ? estilo.TamanhoTextoRotulo : 12f);
        tamanhoHaloRotulo = estilo.TamanhoHaloRotulo;
        corFonteRotulo = string.IsNullOrEmpty(estilo.CorTextoRotulo) ? "#FFFFFF" : estilo.CorTextoRotulo;
        corHaloRotulo = string.IsNullOrEmpty(estilo.CorHaloRotulo) ? "#000000" : estilo.CorHaloRotulo;
        rotuloNegrito = estilo.RotuloNegrito;

        exibirModalPropriedades = true;
    }
    private float _ultimoMidXUI = 0f;
    private float _ultimoMidYUI = 0f;
    private float _ultimaEscalaUI = 1f;

    private SkiaSharp.SKMatrix ObterMatrizMatematica()
{
    SkiaSharp.SKRect limitesTotais = new SkiaSharp.SKRect();
    bool primeiro = true;

    SkiaSharp.SKRect rasterBounds = MapService.LimitesRasterGlobal;
    if (MapService.TemRaster && !rasterBounds.IsEmpty) { limitesTotais = rasterBounds; primeiro = false; }
    if (!MapService.LimitesGlobaisVetor.IsEmpty) {
        if (primeiro) limitesTotais = MapService.LimitesGlobaisVetor;
        else limitesTotais.Union(MapService.LimitesGlobaisVetor);
    }

    float escalaAutoFit; float midX, midY;

    if (limitesTotais.IsEmpty || limitesTotais.Width < 0.001f || limitesTotais.Height < 0.001f)
    {
        escalaAutoFit = _ultimaEscalaUI > 0 ? _ultimaEscalaUI : 1f;
        midX = _ultimoMidXUI; midY = _ultimoMidYUI;
    }
    else
    {
        float escalaX = _larguraTela / limitesTotais.Width;
        float escalaY = _alturaTela / limitesTotais.Height;
        escalaAutoFit = Math.Min(escalaX, escalaY) * 0.8f;
        midX = limitesTotais.MidX; midY = limitesTotais.MidY;

        _ultimaEscalaUI = escalaAutoFit; _ultimoMidXUI = midX; _ultimoMidYUI = midY;
    }

    float zoomReal = (float)(escalaAutoFit * Math.Clamp(MapService.CameraZoom, 0.05, 1_000_000));
    var centroAtual = MapCoordinateSpace.ApplyCssPanToPreciseLocalCenter(
        new MapLocalCoordinate(midX, midY),
        zoomReal,
        MapService.CameraPanX,
        MapService.CameraPanY);
    return MapCoordinateFrame.CreatePrecise(
        ObterMetricasViewport(),
        centroAtual,
        zoomReal).LocalToCssMatrix;
}
    

    private void ExtrairAneisMultiplos(NetTopologySuite.Geometries.Geometry geom, List<List<object>> listaSaida)
    {
        if (geom is NetTopologySuite.Geometries.Polygon poly)
        {
            listaSaida.Add(ConverterCoordenadas(poly.ExteriorRing.Coordinates));
            foreach (var furo in poly.InteriorRings) listaSaida.Add(ConverterCoordenadas(furo.Coordinates));
        }
        else if (geom is NetTopologySuite.Geometries.MultiPolygon multi)
        {
            foreach (NetTopologySuite.Geometries.Polygon p in multi.Geometries) ExtrairAneisMultiplos(p, listaSaida);
        }
        else if (geom is NetTopologySuite.Geometries.LineString linha)
        {
            listaSaida.Add(ConverterCoordenadas(linha.Coordinates));
        }
        else if (geom is NetTopologySuite.Geometries.MultiLineString multiLinha)
        {
            foreach (NetTopologySuite.Geometries.LineString l in multiLinha.Geometries) ExtrairAneisMultiplos(l, listaSaida);
        }
        else
        {
            listaSaida.Add(ConverterCoordenadas(geom.Coordinates));
        }
    }
    private SkiaSharp.SKMatrix ObterMatrizBaseSemMover()
    {
        // Esta matriz ignora o CameraPan e Zoom. Representa a "folha de papel" no estado zero.
        SkiaSharp.SKRect limitesTotais = new SkiaSharp.SKRect();
        bool primeiro = true;
        SkiaSharp.SKRect rasterBounds = MapService.LimitesRasterGlobal;
        if (MapService.TemRaster && !rasterBounds.IsEmpty) { limitesTotais = rasterBounds; primeiro = false; }
        if (!MapService.LimitesGlobaisVetor.IsEmpty) {
            if (primeiro) limitesTotais = MapService.LimitesGlobaisVetor;
            else limitesTotais.Union(MapService.LimitesGlobaisVetor);
        }

        float escalaAutoFit = _ultimaEscalaUI > 0 ? _ultimaEscalaUI : 1f;
        return MapCoordinateFrame.Create(
            ObterMetricasViewport(),
            new SkiaSharp.SKPoint(_ultimoMidXUI, _ultimoMidYUI),
            escalaAutoFit).LocalToCssMatrix;
    }
    private List<object> ConverterCoordenadas(NetTopologySuite.Geometries.Coordinate[] coords)
    {
        var matriz = ObterMatrizMatematica();
        return coords.Select(c =>
        {
            var pt = matriz.MapPoint(new SkiaSharp.SKPoint((float)(c.X - MapService.OffsetMundoX), -(float)(c.Y - MapService.OffsetMundoY)));
            return (object)new { x = pt.X, y = pt.Y };
        }).ToList();
    }
    private async Task SincronizarOverlay(bool pendenteParaSwap = false)
    {
        var destaque = new List<List<object>>();
        if (_geometriaDestacada != null && !_geometriaDestacada.IsEmpty)
            ExtrairAneisMultiplos(_geometriaDestacada, destaque);

        var matrizMedicao = MatrizPreviaVetorizacaoCliente();
        var matrizMedicaoFallback = ObterMatrizMatematica();
        var medicao = MapService.PontosMedicao.Select(p =>
        {
            var pt = MapearPontoLocalParaTela(p, matrizMedicao, matrizMedicaoFallback);
            return (object)new { x = pt.X, y = pt.Y };
        }).ToList();

        if (pendenteParaSwap)
            await JSRuntime.InvokeVoidAsync("GeoNexGraphics.prepararFuturo", destaque, medicao, MapService.MostrarAreaMedicao);
        else
            await JSRuntime.InvokeVoidAsync("GeoNexGraphics.definirAtivos", destaque, medicao, MapService.MostrarAreaMedicao);
    }
    private SkiaSharp.SKPoint MatrizMundoParaLocalImagem(SkiaSharp.SKPoint ptMundo)
    {
        // Mesmo contrato CSS do servidor, sem a deformação instantânea da câmera.
        return ObterMatrizBaseSemMover().MapPoint(ptMundo);
    }

    private MapViewportMetrics ObterMetricasViewport()
    {
        if (MapViewportMetrics.TryCreate(_larguraTela, _alturaTela, _dpiTela, out MapViewportMetrics viewport))
            return viewport;
        return MapViewportMetrics.Create(1920, 1080, 1f);
    }
    private void ConcluirAquisicaoGeometrica()
    {
        if (_ferramentaAtiva is not (ModoFerramenta.AquisicaoPonto or ModoFerramenta.AquisicaoLinha or ModoFerramenta.AquisicaoPoligono)) return;
        string camadaAlvo = _camadaDestinoAquisicao;
        if (!CamadasAtivas.Any(c => c.Nome == camadaAlvo && c.Tipo == "Vetor"))
        {
            mensagemVetorizacao = "Selecione uma camada vetorial de destino. O desenho foi preservado.";
            StateHasChanged();
            return;
        }
        var pontos = MapService.PontosAquisicao.ToList();
        NetTopologySuite.Geometries.Geometry geometriaNts;
        try
        {
            if (ConstrucaoParametrica) pontos = SketchConstruction.Build(ModoConstrucao, pontos, LadosConstrucao).ToList();
            var kind = _ferramentaAtiva switch
            {
                ModoFerramenta.AquisicaoPonto => DigitizingGeometry.Kind.Point,
                ModoFerramenta.AquisicaoLinha => DigitizingGeometry.Kind.Line,
                _ => DigitizingGeometry.Kind.Polygon
            };
            geometriaNts = DigitizingGeometry.Create(kind, pontos.Select(p =>
                new NetTopologySuite.Geometries.Coordinate(p.X + MapService.OffsetMundoX, -p.Y + MapService.OffsetMundoY)));
        }
        catch (ArgumentException ex)
        {
            mensagemVetorizacao = ex.Message.Split(" (Parameter", StringSplitOptions.None)[0];
            StateHasChanged();
            return;
        }

        NetTopologySuite.Features.Feature? novaFeicao = null;
        GeoNex.Services.CompiledFeature? novaFeicaoVisual = null;
        bool indicePublicado = false;
        try
        {
            var atributos = new NetTopologySuite.Features.AttributesTable();
            if (!MapService.FeicoesOriginais.TryGetValue(camadaAlvo, out var colecao))
            {
                colecao = new NetTopologySuite.Features.FeatureCollection();
                MapService.FeicoesOriginais[camadaAlvo] = colecao;
            }

            // Mantém as colunas da tabela alinhadas para não corromper o DBF
            if (colecao.Count > 0 && colecao[0].Attributes != null)
            {
                foreach (var nomeAtributo in colecao[0].Attributes.GetNames())
                {
                    atributos.Add(nomeAtributo, "");
                }
            }

            novaFeicao = new NetTopologySuite.Features.Feature(geometriaNts, atributos);
            colecao.Add(novaFeicao);

            // 1. Injeta na Placa de Vídeo
            var pathRender = new SkiaSharp.SKPath { FillType = (_ferramentaAtiva == ModoFerramenta.AquisicaoPoligono) ? SkiaSharp.SKPathFillType.EvenOdd : SkiaSharp.SKPathFillType.Winding };
            for (int i = 0; i < pontos.Count; i++)
            {
                if (i == 0) pathRender.MoveTo(pontos[i]);
                else pathRender.LineTo(pontos[i]);
            }
            if (_ferramentaAtiva == ModoFerramenta.AquisicaoPoligono) pathRender.Close();

            novaFeicaoVisual = new GeoNex.Services.CompiledFeature
            {
                FID = colecao.Count > 0 ? (long)colecao.Count : 0,
                LayerName = camadaAlvo,
                CentroidLocal = new SKPoint((float)(geometriaNts.Centroid.X - MapService.OffsetMundoX),
                    (float)(MapService.OffsetMundoY - geometriaNts.Centroid.Y)),
                Kind = _ferramentaAtiva == ModoFerramenta.AquisicaoPoligono ? GeoNex.Services.GeometryKind.Polygon : (_ferramentaAtiva == ModoFerramenta.AquisicaoLinha ? GeoNex.Services.GeometryKind.Line : GeoNex.Services.GeometryKind.Point),
                Path = pathRender,
                EnvelopeWorld = new GeoNex.Services.FeatureEnvelope(
                    geometriaNts.EnvelopeInternal.MinX, geometriaNts.EnvelopeInternal.MaxX,
                    geometriaNts.EnvelopeInternal.MinY, geometriaNts.EnvelopeInternal.MaxY)
            };
            novaFeicaoVisual.SetCentroidLocalPrecise(
                geometriaNts.Centroid.X - MapService.OffsetMundoX,
                MapService.OffsetMundoY - geometriaNts.Centroid.Y);

            if (!MapService.FeaturesPorCamada.TryGetValue(camadaAlvo, out var featList))
            {
                featList = new List<GeoNex.Services.CompiledFeature>();
                MapService.FeaturesPorCamada[camadaAlvo] = featList;
            }
            featList.Add(novaFeicaoVisual);

            // 2. Reconstrói a árvore de pesquisa espacial (SNAP)
            MapService.ConstruirIndiceEspacial(camadaAlvo, featList);
            indicePublicado = true;

            // 3. Recalcula as cores se for um mapa temático
            if (MapService.EstilosPorCamada.TryGetValue(camadaAlvo, out var estilo) && estilo.TipoSimbologia == "CATEGORIZADA")
            {
                MapService.CompilarCategorias(camadaAlvo, estilo.ColunaSimbologia);
            }
        }
        catch (Exception ex)
        {
            // Remove only this attempted insertion; retain sketch and undo history.
            if (novaFeicao != null && MapService.FeicoesOriginais.TryGetValue(camadaAlvo, out var colecao))
                colecao.Remove(novaFeicao);
            if (novaFeicaoVisual != null && MapService.FeaturesPorCamada.TryGetValue(camadaAlvo, out var features))
            {
                features.Remove(novaFeicaoVisual);
                if (indicePublicado)
                {
                    try { MapService.ConstruirIndiceEspacial(camadaAlvo, features); }
                    catch (Exception indexError) { Console.Error.WriteLine($"Falha ao atualizar índice após rejeitar feição: {indexError}"); }
                }
                novaFeicaoVisual.Path?.Dispose();
            }
            Console.Error.WriteLine($"Falha ao concluir vetorização: {ex}");
            mensagemVetorizacao = "Não foi possível adicionar a feição à camada. O desenho foi preservado; revise a camada e tente novamente.";
            StateHasChanged();
            return;
        }

        // Acende a luz amarela de "Gravação Pendente" no menu superior
        temEdicoesPendentes = true;
        MapService.RequestRedraw();

        // Limpa a tela
        HistoricoAquisicao.Clear();
        LimparCursorDesenho();
        LimparMetricasAquisicao();
        mensagemVetorizacao = "";

        bool manterPreviaAteFrameFinal = PreviaVetorizacaoClienteAtiva;
        SolicitarNovoFrame(limparPreviaVetorizacaoAoApresentar: manterPreviaAteFrameFinal);
        StateHasChanged();
    }

