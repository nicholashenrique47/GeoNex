    private async Task SelecionarArquivoVetor()
    {
        try
        {
            var opcoes = new PickOptions
            {
                PickerTitle = "Selecione o Vetor (SHP, GeoJSON)",
                FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>> { { DevicePlatform.WinUI, new[] { ".shp", ".geojson", ".kml" } } })
            };
            var resultado = await FilePicker.Default.PickAsync(opcoes);
            if (resultado != null) { caminhoArquivoVetor = resultado.FullPath; StateHasChanged(); }
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"Erro ao selecionar arquivo vetorial: {ex.Message}"); }
    }

    private async Task AdicionarVetorAoMapa()
    {
        string? nomeReservado = null;
        string caminhoFonte = caminhoArquivoVetor;
        string crsAnterior = MapService.ProjetoSRS;
        double offsetXAnterior = MapService.OffsetMundoX;
        double offsetYAnterior = MapService.OffsetMundoY;
        bool offsetDefinidoAnterior = MapService.OffsetMundoDefinido;
        double panXAnterior = MapService.CameraPanX;
        double panYAnterior = MapService.CameraPanY;
        double zoomAnterior = MapService.CameraZoom;
        SKRect limitesVetoriaisAnteriores = MapService.LimitesGlobaisVetor;
        string? camadaBaseAnterior = _camadaBaseProjeto;
        try
        {
            if (string.IsNullOrEmpty(caminhoFonte))
            {
                await JSRuntime.InvokeVoidAsync("alert", "Selecione um arquivo Shapefile primeiro!");
                return;
            }

            exibirModalImportacao = false;
            string nomeArquivo = System.IO.Path.GetFileName(caminhoFonte);
            if (!ReservarNomeCamada(nomeArquivo))
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Já existe uma camada chamada '{nomeArquivo}' no mapa ou ela está sendo carregada.");
                return;
            }
            nomeReservado = nomeArquivo;

            // === A MÁGICA ACONTECE AQUI ===
            // Substituímos o extrator antigo pelo nosso Motor Duplo que carrega o SkiaSharp e a Árvore NTS
            ocultarResumoVetorCts?.Cancel();
            ocultarResumoVetorCts = new CancellationTokenSource();
            exibirResumoCarregamentoVetor = true;
            carregamentoVetorEmAndamento = true;
            nomeVetorCarregando = nomeArquivo;
            numeroFeicoesCarregamento = -1;
            tempoCarregamentoVetor = "0,00 s";
            StateHasChanged();

            var sw = System.Diagnostics.Stopwatch.StartNew();
            using var timer = new System.Threading.Timer(_ => 
            {
                tempoCarregamentoVetor = $"{sw.Elapsed.TotalSeconds:F2} s";
                InvokeAsync(StateHasChanged);
            }, null, 0, 50); // Atualiza a cada 50ms para fluidez

            using IDisposable? renderPause = _server is null ? null : await _server.PauseRenderingAsync();
            await Task.Run(() =>
            {
                // JIT COMPILATION: Converte GeoJSON/KML em Shapefile Binário na hora!
                string caminhoCompilado = ProjetoService.CompilarParaShapefileNativo(caminhoFonte);
                
                // O motor vai sempre receber um binário nativo (.shp) ultrarrápido
                ProjetoService.CarregarShapefileParaMotorMapas(caminhoCompilado, nomeArquivo, MapService);
                MapService.ConstruirIndiceEspacial();
            });

            sw.Stop();
            timer.Change(System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
            
            int fCount = MapService.FeaturesPorCamada.ContainsKey(nomeArquivo) ? MapService.FeaturesPorCamada[nomeArquivo].Count : -1;
            numeroFeicoesCarregamento = fCount;
            tempoCarregamentoVetor = $"{sw.Elapsed.TotalSeconds:F2} s";
            carregamentoVetorEmAndamento = false;
            StateHasChanged();
            _ = OcultarResumoVetorAsync(ocultarResumoVetorCts);


            // CORREÇÃO CRÍTICA: Popula a árvore de busca logarítmica com os lotes importados
            // MapService.ConstruirIndiceEspacial(); já foi movido para dentro da Task.Run para não travar a UI!
            // Mantém novas camadas no topo, sem duplicá-las.
            if (!RegistrarNovaCamada(
                new Camada { Nome = nomeArquivo, Tipo = "Vetor", Visivel = true, CaminhoArquivo = caminhoFonte },
                inserirNoInicio: true,
                reservaDoChamador: true))
                throw new InvalidOperationException($"A camada '{nomeArquivo}' já existe no mapa.");
            if (_camadaBaseProjeto is null)
                _camadaBaseProjeto = nomeArquivo;

            SincronizarHierarquia(solicitarFrame: false);
            await EnquadrarCamadaAsync(nomeArquivo);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            carregamentoVetorEmAndamento = false;
            exibirResumoCarregamentoVetor = false;
            ocultarResumoVetorCts?.Cancel();
            if (nomeReservado is not null)
            {
                using IDisposable? pausaLimpeza = _server is null ? null : await _server.PauseRenderingAsync();
                RemoverRecursosVetoriais(nomeReservado);
                CamadasAtivas.RemoveAll(camada => string.Equals(camada.Nome, nomeReservado, StringComparison.OrdinalIgnoreCase));
                MapService.ProjetoSRS = crsAnterior;
                MapService.OffsetMundoX = offsetXAnterior;
                MapService.OffsetMundoY = offsetYAnterior;
                MapService.OffsetMundoDefinido = offsetDefinidoAnterior;
                MapService.CameraPanX = panXAnterior;
                MapService.CameraPanY = panYAnterior;
                MapService.CameraZoom = zoomAnterior;
                _camadaBaseProjeto = camadaBaseAnterior;
                RecalcularLimitesGlobaisVetoriais();
                if (MapService.LimitesGlobaisVetor.IsEmpty && !limitesVetoriaisAnteriores.IsEmpty)
                    MapService.LimitesGlobaisVetor = limitesVetoriaisAnteriores;
                MapService.RequestRedraw();
                try
                {
                    await JSRuntime.InvokeVoidAsync(
                        "mapEngine.sincronizarCameraComBlazor", panXAnterior, panYAnterior, zoomAnterior);
                }
                catch { }
            }
            await JSRuntime.InvokeVoidAsync("alert", $"Erro Crítico na Importação Nativa: {ex.Message}");
        }
        finally
        {
            if (nomeReservado is not null) LiberarNomeCamada(nomeReservado);
        }
    }

    private async Task OcultarResumoVetorAsync(CancellationTokenSource? cts)
    {
        if (cts == null) return;

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(4), cts.Token);
            if (ReferenceEquals(ocultarResumoVetorCts, cts))
            {
                exibirResumoCarregamentoVetor = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Um novo carregamento substituiu o resumo anterior.
        }
        finally
        {
            if (ReferenceEquals(ocultarResumoVetorCts, cts))
                ocultarResumoVetorCts = null;
            cts.Dispose();
        }
    }

    private void CalcularLimitesDoMapa()
    {
        mapaMinX = float.MaxValue; mapaMaxX = float.MinValue;
        mapaMinY = float.MaxValue; mapaMaxY = float.MinValue;
        foreach (var poli in poligonosNativos)
        {
            for (int i = 0; i < poli.Length; i += 2)
            {
                float x = poli[i]; float y = poli[i + 1];
                if (x < mapaMinX) mapaMinX = x; if (x > mapaMaxX) mapaMaxX = x;
                if (y < mapaMinY) mapaMinY = y; if (y > mapaMaxY) mapaMaxY = y;
            }
        }
    }

