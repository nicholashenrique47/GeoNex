    private bool RegistrarNovaCamada(Camada camada, bool inserirNoInicio = false, bool reservaDoChamador = false)
    {
        if (string.IsNullOrWhiteSpace(camada.Nome) ||
            CamadasAtivas.Any(c => string.Equals(c.Nome, camada.Nome, StringComparison.OrdinalIgnoreCase)) ||
            (!reservaDoChamador && _nomesCamadasCarregando.ContainsKey(camada.Nome)))
            return false;

        bool primeiraCamada = CamadasAtivas.Count == 0;
        if (inserirNoInicio) CamadasAtivas.Insert(0, camada);
        else CamadasAtivas.Add(camada);

        if (primeiraCamada) _painelCamadasAberto = true;
        return true;
    }
