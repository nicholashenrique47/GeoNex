    [JSInvokable]
    public void AtualizarTelemetria(double latenciaMs)
    {
        _jsLatency = latenciaMs;
        long agora = System.Diagnostics.Stopwatch.GetTimestamp();
        long anterior = System.Threading.Interlocked.Read(ref _ultimaTelemetriaTimestamp);
        if (anterior != 0 && agora - anterior < System.Diagnostics.Stopwatch.Frequency / 2)
            return;
        System.Threading.Interlocked.Exchange(ref _ultimaTelemetriaTimestamp, agora);

        _ramEmUsoMB = System.Diagnostics.Process.GetCurrentProcess().WorkingSet64 / (1024 * 1024);
        _gdalLimitMB = GeoNex.Services.GdalRuntimeConfiguration.Current.GdalCacheMb
            .ToString(System.Globalization.CultureInfo.InvariantCulture);
        InvokeAsync(StateHasChanged);
    }

