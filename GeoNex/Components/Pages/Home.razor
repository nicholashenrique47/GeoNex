    private void AoSobrevoarCamada(Camada camadaAlvo)
    {
        if (camadaArrastada == null || camadaArrastada == camadaAlvo) return;

        int indexOrigem = CamadasAtivas.IndexOf(camadaArrastada);
        int indexDestino = CamadasAtivas.IndexOf(camadaAlvo);

        if (indexOrigem >= 0 && indexDestino >= 0)
        {
            CamadasAtivas.RemoveAt(indexOrigem);
            CamadasAtivas.Insert(indexDestino, camadaArrastada);

            // A MAGIA: Avisa a placa gráfica SkiaSharp para redesenhar o Z-Index em TEMPO REAL!
            SincronizarHierarquia();
        }
    }

    private void FinalizarArraste()
    {
        if (camadaArrastada != null)
        {
            camadaArrastada = null;

            // O mapa já foi desenhado com sucesso durante o arrasto.
            // Aqui apenas limpamos a memória para o CSS desligar a sombra e o efeito de levitação!
            StateHasChanged();
        }
    }

