    private async Task ExecutarExportacao()
    {
        if (string.IsNullOrWhiteSpace(exportCamadaOrigem))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Selecione a camada de origem.");
            return;
        }

        var camadaOrig = CamadasAtivas.FirstOrDefault(c => c.Nome == exportCamadaOrigem);
        if (camadaOrig == null || string.IsNullOrWhiteSpace(camadaOrig.CaminhoArquivo))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Caminho do ficheiro original não encontrado.");
            return;
        }

        string extensao = exportFormatoDriver == "GeoJSON" ? ".geojson" : (exportFormatoDriver == "KML" ? ".kml" : ".shp");
        var opcoes = new PickOptions { PickerTitle = "Exportar Vetor" };
        
        // Simulação de SaveFileDialog nativo - MAUI não tem SavePicker bom, então usaremos um Pick genérico de diretório se estivéssemos num desktop puro
        // Para simplificar, vou exportar diretamente para Meus Documentos e alertar.
        
        string pasta = Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments);
        string caminhoDestino = System.IO.Path.Combine(pasta, $"Exportacao_{exportCamadaOrigem}{extensao}");

        bool sucesso = ExportService.ExportarVetor(exportCamadaOrigem, camadaOrig.CaminhoArquivo, caminhoDestino, exportFormatoDriver, exportEPSG);

        if (sucesso)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Exportação concluída!\nO ficheiro foi gerado em:\n{caminhoDestino}");
            FecharModalExportacao();
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Erro ao exportar camada. Verifique o console ou a integridade do GDAL.");
        }
    }

