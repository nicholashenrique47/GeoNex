    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focoMenuDadosPendente is { } focoMenuDados)
        {
            _focoMenuDadosPendente = null;
            if (focoMenuDados == "voltar") await _menuDadosVoltarRef.FocusAsync();
            else if (focoMenuDados == "adicionar") await _menuDadosAdicionarRef.FocusAsync();
            else if (focoMenuDados == "criar") await _menuDadosCriarRef.FocusAsync();
        }
        if (_focoMapaPendente)
        {
            _focoMapaPendente = false;
            await _mapContainerRef.FocusAsync();
        }
        if (_focoContextoVetorizacaoPendente && _mostrarMenuContexto)
        {
            _focoContextoVetorizacaoPendente = false;
            await _contextoVetorizacaoRef.FocusAsync();
        }
        if (FerramentaDesenhoAtiva && (_focoCoordenadaPendente || _focoCogoPendente))
        {
            if (_focoCoordenadaPendente && _mostrarInputAbsoluto)
            {
                _focoCoordenadaPendente = false;
                await _inputAbsolutoXRef.FocusAsync();
            }
            if (_focoCogoPendente && _mostrarInputCogo)
            {
                _focoCogoPendente = false;
                await _inputDistanciaRef.FocusAsync();
            }
        }
        if (_hudPosicaoPendente && FerramentaDesenhoAtiva)
        {
            _hudPosicaoPendente = false;
            await JSRuntime.InvokeVoidAsync("reposicionarHudFlutuante");
        }
        if (firstRender)
        {
            IniciarAutosaveProjeto();
            await Task.Delay(100);
            if (!_mostrarTelaInicialProjeto)
            {
                try { await _mapContainerRef.FocusAsync(); } catch { }
            }

            var dimensoes = await JSRuntime.InvokeAsync<DimensoesTela>("dimensoesJanela.obter");
            _larguraTela = dimensoes.largura > 0 ? dimensoes.largura : 1920;
            _alturaTela = dimensoes.altura > 0 ? dimensoes.altura : 1080;
            _dpiTela = float.IsFinite(dimensoes.dpi) &&
                dimensoes.dpi >= MapViewportMetrics.MinimumDpi &&
                dimensoes.dpi <= MapViewportMetrics.MaximumDpi
                    ? dimensoes.dpi
                    : 1f;

            await JSRuntime.InvokeVoidAsync("dimensoesJanela.registrarResize", objRef);
            await JSRuntime.InvokeVoidAsync("mapEngine.init", objRef);
            await JSRuntime.InvokeVoidAsync("mapEngine.setFerramenta", _ferramentaAtiva.ToString()); // <-- ADICIONAR ESTA LINHA
            SincronizarPreviaVetorizacaoCliente();
            SolicitarNovoFrame();

            // JAVASCRIPT REMOVIDO: O C# agora assume o controlo absoluto!
        }
    }

    [JSInvokable]
    public void AtualizarDimensoesTela(int w, int h, float dpi)
    {
        if (!MapViewportMetrics.TryCreate(w, h, dpi, out MapViewportMetrics viewport)) return;
        _larguraTela = viewport.CssWidth;
        _alturaTela = viewport.CssHeight;
        _dpiTela = viewport.RequestedDpi;
        SolicitarNovoFrame();
    }

    public void Dispose()
    {
        _renderDisposed = true;
        WindowCloseCoordinator.CloseRequested -= AoSolicitarFechamentoNativo;
        _autosaveProjetoCts?.Cancel();
        MapService.ClientRenderedDigitizingPreview = false;
        if (_server != null) _server.OnOnlineFrameReady -= AtualizarImagemOnline;
        foreach (var raster in CamadasAtivas.Where(c => c.Tipo == "Raster"))
            GeoNex.Services.RasterOverviewBuilder.Cancel(raster.CaminhoArquivo);
        ocultarResumoVetorCts?.Cancel();
        ocultarResumoVetorCts = null;
        notificacaoSalvamentoCts?.Cancel();
        notificacaoSalvamentoCts = null;
        objRef?.Dispose();
        _server?.Stop();

    }

    // =========================================================================
    // 6. PIPELINE DE COMUNICAÇÃO DO MOTOR GRÁFICO (STREAMING BINÁRIO NATIVO)
    private long SolicitarNovoFrame(
        bool interacaoRapida = false,
        long requisicaoCamera = 0,
        bool limparPreviaVetorizacaoAoApresentar = false)
    {
        if (_server == null) return 0;
        long frameId = System.Threading.Interlocked.Increment(ref _sequenciaFrame);
        if (limparPreviaVetorizacaoAoApresentar)
        {
            _digitizingPreviewClearAfterFrameId = frameId;
            _digitizingPreviewClearRevision = _digitizingPreviewRevision;
        }
        // O C# não precisa de enviar fases de animação. O URL regressa à sua forma pura e leve.
        int frameWidth = _larguraTela, frameHeight = _alturaTela;
        float frameDpi = _dpiTela;
        string dpi = frameDpi.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
        var camera = new MapCameraState(MapService.CameraPanX, MapService.CameraPanY, MapService.CameraZoom);
        string cameraQuery = FormattableString.Invariant($"&panx={camera.PanX:R}&pany={camera.PanY:R}&zoom={camera.Zoom:R}");
        string url = $"{_server.BaseUrl}mapa/?w={frameWidth}&h={frameHeight}&dpi={dpi}&nav=1&i={(interacaoRapida ? 1 : 0)}&fid={frameId}&t={DateTime.Now.Ticks}{cameraQuery}";
        object digitizingMatrix = MatrizPreviaVetorizacaoCliente();

        // Pede ao JS para trocar a imagem sem o Blazor piscar a tela
        InvokeAsync(() => JSRuntime.InvokeVoidAsync(
            "mapEngine.carregarNovoFrame", url, frameId, requisicaoCamera, _server.IsTelemetryEnabled,
            NavigationFramePolicy.Padding(frameWidth, frameHeight, frameDpi), frameWidth, frameHeight,
            camera.PanX, camera.PanY, camera.Zoom, false, digitizingMatrix,
            _digitizingPreviewClearAfterFrameId, _digitizingPreviewClearRevision));
        return frameId;
    }

    private bool _renderDisposed;
    private readonly System.Threading.SemaphoreSlim _projectSaveGate = new(1, 1);
    private System.Threading.CancellationTokenSource? _autosaveProjetoCts;
    private DateTime _ultimoAutosaveProjetoUtc = DateTime.UtcNow;
    private bool _autosaveSnapshotAtualizado;

    private void IniciarAutosaveProjeto()
    {
        if (_autosaveProjetoCts is not null) return;
        var cancellation = new System.Threading.CancellationTokenSource();
        _autosaveProjetoCts = cancellation;
        _ = MonitorarAutosaveProjetoAsync(cancellation);
    }

    private async Task MonitorarAutosaveProjetoAsync(System.Threading.CancellationTokenSource cancellation)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
            while (await timer.WaitForNextTickAsync(cancellation.Token))
            {
                if (_renderDisposed || !ProjetoService.TemProjetoAberto) continue;
                int intervalo = LerIntervaloAutosaveProjeto();
                if (intervalo <= 0 || DateTime.UtcNow - _ultimoAutosaveProjetoUtc < TimeSpan.FromMinutes(intervalo))
                    continue;

                try { await InvokeAsync(AutosalvarProjetoSeSeguroAsync); }
                catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { break; }
                catch (Exception ex) { Console.Error.WriteLine($"Falha no ciclo de salvamento automático do projeto: {ex.Message}"); }
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        finally
        {
            if (ReferenceEquals(_autosaveProjetoCts, cancellation)) _autosaveProjetoCts = null;
            cancellation.Dispose();
        }
    }

    private async Task AutosalvarProjetoSeSeguroAsync()
    {
        if (_renderDisposed || !ProjetoService.TemProjetoAberto) return;
        if (_salvandoEdicoes || temEdicoesPendentes || MapService.PontosAquisicao.Count > 0 || listaPontosCaderneta.Count > 0)
            return;

        try
        {
            _autosaveSnapshotAtualizado = false;
            List<string> avisos = await PersistirProjetoAtualAsync(
                criarPontoRestauracao: false,
                salvarComoAutosave: true);
            _ultimoAutosaveProjetoUtc = DateTime.UtcNow;
            if (!_autosaveSnapshotAtualizado)
            {
                await InvokeAsync(StateHasChanged);
                return;
            }
            string detalhe = avisos.Count == 0
                ? "A sessão recuperável foi atualizada sem alterar o projeto salvo."
                : string.Join(" ", avisos.Distinct());
            ExibirNotificacaoSalvamento("Ponto de recuperação atualizado", detalhe);
        }
        catch (Exception ex)
        {
            _ultimoAutosaveProjetoUtc = DateTime.UtcNow;
            ExibirNotificacaoSalvamento("Falha no salvamento automático", ex.Message, erro: true);
        }
    }

    private void AtualizarImagemOnline()
        => _ = InvokeAsync(() => { if (!_renderDisposed) SolicitarNovoFrame(); });

    private async Task AdicionarCamadaAoMapa()
    {
        string? nomeReservado = null;
        string caminhoFonte = caminhoArquivoRaster;
        string crsAnterior = MapService.ProjetoSRS;
        double offsetXAnterior = MapService.OffsetMundoX;
        double offsetYAnterior = MapService.OffsetMundoY;
        bool offsetDefinidoAnterior = MapService.OffsetMundoDefinido;
        double panXAnterior = MapService.CameraPanX;
        double panYAnterior = MapService.CameraPanY;
        double zoomAnterior = MapService.CameraZoom;
        string? camadaBaseAnterior = _camadaBaseProjeto;
        OSGeo.GDAL.Dataset? datasetAberto = null;
        try
        {
            if (string.IsNullOrEmpty(caminhoFonte))
            {
                await JSRuntime.InvokeVoidAsync("alert", "Selecione um ficheiro primeiro!");
                return;
            }

            if (GeoNex.Services.GdalRuntimeBootstrap.IsEcwPath(caminhoFonte) &&
                !GeoNex.Services.GdalRuntimeBootstrap.EcwReadAvailable)
            {
                await JSRuntime.InvokeVoidAsync("alert", "O suporte nativo a ECW não foi carregado nesta instalação.");
                return;
            }

            exibirModalImportacao = false;

            // BLINDAGEM 3: Lock no momento da troca de Dataset para evitar choque de Threads
            string nome = System.IO.Path.GetFileName(caminhoFonte);
            if (!ReservarNomeCamada(nome))
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Já existe uma camada chamada '{nome}' no mapa ou ela está sendo carregada.");
                return;
            }
            nomeReservado = nome;
            GeoNex.Services.RasterOverviewBuilder.Cancel(caminhoFonte);
            using IDisposable? renderPause = _server == null ? null : await _server.PauseRenderingAsync();
            lock (MapService)
            {
                var ds = OSGeo.GDAL.Gdal.Open(caminhoFonte, OSGeo.GDAL.Access.GA_ReadOnly);
                datasetAberto = ds;

                // Prevenção contra ficheiros corrompidos
                if (ds == null)
                {
                    string failure = GeoNex.Services.GdalRuntimeBootstrap.ExplainOpenFailure(caminhoFonte);
                    InvokeAsync(() => JSRuntime.InvokeVoidAsync("alert", failure));
                    return;
                }
                
                bool isWmsRaster = ds.GetDriver()?.ShortName == "WMS";
                // O primeiro raster define a referência da cena. Isso precisa
                // acontecer antes de criar o VRT e de calcular seus limites;
                // caso contrário o projeto ainda está em EPSG:4326, o ECW/TIFF
                // é reamostrado para graus e, depois, o projeto muda para UTM.
                // O vetor carregado em seguida passa a usar metros enquanto o
                // raster/cache continuam em graus, fazendo a ortofoto sumir.
                string sourceProjection = ds.GetProjection();
                if (!MapService.OffsetMundoDefinido && !string.IsNullOrWhiteSpace(sourceProjection))
                    MapService.ProjetoSRS = sourceProjection;
                MapService.RemoveWarpedRaster(nome);
                MapService.PublishRaster(nome, ds);
                datasetAberto = null; // MapService assumiu a propriedade do handle.

                // === TIER 1: QGIS HYBRID ARCHITECTURE (VRT Bypass) ===
                // O QGIS nunca cria um WarpedVRT se o raster e o mapa usarem o mesmo SRC.
                // Criar um VRT desnecessário força a CPU a fazer interpolação e destrói os FPS e a qualidade.
                if (!isWmsRaster)
                {
                    try
                    {
                        bool precisaVrt = true;
                        string srcWkt = sourceProjection;
                        string dstWkt = !string.IsNullOrEmpty(MapService.ProjetoSRS) ? MapService.ProjetoSRS : srcWkt;
                        
                        if (string.IsNullOrEmpty(srcWkt))
                        {
                            precisaVrt = false; // Sem projeção na fonte, assumimos que está correta
                        }
                        else if (!string.IsNullOrEmpty(dstWkt))
                        {
                            // Normalizar SRC
                            using var srcSrs = SrsFactory.FromUserInput(srcWkt);
                            srcSrs.ExportToWkt(out string realSrcWkt, null);
                            srcWkt = realSrcWkt;

                            // Normalizar DST
                            using var dstSrs = SrsFactory.FromUserInput(dstWkt);
                            dstSrs.ExportToWkt(out string realDstWkt, null);
                            
                            precisaVrt = !SrsFactory.IsSame(srcWkt, realDstWkt);
                            dstWkt = realDstWkt;
                        }

                        if (precisaVrt)
                        {
                            Console.WriteLine($"[GEONEX] Criando VRT reprojetado via Gdal.Warp para {nome}...");
                            
                            // Em vez de AutoCreateWarpedVRT (que pode crashar por AccessViolation), usamos o robusto Gdal.Warp
                            string tempVrt = $"/vsimem/warped_{Guid.NewGuid():N}.vrt";
                            string vrtResampling = GeoNex.Services.RasterDatasetPolicy.SelectRenderResampling(ds, false);
                            var warpOptions = new OSGeo.GDAL.GDALWarpAppOptions(new[] {
                                "-t_srs", dstWkt,
                                "-r", vrtResampling,
                                "-of", "VRT"
                            });
                            
                            OSGeo.GDAL.Dataset vrt = null;
                            lock (MapService.GdalRasterLock)
                            {
                                vrt = OSGeo.GDAL.Gdal.Warp(tempVrt, new[] { ds }, warpOptions, null, null);
                            }
                            
                            if (vrt != null) {
                                MapService.PublishWarpedRaster(nome, ds, vrt);
                                Console.WriteLine($"[GEONEX] VRT gerado com sucesso.");
                            } else {
                                Console.WriteLine($"[GEONEX] Erro: Gdal.Warp retornou null para {nome}.");
                            }
                        }
                    }
                    catch (Exception vrtEx)
                    {
                        Console.WriteLine($"[GEONEX] Aviso: VRT não criado para {nome}: {vrtEx.Message}");
                    }
                }

                double[] trans = new double[6];
                ds.GetGeoTransform(trans);
                GeoNex.Services.RasterPoint[] boundary = GeoNex.Services.RasterGeometry.GetBoundaryPoints(
                    trans,
                    ds.RasterXSize,
                    ds.RasterYSize);

                // Densificar as bordas antes da reprojeção evita omitir a curvatura
                // entre cantos em transformações não lineares.
                try
                {
                    string srcWkt = sourceProjection;
                    string dstWkt = MapService.ProjetoSRS;
                    if (!string.IsNullOrEmpty(srcWkt) && !string.IsNullOrEmpty(dstWkt) &&
                        !GeoNex.Services.SrsFactory.IsSame(srcWkt, dstWkt))
                    {
                        using var ct = SrsFactory.CreateTransform(srcWkt, dstWkt);
                        var projectedBoundary = new GeoNex.Services.RasterPoint[boundary.Length];
                        for (int i = 0; i < boundary.Length; ++i)
                        {
                            double[] point = [boundary[i].X, boundary[i].Y, 0];
                            ct.TransformPoint(point);
                            projectedBoundary[i] = new GeoNex.Services.RasterPoint(point[0], point[1]);
                        }
                        boundary = projectedBoundary;
                    }
                } catch (Exception tEx) { Console.WriteLine($"[GEONEX] Aviso: Erro a reprojetar limites do raster ({nome}): {tEx.Message}"); }

                GeoNex.Services.RasterBounds rasterBounds = GeoNex.Services.RasterGeometry.GetBounds(boundary);
                double minX = rasterBounds.MinX;
                double minY = rasterBounds.MinY;
                double maxX = rasterBounds.MaxX;
                double maxY = rasterBounds.MaxY;

                // === CORREÇÃO DE ALINHAMENTO UTM/RASTER ===
                // Se a ortofoto for o primeiro ficheiro a ser carregado, ela define a Âncora do Mundo.
                if (!MapService.OffsetMundoDefinido)
                {
                    MapService.OffsetMundoX = minX;
                    MapService.OffsetMundoY = maxY;
                    MapService.OffsetMundoDefinido = true;
                    
                    string proj = sourceProjection;
                    if (!string.IsNullOrEmpty(proj))
                    {
                        MapService.ProjetoSRS = proj;
                    }
                }

                // Grava os limites na memória gráfica anulando os "milhões" do UTM
                MapService.LimitesRasters[nome] = new SkiaSharp.SKRect(
                    (float)(minX - MapService.OffsetMundoX),
                    (float)-(maxY - MapService.OffsetMundoY),
                    (float)(maxX - MapService.OffsetMundoX),
                    (float)-(minY - MapService.OffsetMundoY)
                );
            }

            // A primeira imagem usa o raster original. Pirâmides externas são
            // criadas depois, com handle próprio, sem alterar a fonte em GA_Update.
            var overviewRefresh = MapService.CaptureRasterOverviewRefresh(nome, caminhoFonte);
            var overviewServer = _server;
            if (overviewRefresh != null && overviewServer != null)
                GeoNex.Services.RasterOverviewBuilder.Schedule(
                    overviewRefresh.SourcePath,
                    MapService.GdalRasterLock,
                    onPublishedAsync: () => InvokeAsync(async () =>
                    {
                        if (_renderDisposed || !ReferenceEquals(_server, overviewServer)) return;
                        using var pause = await overviewServer.PauseForRasterMaintenanceAsync();
                        if (_renderDisposed || !ReferenceEquals(_server, overviewServer)) return;
                        MapService.TryRefreshRasterOverviews(overviewRefresh);
                    }));

            MapService.RemoveRasterCache(nome);

            if (!RegistrarNovaCamada(
                new Camada { Nome = nome, Tipo = "Raster", Visivel = true, CaminhoArquivo = caminhoFonte },
                inserirNoInicio: true,
                reservaDoChamador: true))
                throw new InvalidOperationException($"A camada '{nome}' já existe no mapa.");
            if (_camadaBaseProjeto is null)
                _camadaBaseProjeto = nome;
            
            SincronizarHierarquia(); // FUNDAMENTAL: Informa o C# que a camada já existe
            MapService.RequestRedraw(); // Invalida o cache
            
            // Força a câmera a comportar-se exatamente como o 'AproximarCamada'
            var layerRect = MapService.LimitesRasters[nome];
            if (layerRect.IsEmpty || !float.IsFinite(layerRect.Width) || !float.IsFinite(layerRect.Height) ||
                layerRect.Width <= 0 || layerRect.Height <= 0)
                throw new InvalidDataException($"O raster '{nome}' não possui uma extensão geográfica válida.");
            float w = MapService.ViewportWidth > 0 ? MapService.ViewportWidth : 1920;
            float h = MapService.ViewportHeight > 0 ? MapService.ViewportHeight : 1080;
            
            float layerEscala = Math.Min(w / layerRect.Width, h / layerRect.Height) * 0.8f;
            
            // Simular o que o LocalMapServer vai fazer no próximo frame
            var limitesGlobais = MapService.LimitesRasterGlobal;
            if (limitesGlobais.IsEmpty || limitesGlobais.Width <= 0 || limitesGlobais.Height <= 0)
                throw new InvalidDataException($"Não foi possível calcular a extensão total após carregar '{nome}'.");
            float futureGlobalEscala = Math.Min(w / limitesGlobais.Width, h / limitesGlobais.Height) * 0.8f;
            
            MapService.CameraZoom = layerEscala / futureGlobalEscala;
            MapService.CameraPanX = (limitesGlobais.MidX - layerRect.MidX) * layerEscala;
            MapService.CameraPanY = (limitesGlobais.MidY - layerRect.MidY) * layerEscala;

            SolicitarNovoFrame();
            StateHasChanged();
            
            await JSRuntime.InvokeVoidAsync("mapEngine.resetarCamera");
            SolicitarNovoFrame();
        }
        catch (Exception ex)
        {
            using IDisposable? pausaLimpeza = _server is null ? null : await _server.PauseRenderingAsync();
            datasetAberto?.Dispose();
            if (nomeReservado is not null)
            {
                RemoverRecursosRaster(nomeReservado, caminhoFonte);
                CamadasAtivas.RemoveAll(camada => string.Equals(camada.Nome, nomeReservado, StringComparison.OrdinalIgnoreCase));
                MapService.ProjetoSRS = crsAnterior;
                MapService.OffsetMundoX = offsetXAnterior;
                MapService.OffsetMundoY = offsetYAnterior;
                MapService.OffsetMundoDefinido = offsetDefinidoAnterior;
                MapService.CameraPanX = panXAnterior;
                MapService.CameraPanY = panYAnterior;
                MapService.CameraZoom = zoomAnterior;
                _camadaBaseProjeto = camadaBaseAnterior;
                MapService.RequestRedraw();
                try
                {
                    await JSRuntime.InvokeVoidAsync(
                        "mapEngine.sincronizarCameraComBlazor", panXAnterior, panYAnterior, zoomAnterior);
                }
                catch { }
            }
            await JSRuntime.InvokeVoidAsync("alert", "Erro crítico na importação raster: " + ex.Message);
        }
        finally
        {
            if (nomeReservado is not null) LiberarNomeCamada(nomeReservado);
        }
    }

