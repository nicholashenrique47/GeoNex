    [JSInvokable]
    public async Task HitTestNativo(double lat, double lng)
    {
        try
        {
            double mundoX = lng;
            double mundoY = lat;
            
            if (!string.IsNullOrEmpty(MapService.ProjetoSRS) && MapService.ProjetoSRS != "EPSG:4326")
            {
                var wgs84 = new OSGeo.OSR.SpatialReference("");
                wgs84.ImportFromEPSG(4326);
                
                var dstSrs = new OSGeo.OSR.SpatialReference("");
                string projTemp = MapService.ProjetoSRS;
                if (projTemp.StartsWith("EPSG:")) dstSrs.ImportFromEPSG(int.Parse(projTemp.Split(':')[1]));
                else dstSrs.ImportFromWkt(ref projTemp);

                var ct = new OSGeo.OSR.CoordinateTransformation(wgs84, dstSrs);
                double[] pt = new double[] { lng, lat, 0 };
                ct.TransformPoint(pt);
                mundoX = pt[0];
                mundoY = pt[1];
            }

            var vetorAtivo = CamadasAtivas.FirstOrDefault(c => c.Tipo == "Vetor" && c.Visivel);
            if (vetorAtivo != null)
            {
                using var indexLease = MapService.AcquireSpatialIndex(vetorAtivo.Nome);
                if (indexLease != null)
                {
                    var arvore = indexLease.Resource;
                    double tol = (MapService.ProjetoSRS == "EPSG:4326") ? 0.0001 : 10.0;
                    var envelopeBusca = new NetTopologySuite.Geometries.Envelope(mundoX - tol, mundoX + tol, mundoY - tol, mundoY + tol);

                    using var feicoesPossiveis = arvore.Query(envelopeBusca);
                    foreach (var f in feicoesPossiveis)
                    {
                        if (f.EnvelopeWorld.MinX <= envelopeBusca.MaxX && f.EnvelopeWorld.MaxX >= envelopeBusca.MinX &&
                            f.EnvelopeWorld.MinY <= envelopeBusca.MaxY && f.EnvelopeWorld.MaxY >= envelopeBusca.MinY)
                        {
                            MapService.CaminhoFeicaoDestacada = f.Path;
                            
                            using var shapefileLease = MapService.AcquireShapefile(vetorAtivo.Nome);
                            if (shapefileLease != null)
                            {
                                var props = shapefileLease.Resource.LerAtributos((int)f.FID);
                                string json = System.Text.Json.JsonSerializer.Serialize(props);
                                await SelecionarFeicaoNoMapa(vetorAtivo.Nome, json);
                            }
                            
                            SolicitarNovoFrame();
                            StateHasChanged();
                            return; // Hit found, break
                        }
                    }
                }
            }
            
            // Limpar destaque se clicou no vazio
            MapService.CaminhoFeicaoDestacada = null;
            SolicitarNovoFrame();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine("HitTestNativo error: " + ex.Message);
        }
    }

