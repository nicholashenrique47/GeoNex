    @if (exibirModalNovaCamada)
    {
        <div class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="new-layer-dialog-title" @onpointerdown:stopPropagation="true" @onpointerup:stopPropagation="true" @onpointermove:stopPropagation="true">
            <div class="glass-panel import-modal new-layer-modal" style="width: 550px; height: auto;">
                <div class="modal-header">
                    <h2 id="new-layer-dialog-title">Criar camada vetorial</h2>
                    <button class="close-btn-red" @onclick="FecharModalNovaCamada">✕</button>
                </div>
                <div class="modal-body" style="padding: 20px; display: flex; flex-direction: column; gap: 15px; height: auto;">

                    <div class="form-row">
                        <div class="form-group-vertical">
                            <label class="gis-label">NOME DA CAMADA</label>
                            <input type="text" class="glass-input" @bind="novaCamadaNome" @bind:event="oninput" placeholder="Ex: Levantamento_Topografico" />
                        </div>

                        <div class="form-group-vertical">
                            <label class="gis-label">FORMATO FÍSICO</label>
                            <select class="gis-select" @bind="novaCamadaFormato">
                                <option value="SHP">ESRI Shapefile (.shp)</option>
                                <option value="GEOJSON">GeoJSON (.geojson)</option>
                                <option value="GPKG">GeoPackage (.gpkg)</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group-vertical">
                            <label class="gis-label">CLASSE DE GEOMETRIA</label>
                            <select class="gis-select" @bind="novaCamadaGeometria">
                                <option value="POLIGONO">Polígono (Polygon)</option>
                                <option value="LINHA">Linha (LineString)</option>
                                <option value="PONTO">Ponto (Point)</option>
                            </select>
                        </div>

                        <div class="form-group-vertical">
                            <label class="gis-label">SISTEMA DE REFERÊNCIA (CRS)</label>
                            <select class="gis-select" @bind="novaCamadaCrs">
                                <option value="EPSG:31982">EPSG:31982 - SIRGAS 2000 / UTM 22S</option>
                                <option value="EPSG:4326">EPSG:4326 - WGS 84</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group-vertical">
                        <label class="gis-label">DIRETÓRIO DE DESTINO (PASTA)</label>
                        <div style="display: flex; gap: 10px;">
                            <input type="text" class="glass-input" @bind="pastaDestinoSelecionada" @bind:event="oninput" placeholder="Ex: C:\Projetos_SIG" style="flex: 1; font-family: monospace; font-size: 12px; color: #fff;" />
                            <button class="btn-browse" @onclick="SelecionarDiretorioDestino">PROCURAR...</button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(CaminhoAbsolutoGerado))
                        {
                            <span style="font-size: 10px; color: #34d399; font-family: monospace; margin-top: 4px;">
                                <strong>Destino Final:</strong> @CaminhoAbsolutoGerado
                            </span>
                        }
                    </div>

                    <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: flex-end; gap: 10px;">
                        <button class="btn-cancel" @onclick="FecharModalNovaCamada">Cancelar</button>
                        <button class="btn-save" @onclick="ConfirmarCriacaoNovaCamada" disabled="@(!PermiteCriarCamada)" style="background: @(PermiteCriarCamada ? "#047857" : "rgba(255,255,255,0.1)"); border-color: @(PermiteCriarCamada ? "#059669" : "transparent"); color: @(PermiteCriarCamada ? "white" : "#64748b"); width: auto; margin: 0; transition: 0.2s;">Criar camada</button>
                    </div>
                </div>
            </div>
        </div>
    }
    
</div> <!-- Fim da div geonex-ui -->

<style>
    /* =========================================================
