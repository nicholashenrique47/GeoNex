    private async Task EnquadrarCamadaAsync(string alvo)
    {
        
        SkiaSharp.SKRect layerRect = SkiaSharp.SKRect.Empty;

        if (MapService.LimitesVetoresWorld.TryGetValue(alvo, out var bounds) && !bounds.IsNull)
        {
            // Metadata already reprojected to the project CRS; O(1), even for millions of features.
            layerRect = new SkiaSharp.SKRect(
                (float)(bounds.MinX - MapService.OffsetMundoX),
                (float)(MapService.OffsetMundoY - bounds.MaxY),
                (float)(bounds.MaxX - MapService.OffsetMundoX),
                (float)(MapService.OffsetMundoY - bounds.MinY));
        }
        else if (MapService.HasRaster(alvo))
        {
            if (MapService.LimitesRasters.TryGetValue(alvo, out var r))
                layerRect = r;
        }

        if (LayerCameraPolicy.TryFit(MapService.GetSceneBounds(), layerRect,
            _larguraTela, _alturaTela, out var camera))
        {
            // Cancel old inertia/decodes before requesting the new frame, retaining the fitted basis.
            long serial = await JSRuntime.InvokeAsync<long>("mapEngine.sincronizarCameraComBlazor",
                camera.PanX, camera.PanY, camera.Zoom);
            _ultimaRequisicaoCamera = Math.Max(_ultimaRequisicaoCamera, serial);
            MapService.CameraPanX = camera.PanX;
            MapService.CameraPanY = camera.PanY;
            MapService.CameraZoom = camera.Zoom;
            MapService.IsPanning = false;

            MapService.RequestRedraw();
            await JSRuntime.InvokeVoidAsync("mapEngine.executarRequisicao", true, true);
        }
        else SolicitarNovoFrame();
    }

    private async Task PrepararRemocaoCamada()
    {
        string alvo = camadaSelecionadaMenu;
        FecharMenuContexto();

        var camada = CamadasAtivas.FirstOrDefault(c => c.Nome == alvo);
        if (camada != null)
        {
            // 1. Remove da Interface
            CamadasAtivas.Remove(camada);
            using IDisposable? renderPause = _server == null ? null : await _server.PauseRenderingAsync();

            if (camada.Tipo == "Raster")
                RemoverRecursosRaster(alvo, camada.CaminhoArquivo);
            else if (camada.Tipo == "Vetor")
                RemoverRecursosVetoriais(alvo);
            else MapService.EstilosPorCamada.TryRemove(alvo, out _);
            if (string.Equals(_camadaBaseProjeto, alvo, StringComparison.OrdinalIgnoreCase))
                _camadaBaseProjeto = CamadasAtivas.FirstOrDefault(item => !item.PendenteReconexao)?.Nome;

            // 3. Atualiza a tela imediatamente
            SincronizarHierarquia();
            StateHasChanged();
        }
        await JSRuntime.InvokeVoidAsync("removerCamadaDoMapa", alvo);
    }

    // 1. OS BOTÕES DO MENU DE CONTEXTO (Limpos do Javascript)
    private void MoverCamada(string nomeCamada, int direcao)
    {
        FecharMenuContexto();
        int index = CamadasAtivas.FindIndex(c => c.Nome == nomeCamada);
        if (index < 0) return;

        int novoIndex = index + direcao;
        if (novoIndex >= 0 && novoIndex < CamadasAtivas.Count)
        {
            var item = CamadasAtivas[index];

            CamadasAtivas.RemoveAt(index);
            CamadasAtivas.Insert(novoIndex, item);

            // Avisa a placa gráfica e força o ecrã a atualizar
            SincronizarHierarquia();
            StateHasChanged();
        }
    }

    
