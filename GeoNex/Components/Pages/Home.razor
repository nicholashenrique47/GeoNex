    private async Task CriarNovoProjeto()
    {
        try
        {
            if (!await PodeTrocarProjetoAsync()) return;

            var paginaNativa = Microsoft.Maui.Controls.Application.Current?.Windows.FirstOrDefault()?.Page;
            if (paginaNativa is null)
                throw new InvalidOperationException("A janela do GeoNex não está disponível para criar o projeto.");
            string? nomeProjeto = await paginaNativa.DisplayPromptAsync(
                "Novo projeto",
                "Informe o nome do projeto:",
                "Continuar",
                "Cancelar",
                "Nome do projeto",
                maxLength: 120,
                initialValue: "Meu projeto");
            if (string.IsNullOrWhiteSpace(nomeProjeto)) return;

            var pasta = await CommunityToolkit.Maui.Storage.FolderPicker.Default.PickAsync(default);
            if (pasta is null || !pasta.IsSuccessful) return;

            char[] caracteresInvalidos = System.IO.Path.GetInvalidFileNameChars();
            string nomeArquivo = string.Concat(nomeProjeto.Trim().Select(c => caracteresInvalidos.Contains(c) ? '_' : c)).Trim().TrimEnd('.');
            if (string.IsNullOrWhiteSpace(nomeArquivo))
                throw new InvalidOperationException("O nome informado não pode ser usado como nome de arquivo.");

            string caminhoGnx = System.IO.Path.Combine(pasta.Folder.Path, nomeArquivo + ".gnx");
            if (System.IO.File.Exists(caminhoGnx))
            {
                ExibirNotificacaoSalvamento("Projeto não criado", "Já existe um projeto com esse nome nessa pasta. Escolha outro nome ou abra o projeto existente.", erro: true);
                return;
            }

            var transicaoProjetoAnterior = await PrepararTransicaoProjetoAsync("criar outro projeto");
            if (!transicaoProjetoAnterior.PodeContinuar) return;
            var avisosAnteriores = transicaoProjetoAnterior.Avisos;
            GeoNex.Models.Projeto? projetoAnterior = null;
            if (ProjetoService.ProjetoAtual is not null)
            {
                projetoAnterior = await ProjetoService.CarregarProjetoAsync(ProjetoService.ProjetoAtual.CaminhoArquivo);
            }

            GeoNex.Models.Projeto projeto = await ProjetoService.CriarNovoProjetoAsync(caminhoGnx, nomeProjeto.Trim());
            try
            {
                await LimparCamadasDoProjetoAtualAsync();
            }
            catch (Exception erroLimpeza)
            {
                if (projetoAnterior is not null)
                {
                    try
                    {
                        await LimparCamadasDoProjetoAtualAsync();
                        await CarregarCamadasDoProjetoAsync(projetoAnterior, projetoAnterior.Camadas);
                        ProjetoService.AtivarProjeto(projetoAnterior);
                    }
                    catch (Exception erroRestauro)
                    {
                        try { await LimparCamadasDoProjetoAtualAsync(); } catch { }
                        ProjetoService.FecharProjeto();
                        ExibirNotificacaoSalvamento("Falha ao criar projeto", $"O projeto anterior também não pôde ser restaurado. Novo projeto: {erroLimpeza.Message} Restauração: {erroRestauro.Message}", erro: true);
                        return;
                    }
                }

                ExibirNotificacaoSalvamento("Projeto anterior restaurado", $"Não foi possível trocar para o novo projeto. {erroLimpeza.Message}", erro: true);
                return;
            }
            ProjetoService.AtivarProjeto(projeto);
            _mostrarTelaInicialProjeto = false;
            if (transicaoProjetoAnterior.ProjetoDoAutosaveParaDescartar is { } projetoAnteriorDescartado)
                GeoNex.Services.GnxProjectStore.DescartarAutosave(projetoAnteriorDescartado);
            RegistrarProjetoRecente(projeto.CaminhoArquivo);
            MapService.ProjetoSRS = projeto.CRS;
            MapService.RequestRedraw();
            string avisoAnterior = avisosAnteriores.Count == 0
                ? string.Empty
                : "\n\nAvisos do projeto anterior:\n• " + string.Join("\n• ", avisosAnteriores.Distinct());
            ExibirNotificacaoSalvamento("Projeto criado", $"{projeto.CaminhoArquivo}{avisoAnterior}");
            StateHasChanged();
        }
        catch (Exception ex) { ExibirNotificacaoSalvamento("Não foi possível criar o projeto", ex.Message, erro: true); }
    }

    private Task AbrirProjeto() => AbrirProjetoAsync(null);

    private Task AbrirProjetoPorCaminhoAsync(string caminho) => AbrirProjetoAsync(caminho);

    private async Task AbrirProjetoAsync(string? caminhoSelecionado, string? caminhoOriginalParaPromoverAutosave = null)
    {
        // A leitura das fontes pode levar alguns segundos. Bloquear a reentrada
        // antes do primeiro await impede cliques repetidos de limpar/carregar o
        // mesmo mapa em paralelo e disputar os nomes das camadas.
        if (_abrindoProjeto) return;
        _abrindoProjeto = true;
        _statusAberturaProjeto = "Preparando abertura do projeto…";
        try
        {
            await InvokeAsync(StateHasChanged);
            if (!await PodeTrocarProjetoAsync()) return;

            if (string.IsNullOrWhiteSpace(caminhoSelecionado))
            {
                var opcoes = new PickOptions
                {
                    PickerTitle = "Abrir projeto GeoNex (.gnx)",
                    FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
                    {
                        { DevicePlatform.WinUI, new[] { ".gnx" } }
                    })
                };
                var arquivo = await FilePicker.Default.PickAsync(opcoes);
                if (arquivo is null) return;
                caminhoSelecionado = arquivo.FullPath;
            }

            bool abrindoPontoRestauracao = GeoNex.Services.GnxProjectStore.EhPontoRestauracao(caminhoSelecionado);
            bool abrindoAutosave = GeoNex.Services.GnxProjectStore.EhAutosave(caminhoSelecionado);
            bool promovendoAutosave = abrindoAutosave && !string.IsNullOrWhiteSpace(caminhoOriginalParaPromoverAutosave);
            if (abrindoAutosave && !promovendoAutosave)
                throw new InvalidOperationException("Use Recuperar sessão automática na tela inicial para restaurar este arquivo.");
            if (promovendoAutosave &&
                !string.Equals(
                    GeoNex.Services.GnxProjectStore.ObterCaminhoAutosave(caminhoOriginalParaPromoverAutosave!),
                    System.IO.Path.GetFullPath(caminhoSelecionado),
                    StringComparison.OrdinalIgnoreCase))
                throw new InvalidOperationException("A sessão automática selecionada não corresponde ao projeto que será recuperado.");
            if (promovendoAutosave && ProjetoService.TemProjetoAberto)
                throw new InvalidOperationException("Feche o projeto atual antes de recuperar uma sessão automática.");
            bool pontoRestauracaoDoProjetoAtual = abrindoPontoRestauracao &&
                ProjetoService.ProjetoAtual is { } projetoAtualAntesDaAbertura &&
                string.Equals(
                    GeoNex.Services.GnxProjectStore.ObterCaminhoPontoRestauracao(projetoAtualAntesDaAbertura.CaminhoArquivo),
                    System.IO.Path.GetFullPath(caminhoSelecionado),
                    StringComparison.OrdinalIgnoreCase);

            _statusAberturaProjeto = "Lendo o arquivo do projeto…";
            await InvokeAsync(StateHasChanged);
            GeoNex.Models.Projeto projeto = await ProjetoService.CarregarProjetoAsync(caminhoSelecionado);
            if (ProjetoService.ProjetoAtual is not null &&
                string.Equals(
                    System.IO.Path.GetFullPath(ProjetoService.ProjetoAtual.CaminhoArquivo),
                    System.IO.Path.GetFullPath(projeto.CaminhoArquivo),
                    StringComparison.OrdinalIgnoreCase))
            {
                ExibirNotificacaoSalvamento("Projeto já aberto", "Esse projeto já está aberto.");
                return;
            }

            var camadasLocais = projeto.Camadas
                .Where(camada => TipoFonteProjeto(camada) == "Arquivo" &&
                    (string.Equals(camada.Tipo, "Vetor", StringComparison.OrdinalIgnoreCase) ||
                     string.Equals(camada.Tipo, "Raster", StringComparison.OrdinalIgnoreCase)) &&
                    !string.IsNullOrWhiteSpace(camada.CaminhoFonteOriginal))
                .OrderBy(camada => camada.Ordem)
                .ToList();

            var fontesAusentes = camadasLocais.Where(camada =>
                !GeoNex.Services.GnxProjectStore.FonteEhRemota(camada.CaminhoFonteOriginal!) &&
                !System.IO.File.Exists(camada.CaminhoFonteOriginal)).ToArray();
            _statusAberturaProjeto = "Validando arquivos das camadas…";
            await InvokeAsync(StateHasChanged);
            await ValidarFontesDoProjetoAsync(camadasLocais.Except(fontesAusentes));

            if (promovendoAutosave)
            {
                _statusAberturaProjeto = "Recuperando a sessão e preservando a versão salva…";
                await InvokeAsync(StateHasChanged);
                projeto = await GeoNex.Services.GnxProjectStore.PromoverAutosaveAsync(caminhoOriginalParaPromoverAutosave!);
            }

            var transicaoProjetoAnterior = await PrepararTransicaoProjetoAsync(
                "abrir outro projeto",
                criarPontoRestauracaoAoSalvar: !pontoRestauracaoDoProjetoAtual);
            if (!transicaoProjetoAnterior.PodeContinuar) return;
            List<string> avisosAnteriores = transicaoProjetoAnterior.Avisos;

            GeoNex.Models.Projeto? projetoAnterior = ProjetoService.ProjetoAtual is null
                ? null
                : await ProjetoService.CarregarProjetoAsync(ProjetoService.ProjetoAtual.CaminhoArquivo);
            var avisosProjeto = new List<string>();
            bool mapaLimpo = false;
            try
            {
                _statusAberturaProjeto = "Carregando camadas e mapa-base…";
                await InvokeAsync(StateHasChanged);
                mapaLimpo = true;
                await LimparCamadasDoProjetoAtualAsync();
                avisosProjeto.AddRange(await CarregarCamadasDoProjetoAsync(projeto, projeto.Camadas));
                ProjetoService.AtivarProjeto(projeto);
                _mostrarTelaInicialProjeto = false;
                if (!abrindoPontoRestauracao)
                    RegistrarProjetoRecente(projeto.CaminhoArquivo);
                if (promovendoAutosave)
                    GeoNex.Services.GnxProjectStore.DescartarAutosave(projeto.CaminhoArquivo);
                if (transicaoProjetoAnterior.ProjetoDoAutosaveParaDescartar is { } projetoAnteriorDescartado)
                    GeoNex.Services.GnxProjectStore.DescartarAutosave(projetoAnteriorDescartado);
            }
            catch (Exception ex)
            {
                if (mapaLimpo)
                {
                    await LimparCamadasDoProjetoAtualAsync();
                    if (projetoAnterior is not null)
                    {
                        try
                        {
                            await CarregarCamadasDoProjetoAsync(projetoAnterior, projetoAnterior.Camadas);
                            ProjetoService.AtivarProjeto(projetoAnterior);
                        }
                        catch (Exception erroRestauro)
                        {
                            await LimparCamadasDoProjetoAtualAsync();
                            ProjetoService.FecharProjeto();
                            ExibirNotificacaoSalvamento("Falha ao restaurar o mapa", $"Abertura: {ex.Message} Restauração: {erroRestauro.Message}", erro: true);
                            return;
                        }
                    }
                    else
                    {
                        ProjetoService.FecharProjeto();
                    }
                }
                ExibirNotificacaoSalvamento("Não foi possível abrir o projeto", ex.Message, erro: true);
                return;
            }

            if (avisosAnteriores.Count > 0)
                avisosProjeto.AddRange(avisosAnteriores.Select(aviso => $"Projeto anterior: {aviso}"));
            string textoAvisos = avisosProjeto.Count == 0 ? string.Empty : "\n\nAvisos:\n• " + string.Join("\n• ", avisosProjeto.Distinct());
            string mensagemAbertura = promovendoAutosave
                ? $"Sessão recuperada: {projeto.Nome}. A última versão salva foi preservada como ponto de restauração."
                : abrindoPontoRestauracao
                ? $"Versão anterior aberta como cópia: {projeto.Nome}. O projeto original foi preservado. Use Salvar Projeto Como para criar outra cópia restaurada."
                : $"Projeto aberto: {projeto.Nome}";
            ExibirNotificacaoSalvamento(promovendoAutosave ? "Sessão recuperada" : abrindoPontoRestauracao ? "Versão anterior aberta" : "Projeto aberto", $"{mensagemAbertura}{textoAvisos}");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ExibirNotificacaoSalvamento("Não foi possível abrir esse projeto", ex.Message, erro: true);
        }
        finally
        {
            _abrindoProjeto = false;
            _statusAberturaProjeto = string.Empty;
            try { await InvokeAsync(StateHasChanged); } catch { }
        }
    }

    private async Task<bool> PodeTrocarProjetoAsync()
    {
        if (_salvandoEdicoes || temEdicoesPendentes || MapService.PontosAquisicao.Count > 0 || listaPontosCaderneta.Count > 0)
        {
            ExibirNotificacaoSalvamento("Finalize as edições", "Grave as edições vetoriais e conclua ou cancele o esboço antes de criar ou abrir outro projeto. O mapa atual foi mantido.", erro: true);
            return false;
        }

        return true;
    }

    private async Task ValidarFontesDoProjetoAsync(IEnumerable<GeoNex.Models.Camada> camadas)
    {
        await GeoNex.Services.GnxProjectSourceValidator.ValidarAsync(camadas, MapService.GdalRasterLock);
    }

    private async Task SalvarProjeto()
    {
        if (ProjetoService.ProjetoAtual is null)
        {
            ExibirNotificacaoSalvamento("Nenhum projeto aberto", "Crie ou abra um projeto antes de salvar.", erro: true);
            return;
        }

        try
        {
            List<string> avisos = await PersistirProjetoAtualAsync();
            string textoAvisos = avisos.Count == 0 ? string.Empty : "\n\nAvisos:\n• " + string.Join("\n• ", avisos.Distinct());
            ExibirNotificacaoSalvamento("Projeto salvo", $"{ProjetoService.ProjetoAtual.Nome}{textoAvisos}");
        }
        catch (Exception ex)
        {
            ExibirNotificacaoSalvamento("Não foi possível salvar o projeto", ex.Message, erro: true);
        }
    }

    private async Task<List<string>> PersistirProjetoAtualAsync(
        string? nomeProjeto = null,
        bool criarPontoRestauracao = true,
        bool salvarComoAutosave = false)
    {
        await _projectSaveGate.WaitAsync();
        try
        {
        var avisos = new List<string>();
        foreach (Camada camada in CamadasAtivas.Where(camada => camada.FontePostgis is not null))
        {
            try
            {
                var fonte = camada.FontePostgis!;
                await Microsoft.Maui.Storage.SecureStorage.Default.SetAsync(
                    GeoNex.Services.GnxProjectStore.ChaveSeguraPostgis(ProjetoService.ProjetoAtual!.Id, camada.Nome),
                    fonte.Connection.Password);
            }
            catch
            {
                avisos.Add($"A senha PostGIS de '{camada.Nome}' não pôde ser guardada no armazenamento seguro do dispositivo; será necessário reconectar.");
            }
        }

        var camadasSalvas = CamadasAtivas
            .Select((camada, ordem) => (camada, ordem))
            .Select(item => new GeoNex.Services.CamadaProjetoSnapshot(
                item.camada.Nome,
                item.camada.Tipo,
                item.camada.Visivel,
                item.ordem,
                item.camada.CaminhoArquivo ?? string.Empty,
                SerializarFonteProjeto(item.camada),
                MapService.EstilosPorCamada.TryGetValue(item.camada.Nome, out var estilo)
                    ? System.Text.Json.JsonSerializer.Serialize(estilo)
                    : null))
            .ToArray();

        string? camadaBase = _camadaBaseProjeto;
        if (camadaBase is null || !camadasSalvas.Any(camada =>
                string.Equals(camada.Nome, camadaBase, StringComparison.OrdinalIgnoreCase) &&
                !CamadasAtivas.First(runtime => string.Equals(runtime.Nome, camada.Nome, StringComparison.OrdinalIgnoreCase)).PendenteReconexao))
            camadaBase = camadasSalvas
                .Where(camada => !CamadasAtivas.First(runtime => string.Equals(runtime.Nome, camada.Nome, StringComparison.OrdinalIgnoreCase)).PendenteReconexao)
                .OrderBy(camada => camada.Ordem)
                .FirstOrDefault()?.Nome;

        if (salvarComoAutosave)
        {
            _autosaveSnapshotAtualizado = await ProjetoService.SalvarAutosaveProjetoAsync(
                camadasSalvas,
                MapService.ProjetoSRS,
                camadaBase,
                MapService.OffsetMundoX,
                MapService.OffsetMundoY,
                MapService.OffsetMundoDefinido,
                MapService.CameraPanX,
                MapService.CameraPanY,
                MapService.CameraZoom);
        }
        else
        {
            await ProjetoService.SalvarProjetoAsync(
                camadasSalvas,
                MapService.ProjetoSRS,
                camadaBase,
                MapService.OffsetMundoX,
                MapService.OffsetMundoY,
                MapService.OffsetMundoDefinido,
                MapService.CameraPanX,
                MapService.CameraPanY,
                MapService.CameraZoom,
                nomeProjeto,
                criarPontoRestauracao);
            _autosaveSnapshotAtualizado = false;
            if (ProjetoService.ProjetoAtual is { } projetoSalvo &&
                !GeoNex.Services.GnxProjectStore.EhAutosave(projetoSalvo.CaminhoArquivo) &&
                !GeoNex.Services.GnxProjectStore.EhPontoRestauracao(projetoSalvo.CaminhoArquivo))
                GeoNex.Services.GnxProjectStore.DescartarAutosave(projetoSalvo.CaminhoArquivo);
        }
        _ultimoAutosaveProjetoUtc = DateTime.UtcNow;

        var semFonteConhecida = CamadasAtivas
            .Where(camada => string.IsNullOrWhiteSpace(camada.CaminhoArquivo) && !camada.PendenteReconexao &&
                camada.FontePostgis is null && !GeoNex.Services.OnlineBasemapPolicy.TryGetKeyForLayerName(camada.Nome, out _))
            .Select(camada => camada.Nome)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (semFonteConhecida.Count > 0)
            avisos.Add($"Algumas camadas não têm uma fonte reconstruível salva: {string.Join(", ", semFonteConhecida)}.");
        return avisos;
        }
        finally
        {
            _projectSaveGate.Release();
        }
    }

    private static string TipoFonteProjeto(GeoNex.Models.Camada camada)
    {
        if (!string.IsNullOrWhiteSpace(camada.FonteJson))
        {
            try
            {
                var fonte = System.Text.Json.JsonSerializer.Deserialize<GeoNex.Models.ProjetoFonteCamada>(
                    camada.FonteJson,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (!string.IsNullOrWhiteSpace(fonte?.Tipo)) return fonte.Tipo;
            }
            catch (System.Text.Json.JsonException) { }
        }

        return string.IsNullOrWhiteSpace(camada.CaminhoFonteOriginal) ? "Desconhecida" : "Arquivo";
    }

    private static string TipoFonteProjeto(Camada camada)
    {
        if (!string.IsNullOrWhiteSpace(camada.FonteJson))
        {
            try
            {
                var fonte = System.Text.Json.JsonSerializer.Deserialize<GeoNex.Models.ProjetoFonteCamada>(
                    camada.FonteJson,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (!string.IsNullOrWhiteSpace(fonte?.Tipo)) return fonte.Tipo;
            }
            catch (System.Text.Json.JsonException) { }
        }

        return !string.IsNullOrWhiteSpace(camada.CaminhoArquivo) ? "Arquivo" : "Desconhecida";
    }

    private static string? SerializarFonteProjeto(Camada camada)
    {
        GeoNex.Models.ProjetoFonteCamada fonte;
        if (camada.FontePostgis is { } postgis)
        {
            fonte = new GeoNex.Models.ProjetoFonteCamada
            {
                Tipo = "PostGIS",
                Servidor = postgis.Connection.Host,
                Porta = postgis.Connection.Port,
                BancoDados = postgis.Connection.Database,
                Usuario = postgis.Connection.Username,
                ModoSsl = postgis.Connection.SslMode,
                Esquema = postgis.Table.Schema,
                Tabela = postgis.Table.Table,
                ColunaGeometria = postgis.Table.GeometryColumn,
                TipoGeometria = postgis.Table.GeometryType,
                Srid = postgis.Table.Srid,
                DimensaoCoordenada = postgis.Table.CoordinateDimension
            };
        }
        else if (GeoNex.Services.OnlineBasemapPolicy.TryGetKeyForLayerName(camada.Nome, out string key))
        {
            fonte = new GeoNex.Models.ProjetoFonteCamada { Tipo = "MapaBaseOnline", Identificador = key };
        }
        else if (!string.IsNullOrWhiteSpace(camada.FonteJson))
        {
            try
            {
                fonte = System.Text.Json.JsonSerializer.Deserialize<GeoNex.Models.ProjetoFonteCamada>(
                    camada.FonteJson,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                    ?? new GeoNex.Models.ProjetoFonteCamada();
            }
            catch (System.Text.Json.JsonException)
            {
                fonte = new GeoNex.Models.ProjetoFonteCamada();
            }
        }
        else
        {
            fonte = new GeoNex.Models.ProjetoFonteCamada { Tipo = "Arquivo" };
        }

        if (fonte.Tipo is not ("Arquivo" or "MapaBaseOnline" or "PostGIS" or "Desconhecida"))
            fonte = new GeoNex.Models.ProjetoFonteCamada { Tipo = "Desconhecida" };
        return System.Text.Json.JsonSerializer.Serialize(fonte);
    }

    private bool CamadaUsaCrsProjeto(GeoNex.Models.Camada camada, string crsProjeto)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(camada.CaminhoFonteOriginal)) return false;
            string? crsFonte = null;
            if (string.Equals(camada.Tipo, "Vetor", StringComparison.OrdinalIgnoreCase))
            {
                string caminhoPrj = System.IO.Path.ChangeExtension(camada.CaminhoFonteOriginal, ".prj");
                if (System.IO.File.Exists(caminhoPrj))
                    crsFonte = System.IO.File.ReadAllText(caminhoPrj);
            }
            else if (string.Equals(camada.Tipo, "Raster", StringComparison.OrdinalIgnoreCase))
            {
                lock (MapService.GdalRasterLock)
                {
                    using var dataset = OSGeo.GDAL.Gdal.Open(camada.CaminhoFonteOriginal, OSGeo.GDAL.Access.GA_ReadOnly);
                    crsFonte = dataset?.GetProjection();
                }
            }

            return !string.IsNullOrWhiteSpace(crsFonte) && SrsFactory.IsSame(crsFonte, crsProjeto);
        }
        catch { return false; }
    }

    private async Task<List<string>> CarregarCamadasDoProjetoAsync(
        GeoNex.Models.Projeto projeto,
        IReadOnlyList<GeoNex.Models.Camada> camadasProjeto)
    {
        // O .gnx guarda o SRC e a origem do mapa no espaço do próprio projeto.
        // Aplicá-los antes de ler os dados é essencial: cada vetor calcula seus
        // envelopes e índices já no SRC de destino. Trocar o SRC depois da carga
        // deixava os caminhos reprojetados, mas os envelopes em graus, escondendo
        // as camadas ao reabrir projetos que usam um mapa-base em EPSG:3857.
        string crsSalvo = string.IsNullOrWhiteSpace(projeto.CRS) ? "EPSG:4326" : projeto.CRS;
        bool origemSalvaValida = projeto.OffsetMundoDefinido &&
            double.IsFinite(projeto.OffsetMundoX) && double.IsFinite(projeto.OffsetMundoY);
        MapService.ProjetoSRS = crsSalvo;
        MapService.OffsetMundoX = origemSalvaValida ? projeto.OffsetMundoX : 0;
        MapService.OffsetMundoY = origemSalvaValida ? projeto.OffsetMundoY : 0;
        bool possuiCamadasLocais = camadasProjeto.Any(camada =>
            TipoFonteProjeto(camada) == "Arquivo" && !string.IsNullOrWhiteSpace(camada.CaminhoFonteOriginal));
        bool possuiMapaBaseOnline = camadasProjeto.Any(camada => TipoFonteProjeto(camada) == "MapaBaseOnline");
        if (!origemSalvaValida && !possuiCamadasLocais && possuiMapaBaseOnline)
        {
            // Projetos antigos apenas com mapa-base ainda começam na mesma área
            // padrão do GeoNex, mas já no SRC persistido pelo projeto.
            double[] centroPadrao = { -48.5747, -25.8828, 0 };
            using var paraProjeto = SrsFactory.CreateTransform("EPSG:4326", crsSalvo);
            paraProjeto.TransformPoint(centroPadrao);
            if (!double.IsFinite(centroPadrao[0]) || !double.IsFinite(centroPadrao[1]))
                throw new InvalidDataException("O centro inicial do mapa não pôde ser convertido para o SRC do projeto.");
            MapService.OffsetMundoX = centroPadrao[0];
            MapService.OffsetMundoY = centroPadrao[1];
        }
        // Em projetos com camadas, origem zero serve apenas como fallback para
        // documentos antigos sem centro persistido e impede que a primeira fonte
        // troque o SRC do projeto durante a reconstrução. Projetos vazios deixam
        // a origem livre para que a primeira camada escolha uma origem adequada.
        MapService.OffsetMundoDefinido = origemSalvaValida || camadasProjeto.Count > 0;
        _camadaBaseProjeto = null;
        var avisos = new List<string>();
        var estilosProjeto = new Dictionary<string, EstiloCamada>(StringComparer.OrdinalIgnoreCase);

        foreach (GeoNex.Models.Camada persistida in camadasProjeto)
        {
            if (string.IsNullOrWhiteSpace(persistida.EstiloJson)) continue;
            try
            {
                var estilo = System.Text.Json.JsonSerializer.Deserialize<EstiloCamada>(persistida.EstiloJson);
                if (estilo is not null)
                {
                    estilosProjeto[persistida.Nome] = estilo;
                    MapService.EstilosPorCamada[persistida.Nome] = estilo;
                }
            }
            catch (System.Text.Json.JsonException ex)
            {
                avisos.Add($"O estilo da camada '{persistida.Nome}' está inválido e foi ignorado: {ex.Message}");
            }
        }

        var camadasLocais = camadasProjeto
            .Where(camada => TipoFonteProjeto(camada) == "Arquivo" &&
                !string.IsNullOrWhiteSpace(camada.CaminhoFonteOriginal) &&
                (string.Equals(camada.Tipo, "Vetor", StringComparison.OrdinalIgnoreCase) ||
                 string.Equals(camada.Tipo, "Raster", StringComparison.OrdinalIgnoreCase)))
            .OrderBy(camada => camada.Ordem)
            .ToList();

        var basePersistida = camadasLocais.FirstOrDefault(camada =>
            string.Equals(camada.Nome, projeto.CamadaBase, StringComparison.OrdinalIgnoreCase));
        basePersistida ??= camadasLocais.FirstOrDefault(camada => CamadaUsaCrsProjeto(camada, projeto.CRS));

        IEnumerable<GeoNex.Models.Camada> ordemCarregamento = basePersistida is null
            ? camadasLocais
            : new[] { basePersistida }.Concat(camadasLocais.Where(camada => !ReferenceEquals(camada, basePersistida)));

        foreach (GeoNex.Models.Camada persistida in ordemCarregamento)
        {
            string caminho = persistida.CaminhoFonteOriginal!;
            if (!GeoNex.Services.GnxProjectStore.FonteEhRemota(caminho) && !System.IO.File.Exists(caminho))
            {
                RegistrarNovaCamada(new Camada
                {
                    Nome = persistida.Nome,
                    Tipo = persistida.Tipo,
                    Visivel = persistida.Visivel,
                    CaminhoArquivo = caminho,
                    FonteJson = persistida.FonteJson,
                    PendenteReconexao = true
                });
                avisos.Add($"A fonte da camada '{persistida.Nome}' não foi encontrada e ficou offline. Caminho esperado: {caminho}");
                continue;
            }

            if (string.Equals(persistida.Tipo, "Raster", StringComparison.OrdinalIgnoreCase))
            {
                caminhoArquivoRaster = caminho;
                await AdicionarCamadaAoMapa();
            }
            else
            {
                caminhoArquivoVetor = caminho;
                await AdicionarVetorAoMapa();
            }

            string nomeRuntime = System.IO.Path.GetFileName(caminho);
            Camada? carregada = CamadasAtivas.FirstOrDefault(camada =>
                string.Equals(camada.Nome, nomeRuntime, StringComparison.OrdinalIgnoreCase));
            if (carregada is null)
                throw new InvalidDataException($"A camada '{persistida.Nome}' não pôde ser carregada.");

            carregada.Visivel = persistida.Visivel;
            carregada.FonteJson = persistida.FonteJson;

            _camadaBaseProjeto ??= carregada.Nome;
        }

        foreach (GeoNex.Models.Camada persistida in camadasProjeto.OrderBy(camada => camada.Ordem))
        {
            string tipoFonte = TipoFonteProjeto(persistida);
            if (tipoFonte == "Arquivo" && !string.IsNullOrWhiteSpace(persistida.CaminhoFonteOriginal))
                continue;

            if (tipoFonte == "MapaBaseOnline" && TentarLerFonteProjeto(persistida) is { Identificador: { Length: > 0 } key } &&
                GeoNex.Services.OnlineBasemapPolicy.TryResolve(key, out _))
            {
                await CarregarMapaBaseOnline(key);
                Camada? mapa = CamadasAtivas.FirstOrDefault(camada =>
                    string.Equals(camada.Nome, persistida.Nome, StringComparison.OrdinalIgnoreCase));
                if (mapa is not null && !mapa.PendenteReconexao)
                {
                    mapa.Visivel = persistida.Visivel;
                    if (mapa.Visivel) MapService.CamadasInvisiveis.Remove(mapa.Nome);
                    else MapService.CamadasInvisiveis.Add(mapa.Nome);
                    mapa.FonteJson = SerializarFonteProjeto(mapa);
                    _camadaBaseProjeto ??= mapa.Nome;
                    continue;
                }

                avisos.Add($"O mapa-base online '{persistida.Nome}' não abriu e ficou marcado como offline.");
            }
            else if (tipoFonte == "MapaBaseOnline")
            {
                avisos.Add($"A definição do mapa-base online de '{persistida.Nome}' não é reconhecida.");
            }
            else if (tipoFonte == "PostGIS")
            {
                var fonte = TentarLerFonteProjeto(persistida);
                if (fonte is not null &&
                    !string.IsNullOrWhiteSpace(fonte.Servidor) &&
                    !string.IsNullOrWhiteSpace(fonte.BancoDados) &&
                    !string.IsNullOrWhiteSpace(fonte.Usuario) &&
                    !string.IsNullOrWhiteSpace(fonte.Esquema) &&
                    !string.IsNullOrWhiteSpace(fonte.Tabela) &&
                    !string.IsNullOrWhiteSpace(fonte.ColunaGeometria) &&
                    fonte.Porta is > 0 && fonte.Srid is > 0 && fonte.DimensaoCoordenada is not null)
                {
                    try
                    {
                        string? password = await Microsoft.Maui.Storage.SecureStorage.Default.GetAsync(
                            GeoNex.Services.GnxProjectStore.ChaveSeguraPostgis(projeto.Id, persistida.Nome));
                        if (password is not null)
                        {
                            var options = new GeoNex.Services.PostgisConnectionOptions
                            {
                                Host = fonte.Servidor!,
                                Port = fonte.Porta!.Value,
                                Database = fonte.BancoDados!,
                                Username = fonte.Usuario!,
                                Password = password,
                                SslMode = fonte.ModoSsl ?? "Prefer"
                            };
                            var table = new GeoNex.Services.PostgisSpatialTable(
                                fonte.Esquema!, fonte.Tabela!, fonte.ColunaGeometria!,
                                fonte.TipoGeometria ?? "GEOMETRY", fonte.Srid!.Value, fonte.DimensaoCoordenada!.Value);
                            var conexaoAnterior = _postgisConnection;
                            _postgisConnection = options;
                            try { await AdicionarCamadaPostgisAsync(table); }
                            finally { _postgisConnection = conexaoAnterior; }

                            Camada? postgis = CamadasAtivas.FirstOrDefault(camada =>
                                string.Equals(camada.Nome, persistida.Nome, StringComparison.OrdinalIgnoreCase));
                            if (postgis is not null && postgis.FontePostgis is not null)
                            {
                                postgis.Visivel = persistida.Visivel;
                                if (postgis.Visivel) MapService.CamadasInvisiveis.Remove(postgis.Nome);
                                else MapService.CamadasInvisiveis.Add(postgis.Nome);
                                postgis.FonteJson = SerializarFonteProjeto(postgis);
                                if (estilosProjeto.TryGetValue(postgis.Nome, out var estiloPostgis))
                                    MapService.EstilosPorCamada[postgis.Nome] = estiloPostgis;
                                _camadaBaseProjeto ??= postgis.Nome;
                                continue;
                            }
                        }
                    }
                    catch
                    {
                        // Keep the source descriptor in the layer list for an explicit reconnect.
                    }
                }

                avisos.Add($"A camada PostGIS '{persistida.Nome}' precisa ser reconectada ou não pôde ser carregada.");
            }
            else if (tipoFonte == "Arquivo")
            {
                avisos.Add($"A camada '{persistida.Nome}' não tem um caminho de arquivo salvo e ficou offline.");
            }
            else if (tipoFonte != "MapaBaseOnline")
            {
                avisos.Add($"A origem de '{persistida.Nome}' não é reconhecida; os dados da camada foram preservados para reconexão.");
            }

            if (!CamadasAtivas.Any(camada => string.Equals(camada.Nome, persistida.Nome, StringComparison.OrdinalIgnoreCase)))
            {
                RegistrarNovaCamada(new Camada
                {
                    Nome = persistida.Nome,
                    Tipo = persistida.Tipo,
                    Visivel = persistida.Visivel,
                    CaminhoArquivo = persistida.CaminhoFonteOriginal ?? string.Empty,
                    FonteJson = SerializarFonteProjeto(new Camada
                    {
                        Nome = persistida.Nome,
                        FonteJson = persistida.FonteJson,
                        CaminhoArquivo = persistida.CaminhoFonteOriginal ?? string.Empty
                    }),
                    PendenteReconexao = true
                });
            }
        }

        var porNome = CamadasAtivas.ToDictionary(camada => camada.Nome, StringComparer.OrdinalIgnoreCase);
        CamadasAtivas = camadasProjeto
            .OrderBy(camada => camada.Ordem)
            .Select(camada => porNome.GetValueOrDefault(camada.Nome))
            .Where(camada => camada is not null)
            .Cast<Camada>()
            .Concat(CamadasAtivas.Where(camada => !camadasProjeto.Any(item =>
                string.Equals(item.Nome, camada.Nome, StringComparison.OrdinalIgnoreCase))))
            .ToList();

        Camada? camadaBaseSalva = string.IsNullOrWhiteSpace(projeto.CamadaBase)
            ? null
            : CamadasAtivas.FirstOrDefault(camada =>
                string.Equals(camada.Nome, projeto.CamadaBase, StringComparison.OrdinalIgnoreCase));
        _camadaBaseProjeto = camadaBaseSalva?.Nome
            ?? CamadasAtivas.FirstOrDefault(camada => !camada.PendenteReconexao)?.Nome
            ?? CamadasAtivas.FirstOrDefault()?.Nome;

        using (IDisposable? pausaRender = _server is null ? null : await _server.PauseRenderingAsync())
        {
            foreach (Camada camada in CamadasAtivas.Where(camada => camada.Tipo == "Vetor" && !camada.PendenteReconexao))
            {
                if (!MapService.EstilosPorCamada.TryGetValue(camada.Nome, out var estilo)) continue;
                if (estilo.TipoSimbologia == "CATEGORIZADA")
                    MapService.CompilarCategorias(camada.Nome, estilo.ColunaSimbologia);
                if (estilo.ExibirRotulos && !string.IsNullOrWhiteSpace(estilo.ColunaRotulo))
                    MapService.AtualizarRotulosCamada(camada.Nome, estilo.ColunaRotulo);
            }
        }

        MapService.CamadasInvisiveis.Clear();
        foreach (Camada camada in CamadasAtivas.Where(camada => !camada.Visivel || camada.PendenteReconexao))
            MapService.CamadasInvisiveis.Add(camada.Nome);
        foreach (Camada camada in CamadasAtivas.Where(camada => camada.Visivel && !camada.PendenteReconexao))
            MapService.CamadasInvisiveis.Remove(camada.Nome);
        SincronizarHierarquia(solicitarFrame: false);

        bool cameraSalvaValida = double.IsFinite(projeto.CameraPanX) &&
            double.IsFinite(projeto.CameraPanY) &&
            Math.Abs(projeto.CameraPanX) <= 1_000_000_000 &&
            Math.Abs(projeto.CameraPanY) <= 1_000_000_000 &&
            double.IsFinite(projeto.CameraZoom) && projeto.CameraZoom is >= 0.05 and <= 1_000_000;
        MapService.CameraPanX = cameraSalvaValida ? projeto.CameraPanX : 0;
        MapService.CameraPanY = cameraSalvaValida ? projeto.CameraPanY : 0;
        MapService.CameraZoom = cameraSalvaValida ? projeto.CameraZoom : 1;
        MapService.IsPanning = false;
        long serial = await JSRuntime.InvokeAsync<long>(
            "mapEngine.sincronizarCameraComBlazor",
            MapService.CameraPanX,
            MapService.CameraPanY,
            MapService.CameraZoom);
        _ultimaRequisicaoCamera = Math.Max(_ultimaRequisicaoCamera, serial);
        MapService.RequestRedraw();
        await JSRuntime.InvokeVoidAsync("mapEngine.executarRequisicao", true, true);
        SolicitarNovoFrame();
        return avisos;
    }

    private static GeoNex.Models.ProjetoFonteCamada? TentarLerFonteProjeto(GeoNex.Models.Camada camada)
    {
        if (string.IsNullOrWhiteSpace(camada.FonteJson)) return null;
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<GeoNex.Models.ProjetoFonteCamada>(
                camada.FonteJson,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch (System.Text.Json.JsonException) { return null; }
    }

    private void RemoverRecursosRaster(string nome, string? caminhoFonte)
    {
        if (!string.IsNullOrWhiteSpace(caminhoFonte))
            GeoNex.Services.RasterOverviewBuilder.Cancel(caminhoFonte);
        lock (MapService)
        {
            MapService.RemoveWarpedRaster(nome);
            MapService.RemoveRaster(nome);
            MapService.LimitesRasters.Remove(nome);
            MapService.RemoveRasterCache(nome);
            MapService.EstilosPorCamada.TryRemove(nome, out _);
            MapService.OrdemCamadas.RemoveAll(item => string.Equals(item, nome, StringComparison.OrdinalIgnoreCase));
            MapService.CamadasInvisiveis.Remove(nome);
        }
    }

    private bool RemoverRecursosVetoriais(string nome)
    {
        MapService.CaminhoFeicaoDestacada = null;
        MapService.DestacarFeicao(null);
        MapService.RemoveVectorResources(nome);
        bool removeuFeicoes = false;
        if (MapService.FeaturesPorCamada.Remove(nome, out var feicoes))
        {
            removeuFeicoes = true;
            foreach (var feicao in feicoes)
                System.Threading.Interlocked.Exchange(ref feicao.Path, null)?.Dispose();
        }
        MapService.FeicoesOriginais.Remove(nome);
        MapService.LimitesVetoresWorld.Remove(nome);
        if (MapService.VetoresPorCamada.Remove(nome, out var vetores))
            foreach (var caminho in vetores) caminho.Dispose();
        if (MapService.LinhasPorCamada.Remove(nome, out var linhas))
            foreach (var caminho in linhas) caminho.Dispose();
        if (MapService.PontosPorCamada.Remove(nome, out var pontos)) pontos.Dispose();
        if (MapService.VetoresCategorizados.Remove(nome, out var categorias))
            foreach (var grupo in categorias.Values)
                foreach (var caminho in grupo) caminho.Dispose();
        if (MapService.LinhasCategorizadas.Remove(nome, out var linhasCategorizadas))
            foreach (var grupo in linhasCategorizadas.Values)
                foreach (var caminho in grupo) caminho.Dispose();
        MapService.PontosAncoragemRotulo.Remove(nome);
        MapService.EstilosPorCamada.TryRemove(nome, out _);
        MapService.OrdemCamadas.RemoveAll(item => string.Equals(item, nome, StringComparison.OrdinalIgnoreCase));
        MapService.CamadasInvisiveis.Remove(nome);
        RecalcularLimitesGlobaisVetoriais();
        return removeuFeicoes;
    }

    private void RecalcularLimitesGlobaisVetoriais()
    {
        SKRect limites = SKRect.Empty;
        foreach (var envelope in MapService.LimitesVetoresWorld.Values)
        {
            if (envelope.IsNull || !double.IsFinite(envelope.MinX) || !double.IsFinite(envelope.MinY) ||
                !double.IsFinite(envelope.MaxX) || !double.IsFinite(envelope.MaxY))
                continue;
            var retangulo = new SKRect(
                (float)(envelope.MinX - MapService.OffsetMundoX),
                (float)-(envelope.MaxY - MapService.OffsetMundoY),
                (float)(envelope.MaxX - MapService.OffsetMundoX),
                (float)-(envelope.MinY - MapService.OffsetMundoY));
            if (!float.IsFinite(retangulo.Left) || !float.IsFinite(retangulo.Top) ||
                !float.IsFinite(retangulo.Right) || !float.IsFinite(retangulo.Bottom) || retangulo.IsEmpty)
                continue;
            if (limites.IsEmpty) limites = retangulo;
            else limites.Union(retangulo);
        }
        MapService.LimitesGlobaisVetor = limites;
    }

    private async Task LimparCamadasDoProjetoAtualAsync()
    {
        if (_ferramentaAtiva != ModoFerramenta.Identificacao)
            TrocarFerramenta(ModoFerramenta.Identificacao);
        else
            MapService.DestacarFeicao(null);
        HistoricoAquisicao.Clear();
        HistoricoMedicao.Clear();
        LimparCursorDesenho();
        LimparMetricasAquisicao();
        RecalcularMedicoes(incluirCursor: false);
        _medicaoConcluida = false;
        modoEdicaoVerticeLigado = false;
        _geometriaDestacada = null;
        _ultimoSnapRenderizado = null;

        using IDisposable? pausaRender = _server is null ? null : await _server.PauseRenderingAsync();
        foreach (Camada camada in CamadasAtivas.ToArray())
        {
            string nome = camada.Nome;
            if (camada.Tipo == "Raster")
                RemoverRecursosRaster(nome, camada.CaminhoArquivo);
            else if (camada.Tipo == "Vetor")
                RemoverRecursosVetoriais(nome);
            else MapService.EstilosPorCamada.TryRemove(nome, out _);
        }

        CamadasAtivas.Clear();
        MapService.ResetarEstadoInteracaoVetorial();
        MapService.OrdemCamadas = new List<string>();
        MapService.CamadasInvisiveis.Clear();
        MapService.LimitesRasters.Clear();
        MapService.LimitesGlobaisVetor = SKRect.Empty;
        MapService.ClearRasterCaches();
        MapService.ClearWarpedRasters();
        MapService.OffsetMundoX = 0;
        MapService.OffsetMundoY = 0;
        MapService.OffsetMundoDefinido = false;
        MapService.ProjetoSRS = "EPSG:4326";
        MapService.CameraPanX = 0;
        MapService.CameraPanY = 0;
        MapService.CameraZoom = 1;
        MapService.PontosMedicao.Clear();
        MapService.PontosAquisicao.Clear();
        MapService.MostrarAreaMedicao = false;
        MapService.ClientRenderedDigitizingPreview = false;
        MapService.ClientRenderedMeasurementPreview = false;
        MapService.DestacarFeicao(null);
        MapService.RequestRedraw();
        _camadaBaseProjeto = null;
        camadaSelecionadaPainel = string.Empty;
        camadaSelecionadaMenu = string.Empty;
        _camadaDestinoAquisicao = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

