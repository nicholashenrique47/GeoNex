    <!-- ========================================================= -->
    <!-- ========================================================= -->
    <!-- PAINEL FLUTUANTE DE DESENHO (AQUISIÇÃO)                   -->
    <!-- ========================================================= -->
    <!-- ========================================================= -->
    <!-- PAINEL FLUTUANTE DE DESENHO (AQUISIÇÃO)                   -->
    <!-- ========================================================= -->
    <!-- ========================================================= -->
    <!-- PAINEL FLUTUANTE DE DESENHO (AQUISIÇÃO)                   -->
    <!-- ========================================================= -->
    @if (_ferramentaAtiva == ModoFerramenta.AquisicaoPoligono || _ferramentaAtiva == ModoFerramenta.AquisicaoLinha || _ferramentaAtiva == ModoFerramenta.AquisicaoPonto)
    {
        <section class="glass-panel digitizing-toolbar tool-workbench" aria-label="Ferramentas de vetorização">
            <div class="workbench-heading">
                <div class="tool-identity"><span class="tool-symbol" aria-hidden="true">◇</span><div><h2>Vetorização</h2><span>@(_modoAvancadoVetorizacao ? "Ferramentas e precisão" : $"{MapService.PontosAquisicao.Count} ponto(s)")</span></div></div>
                <div class="digitizing-mode" role="group" aria-label="Nível de ferramentas">
                    <button class="@(!_modoAvancadoVetorizacao ? "selected" : "")" aria-pressed="@(!_modoAvancadoVetorizacao)" disabled="@(_modoAvancadoVetorizacao && ConstrucaoParametrica && MapService.PontosAquisicao.Count > 0)" title="Conclua ou cancele a construção avançada antes de voltar ao modo simples" @onclick="() => DefinirModoVetorizacaoAvancado(false)">Simples</button>
                    <button class="@(_modoAvancadoVetorizacao ? "selected" : "")" aria-pressed="@_modoAvancadoVetorizacao" @onclick="() => DefinirModoVetorizacaoAvancado(true)">Avançada</button>
                </div>
                <label class="destination-field">Camada de destino
                    <select class="gis-select" value="@_camadaDestinoAquisicao" @onchange="AoMudarCamadaDestino" disabled="@(MapService.PontosAquisicao.Count > 0 || _coordenadaAbsolutaTravada)" aria-label="Camada de destino da vetorização">
                        <option value="" disabled>Selecione uma camada</option>
                        @foreach (var camada in CamadasAtivas.Where(c => c.Tipo == "Vetor"))
                        {
                            <option value="@camada.Nome">@camada.Nome (@camada.Geometria)</option>
                        }
                    </select>
                </label>
                <div class="sketch-actions" role="group" aria-label="Ações do esboço">
                    <div class="sketch-history-actions" role="group" aria-label="Histórico do desenho">
                        <button class="workbench-button history-icon-button" aria-label="Desfazer último ponto" @onclick="DesfazerUltimoPontoAquisicao" disabled="@(!HistoricoAquisicao.CanUndo)" title="Desfazer · Ctrl+Z"><span aria-hidden="true">↶</span></button>
                        <button class="workbench-button history-icon-button" aria-label="Refazer último ponto" @onclick="RefazerUltimoPontoAquisicao" disabled="@(!HistoricoAquisicao.CanRedo)" title="Refazer · Ctrl+Y"><span aria-hidden="true">↷</span></button>
                    </div>
                    <span class="workbench-action-divider" aria-hidden="true"></span>
                    <button class="workbench-button danger" @onclick="CancelarAquisicao" title="Cancelar · Esc">Cancelar</button>
                    <button class="workbench-button precision-shortcut" aria-label="Inserir coordenadas (F6)" aria-keyshortcuts="F6" title="Coordenadas absolutas · F6" @onclick="(Microsoft.AspNetCore.Components.Web.MouseEventArgs e) => AbrirEntradaPrecisa(false, e.ClientX, e.ClientY)"><span>XY</span><kbd>F6</kbd></button>
                    <button class="workbench-button primary" @onclick="ConcluirAquisicaoGeometrica" disabled="@(MapService.PontosAquisicao.Count < MinimoPontosAquisicao)" title="Concluir · Enter">Concluir <kbd>↵</kbd></button>
                </div>
            </div>
            @if (_modoAvancadoVetorizacao)
            {
                <div class="workbench-controls advanced-controls">
                    <section class="advanced-control-group advanced-construction-group" aria-label="Construção da geometria">
                        <div class="advanced-group-heading"><span class="advanced-group-index">01</span><div><strong>Construção</strong><small>Forma da geometria</small></div></div>
                        @if (_ferramentaAtiva == ModoFerramenta.AquisicaoPoligono)
                        {
                            <div class="advanced-construction-fields">
                                <label class="construction-field"><span>Modo de construção</span>
                                    <select class="gis-select" aria-label="Modo de construção" @bind="ModoConstrucao" disabled="@(MapService.PontosAquisicao.Count > 0)">
                                        <option value="@ConstructionMode.Vertices">Vértice a vértice</option>
                                        <option value="@ConstructionMode.Rectangle">Retângulo · 2 cantos</option>
                                        <option value="@ConstructionMode.OrientedRectangle">Retângulo orientado · 3 pontos</option>
                                        <option value="@ConstructionMode.Circle">Círculo · centro e raio</option>
                                        <option value="@ConstructionMode.Ellipse">Elipse · centro e 2 eixos</option>
                                        <option value="@ConstructionMode.RegularPolygon">Polígono regular · centro e raio</option>
                                    </select>
                                </label>
                                @if (ModoConstrucao == ConstructionMode.RegularPolygon)
                                {
                                    <label class="sides-field"><span>Lados</span>
                                        <select class="gis-select" aria-label="Lados do polígono regular" @bind="LadosConstrucao" disabled="@(MapService.PontosAquisicao.Count > 0)">
                                            @for (int lados = 3; lados <= 32; lados++) { <option value="@lados">@lados</option> }
                                        </select>
                                    </label>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="advanced-fixed-geometry"><strong>@(_ferramentaAtiva == ModoFerramenta.AquisicaoLinha ? "Linha" : "Ponto")</strong><small>Geometria definida pela camada de destino</small></div>
                        }
                        <small class="advanced-control-help">@InstrucaoConstrucao</small>
                    </section>

                    <section class="advanced-control-group advanced-precision-group" aria-label="Ferramentas de precisão">
                        <div class="advanced-group-heading"><span class="advanced-group-index">02</span><div><strong>Precisão</strong><small>Coordenadas e vetor polar</small></div></div>
                        <button class="workbench-button precision-shortcut advanced-cogo-button" aria-label="Abrir COGO (Tab)" aria-keyshortcuts="Tab" title="Vetor polar COGO · Tab" @onclick="(Microsoft.AspNetCore.Components.Web.MouseEventArgs e) => AbrirEntradaPrecisa(true, e.ClientX, e.ClientY)"><span class="advanced-cogo-icon" aria-hidden="true">∠</span><span>Vetor polar COGO</span><kbd>Tab</kbd></button>
                        <small class="advanced-control-help">Informe distância e azimute a partir do último ponto.</small>
                    </section>

                    <section class="advanced-control-group advanced-snap-group" aria-label="Captura e encaixes">
                        <div class="advanced-group-heading"><span class="advanced-group-index">03</span><div><strong>Captura</strong><small>Alinhamento inteligente</small></div></div>
                        <details class="snap-options workbench-details">
                            <summary><span class="advanced-snap-icon" aria-hidden="true">⌖</span><span>Encaixes ativos</span><span class="setting-count">@NumeroEncaixesAtivos</span></summary>
                            <div class="snap-menu">
                                <div class="settings-title">Atração do cursor</div>
                                <button class="snap-toggle" aria-pressed="@_snapAquisicaoVertice" @onclick="() => _snapAquisicaoVertice = !_snapAquisicaoVertice"><i class="snap-key vertex"></i>Atrair vértices<span>@(_snapAquisicaoVertice ? "Ligado" : "Desligado")</span></button>
                                <button class="snap-toggle" aria-pressed="@_snapAquisicaoAresta" @onclick="() => _snapAquisicaoAresta = !_snapAquisicaoAresta"><i class="snap-key edge"></i>Atrair arestas<span>@(_snapAquisicaoAresta ? "Ligado" : "Desligado")</span></button>
                                <label><input type="checkbox" @bind="_snapAquisicaoMeio" /><i class="snap-key midpoint"></i>Meio das arestas</label>
                                <label><input type="checkbox" @bind="_snapAquisicaoIntersecao" /><i class="snap-key intersection"></i>Interseções</label>
                                <label><input type="checkbox" @bind="_modoOrtogonalAquisicao" disabled="@ConstrucaoParametrica" />Ortogonal (90°) · vértices</label>
                                <label class="tolerance-field">Tolerância em tela
                                    <select class="gis-select" aria-label="Tolerância do snap" @bind="ToleranciaSnapPixels">
                                        <option value="6">6 px · precisa</option><option value="10">10 px</option><option value="15">15 px · padrão</option><option value="20">20 px</option><option value="30">30 px · ampla</option>
                                    </select>
                                </label>
                            </div>
                        </details>
                        <small class="advanced-control-help">@NumeroEncaixesAtivos opção(ões) de captura ativada(s).</small>
                    </section>
                </div>
            }
            @if (_mostrarMenuContexto)
            {
                <div class="digitizing-context-controls" role="group" aria-label="Ações rápidas da vetorização" @onkeydown="TecladoContextoVetorizacao">
                    <span>AÇÕES DO ESBOÇO</span>
                    <button @ref="_contextoVetorizacaoRef" class="workbench-button" @onclick="DesfazerUltimoPontoAquisicao" disabled="@(!HistoricoAquisicao.CanUndo)">Desfazer ponto</button>
                    @if (_modoAvancadoVetorizacao)
                    {
                        <button class="workbench-button" @onclick="() => AbrirEntradaPrecisa(true, _menuContextoX, _menuContextoY)">Vetor polar · COGO</button>
                    }
                    <button class="workbench-button primary" @onclick="() => { _mostrarMenuContexto = false; ConcluirAquisicaoGeometrica(); }" disabled="@(MapService.PontosAquisicao.Count < MinimoPontosAquisicao)">Concluir esboço</button>
                    <button class="workbench-button" @onclick="() => _mostrarMenuContexto = false">Fechar</button>
                </div>
            }
            <div class="workbench-footer">
                <span class="toolbar-status @(string.IsNullOrEmpty(mensagemVetorizacao) ? "" : "warning")" role="status">@MapService.PontosAquisicao.Count ponto(s) · @(string.IsNullOrEmpty(mensagemVetorizacao) ? "Enter conclui · Esc cancela" : mensagemVetorizacao)</span>
                @if (MapService.PontosAquisicao.Count > 0)
                {
                    <div class="sketch-metrics" aria-label="Métricas do esboço">
                        <strong>@TextoMetricasAquisicao</strong>
                        <small class="@(_aquisicaoAreaErro != null ? "sketch-metrics-error" : "")">@(_aquisicaoAreaErro ?? _aquisicaoMetodo)</small>
                    </div>
                }
                @if (ConstrucaoParametrica)
                {
                    <small class="construction-note">Grade do SRC@(ModoConstrucao is ConstructionMode.Circle or ConstructionMode.Ellipse ? " · 128 segmentos" : "")</small>
                }
            </div>
        </section>
    }
    @if (FerramentaDesenhoAtiva && _mostrarInputAbsoluto)
    {
        <section id="hud-f6" class="precision-hud precision-hud-coordinate" style="@EstiloHud(_hudX, _hudY)" role="region" aria-labelledby="hud-f6-title">
            <header class="precision-hud-heading" onpointerdown="window.iniciarArrasteHUD(event,'hud-f6')">
                <span class="precision-heading-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v4M12 17v4M3 12h4m10 0h4"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg>
                </span>
                <div class="precision-heading-copy"><span class="precision-eyebrow">COORDENADAS ABSOLUTAS</span><strong id="hud-f6-title">Posicionar vértice <kbd>F6</kbd></strong><small>Fixe X e Y e clique no mapa para inserir</small></div>
                <button type="button" class="precision-close" aria-label="Fechar coordenadas F6" title="Fechar" @onpointerdown:stopPropagation="true" @onclick="FecharEntradaAbsoluta">×</button>
            </header>
            <form class="precision-form" @onsubmit="TravarCoordenadaAbsoluta" @onsubmit:preventDefault="true">
                <div class="precision-srs-picker">
                    <span>SRC das coordenadas</span>
                    <span class="precision-srs-value" title="@TextoSrsEntradaAbsoluta">@TextoSrsEntradaAbsoluta</span>
                </div>
                <div class="precision-field-grid">
                    <label class="precision-field">
                        <span class="precision-field-label"><strong>X</strong><small>@(_entradaAbsolutaGeografica ? "Longitude" : "Este")</small></span>
                        <span class="precision-input-shell"><span class="precision-axis" aria-hidden="true">X</span><input @ref="_inputAbsolutoXRef" type="number" step="any" required disabled="@_coordenadaAbsolutaTravada" @bind="_absolutoX" @bind:event="oninput" aria-label="Coordenada X" /></span>
                    </label>
                    <label class="precision-field">
                        <span class="precision-field-label"><strong>Y</strong><small>@(_entradaAbsolutaGeografica ? "Latitude" : "Norte")</small></span>
                        <span class="precision-input-shell"><span class="precision-axis" aria-hidden="true">Y</span><input type="number" step="any" required disabled="@_coordenadaAbsolutaTravada" @bind="_absolutoY" @bind:event="oninput" aria-label="Coordenada Y" /></span>
                    </label>
                </div>
                <div class="precision-form-actions">
                    @if (_coordenadaAbsolutaTravada)
                    {
                        <div class="precision-lock-state is-active"><span class="precision-lock-indicator" aria-hidden="true"></span><strong>Posição fixada no mapa</strong><button type="button" class="precision-unlock" @onclick="() => DestravarCoordenadaAbsoluta()">Liberar</button></div>
                    }
                    else
                    {
                        <button type="submit" class="workbench-button primary" disabled="@(!_absolutoX.HasValue || !_absolutoY.HasValue)"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 3v14M3 10h14"/></svg>Fixar posição</button>
                    }
                </div>
                <div class="precision-hint @(_coordenadaAbsolutaTravada ? "is-locked" : "")"><span class="precision-hint-icon" aria-hidden="true">i</span><span class="precision-hint-copy"><span class="precision-srs-row"><span>Mapa</span><strong class="precision-srs" title="@MapService.ProjetoSRS">@_textoSrsProjetoEntrada</strong></span><span class="precision-hint-secondary">@(_coordenadaAbsolutaTravada ? "Clique no mapa para adicionar o vértice na cruz verde." : "Os valores serão convertidos para o SRC do projeto antes de fixar.")</span></span></div>
            </form>
        </section>
    }
    @if (FerramentaDesenhoAtiva && _mostrarInputCogo)
    {
        <section id="hud-cogo" class="precision-hud precision-hud-cogo" style="@EstiloHud(_hudCogoX, _hudCogoY)" role="region" aria-labelledby="hud-cogo-title">
            <header class="precision-hud-heading" onpointerdown="window.iniciarArrasteHUD(event,'hud-cogo')">
                <span class="precision-heading-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="m14.8 9.2-2 5.6-3.6 1.4 2-5.6 3.6-1.4Z"/><path d="M12 2v2M22 12h-2"/></svg>
                </span>
                <div class="precision-heading-copy"><span class="precision-eyebrow">DIGITAÇÃO POLAR</span><strong id="hud-cogo-title">Projetar vértice <kbd>Tab</kbd></strong><small>Distância e azimute a partir do último ponto</small></div>
                <button type="button" class="precision-close" aria-label="Fechar COGO" title="Fechar" @onpointerdown:stopPropagation="true" @onclick="FecharEntradaCogo">×</button>
            </header>
            <form class="precision-form" @onsubmit="AplicarVetorRestritoCogo" @onsubmit:preventDefault="true">
                <div class="precision-field-grid">
                    <label class="precision-field">
                        <span class="precision-field-label"><strong>Distância</strong><small>Comprimento do segmento</small></span>
                        <span class="precision-input-shell"><input @ref="_inputDistanciaRef" type="number" step="any" min="0.000001" required @bind="_cogoDistancia" @bind:event="oninput" aria-label="Distância polar em metros" /><span class="precision-unit" aria-hidden="true">m</span></span>
                    </label>
                    <label class="precision-field">
                        <span class="precision-field-label"><strong>Azimute</strong><small>Ângulo a partir do norte</small></span>
                        <span class="precision-input-shell"><input type="number" step="any" required @bind="_cogoAzimute" @bind:event="oninput" aria-label="Azimute polar em graus" /><span class="precision-unit" aria-hidden="true">°</span></span>
                    </label>
                </div>
                <div class="precision-form-actions">
                    <button type="submit" class="workbench-button primary" disabled="@(MapService.PontosAquisicao.Count == 0 || !(_cogoDistancia > 0) || !_cogoAzimute.HasValue)"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 15.5 15.5 3M6 3h9.5v9.5"/></svg>Projetar ponto</button>
                </div>
                <div class="precision-hint @(MapService.PontosAquisicao.Count == 0 ? "is-prompt" : "")"><span class="precision-hint-icon" aria-hidden="true">@(MapService.PontosAquisicao.Count == 0 ? "!" : "i")</span><span>@(MapService.PontosAquisicao.Count == 0 ? "Marque o primeiro ponto ou informe uma coordenada." : "0° norte da grade · 90° leste · requer SRC projetado")</span></div>
            </form>
            <section class="precision-constraint" aria-label="Restrição de distância">
                <header class="precision-constraint-heading"><div><strong>Restrição e raio</strong><small>Limite o segmento e visualize o raio no mapa</small></div><span class="constraint-state @(MapService.TravaDistanciaAtiva ? "active" : "")">@(MapService.TravaDistanciaAtiva ? "RAIO ATIVO" : "OPCIONAL")</span></header>
                <div class="precision-constraint-grid">
                    <label class="precision-field compact-field">
                        <span class="precision-field-label"><strong>Medida</strong><small>Metros de grade</small></span>
                        <span class="precision-input-shell"><input type="number" step="any" min="0.000001" @bind="_restricaoDistanciaMetros" @bind:event="oninput" aria-label="Distância da restrição em metros" disabled="@MapService.TravaDistanciaAtiva" /><span class="precision-unit" aria-hidden="true">m</span></span>
                    </label>
                    <label class="precision-field compact-field">
                        <span class="precision-field-label"><strong>Comportamento</strong><small>Como usar o raio</small></span>
                        <select class="gis-select" value="@MapService.TravaModoFixo.ToString().ToLowerInvariant()" @onchange='e => AlterarModoRestricaoDistancia(e.Value?.ToString())' aria-label="Modo da restrição"><option value="false">Máxima · até o raio</option><option value="true">Fixa · sobre o raio</option></select>
                    </label>
                    <button class="workbench-button constraint-toggle @(MapService.TravaDistanciaAtiva ? "is-active" : "")" disabled="@ConstrucaoParametrica" aria-pressed="@MapService.TravaDistanciaAtiva" @onclick="AlternarRestricaoPrecisa">@(MapService.TravaDistanciaAtiva ? "Desativar raio" : "Ativar raio e restrição")</button>
                </div>
            </section>
        </section>
    }
    <!-- PAINÉIS LATERAIS E ÁREA DE TRABALHO -->
    <main class="workspace-area">

        <!-- PAINEL ESQUERDO: CAMADAS -->
        <aside class="glass-panel side-panel left-panel">
            <div class="panel-header">
                <button type="button" class="panel-dock-toggle" aria-expanded="@_painelCamadasAberto" aria-label="@(_painelCamadasAberto ? "Recolher painel de camadas" : "Abrir painel de camadas")" title="@(_painelCamadasAberto ? "Recolher camadas" : "Abrir camadas")" @onclick="() => _painelCamadasAberto = !_painelCamadasAberto">
                    @if (_painelCamadasAberto) { <span aria-hidden="true">‹</span> }
                    else { <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5M3 16l9 5 9-5"/></svg> }
                </button>
                <span class="panel-rail-label" aria-hidden="true">Camadas</span>
                <div class="panel-heading-copy">
                    <h2>Camadas</h2>
                    <span class="panel-count" title="Camadas carregadas">@CamadasAtivas.Count</span>
                </div>
                <div class="header-actions">
                    <button type="button" class="icon-action-btn" aria-label="Adicionar camada" title="Adicionar camada" @onclick="AbrirModalImportacao">
                        <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                    </button>
                </div>
            </div>

            <div class="layer-list custom-scrollbar" @onpointerup="FinalizarArraste">
                @if (CamadasAtivas.Count == 0)
                {
                    <div class="layer-empty-state">
                        <span class="layer-empty-icon" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5M3 16l9 5 9-5"/></svg>
                        </span>
                        <strong>Nenhuma camada ainda</strong>
                        <span>Adicione dados para começar seu mapa.</span>
                        <button type="button" class="layer-empty-action" @onclick="AbrirModalImportacao">Adicionar dados</button>
                    </div>
                }
                else
                {
                    @foreach (var camada in CamadasAtivas)
                    {
                    var camadaAtual = camada;

                    // Deteta se esta é a camada que o utilizador tem agarrada neste momento
                    bool sendoArrastada = (camadaArrastada == camadaAtual);

                    <div @key="camadaAtual.Nome"
                         class="layer-item @(camadaAtual.Tipo.ToLower()) @(sendoArrastada ? "is-dragging" : "")"
                         @onpointerenter="() => AoSobrevoarCamada(camadaAtual)"
                         @oncontextmenu="(e) => MostrarMenuContexto(e, camadaAtual.Nome)"
                         @oncontextmenu:preventDefault="true">

                        <div class="drag-handle" title="Arrastar para reordenar"
                             @onpointerdown="() => IniciarArraste(camadaAtual)"
                             @onpointerdown:stopPropagation="true">
                            <svg style="pointer-events: none;" width="14" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="9" cy="12" r="1.5"></circle>
                                <circle cx="9" cy="5" r="1.5"></circle>
                                <circle cx="9" cy="19" r="1.5"></circle>
                                <circle cx="15" cy="12" r="1.5"></circle>
                                <circle cx="15" cy="5" r="1.5"></circle>
                                <circle cx="15" cy="19" r="1.5"></circle>
                            </svg>
                        </div>

                        <input type="checkbox" checked="@camadaAtual.Visivel" @onchange="@(e => ToggleCamada(camadaAtual, (bool)(e.Value ?? false)))" />
                        <span class="type-tag" style="background: @(camadaAtual.Tipo == "Raster" ? "#5b21b6" : "#065f46"); color: @(camadaAtual.Tipo == "Raster" ? "#ddd6fe" : "#a7f3d0");">
                            @(camadaAtual.Tipo == "Raster" ? "R" : "V")
                        </span>
                        <span class="layer-title no-select" title="@camadaAtual.Nome">@camadaAtual.Nome</span>
                        @if (camadaAtual.PendenteReconexao)
                        {
                            <span class="type-tag" style="background:#78350f;color:#fde68a" title="A fonte está offline. Reabra a fonte ou reconecte o serviço.">OFFLINE</span>
                            @if (TipoFonteProjeto(camadaAtual) == "Arquivo")
                            {
                                <button type="button" class="layer-action-btn" title="Localizar novamente o arquivo desta camada" aria-label="Reconectar camada @camadaAtual.Nome" @onclick="() => RepararFonteCamadaAsync(camadaAtual)" @onclick:stopPropagation="true">↻</button>
                            }
                        }

                        @if (camadaAtual.Tipo == "Vetor" && !camadaAtual.PendenteReconexao)
                        {
                            <div class="layer-actions" style="display: flex; gap: 5px; margin-left: auto;">
                                <button type="button" class="layer-action-btn" title="Abrir Tabela de Atributos" @onclick="() => AbrirTabela(camadaAtual.Nome)" @onclick:stopPropagation="true">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                                </button>
                                <button type="button" class="layer-action-btn" title="Propriedades da Camada" @onclick="() => AbrirPropriedadesSincronizadas(camadaAtual.Nome)" @onclick:stopPropagation="true">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                                </button>
                                <button type="button" class="layer-action-btn" title="Opções da Camada" @onclick="(e) => BotaoOpcoesClicado(e, camadaAtual.Nome)" @onclick:stopPropagation="true">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
                                </button>
                            </div>
                        }
                    </div>
                    }
                }
            </div>
            <button type="button" class="panel-resize-handle"
                 role="separator"
                 aria-orientation="horizontal"
                 aria-label="Ajustar altura do painel de camadas"
                 aria-valuemin="20"
                 aria-valuemax="100"
                 aria-valuenow="50"
                 tabindex="0"
                 title="Arraste para ajustar a altura · use ↑ e ↓"
                 onpointerdown="window.geonexResizeDockStart(event)"
                 onkeydown="window.geonexResizeDockKeydown(event)"></button>
        </aside>

<div id="map-container"
     @ref="_mapContainerRef"
     tabindex="0"
     @onpointerdown="ProcessarPressionarMouse"
     @onpointerup="ProcessarSoltarMouse"
     @onpointercancel="ProcessarSoltarMouse"
     @oncontextmenu:preventDefault="true"
     style="cursor: @EstiloCursor; width: 100%; height: 100%; background-color: #161921; position: relative; min-width: 0; min-height: 0; z-index: 0; overflow: hidden; user-select: none; -webkit-user-select: none; touch-action: none; overscroll-behavior: none; contain: strict;">
    <!-- A área de entrada fica imóvel; somente esta superfície vai para a GPU. -->
    <div id="map-render-surface" style="width: 100%; height: 100%; position: absolute; left: 0; top: 0; pointer-events: none; transform-origin: 50% 50%; will-change: transform; contain: layout style;">
        <!-- TIER 0: RENDERING EM CANVAS (Zero-Blink) -->
        <canvas id="skia-canvas" style="width: 100%; height: 100%; position: absolute; left: 0; top: 0; pointer-events: none; z-index: 1;"></canvas>
        <canvas id="skia-canvas-back" style="width: 100%; height: 100%; position: absolute; left: 0; top: 0; pointer-events: none; z-index: 1; visibility: hidden;"></canvas>

        <canvas id="overlayCanvas" style="width: 100%; height: 100%; position: absolute; left: 0; top: 0; pointer-events: none; z-index: 10;"></canvas>
    </div>
</div>
       
        <!-- PAINEL DIREITO: ATRIBUTOS -->
        <aside id="@(_ferramentaAtiva == ModoFerramenta.Medicao ? "measurement-floating-panel" : null)"
               class="glass-panel side-panel right-panel @(_ferramentaAtiva == ModoFerramenta.Medicao ? "measurement-floating-panel" : "")"
               style="@(_ferramentaAtiva == ModoFerramenta.Medicao ? EstiloHud(_measurementPanelX, _measurementPanelY) : null)">
            @if (_ferramentaAtiva == ModoFerramenta.Medicao)
            {
                <div class="panel-header measurement-panel-header" onpointerdown="window.iniciarArrasteHUD(event,'measurement-floating-panel')">
                    <span class="measurement-panel-icon" aria-hidden="true">⌖</span>
                    <div class="measurement-panel-heading"><strong>Medição</strong><small>@MapService.PontosMedicao.Count ponto(s) · arraste para mover</small></div>
                    <button type="button" class="measurement-panel-close" aria-label="Fechar ferramenta de medição" title="Voltar para identificação" @onclick="() => TrocarFerramenta(ModoFerramenta.Identificacao)" @onclick:stopPropagation="true">×</button>
                </div>
            }
            else
            {
                <div class="panel-header">
                    <button type="button" class="panel-dock-toggle" aria-expanded="@_painelIdentificarAberto" aria-label="@(_painelIdentificarAberto ? "Recolher painel de identificação" : "Abrir painel de identificação")" title="@(_painelIdentificarAberto ? "Recolher identificação" : "Abrir identificação")" @onclick="() => _painelIdentificarAberto = !_painelIdentificarAberto">
                        @if (_painelIdentificarAberto) { <span aria-hidden="true">›</span> }
                        else { <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4"/></svg> }
                    </button>
                    <span class="panel-rail-label" aria-hidden="true">Identificar</span>
                    <h2>Identificar</h2>
                </div>
            }

            <div class="properties-content custom-scrollbar" style="padding: 15px;">

                @if (_ferramentaAtiva == ModoFerramenta.Medicao)
                {
                    <section class="measurement-workbench" aria-label="Medição">
                        <div class="measurement-title"><span class="eyebrow">INSPECIONAR DISTÂNCIAS E ÁREAS</span><h3>Medição</h3><p>@(_medicaoConcluida ? "Valores fixos. Continue para acrescentar pontos." : "Clique no mapa. Enter confirma os pontos marcados.")</p></div>
                        <div class="measurement-state @(_medicaoConcluida ? "confirmed" : "")" data-testid="measurement-state" role="status">@EstadoMedicao <span>@MapService.PontosMedicao.Count ponto(s)</span></div>
                        <div class="measurement-modes" role="group" aria-label="Tipo de medição">
                            <button class="workbench-button @(!MapService.MostrarAreaMedicao ? "selected" : "")" aria-pressed="@(!MapService.MostrarAreaMedicao)" @onclick="() => DefinirModoMedicao(false)">Distância</button>
                            <button class="workbench-button @(MapService.MostrarAreaMedicao ? "selected" : "")" aria-pressed="@MapService.MostrarAreaMedicao" @onclick="() => DefinirModoMedicao(true)">Área</button>
                        </div>
                        <div class="measurement-result form-group-vertical">
                            <label>COMPRIMENTO LINEAR</label>
                            <span class="result-number" data-testid="measurement-length">@ComprimentoMedicaoExibido.ToString("N2") <span>@RotuloComprimentoMedicao</span></span>
                            <select class="gis-select result-unit" aria-label="Unidade da distância" @bind="_unidadeComprimentoMedicao">
                                <option value="m">Metros (m)</option><option value="km">Quilômetros (km)</option><option value="ft">Pés (ft)</option><option value="mi">Milhas (mi)</option>
                            </select>
                        </div>
                        @if (MapService.MostrarAreaMedicao)
                        {
                            <div class="measurement-result form-group-vertical">
                                <label>ÁREA DO CONTORNO</label>
                                <span class="result-number" data-testid="measurement-area">@(MapService.PontosMedicao.Count < 3 || _medicaoAreaErro != null ? "—" : AreaMedicaoExibida.ToString("N2")) <span>@RotuloAreaMedicao</span></span>
                                <select class="gis-select result-unit" aria-label="Unidade da área" @bind="_unidadeAreaMedicao">
                                    <option value="m2">Metros quadrados (m²)</option><option value="ha">Hectares (ha)</option><option value="km2">Quilômetros quadrados (km²)</option><option value="ac">Acres (ac)</option>
                                </select>
                                <small class="measurement-error">@(_medicaoAreaErro ?? (MapService.PontosMedicao.Count < 3 ? "Adicione pelo menos três pontos." : ""))</small>
                            </div>
                        }
                        @if (_medicaoAzimuteGraus is { } azimute)
                        {
                            <div class="bearing-result"><span>Azimute da última perna</span><strong>@azimute.ToString("N1")°</strong></div>
                        }
                        <p class="measurement-method">@_medicaoMetodo</p>
                        <div class="measurement-actions" role="group" aria-label="Ações da medição">
                            @if (_medicaoConcluida)
                            {
                                <button class="workbench-button primary measurement-finish" @onclick="ContinuarMedicao">Continuar medição</button>
                            }
                            else
                            {
                                <button class="workbench-button primary measurement-finish" disabled="@(MapService.PontosMedicao.Count < MinimoPontosMedicao)" title="Confirmar pontos marcados · Enter" @onclick="ConcluirMedicao">Concluir medição</button>
                            }
                            <button class="workbench-button" disabled="@(!HistoricoMedicao.CanUndo)" title="Desfazer · Ctrl+Z" @onclick="() => AlterarHistoricoMedicao(false)">Desfazer</button>
                            <button class="workbench-button" disabled="@(!HistoricoMedicao.CanRedo)" title="Refazer · Ctrl+Y" @onclick="() => AlterarHistoricoMedicao(true)">Refazer</button>
                            <button class="workbench-button copy-result" disabled="@(MapService.PontosMedicao.Count < 2)" @onclick="CopiarResumoMedicao">Copiar resultado</button>
                            <button class="workbench-button danger" disabled="@(MapService.PontosMedicao.Count == 0)" title="Limpar · Esc" @onclick="LimparMedicao">Limpar rastro</button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_medicaoMensagem)) { <small class="measurement-feedback" role="status">@_medicaoMensagem</small> }
                        <details class="measurement-settings workbench-details">
                            <summary>Encaixes e precisão</summary>
                            <div role="group" aria-label="Encaixes da medição">
                                <label><input type="checkbox" @bind="_snapMedicaoAtivo" />Encaixar nos vértices</label>
                                <label><input type="checkbox" @bind="_snapMedicaoAresta" />Encaixar nas arestas</label>
                                <label><input type="checkbox" @bind="_snapMedicaoMeio" />Encaixar no meio das arestas</label>
                                <label><input type="checkbox" @bind="_snapMedicaoIntersecao" />Encaixar em interseções</label>
                                <label class="tolerance-field">Tolerância em tela
                                    <select class="gis-select" aria-label="Tolerância do snap de medição" @bind="ToleranciaSnapPixels">
                                        <option value="6">6 px · precisa</option><option value="10">10 px</option><option value="15">15 px · padrão</option><option value="20">20 px</option><option value="30">30 px · ampla</option>
                                    </select>
                                </label>
                            </div>
                        </details>
                        <div class="measurement-help"><kbd>Enter</kbd> concluir <span>·</span> <kbd>Ctrl Z</kbd> desfazer <span>·</span> <kbd>Esc</kbd> limpar</div>
                    </section>
                }
                else
                {
                    @if (atributosFeicaoSelecionada != null && atributosFeicaoSelecionada.Count > 0)
                    {
                        <div class="attribute-form">
                            <div class="form-group mb-15" style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px;">
                                <label>Camada Origem</label>
                                <span style="font-size: 0.75rem; color: #38bdf8; font-weight: bold; word-break: break-all;">@camadaSelecionadaPainel</span>
                            </div>

                            @foreach (var atributo in atributosFeicaoSelecionada)
                            {
                                <div class="form-group">
                                    <label>@atributo.Key</label>
                                    @if (atributo.Key.ToUpper() == "FID" || atributo.Key.ToUpper() == "ID")
                                    {
                                        <input type="text" class="glass-input" value="@atributo.Value" readonly style="opacity: 0.6;" />
                                    }
                                    else
                                    {
                                        <input type="text" class="glass-input editable" value="@atributo.Value" @onchange="(e) => AtualizarAtributoPainel(atributo.Key, e.Value.ToString())" />
                                    }
                                </div>
                            }
                            <button class="btn-save add-layer-btn" style="width: 100%; margin-top: 20px;" @onclick="SalvarAtributosPainel">SALVAR ALTERAÇÕES</button>
                        </div>
                    }
                    else
                    {
                        <div class="identify-empty-state" role="status">
                            <span class="identify-empty-icon" aria-hidden="true"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.8" cy="10.8" r="7.3"/><path d="m16.2 16.2 4.3 4.3M8 10.8h5.6M10.8 8v5.6"/></svg></span>
                            <strong>Nenhuma feição selecionada</strong>
                            <span>Clique em uma feição no mapa para consultar seus atributos.</span>
                        </div>
                    }
                }
            </div>
            <button type="button" class="panel-resize-handle"
                 role="separator"
                 aria-orientation="horizontal"
                 aria-label="Ajustar altura do painel de identificação"
                 aria-valuemin="20"
                 aria-valuemax="100"
                 aria-valuenow="50"
                 tabindex="0"
                 title="Arraste para ajustar a altura · use ↑ e ↓"
                 onpointerdown="window.geonexResizeDockStart(event)"
                 onkeydown="window.geonexResizeDockKeydown(event)"></button>
        </aside>

    </main>

    @if (exibirTabelaAtributos)
    {
        <div class="glass-panel attribute-table-container">
            <div class="table-header">
                <span>TABELA DE ATRIBUTOS: @nomeCamadaAtiva</span>
                <button class="close-btn" @onclick="() => exibirTabelaAtributos = false">✕</button>
            </div>
            <div class="table-wrapper custom-scrollbar">
                <table>
                    <thead>
                        <tr>
                            @foreach (var col in colunasTabela)
                            {
                                <th>@col</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var linha in dadosTabela)
                        {
                            <tr @onclick="() => SelecionarNoMapa(linha)">
                                @foreach (var col in colunasTabela)
                                {
                                    <td>
                                        <input class="cell-input"
                                               value="@(linha.ContainsKey(col) ? linha[col] : "")"
                                               @onchange="(e) => AtualizarAtributo(linha, col, e.Value)" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- RODAPÉ DE TELEMETRIA -->
    <footer class="bottom-status-bar">
        <div class="status-left">
            <span title="@(ProjetoService.ProjetoAtual?.CaminhoArquivo ?? "Nenhum arquivo de projeto aberto")"><strong>PROJETO:</strong> @ProjetoService.ObterNomeProjetoAtivo()</span>
            @if (ProjetoService.ProjetoAtual is { } projetoComAlteracoes &&
                (temEdicoesPendentes || GeoNex.Services.GnxProjectStore.TemAutosaveMaisRecente(projetoComAlteracoes.CaminhoArquivo)))
            {
                <span class="project-dirty-indicator" title="Há alterações recuperáveis ainda não incorporadas à versão salva do projeto">Alterações não salvas</span>
            }
        </div>
        <div class="status-right">
            <span><strong>X:</strong> <span class="mono">@longitude</span></span>
            <span><strong>Y:</strong> <span class="mono">@latitude</span></span>
            <span class="scale-box">1:1.000</span>
        </div>
    </footer>

    @if (_mostrarPropriedadesProjeto && ProjetoService.ProjetoAtual is { } projetoConfiguracoes)
    {
        <div class="project-properties-backdrop" role="dialog" aria-modal="true" aria-labelledby="project-properties-title" @onclick="FecharPropriedadesProjeto">
            <section class="glass-panel project-properties-modal" @onclick:stopPropagation="true">
                <header class="project-properties-header">
                    <div>
                        <span class="project-properties-eyebrow">ARQUIVO DE PROJETO GEONEX</span>
                        <h2 id="project-properties-title">Propriedades do Projeto</h2>
                    </div>
                    <button type="button" class="close-modal-btn" aria-label="Fechar propriedades" @onclick="FecharPropriedadesProjeto">✕</button>
                </header>

                <div class="project-properties-content custom-scrollbar">
                    <section class="project-properties-section">
                        <div class="project-properties-section-title">
                            <strong>Geral</strong>
                            <span>Identidade e camada de referência do projeto</span>
                        </div>
                        <div class="project-properties-form-grid">
                            <label class="project-properties-field">
                                <span>Nome exibido</span>
                                <input class="glass-input" maxlength="120" @bind="_nomeProjetoConfiguracao" />
                            </label>
                            <label class="project-properties-field">
                                <span>Camada-base</span>
                                <select class="glass-input" @bind="_camadaBaseConfiguracao">
                                    <option value="">Selecionar automaticamente</option>
                                    @foreach (Camada camada in CamadasAtivas.Where(item => !item.PendenteReconexao))
                                    {
                                        <option value="@camada.Nome">@camada.Nome</option>
                                    }
                                </select>
                            </label>
                            <label class="project-properties-field project-properties-crs-field">
                                <span>Sistema de referência · código EPSG ou WKT</span>
                                <input class="glass-input" maxlength="10000" placeholder="EPSG:31982" @bind="_crsProjetoConfiguracao" />
                            </label>
                        </div>
                        <div class="project-properties-facts">
                            <div><span>Arquivo</span><strong title="@projetoConfiguracoes.CaminhoArquivo">@projetoConfiguracoes.CaminhoArquivo</strong></div>
                            <div><span>SRC atual</span><strong>@MapService.ProjetoSRS</strong></div>
                            <div><span>Criado em</span><strong>@projetoConfiguracoes.CriadoEm.ToString("dd/MM/yyyy HH:mm")</strong></div>
                            <div><span>Camadas no mapa</span><strong>@CamadasAtivas.Count</strong></div>
                        </div>
                    </section>

                    <section class="project-properties-section">
                        <div class="project-properties-section-title">
                            <strong>Exibição e extensão</strong>
                            <span>Estado gravado junto com o projeto ao salvar</span>
                        </div>
                        <div class="project-properties-metrics">
                            <div><span>Centro X</span><strong>@projetoConfiguracoes.OffsetMundoX.ToString("G8", System.Globalization.CultureInfo.InvariantCulture)</strong></div>
                            <div><span>Centro Y</span><strong>@projetoConfiguracoes.OffsetMundoY.ToString("G8", System.Globalization.CultureInfo.InvariantCulture)</strong></div>
                            <div><span>Zoom</span><strong>@projetoConfiguracoes.CameraZoom.ToString("G5", System.Globalization.CultureInfo.InvariantCulture)</strong></div>
                            <div><span>Layout de impressão</span><strong>@(string.IsNullOrWhiteSpace(projetoConfiguracoes.LayoutJson) ? "Ainda não criado" : "Salvo no projeto")</strong></div>
                        </div>
                    </section>

                    <section class="project-properties-section">
                        <div class="project-properties-section-title">
                            <strong>Salvamento e recuperação</strong>
                            <span>Proteja o estado do mapa contra fechamentos inesperados</span>
                        </div>
                        <div class="project-properties-form-grid">
                            <label class="project-properties-field">
                                <span>Salvar automaticamente</span>
                                <select class="glass-input" @bind="_intervaloAutosaveConfiguracao">
                                    <option value="0">Desativado</option>
                                    <option value="1">A cada minuto</option>
                                    <option value="5">A cada 5 minutos</option>
                                    <option value="10">A cada 10 minutos</option>
                                    <option value="15">A cada 15 minutos</option>
                                </select>
                            </label>
                            <div class="project-properties-field project-autosave-note">
                                <span>Comportamento</span>
                                <small>A preferência vale para este GeoNex. O salvamento atualiza o arquivo .gnx e aguarda a conclusão de edições e esboços ativos.</small>
                            </div>
                        </div>
                    </section>

                    <section class="project-properties-section">
                        <div class="project-properties-section-title">
                            <strong>Camadas</strong>
                            <span>Ordem atual, visibilidade e estado de conexão</span>
                        </div>
                        @if (CamadasAtivas.Count == 0)
                        {
                            <div class="project-properties-empty">Este projeto ainda não tem camadas.</div>
                        }
                        else
                        {
                            <div class="project-properties-layer-list">
                                @foreach (Camada camada in CamadasAtivas)
                                {
                                    <div class="project-properties-layer-row">
                                        <span class="project-properties-layer-state @(camada.PendenteReconexao ? "is-pending" : "")"></span>
                                        <div><strong>@camada.Nome</strong><small>@camada.Tipo · @(camada.Visivel ? "Visível" : "Oculta") · @(camada.PendenteReconexao ? "Reconexão pendente" : "Conectada")</small></div>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                </div>

                <footer class="project-properties-footer">
                    <button type="button" class="btn-cancel" @onclick="FecharPropriedadesProjeto">Cancelar</button>
                    <button type="button" class="btn-cancel" @onclick="AbrirCompositorPeloMenuArquivo">Compositor de impressão</button>
                    <button type="button" class="btn-save" @onclick="SalvarPropriedadesProjetoAsync">Salvar configurações</button>
                </footer>
            </section>
        </div>
    }

    <!-- ========================================== -->
    <!-- JANELA MODAL DE IMPORTAÇÃO (DATA MANAGER)  -->
    <!-- ========================================== -->
    @if (exibirModalImportacao)
    {
        <div class="modal-overlay" role="dialog" aria-modal="true" @onpointerdown:stopPropagation="true" @onpointerup:stopPropagation="true" @onpointermove:stopPropagation="true">
            <div class="glass-panel import-modal @(AbaModalAtiva == "Nuvem" ? "postgis-open" : AbaModalAtiva == "Texto" ? "point-table-open" : "")">
                <div class="modal-header">
                    <h2>GERENCIADOR DE FONTES DE DADOS</h2>
                    <button class="close-modal-btn" @onclick="FecharModalImportacao">✕</button>
                </div>
                <div class="modal-body">
                    <div class="modal-tabs">
                        <button class="tab-btn @(AbaModalAtiva == "Raster" ? "active" : "")" @onclick="@(() => TrocarAbaModal("Raster"))">Raster (ECW, TIF)</button>
                        <button class="tab-btn @(AbaModalAtiva == "Vetor" ? "active" : "")" @onclick="@(() => TrocarAbaModal("Vetor"))">Vetor (SHP, GeoJSON)</button>
                        <button class="tab-btn @(AbaModalAtiva == "Texto" ? "active" : "")" @onclick="@(() => TrocarAbaModal("Texto"))">Tabela de pontos</button>
                        <button class="tab-btn @(AbaModalAtiva == "Nuvem" ? "active" : "")" @onclick="@(() => TrocarAbaModal("Nuvem"))">PostGIS</button>
                    </div>

                    <div class="modal-content">

                        @if (AbaModalAtiva == "Raster")
                        {
                            <div class="form-group mb-15">
                                <label>Arquivo Fonte / Dataset (Raster)</label>
                                <div class="file-input-group">
                                    <input type="text" class="glass-input file-path" value="@caminhoArquivoRaster" placeholder="C:\Caminho\para\arquivo.tif" readonly />
                                    <button class="btn-browse" @onclick="SelecionarArquivoRaster">PROCURAR...</button>
                                </div>
                                <div style="margin-top: 10px; font-size: 0.7rem; color: #34d399; background: rgba(0,0,0,0.2); padding: 10px; border-radius: 4px; border: 1px solid rgba(52,211,153,0.2);">
                                    <pre style="margin:0; white-space: pre-wrap;">@statusGdal</pre>
                                </div>
                            </div>

                            <div class="import-actions">
                                <button class="btn-save add-layer-btn" @onclick="AdicionarCamadaAoMapa">ADICIONAR RASTER AO MAPA</button>
                                <button class="btn-cancel" @onclick="FecharModalImportacao">CANCELAR</button>
                            </div>
                        }
                        else if (AbaModalAtiva == "Vetor")
                        {
                            <div class="form-group mb-15">
                                <label>Arquivo Fonte Vetorial (Shapefile, KML, GeoJSON)</label>
                                <div class="file-input-group">
                                    <input type="text" class="glass-input file-path" value="@caminhoArquivoVetor" placeholder="C:\Caminho\para\lotes.shp" readonly />
                                    <button class="btn-browse" @onclick="SelecionarArquivoVetor">PROCURAR...</button>
                                </div>
                            </div>

                            <div class="form-group mb-15">
                                <label>Sistema de Referência de Coordenadas (CRS/EPSG)</label>
                                <select class="glass-input editable">
                                    <option>Automático (Lido do arquivo .prj)</option>
                                    <option>EPSG:31982 - SIRGAS 2000 / UTM zone 22S</option>
                                    <option>EPSG:4326 - WGS 84</option>
                                </select>
                            </div>

                            <div class="import-actions">
                                <button class="btn-save add-layer-btn" @onclick="AdicionarVetorAoMapa">ADICIONAR VETOR AO MAPA</button>
                                <button class="btn-cancel" @onclick="FecharModalImportacao">CANCELAR</button>
                            </div>
                        }
                        else if (AbaModalAtiva == "Texto")
                        {
                            <div class="point-table-import">
                                <div class="point-table-intro">
                                    <strong>Importar tabela como pontos</strong>
                                    <span>CSV, TXT ou TSV com cabeçalho. Escolha as colunas X/Y e o EPSG das coordenadas.</span>
                                </div>
                                <div class="form-group mb-15">
                                    <label>Arquivo de texto delimitado</label>
                                    <div class="file-input-group">
                                        <input type="text" class="glass-input file-path" value="@_tabelaPontosCaminho" placeholder="Selecione um arquivo CSV, TXT ou TSV" readonly />
                                        <button class="btn-browse" @onclick="SelecionarArquivoTabelaPontos" disabled="@_tabelaPontosImportando">PROCURAR...</button>
                                    </div>
                                </div>
                                @if (_tabelaPontosPreview is not null)
                                {
                                    <div class="point-table-options">
                                        <label>Separador
                                            <select class="glass-input" value="@DelimitadorTabelaPontosValor" @onchange="AlterarDelimitadorTabelaPontos" disabled="@_tabelaPontosImportando">
                                                <option value=",">Vírgula (,)</option>
                                                <option value=";">Ponto e vírgula (;)</option>
                                                <option value="tab">Tabulação</option>
                                                <option value="|">Barra vertical (|)</option>
                                            </select>
                                        </label>
                                        <label>Coluna X
                                            <select class="glass-input" @bind="_tabelaPontosColunaX" disabled="@_tabelaPontosImportando">
                                                @foreach (var coluna in _tabelaPontosPreview.Columns)
                                                {
                                                    <option value="@coluna.Index">@coluna.Name</option>
                                                }
                                            </select>
                                        </label>
                                        <label>Coluna Y
                                            <select class="glass-input" @bind="_tabelaPontosColunaY" disabled="@_tabelaPontosImportando">
                                                @foreach (var coluna in _tabelaPontosPreview.Columns)
                                                {
                                                    <option value="@coluna.Index">@coluna.Name</option>
                                                }
                                            </select>
                                        </label>
                                        <div class="point-table-crs-picker">
                                            <label for="point-table-crs-search">SRC das coordenadas</label>
                                            <input id="point-table-crs-search" class="glass-input" value="@_tabelaPontosCrsBusca" @oninput="FiltrarCrsTabelaPontos" placeholder="Pesquisar por nome ou código (EPSG, ESRI…)" disabled="@_tabelaPontosImportando" />
                                            <div class="point-table-crs-selected">Selecionado: <strong>@RotuloCrsTabelaPontosSelecionado</strong></div>
                                            @if (string.IsNullOrWhiteSpace(_tabelaPontosCrsBusca) && _tabelaPontosCrsAtalhos.Count > 0)
                                            {
                                                <div class="point-table-crs-presets" aria-label="SRC usados com frequência">
                                                    @foreach (var crs in _tabelaPontosCrsAtalhos)
                                                    {
                                                        <button type="button" class="point-table-crs-preset @(string.Equals(crs.Identifier, _tabelaPontosCrsSelecionado, StringComparison.OrdinalIgnoreCase) ? "active" : "")" @onclick="() => SelecionarCrsTabelaPontos(crs)" disabled="@_tabelaPontosImportando">@crs.Identifier</button>
                                                    }
                                                </div>
                                            }
                                            @if (_tabelaPontosCrsResultados.Count > 0)
                                            {
                                                <div class="point-table-crs-results" role="listbox" aria-label="Sistemas de referência encontrados">
                                                    @foreach (var crs in _tabelaPontosCrsResultados)
                                                    {
                                                        <button type="button" class="point-table-crs-option" @onclick="() => SelecionarCrsTabelaPontos(crs)" disabled="@_tabelaPontosImportando">
                                                            <span><strong>@crs.Identifier</strong><small>@crs.Name</small></span>
                                                            <small>@crs.Kind</small>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(_tabelaPontosCrsBusca) && !string.Equals(_tabelaPontosCrsBusca.Trim(), _tabelaPontosCrsSelecionado, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <div class="point-table-crs-empty">Nenhum SRC do catálogo corresponde à busca.</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(_tabelaPontosCrsBusca) && !string.Equals(_tabelaPontosCrsBusca.Trim(), _tabelaPontosCrsSelecionado, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <button type="button" class="point-table-crs-custom" @onclick="UsarCrsDigitadoTabelaPontos" disabled="@_tabelaPontosImportando">Usar identificador informado: @_tabelaPontosCrsBusca</button>
                                            }
                                            <small class="point-table-crs-hint">@_tabelaPontosCrsCatalogo.Count SRC no catálogo · também aceita identificadores reconhecidos pelo PROJ, como EPSG:31982 ou ESRI:102033.</small>
                                        </div>
                                    </div>
                                    <div class="point-table-preview-wrap">
                                        <div class="point-table-preview-heading">Prévia · @_tabelaPontosPreview.Columns.Count coluna(s)</div>
                                        <div class="point-table-preview-scroll">
                                            <table class="point-table-preview">
                                                <thead><tr>@foreach (var coluna in _tabelaPontosPreview.Columns) { <th>@coluna.Name</th> }</tr></thead>
                                                <tbody>
                                                    @foreach (var linha in _tabelaPontosPreview.Rows)
                                                    {
                                                        <tr>@foreach (var coluna in _tabelaPontosPreview.Columns) { <td>@(coluna.Index < linha.Length ? linha[coluna.Index] : "")</td> }</tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_tabelaPontosMensagem))
                                {
                                    <div class="point-table-message @(_tabelaPontosErro ? "error" : "")" role="status">@_tabelaPontosMensagem</div>
                                }
                                <div class="import-actions">
                                    <button class="btn-save add-layer-btn" @onclick="AdicionarTabelaPontosAsync" disabled="@(_tabelaPontosImportando || _tabelaPontosPreview is null || _tabelaPontosColunaX == _tabelaPontosColunaY)">@(_tabelaPontosImportando ? "IMPORTANDO…" : "ADICIONAR PONTOS AO MAPA")</button>
                                    <button class="btn-cancel" @onclick="FecharModalImportacao" disabled="@_tabelaPontosImportando">CANCELAR</button>
                                </div>
                            </div>
                        }
                        else if (AbaModalAtiva == "Nuvem")
                        {
                            <div class="postgis-workspace">
                                <div class="postgis-intro">
                                    <strong>Conexão PostGIS</strong>
                                    <span>Use o hostname ou IP do servidor PostgreSQL. ‘localhost’ só funciona se o GeoNex estiver na mesma máquina. As credenciais ficam apenas nesta sessão.</span>
                                </div>
                                <div class="postgis-connection-grid">
                                    <label>Servidor
                                        <input class="glass-input" @bind="_postgisFormulario.Host" @bind:event="oninput" @bind:after="CredenciaisPostgisAlteradas" placeholder="Ex.: db.exemplo.com ou 127.0.0.1" autocomplete="off" required disabled="@(_postgisConectando || _postgisCamadaCarregando is not null)" />
                                    </label>
                                    <label>Porta
                                        <input class="glass-input" type="number" min="1" max="65535" @bind="_postgisFormulario.Port" @bind:after="CredenciaisPostgisAlteradas" disabled="@(_postgisConectando || _postgisCamadaCarregando is not null)" />
                                    </label>
                                    <label>Banco de dados
                                        <input class="glass-input" @bind="_postgisFormulario.Database" @bind:event="oninput" @bind:after="CredenciaisPostgisAlteradas" placeholder="Nome do banco PostgreSQL" autocomplete="off" required disabled="@(_postgisConectando || _postgisCamadaCarregando is not null)" />
                                    </label>
                                    <label>Usuário
                                        <input class="glass-input" @bind="_postgisFormulario.Username" @bind:event="oninput" @bind:after="CredenciaisPostgisAlteradas" placeholder="Usuário do banco PostgreSQL" autocomplete="username" required disabled="@(_postgisConectando || _postgisCamadaCarregando is not null)" />
                                    </label>
                                    <label>Senha
                                        <input class="glass-input" type="password" @bind="_postgisFormulario.Password" @bind:event="oninput" @bind:after="CredenciaisPostgisAlteradas" autocomplete="current-password" disabled="@(_postgisConectando || _postgisCamadaCarregando is not null)" />
                                    </label>
                                    <label>SSL
                                        <select class="glass-input" @bind="_postgisFormulario.SslMode" @bind:after="CredenciaisPostgisAlteradas" disabled="@(_postgisConectando || _postgisCamadaCarregando is not null)">
                                            <option value="Prefer">Preferir TLS</option>
                                            <option value="Require">Exigir TLS</option>
                                            <option value="Disable">Desativar TLS</option>
                                        </select>
                                    </label>
                                </div>
                                <div class="postgis-connect-actions">
                                    <span class="postgis-session-status @(_postgisStatusErro ? "error" : "")" role="status" aria-live="polite">
                                        @if (_postgisConectando) { <span>Conectando ao PostGIS…</span> }
                                        else if (!string.IsNullOrWhiteSpace(_postgisMensagem)) { <span>@_postgisMensagem</span> }
                                        else { <span>Informe host, porta e credenciais cadastrados no servidor PostgreSQL.</span> }
                                    </span>
                                    <button class="btn-save" @onclick="ConectarPostgisAsync" disabled="@_postgisConectando">@(_postgisConectando ? "CONECTANDO…" : _postgisConnection is null ? "CONECTAR E LISTAR CAMADAS" : "ATUALIZAR CAMADAS")</button>
                                </div>
                                @if (_postgisConnection != null)
                                {
                                    <div class="postgis-layer-browser">
                                        <div class="postgis-layer-heading">
                                            <div><strong>Camadas espaciais</strong><small>@_postgisTabelas.Count tabela(s) · até @PostgisDataService.MaximumFeaturesPerLayer.ToString("N0") feições por camada</small></div>
                                            <button class="workbench-button" @onclick="AtualizarListaPostgisAsync" disabled="@_postgisConectando">Atualizar lista</button>
                                        </div>
                                        @if (_postgisTabelas.Count == 0)
                                        {
                                            <div class="postgis-empty">Nenhuma coluna geometry foi encontrada em <code>geometry_columns</code>.</div>
                                        }
                                        else
                                        {
                                            <div class="postgis-layer-list">
                                                @foreach (var tabelaPostgis in _postgisTabelas)
                                                {
                                                    <div class="postgis-layer-row" @key="PostgisLayerKey(tabelaPostgis)">
                                                        <span class="data-menu-icon vector" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m5 5 14 2-3 12-11-4V5Z"/><circle cx="5" cy="5" r="1.5"/><circle cx="19" cy="7" r="1.5"/><circle cx="16" cy="19" r="1.5"/></svg></span>
                                                        <span class="postgis-layer-copy"><strong>@($"{tabelaPostgis.Schema}.{tabelaPostgis.Table}")</strong><small>@tabelaPostgis.GeometryColumn · @tabelaPostgis.GeometryType · EPSG:@tabelaPostgis.Srid</small></span>
                                                        <button class="workbench-button primary" @onclick="() => AdicionarCamadaPostgisAsync(tabelaPostgis)" disabled="@(_postgisCamadaCarregando != null || tabelaPostgis.CoordinateDimension != 2)" title="@(tabelaPostgis.CoordinateDimension != 2 ? "Camadas com Z/M não são suportadas nesta versão" : "Adicionar esta camada ao mapa")">@(_postgisCamadaCarregando == PostgisLayerKey(tabelaPostgis) ? "CARREGANDO…" : "ADICIONAR")</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div style="display: flex; height: 100%; align-items: center; justify-content: center; color: #64748b; font-size: 0.85rem;">
                                Módulo em desenvolvimento.
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ========================================== -->
    <!-- JANELA MODAL DE EXPORTAÇÃO (VETOR)         -->
    <!-- ========================================== -->
    @if (exibirModalExportacao)
    {
        <div class="modal-overlay" role="dialog" aria-modal="true" @onpointerdown:stopPropagation="true" @onpointerup:stopPropagation="true" @onpointermove:stopPropagation="true">
            <div class="glass-panel import-modal">
                <div class="modal-header">
                    <h2>EXPORTAR CAMADA VETORIAL (OGR)</h2>
                    <button class="close-modal-btn" @onclick="FecharModalExportacao">✕</button>
                </div>
                <div class="modal-body" style="padding: 20px;">
                    <div class="form-group mb-15">
                        <label>Camada a Exportar</label>
                        <select class="glass-input editable" @bind="exportCamadaOrigem">
                            <option value="">-- Selecione uma camada --</option>
                            @foreach (var camada in CamadasAtivas.Where(c => c.Tipo == "Vetor"))
                            {
                                <option value="@camada.Nome">@camada.Nome</option>
                            }
                        </select>
                    </div>

                    <div class="form-group mb-15">
                        <label>Formato de Saída (Driver OGR)</label>
                        <select class="glass-input editable" @bind="exportFormatoDriver">
                            <option value="ESRI Shapefile">ESRI Shapefile (.shp)</option>
                            <option value="GeoJSON">GeoJSON (.geojson)</option>
                            <option value="KML">Google Earth KML (.kml)</option>
                        </select>
                    </div>

                    <div class="form-group mb-15">
                        <label>Sistema de Referência de Coordenadas (EPSG Destino)</label>
                        <input type="number" class="glass-input editable" @bind="exportEPSG" placeholder="Ex: 31982 ou 4326" />
                    </div>

                    <div class="import-actions" style="margin-top: 30px;">
                        <button class="btn-save add-layer-btn" @onclick="ExecutarExportacao" style="background-color: #facc15; color: #0f172a; font-weight: bold;">PROCESSAR EXPORTAÇÃO</button>
                        <button class="btn-cancel" @onclick="FecharModalExportacao">CANCELAR</button>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (exibirModalPropriedades)
    {
        <style>
                
                /* =======================================================
                       FÍSICA DO DRAG & DROP (MÁXIMA SUAVIDADE E GRIP)
                       ======================================================= */

                .layer-item {
                    /* A branda transição que remove os pulos secos do ecrã */
                    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.2s, background-color 0.2s;
                    will-change: transform;
                }

                    /* O Efeito de Levitação Magnética quando o clique é mantido */
                    .layer-item.is-dragging {
                        transform: scale(1.02); /* Aumenta um bocadinho, dando a ilusão que se descolou do fundo */
                        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.6); /* Sombra pesada por baixo */
                        background-color: rgba(30, 41, 59, 0.95) !important;
                        border: 1px solid #38bdf8;
                        opacity: 0.95;
                        z-index: 100;
                    }

                /* O Seu Clique Perfeito (Refinado do seu Print) */
                .drag-handle {
                    padding: 6px;
                    border-radius: 4px;
                    background: rgba(0,0,0,0.15);
                    cursor: grab; /* Mão aberta a pedir clique */
                    touch-action: none;
                    transition: background 0.2s, color 0.2s;
                }

                    .drag-handle:hover {
                        background: rgba(0,0,0,0.3);
                        color: #38bdf8;
                    }

                    /* Quando clica, o ícone do rato muda para mão fechada! */
                    .drag-handle:active, .is-dragging .drag-handle {
                        cursor: grabbing !important;
                        background: rgba(56, 189, 248, 0.2);
                        color: #38bdf8;
                    }
                .geonex-toggle {
                    position: relative;
                    display: inline-block;
                    width: 36px;
                    height: 18px;
                    margin-right: 10px;
                }

                    .geonex-toggle input {
                        opacity: 0;
                        width: 0;
                        height: 0;
                    }

                .geonex-slider {
                    position: absolute;
                    cursor: pointer;
                    top: 0;
                    left: 0;
                    right: 0;
                    bottom: 0;
                    background-color: rgba(255,255,255,0.1);
                    border: 1px solid rgba(255,255,255,0.2);
                    transition: .3s;
                    border-radius: 18px;
                }

                    .geonex-slider:before {
                        position: absolute;
                        content: "";
                        height: 12px;
                        width: 12px;
                        left: 2px;
                        bottom: 2px;
                        background-color: #888;
                        transition: .3s;
                        border-radius: 50%;
                    }

                .geonex-toggle input:checked + .geonex-slider {
                    background-color: rgba(56, 189, 248, 0.2);
                    border-color: #38bdf8;
                }

                    .geonex-toggle input:checked + .geonex-slider:before {
                        transform: translateX(18px);
                        background-color: #38bdf8;
                    }

                .gis-toolbar {
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    background: rgba(0,0,0,0.4);
                    padding: 6px;
                    border-radius: 6px;
                    border: 1px solid rgba(255,255,255,0.05);
                }

                .gis-tool-btn {
                    position: relative;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    height: 32px;
                    border-radius: 4px;
                    cursor: pointer;
                    transition: 0.2s;
                    color: #cbd5e1;
                    background: transparent;
                    border: 1px solid transparent;
                    overflow: hidden;
                }

                    .gis-tool-btn:hover {
                        background: rgba(255,255,255,0.1);
                        color: #fff;
                        border-color: rgba(255,255,255,0.2);
                    }

                    .gis-tool-btn.active {
                        background: rgba(56, 189, 248, 0.15);
                        color: #38bdf8;
                        border-color: rgba(56, 189, 248, 0.4);
                    }

                .gis-color-input {
                    position: absolute;
                    opacity: 0;
                    width: 100%;
                    height: 100%;
                    cursor: pointer;
                }

                .gis-number-wrapper {
                    display: flex;
                    align-items: center;
                    background: rgba(0,0,0,0.4);
                    border: 1px solid rgba(255,255,255,0.05);
                    border-radius: 4px;
                    overflow: hidden;
                    transition: border-color 0.2s;
                }

                    .gis-number-wrapper:focus-within {
                        border-color: #38bdf8;
                    }

                .gis-number-input {
                    width: 100%;
                    background: transparent;
                    border: none;
                    color: #fff;
                    padding: 8px 10px;
                    font-size: 14px;
                    outline: none;
                }

                .gis-number-unit {
                    color: #94a3b8;
                    padding-right: 10px;
                    font-size: 12px;
                    user-select: none;
                }

                /* NOVOS ESTILOS: Textos mais claros e fortes */
                .gis-label {
                    font-size: 11px;
                    color: #cbd5e1;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    margin-bottom: 6px;
                    display: block;
                }

        </style>

        <div class="modal-overlay" role="dialog" aria-modal="true" @onpointerdown:stopPropagation="true" @onpointerup:stopPropagation="true" @onpointermove:stopPropagation="true">
            <div class="glass-panel modal-container" style="width: 550px; min-height: 400px; max-height: 85vh; display: flex; flex-direction: column;">
                <div class="modal-header">
                    <h2>PROPRIEDADES: @camadaEmEdicao</h2>
                    <button class="close-btn-red" @onclick="() => exibirModalPropriedades = false">✕</button>
                </div>

                <div class="modal-body properties-layout" style="flex: 1; overflow-y: auto;">

                    <nav class="properties-sidebar">
                        <button class="tab-btn @(abaAtivaPropriedades == "Simbologia" ? "active" : "")" @onclick='() => abaAtivaPropriedades = "Simbologia"'>Simbologia</button>
                        <button class="tab-btn @(abaAtivaPropriedades == "Rotulos" ? "active" : "")" @onclick='() => abaAtivaPropriedades = "Rotulos"'>Rótulos</button>
                        <button class="tab-btn @(abaAtivaPropriedades == "Informacao" ? "active" : "")" @onclick='() => abaAtivaPropriedades = "Informacao"'>Informação</button>
                    </nav>

                    <div class="properties-content custom-scrollbar">

                        @if (abaAtivaPropriedades == "Simbologia")
                        {
                            <div class="form-group-vertical">
                                <label class="gis-label">TIPO DE SIMBOLOGIA</label>
                                <select class="gis-select" @bind="tipoSimbologia">
                                    <option value="UNICA">Símbolo Único (Cor Sólida)</option>
                                    <option value="CATEGORIZADA">Categorizado (Por Atributo)</option>
                                </select>
                            </div>

                            <hr style="border: none; border-top: 1px solid rgba(255,255,255,0.05); margin: 15px 0;" />

                            @if (tipoSimbologia == "UNICA")
                            {
                                <div class="form-group-vertical" style="position: relative; margin-bottom: 15px;">
                                    <label class="gis-label">Cor de Preenchimento</label>
                                    <div class="arcmap-picker-trigger" @onclick="() => { abrirSeletorFill = !abrirSeletorFill; abrirSeletorBorda = false; }">
                                        @if (semCorPreenchimento)
                                        {
                                            <div class="color-preview-box no-color-diagonal"></div>
                                            <span class="color-text-value">Sem Cor (Transparente)</span>
                                        }
                                        else
                                        {
                                            <div class="color-preview-box" style="background-color: @corPreenchimento;"></div>
                                            <span class="color-text-value">@corPreenchimento.ToUpper()</span>
                                        }
                                        <div class="dropdown-arrow-indicator">▼</div>
                                    </div>

                                    @if (abrirSeletorFill)
                                    {
                                        <div class="arcmap-dropdown-palette glass-panel">
                                            <button type="button" class="arcmap-no-color-btn" @onclick='() => SelecionarCorCustomizada("FILL", "transparent")'>
                                                <div class="no-color-icon-small"></div> Sem Cor
                                            </button>
                                            <div class="arcmap-color-grid">
                                                @foreach (var cor in PaletaCoresSIG)
                                                {
                                                    <div class="arcmap-color-cell" style="background-color: @cor;" @onclick='() => SelecionarCorCustomizada("FILL", cor)'></div>
                                                }
                                            </div>
                                            <label class="arcmap-more-colors-btn">
                                                Mais Cores...
                                                <input @ref="inputColorFillRef" type="color" value="@corPreenchimento" style="display:none;"
                                                       @onchange='(e) => SelecionarCorCustomizada("FILL", e.Value?.ToString() ?? "#38bdf8")' />
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="form-group-vertical">
                                    <label class="gis-label">Separar Cores Usando a Coluna</label>
                                    <select class="gis-select" @bind="colunaSimbologiaCategorizada">
                                        <option value="">[ Selecione a Coluna ]</option>
                                        @foreach (var col in ColunasDaCamadaAtual)
                                        {
                                            <option value="@col">@col</option>
                                        }
                                    </select>
                                </div>
                            }

                            <!-- O CONTORNO (BORDA/CASING) DEVE ESTAR SEMPRE DISPONÍVEL -->
                            <div class="form-group-vertical" style="position: relative; margin-top: 15px;">
                                <label class="gis-label">Cor do Contorno (Borda/Casing)</label>
                                <div class="arcmap-picker-trigger" @onclick="() => { abrirSeletorBorda = !abrirSeletorBorda; abrirSeletorFill = false; }">
                                    @if (semCorBorda)
                                    {
                                        <div class="color-preview-box no-color-diagonal"></div>
                                        <span class="color-text-value">Sem Cor (Transparente)</span>
                                    }
                                    else
                                    {
                                        <div class="color-preview-box" style="background-color: @corBorda;"></div>
                                        <span class="color-text-value">@corBorda.ToUpper()</span>
                                    }
                                    <div class="dropdown-arrow-indicator">▼</div>
                                </div>

                                @if (abrirSeletorBorda)
                                {
                                    <div class="arcmap-dropdown-palette glass-panel">
                                        <button type="button" class="arcmap-no-color-btn" @onclick='() => SelecionarCorCustomizada("BORDA", "transparent")'>
                                            <div class="no-color-icon-small"></div> Sem Cor
                                        </button>
                                        <div class="arcmap-color-grid">
                                            @foreach (var cor in PaletaCoresSIG)
                                            {
                                                <div class="arcmap-color-cell" style="background-color: @cor;" @onclick='() => SelecionarCorCustomizada("BORDA", cor)'></div>
                                            }
                                        </div>
                                        <label class="arcmap-more-colors-btn">
                                            Mais Cores...
                                            <input @ref="inputColorBordaRef" type="color" value="@corBorda" style="display:none;"
                                                   @onchange='(e) => SelecionarCorCustomizada("BORDA", e.Value?.ToString() ?? "#0ea5e9")' />
                                        </label>
                                    </div>
                                }
                            </div>


                            <div class="form-group-vertical" style="margin-top: 15px;">
                                <label class="gis-label" style="display: flex; justify-content: space-between;">
                                    Opacidade <span>@opacidadePreenchimento%</span>
                                </label>
                                <input type="range" min="0" max="100" step="1" @bind="opacidadePreenchimento" @bind:event="oninput" @bind:after="AtualizarSimbologiaAoVivo" class="slider" />
                            </div>

                            <div class="form-group-vertical" style="margin-top: 15px;">
                                <label class="gis-label" style="display: flex; justify-content: space-between; align-items: center;" title="Espessura do miolo interno (Linha Central)">
                                    Espessura do Miolo (Linha Central)
                                    <input type="number" min="0" max="30" step="1" @bind="espessuraLinha" @bind:event="oninput" @bind:after="AtualizarSimbologiaAoVivo" style="width: 60px; text-align: right; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 4px; padding: 2px 5px;" />
                                </label>
                                <input type="range" min="0" max="15" step="1" @bind="espessuraLinha" @bind:event="oninput" @bind:after="AtualizarSimbologiaAoVivo" class="slider" />
                            </div>

                            <div class="form-group-vertical" style="margin-top: 15px;">
                                <label class="gis-label" style="display: flex; justify-content: space-between; align-items: center;" title="Espessura absoluta da base (deve ser maior que o Miolo para ser visível)">
                                    Espessura da Base (Casing/Borda)
                                    <input type="number" min="0" max="15" step="0.5" @bind="espessuraBorda" @bind:event="oninput" @bind:after="AtualizarSimbologiaAoVivo" style="width: 60px; text-align: right; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 4px; padding: 2px 5px;" />
                                </label>
                                <input type="range" min="0" max="15" step="0.5" @bind="espessuraBorda" @bind:event="oninput" @bind:after="AtualizarSimbologiaAoVivo" class="slider" />
                            </div>

                            <div class="form-group-vertical" style="margin-top: 15px;">
                                <label class="gis-label">Estilo do Contorno (Traço)</label>
                                <select class="gis-select" @bind="tipoLinha" @bind:after="AtualizarSimbologiaAoVivo">
                                    <option value="Solid">Linha Sólida (Continua)</option>
                                    <option value="Dash">Tracejado Regular</option>
                                    <option value="Dot">Pontilhado (Pontos)</option>
                                    <option value="DashDot">Traço-Ponto (Alternado)</option>
                                </select>
                            </div>

                            @if (MapService.PontosPorCamada.ContainsKey(camadaEmEdicao))
                            {
                                <div class="form-group-vertical" style="margin-top: 15px;">
                                    <label class="gis-label" style="display: flex; justify-content: space-between; align-items: center;">
                                        Tamanho do Símbolo (Ponto)
                                        <input type="number" min="0" max="100" step="1" @bind="tamanhoPonto" @bind:event="oninput" @bind:after="AtualizarSimbologiaAoVivo" style="width: 60px; text-align: right; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 4px; padding: 2px 5px;" />
                                    </label>
                                    <input type="range" min="0" max="40" step="1" @bind="tamanhoPonto" @bind:event="oninput" @bind:after="AtualizarSimbologiaAoVivo" class="slider" />
                                </div>
                            }
                        }
                        else if (abaAtivaPropriedades == "Rotulos")
                        {
                            <div style="display: flex; align-items: center; margin-bottom: 20px; padding-bottom: 15px; border-bottom: 1px solid rgba(255,255,255,0.05);">
                                <label class="geonex-toggle">
                                    <input type="checkbox" @bind="exibirRotulos">
                                    <span class="geonex-slider"></span>
                                </label>
                                <span style="color: #fff; font-weight: 600; font-size: 14px; letter-spacing: 0.5px;">Exibir Rótulos no Mapa</span>
                            </div>

                            @if (exibirRotulos)
                            {
                                <div style="margin-bottom: 18px;">
                                    <label class="gis-label">Atributo de Leitura</label>
                                    <select class="gis-select" @bind="colunaRotuloSelecionada">
                                        <option value="">Selecione a Coluna...</option>
                                        @foreach (var coluna in ColunasDaCamadaAtual)
                                        {
                                            <option value="@coluna">@coluna</option>
                                        }
                                    </select>
                                </div>

                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 18px;">
                                    <div>
                                        <label class="gis-label">Tamanho do Texto</label>
                                        <div class="gis-number-wrapper">
                                            <input type="number" min="6" max="72" step="1" @bind="tamanhoFonteRotulo" class="gis-number-input" />
                                            <span class="gis-number-unit">px</span>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="gis-label">Espessura do Halo</label>
                                        <div class="gis-number-wrapper">
                                            <input type="number" min="0" max="15" step="0.5" @bind="tamanhoHaloRotulo" class="gis-number-input" />
                                            <span class="gis-number-unit">px</span>
                                        </div>
                                    </div>
                                </div>

                                <div style="margin-bottom: 15px;">
                                    <label class="gis-label">Formatação Visual</label>
                                    <div class="gis-toolbar">

                                        <label class="gis-tool-btn @(rotuloNegrito ? "active" : "")" style="width: 40px;" title="Negrito">
                                            <input type="checkbox" @bind="rotuloNegrito" style="display: none;" />
                                            <span style="font-weight: bold; font-family: serif; font-size: 16px;">N</span>
                                        </label>

                                        <div style="width: 1px; height: 24px; background: rgba(255,255,255,0.1); margin: 0 6px;"></div>

                                        <div class="gis-tool-btn" style="flex: 1; display: flex; gap: 10px; padding: 0 12px;" title="Cor da Fonte">
                                            <span style="font-weight: bold; font-size: 15px; border-bottom: 3px solid @corFonteRotulo; padding-bottom: 2px;">A</span>
                                            <span style="font-size: 13px; font-weight: 500; opacity: 0.8;">Texto</span>
                                            <input type="color" @bind="corFonteRotulo" class="gis-color-input" />
                                        </div>

                                        <div class="gis-tool-btn" style="flex: 1; display: flex; gap: 10px; padding: 0 12px;" title="Cor do Halo (Contorno)">
                                            <span style="font-weight: bold; font-size: 15px; color: transparent; -webkit-text-stroke: 1px @corHaloRotulo; padding-bottom: 2px;">A</span>
                                            <span style="font-size: 13px; font-weight: 500; opacity: 0.8;">Halo</span>
                                            <input type="color" @bind="corHaloRotulo" class="gis-color-input" />
                                        </div>

                                    </div>
                                </div>
                            }
                        }
                        else if (abaAtivaPropriedades == "Informacao")
                        {
                            <div style="color: #94a3b8; font-size: 0.85rem; padding: 10px;">
                                <p style="margin-bottom: 10px;"><strong>Sistema de Coordenadas:</strong> EPSG:4326</p>
                                <p style="margin-bottom: 10px;"><strong>Formato:</strong> Vetor OGR</p>
                            </div>
                        }

                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn-cancel" @onclick="() => exibirModalPropriedades = false">CANCELAR</button>
                    <button class="btn-save add-layer-btn" @onclick="AplicarPropriedadesUnificadas">APLICAR ESTILO</button>
                </div>
            </div>
        </div>
    }
    <!-- A CHAVE DO MODAL DE PROPRIEDADES FECHA AQUI PRIMEIRO -->
    <!-- AGORA SIM, O MENU DE CONTEXTO É TOTALMENTE INDEPENDENTE -->
    @if (mostrarMenuContexto)
    {
        // Lê a memória para saber o estado dos rótulos e da coluna
        var temEstilo = MapService.EstilosPorCamada.TryGetValue(camadaSelecionadaMenu, out var estMenu);
        bool rotulosAtivos = temEstilo && estMenu.ExibirRotulos;
        bool bloquearRotulos = !rotulosAtivos && (!temEstilo || string.IsNullOrEmpty(estMenu.ColunaRotulo));

        <div class="context-menu-overlay" @onclick="FecharMenuContexto" @oncontextmenu="FecharMenuContexto" @oncontextmenu:preventDefault="true"></div>
        <div class="context-menu glass-panel" style="left: @(menuContextoX)px; top: @(menuContextoY)px;">
            <button @onclick="AproximarCamada">Aproximar à Camada</button>

            @if (CamadasAtivas.FirstOrDefault(c => c.Nome == camadaSelecionadaMenu)?.Tipo == "Vetor")
            {
                <button @onclick="() => { FecharMenuContexto(); AbrirTabela(camadaSelecionadaMenu); }">Tabela de Atributos</button>
                <button @onclick="() => { FecharMenuContexto(); AbrirPropriedadesSincronizadas(camadaSelecionadaMenu); }">Propriedades e Estilos</button>

                <hr class="menu-divider" />

                <button @onclick="AlternarRotulosMenuRapido"
                        disabled="@bloquearRotulos"
                        title="@(bloquearRotulos ? "Configure a coluna nas Propriedades primeiro" : "")"
                        style="display: flex; justify-content: space-between; align-items: center; @(bloquearRotulos ? "opacity: 0.4; cursor: not-allowed;" : "")">
                    <span>@(rotulosAtivos ? "Ocultar Rótulos" : "Exibir Rótulos")</span>
                    <span style="color: @(rotulosAtivos ? "#f87171" : (bloquearRotulos ? "#64748b" : "#38bdf8")); font-weight: bold; font-family: serif;">T</span>
                </button>

                <hr class="menu-divider" />
            }

            <button @onclick="FecharMenuContexto">Renomear</button>

            <button @onclick="() => MoverCamada(camadaSelecionadaMenu, -1)">Mover para Cima</button>
            <button @onclick="() => MoverCamada(camadaSelecionadaMenu, 1)">Mover para Baixo</button>

            <hr class="menu-divider" />

            <button @onclick="PrepararRemocaoCamada" class="btn-danger">Remover Camada</button>
        </div>
    }
    
    <!-- MODAL DE INJEÇÃO DE COORDENADAS (CADERNETA DE CAMPO) -->
    @if (exibirModalCoordenadas)
    {
        <div class="modal-overlay" role="dialog" aria-modal="true" @onpointerdown:stopPropagation="true" @onpointerup:stopPropagation="true" @onpointermove:stopPropagation="true">
            <div class="glass-panel" style="width: 550px; display: flex; flex-direction: column;">
                <div class="modal-header">
                    <h2>CADERNETA DE CAMPO DIGITAL</h2>
                    <button class="close-btn" @onclick="() => exibirModalCoordenadas = false">✕</button>
                </div>

                <!-- CORREÇÃO 1: height: auto e max-height para evitar que o conteúdo vaze -->
                <div class="modal-body custom-scrollbar" style="height: auto; max-height: 65vh; padding: 20px; display: flex; flex-direction: column; gap: 15px; overflow-y: auto;">

                    <!-- CONFIGURAÇÕES DE SISTEMA -->
                    <div class="form-row">
                        <div class="form-group-vertical">
                            <label class="gis-label">FORMATO FÍSICO</label>
                            <select class="gis-select" @bind="novaCamadaFormato" style="width: 100%; border-color: rgba(255,255,255,0.2);">
                                <option value="SHP">ESRI Shapefile (.shp)</option>
                                <option value="GEOJSON">GeoJSON (.geojson)</option>
                                <option value="GPKG">GeoPackage (.gpkg)</option>
                            </select>
                        </div>

                        <div class="form-group-vertical">
                            <label class="gis-label">CLASSE DE GEOMETRIA</label>
                            <select class="gis-select" @bind="novaCamadaGeometria" style="width: 100%; border-color: rgba(255,255,255,0.2);">
                                <option value="POLIGONO">Polígono (Polygon)</option>
                                <option value="LINHA">Linha (LineString)</option>
                                <option value="PONTO">Ponto (Point)</option>
                            </select>
                        </div>

                        <div class="form-group-vertical">
                            <label class="gis-label">SISTEMA DE REFERÊNCIA (CRS)</label>
                            <select class="gis-select" @bind="novaCamadaCrs" style="width: 100%; border-color: rgba(255,255,255,0.2);">
                                <option value="EPSG:31982">EPSG:31982 - SIRGAS 2000 / UTM 22S</option>
                                <option value="EPSG:4326">EPSG:4326 - WGS 84</option>
                            </select>
                        </div>
                    </div>

                    <!-- CONFIGURAÇÕES ESPECÍFICAS E MÉTODO DE ENTRADA -->
                    <div class="form-row" style="margin-top: 10px;">
                        @if (sistemaCoordenadas == "UTM")
                        {
                            <div class="form-group-vertical">
                                <label>FUSO / ZONA UTM (Ex: 22S)</label>
                                <input type="text" class="glass-input" @bind="zonaUtm" placeholder="Ex: 22S" />
                            </div>
                        }

                        <!-- Se não for UTM, este select ocupa a largura toda da grelha -->
                        <div class="form-group-vertical" style="@(sistemaCoordenadas != "UTM" ? "grid-column: span 2;" : "")">
                            <label>MÉTODO DE ENTRADA</label>
                            <select class="glass-input" @bind="metodoEntrada">
                                <option value="COORDENADA">Coordenadas Absolutas (X, Y)</option>
                                @if (sistemaCoordenadas == "UTM")
                                {
                                    <option value="AZIMUTE">Azimute e Distância (A partir do anterior)</option>
                                }
                            </select>
                        </div>
                    </div>

                    @if (sistemaCoordenadas == "UTM")
                    {
                        <div class="form-group-vertical">
                            <label>FUSO / ZONA UTM (Ex: 22S)</label>
                            <input type="text" class="glass-input" @bind="zonaUtm" placeholder="Ex: 22S" />
                        </div>
                    }

                    <hr style="border: none; border-top: 1px solid rgba(255,255,255,0.1); margin: 5px 0;" />

                    <!-- ENTRADA DOS DADOS -->
                    <div class="form-row" style="align-items: flex-end;">
                        <div class="form-group-vertical" style="flex: 0.3;">
                            <label>NOME</label>
                            <input type="text" class="glass-input" @bind="novoNomePonto" placeholder="Ex: P1" />
                        </div>
                        <div class="form-group-vertical" style="flex: 0.7;">
                            <label>COORDENADA (X, Y) ou (Lat, Lng)</label>
                            <div style="display: flex; gap: 10px;">
                                <input type="text" class="glass-input" @bind="novaCoordenadaPonto" placeholder="@(sistemaCoordenadas == "UTM" ? "743210.50, 7134560.80" : "-25.8828, -48.5747")" style="flex: 1;" />
                                <button class="btn-save" @onclick="AdicionarPontoCaderneta" style="margin: 0; padding: 8px 15px; width: auto;">+</button>
                            </div>
                        </div>
                    </div>

                    <!-- LISTA DE PONTOS (A Caderneta) -->
                    <div class="form-group-vertical">
                        <label>LISTA DE PONTOS ADICIONADOS (@listaPontosCaderneta.Count)</label>
                        <div class="layer-list custom-scrollbar" style="height: 140px; background: rgba(0,0,0,0.3); border-radius: 4px; padding: 5px; border: 1px solid rgba(255,255,255,0.05);">

                            @if (listaPontosCaderneta.Count == 0)
                            {
                                <div style="text-align: center; color: #64748b; font-size: 0.75rem; margin-top: 40px;">
                                    Nenhum ponto adicionado à caderneta.
                                </div>
                            }

                            @foreach (var pt in listaPontosCaderneta)
                            {
                                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; padding: 8px; border-bottom: 1px solid rgba(255,255,255,0.05); background: rgba(255,255,255,0.02); margin-bottom: 2px; border-radius: 4px;">
                                    <span><strong style="color:#38bdf8; width: 40px; display: inline-block;">@pt["Nome"]</strong> | <span style="font-family: monospace;">@pt["Coord1"], @pt["Coord2"]</span></span>
                                    <button style="background:none; border:none; color:#ef4444; cursor:pointer; font-size: 1.1rem; font-weight: bold;" @onclick="() => RemoverPontoCaderneta(pt)" title="Remover Ponto">✕</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- CORREÇÃO 2: Botões isolados no rodapé -->
                <div class="modal-footer" style="padding: 15px 20px; border-top: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: flex-end; gap: 10px; background: rgba(0,0,0,0.2);">
                    <button class="btn-cancel" @onclick="() => exibirModalCoordenadas = false">CANCELAR</button>
                    <button class="btn-save" style="margin: 0; width: auto;" @onclick="ProcessarCadernetaDeCampo">PROCESSAR LEVANTAMENTO</button>
                </div>

            </div>
        </div>
    }
    
    @if (exibirModalTrocaVertice)
    {
        <div class="modal-overlay" role="dialog" aria-modal="true" @onpointerdown:stopPropagation="true" @onpointerup:stopPropagation="true" @onpointermove:stopPropagation="true">
            <div class="glass-panel" style="width: 400px;">
                <div class="modal-header">
                    <h2>AJUSTE DE VÉRTICE: V@(verticeEditandoIndice + 1)</h2>
                    <button class="close-btn" @onclick="() => exibirModalTrocaVertice = false">✕</button>
                </div>
                <div class="modal-body" style="padding: 15px; display: flex; flex-direction: column; gap: 10px;">

                    <div class="form-row">
                        <div class="form-group-vertical">
                            <label>SISTEMA (CRS)</label>
                            <select class="glass-input" @bind="sistemaCoordenadasEdicao">
                                <option value="DECIMAL">Decimal (WGS 84)</option>
                                <option value="UTM">UTM (SIRGAS 2000)</option>
                            </select>
                        </div>
                        @if (sistemaCoordenadasEdicao == "UTM")
                        {
                            <div class="form-group-vertical">
                                <label>FUSO / ZONA UTM</label>
                                <input type="text" class="glass-input" @bind="zonaUtmEdicao" placeholder="Ex: 22S" />
                            </div>
                        }
                    </div>

                    <div class="form-group-vertical">
                        <label>@(sistemaCoordenadasEdicao == "UTM" ? "COORDENADA NORTE (Y)" : "LATITUDE (Y)")</label>
                        <input type="text" class="glass-input" @bind="verticeEditandoY" />
                    </div>
                    <div class="form-group-vertical">
                        <label>@(sistemaCoordenadasEdicao == "UTM" ? "COORDENADA ESTE (X)" : "LONGITUDE (X)")</label>
                        <input type="text" class="glass-input" @bind="verticeEditandoX" />
                    </div>

                </div>
                <div class="modal-footer" style="padding: 15px; display: flex; justify-content: flex-end; gap: 10px; background: rgba(0,0,0,0.2);">
                    <button class="btn-cancel" @onclick="() => exibirModalTrocaVertice = false">CANCELAR</button>
                    <button class="btn-save" @onclick="ForcarVerticeManual">MOVER VÉRTICE</button>
                </div>
            </div>
        </div>
    }
    <!-- ========================================================= -->
    <!-- HUD DE ENGENHARIA: MENU DE CONTEXTO TÁTICO                -->
    <!-- ========================================================= -->
    <!-- ========================================================= -->
    <!-- HUD DE ENGENHARIA: MENU DE CONTEXTO TÁTICO                -->
    <!-- ========================================================= -->

    <!-- ========================================================= -->
