    [JSInvokable]
    public async Task SelecionarFeicaoNoMapa(string nomeCamada, string propriedadesJson)
    {
        try
        {
            camadaSelecionadaPainel = nomeCamada; atributosFeicaoSelecionada = new Dictionary<string, string>();
            var dadosBrutos = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, System.Text.Json.JsonElement>>(propriedadesJson);
