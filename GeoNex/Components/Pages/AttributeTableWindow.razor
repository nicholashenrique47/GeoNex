                    </div>
                    <div class="form-field" style="flex:1;">
                        <label>Precisão (decimais):</label>
                        <input type="number" class="gis-input" @bind="_novaColPrecisao" min="0" max="15" disabled="@(_novaColTipo != AttributeDataType.Real)" title="Casas decimais (somente para Real)" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-modal secondary" @onclick="() => _mostrarModalAddCol = false">Cancelar</button>
                <button type="button" class="btn-modal primary" disabled="@(string.IsNullOrWhiteSpace(_novaColNome))" @onclick="ExecutarAdicionarColunaAsync">Adicionar Campo</button>
            </div>
        </div>
    </div>
}
</div>

@code {
    private string? _nomeCamadaAtiva;
    private IAttributeDataProvider? _attributeProvider;
    private IReadOnlyList<AttributeRow> _tableRows = Array.Empty<AttributeRow>();
    private IReadOnlyList<AttributeColumnDefinition> _tableColumns = Array.Empty<AttributeColumnDefinition>();
    private AttributeTransactionManager _txManager = new(100);
    private HashSet<long> _selectedFids = new();

    private int _pageIndex = 0;
    private int _pageSize = 100;
    private int _totalPages => _attributeProvider != null && _attributeProvider.FilteredRowCount > 0
        ? (int)Math.Ceiling((double)_attributeProvider.FilteredRowCount / _pageSize)
        : 1;

    private bool _isLoading = false;
    private string _searchQuery = string.Empty;
    private string? _statusMessage;
    private bool _filtroApenasSelecionados = false;

    // Estatísticas
    private bool _mostrarEstatisticas = false;
    private string? _colunaEstatisticas;
    private ColumnStatistics? _estatisticas;

    // Calculadora
    private bool _mostrarModalCalc = false;
    private bool _calcCriarNovaCol = false;
    private bool _calcApenasSelecionados = false;
    private string _calcColDestino = string.Empty;
    private string _calcNovaColNome = string.Empty;
    private AttributeDataType _calcNovaColTipo = AttributeDataType.Real;
    private int _calcNovaColTamanho = 20;
    private int _calcNovaColPrecisao = 4;
    private string _calcExpressao = string.Empty;
    private string? _calcPrevia;
    private string? _calcErro;
    private NetTopologySuite.Geometries.Geometry? _sampleGeom;

    // Adicionar Coluna
    private bool _mostrarModalAddCol = false;
    private string _novaColNome = string.Empty;
    private AttributeDataType _novaColTipo = AttributeDataType.String;
    private int _novaColTamanho = 50;
    private int _novaColPrecisao = 0;

    private void OnTipoNovaColCalcChanged()
    {
        switch (_calcNovaColTipo)
        {
            case AttributeDataType.Real:
                _calcNovaColTamanho = 20;
                _calcNovaColPrecisao = 4;
                break;
            case AttributeDataType.Integer:
                _calcNovaColTamanho = 10;
                _calcNovaColPrecisao = 0;
                break;
            case AttributeDataType.Int64:
                _calcNovaColTamanho = 18;
                _calcNovaColPrecisao = 0;
                break;
            case AttributeDataType.Date:
            case AttributeDataType.DateTime:
                _calcNovaColTamanho = 10;
                _calcNovaColPrecisao = 0;
                break;
            default:
                _calcNovaColTamanho = 50;
                _calcNovaColPrecisao = 0;
                break;
        }
        AtualizarPreviaCalc();
    }

    private void OnTipoNovaColAddChanged()
    {
        switch (_novaColTipo)
        {
            case AttributeDataType.Real:
                _novaColTamanho = 20;
                _novaColPrecisao = 4;
                break;
            case AttributeDataType.Integer:
                _novaColTamanho = 10;
                _novaColPrecisao = 0;
                break;
            case AttributeDataType.Int64:
                _novaColTamanho = 18;
                _novaColPrecisao = 0;
                break;
            case AttributeDataType.Date:
            case AttributeDataType.DateTime:
                _novaColTamanho = 10;
                _novaColPrecisao = 0;
                break;
            default:
                _novaColTamanho = 50;
                _novaColPrecisao = 0;
                break;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AttributeSession.OnCamadaAtivaAlterada += TratarCamadaAlterada;
        AttributeSession.OnSelecaoAlteradaPeloMapa += TratarSelecaoMapa;

        _nomeCamadaAtiva = AttributeSession.CamadaAtivaNome ?? ObterListaCamadasVetoriais().FirstOrDefault();
        if (!string.IsNullOrEmpty(_nomeCamadaAtiva))
        {
            await CarregarCamadaAsync(_nomeCamadaAtiva);
        }
    }

    private void TratarCamadaAlterada()
    {
        InvokeAsync(async () =>
        {
            if (AttributeSession.CamadaAtivaNome != null && AttributeSession.CamadaAtivaNome != _nomeCamadaAtiva)
            {
                await CarregarCamadaAsync(AttributeSession.CamadaAtivaNome);
            }
        });
    }

    private void TratarSelecaoMapa(string camada, IReadOnlySet<long> fids)
    {
        if (string.Equals(camada, _nomeCamadaAtiva, StringComparison.OrdinalIgnoreCase))
        {
            InvokeAsync(() =>
            {
                _selectedFids = new HashSet<long>(fids);
                StateHasChanged();
            });
        }
    }

    private List<string> ObterListaCamadasVetoriais()
    {
        var lista = new List<string>();
        if (ProjetoService.ProjetoAtual?.Camadas != null)
        {
            foreach (var c in ProjetoService.ProjetoAtual.Camadas)
            {
                if (c.Tipo == "Vetor" && !string.IsNullOrWhiteSpace(c.Nome))
                {
                    lista.Add(c.Nome);
                }
            }
        }
        foreach (var kv in MapService.FeaturesPorCamada)
        {
            if (!lista.Contains(kv.Key)) lista.Add(kv.Key);
        }
        foreach (var name in MapService.OrdemCamadas)
        {
            if (!lista.Contains(name) && !name.StartsWith("osm_", StringComparison.OrdinalIgnoreCase) && !name.StartsWith("google_", StringComparison.OrdinalIgnoreCase))
                lista.Add(name);
        }
        return lista;
    }

    private async Task OnCamadaSelecionadaChanged(ChangeEventArgs e)
    {
        string? nova = e.Value?.ToString();
        if (!string.IsNullOrEmpty(nova))
        {
            string? cam = AttributeSession.ObterCaminhoCamada(nova);
            AttributeSession.DefinirCamadaAtiva(nova, cam);
            await CarregarCamadaAsync(nova);
        }
    }

    private async Task CarregarCamadaAsync(string nomeCamada)
    {
        _isLoading = true;
        _nomeCamadaAtiva = nomeCamada;
        _pageIndex = 0;
        _searchQuery = string.Empty;
        _filtroApenasSelecionados = false;
        _mostrarEstatisticas = false;
        _txManager.Clear();
        StateHasChanged();

        try
        {
            string? caminho = null;
            if (string.Equals(AttributeSession.CamadaAtivaNome, nomeCamada, StringComparison.OrdinalIgnoreCase) &&
                !string.IsNullOrEmpty(AttributeSession.CamadaAtivaCaminho) && File.Exists(AttributeSession.CamadaAtivaCaminho))
            {
                caminho = AttributeSession.CamadaAtivaCaminho;
            }

            if (string.IsNullOrEmpty(caminho) || !File.Exists(caminho))
            {
                caminho = AttributeSession.ObterCaminhoCamada(nomeCamada);
            }

            if (string.IsNullOrEmpty(caminho) || !File.Exists(caminho))
            {
                var camada = ProjetoService.ProjetoAtual?.Camadas.FirstOrDefault(c =>
                    string.Equals(c.Nome, nomeCamada, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(Path.GetFileNameWithoutExtension(c.Nome), Path.GetFileNameWithoutExtension(nomeCamada), StringComparison.OrdinalIgnoreCase));
                caminho = camada?.CaminhoFonteOriginal;
            }

            if (string.IsNullOrEmpty(caminho) || !File.Exists(caminho))
            {
                using var shpLease = MapService.AcquireShapefile(nomeCamada);
                if (shpLease?.Resource?.DbfPath != null && File.Exists(shpLease.Resource.DbfPath))
                {
                    string candidateShp = Path.ChangeExtension(shpLease.Resource.DbfPath, ".shp");
                    caminho = File.Exists(candidateShp) ? candidateShp : shpLease.Resource.DbfPath;
                }
            }

            if (!string.IsNullOrEmpty(caminho) && File.Exists(caminho))
            {
                AttributeSession.RegistrarCaminhoCamada(nomeCamada, caminho);
                _attributeProvider?.Dispose();
                var ogrProv = new OgrAttributeDataProvider(caminho, nomeCamada);
                ogrProv.BeforeSchemaChangeAsync = async () =>
                {
                    MapService.RemoveVectorResources(nomeCamada);
                    await Task.CompletedTask;
                };
                ogrProv.AfterSchemaChangeAsync = async () =>
                {
                    try
                    {
                        ProjetoService.CarregarShapefileParaMotorMapas(caminho, nomeCamada, MapService);
                        MapService.InvalidateGlobalCache();
                        MapService.RequestRedraw();
                    }
                    catch (Exception reloadEx)
                    {
                        Console.Error.WriteLine($"[AttributeTable] Falha ao recarregar {nomeCamada}: {reloadEx.Message}");
                    }
                    await Task.CompletedTask;
                };

                _attributeProvider = ogrProv;
                await _attributeProvider.InitializeAsync();
                _tableColumns = _attributeProvider.Columns;
                await CarregarPaginaAsync();
            }
            else
            {
                _statusMessage = "Arquivo da camada não localizado no disco.";
            }
        }
        catch (Exception ex)
        {
            _statusMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CarregarPaginaAsync()
    {
        if (_attributeProvider == null) return;
        _isLoading = true;
        try
        {
            int start = _pageIndex * _pageSize;
            _tableRows = await _attributeProvider.GetRowsAsync(start, _pageSize);
            _tableColumns = _attributeProvider.Columns;
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task IrParaPagina(int idx)
    {
        int max = Math.Max(0, _totalPages - 1);
        _pageIndex = Math.Clamp(idx, 0, max);
        await CarregarPaginaAsync();
    }

    private async Task AplicarBuscaAsync()
    {
        if (_attributeProvider == null) return;
        _pageIndex = 0;
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            await _attributeProvider.SetFilterAsync(null);
        }
        else
        {
            string q = _searchQuery.Trim();
            var textCols = _tableColumns
                .Where(c => c.DataType == AttributeDataType.String)
                .Take(6)
                .Select(c => $"\"{c.Name}\" LIKE '%{q}%'");
            string filter = string.Join(" OR ", textCols);
            if (!string.IsNullOrEmpty(filter)) await _attributeProvider.SetFilterAsync(filter);
        }
        await CarregarPaginaAsync();
    }

    private async Task LimparBuscaAsync()
    {
        _searchQuery = string.Empty;
        if (_attributeProvider != null)
        {
            _pageIndex = 0;
            await _attributeProvider.SetFilterAsync(null);
            await CarregarPaginaAsync();
        }
    }

    private async Task OrdenarPorColunaAsync(string col)
    {
        if (_attributeProvider == null) return;
        bool asc = _attributeProvider.SortColumn == col ? !_attributeProvider.SortAscending : true;
        await _attributeProvider.SetSortingAsync(col, asc);
        _pageIndex = 0;
        await CarregarPaginaAsync();
    }

    private async Task AlternarModoEdicaoAsync()
    {
        if (_attributeProvider == null) return;
        if (_attributeProvider.IsEditing)
        {
            if (_attributeProvider.HasPendingModifications)
            {
                bool salvar = await JSRuntime.InvokeAsync<bool>("confirm", "Deseja salvar as alterações pendentes no arquivo?");
                if (salvar) await SalvarEdicoesAsync();
                else await _attributeProvider.RollbackTransactionAsync();
            }
            else
            {
                await _attributeProvider.RollbackTransactionAsync();
            }
        }
        else
        {
            await _attributeProvider.BeginTransactionAsync();
        }
        await CarregarPaginaAsync();
    }

    private async Task SalvarEdicoesAsync()
    {
        if (_attributeProvider == null) return;
        try
        {
            _isLoading = true;
            await _attributeProvider.CommitTransactionAsync();
            _txManager.Clear();
            _statusMessage = "Alterações salvas com sucesso.";
            await CarregarPaginaAsync();
            MapService.InvalidateGlobalCache();
            MapService.RequestRedraw();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Erro ao salvar: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DesfazerEdicaoAsync()
    {
        if (_attributeProvider == null || !_txManager.CanUndo) return;
        if (_txManager.Undo(_attributeProvider))
        {
            await CarregarPaginaAsync();
        }
    }

    private async Task RefazerEdicaoAsync()
    {
        if (_attributeProvider == null || !_txManager.CanRedo) return;
        if (_txManager.Redo(_attributeProvider))
        {
            await CarregarPaginaAsync();
        }
    }

    private async Task AtualizarCelulaAsync(long fid, string col, object? novo, object? antigo)
    {
        if (_attributeProvider == null) return;
        _txManager.RecordEdit(fid, col, antigo, novo);
        await _attributeProvider.SetCellValueAsync(fid, col, novo);
        await CarregarPaginaAsync();
    }

    private void ToggleSelecaoLinha(long fid)
    {
        if (_selectedFids.Contains(fid)) _selectedFids.Remove(fid);
        else _selectedFids.Add(fid);

        if (_nomeCamadaAtiva != null)
        {
            AttributeSession.NotificarSelecaoTabela(_nomeCamadaAtiva, _selectedFids);
        }
        StateHasChanged();
    }

    private void AlternarSelecionarTudo()
    {
        if (_selectedFids.Count >= _tableRows.Count && _tableRows.Count > 0)
        {
            _selectedFids.Clear();
        }
        else
        {
            foreach (var r in _tableRows) _selectedFids.Add(r.FID);
        }
        if (_nomeCamadaAtiva != null)
        {
            AttributeSession.NotificarSelecaoTabela(_nomeCamadaAtiva, _selectedFids);
        }
        StateHasChanged();
    }

    private void InverterSelecao()
    {
        var novos = new HashSet<long>();
        foreach (var r in _tableRows)
        {
            if (!_selectedFids.Contains(r.FID)) novos.Add(r.FID);
        }
        _selectedFids = novos;
        if (_nomeCamadaAtiva != null)
        {
            AttributeSession.NotificarSelecaoTabela(_nomeCamadaAtiva, _selectedFids);
        }
        StateHasChanged();
    }

    private void LimparSelecao()
    {
        _selectedFids.Clear();
        if (_nomeCamadaAtiva != null)
        {
            AttributeSession.NotificarSelecaoTabela(_nomeCamadaAtiva, _selectedFids);
        }
        StateHasChanged();
    }

    private async Task IniciarEdicaoCelula(long fid, string colName)
    {
        if (_attributeProvider == null) return;
        if (!_attributeProvider.IsEditing)
        {
            await _attributeProvider.BeginTransactionAsync();
            await CarregarPaginaAsync();
        }
    }

    private void ZoomParaLinhaFid(long fid)
    {
        if (_nomeCamadaAtiva != null)
        {
            AttributeSession.SolicitarZoomFeicao(_nomeCamadaAtiva, fid);
        }
    }

    private void PanParaLinhaFid(long fid)
    {
        if (_nomeCamadaAtiva != null)
        {
            AttributeSession.SolicitarPanFeicao(_nomeCamadaAtiva, fid);
        }
    }

    private void BlinkLinhaFid(long fid)
    {
        if (_nomeCamadaAtiva != null)
        {
            AttributeSession.SolicitarBlinkFeicao(_nomeCamadaAtiva, fid);
        }
    }

    private void ZoomParaSelecao()
    {
        if (_nomeCamadaAtiva != null && _selectedFids.Count > 0)
        {
            // Pede zoom da primeira feição selecionada
            AttributeSession.SolicitarZoomFeicao(_nomeCamadaAtiva, _selectedFids.First());
        }
    }

    private async Task AlternarFiltroApenasSelecionadosAsync()
    {
        _filtroApenasSelecionados = !_filtroApenasSelecionados;
        if (_attributeProvider == null) return;
        _pageIndex = 0;
        if (_filtroApenasSelecionados)
        {
            if (_selectedFids.Count > 0)
            {
                string idList = string.Join(",", _selectedFids.Take(1000));
                await _attributeProvider.SetFilterAsync($"FID IN ({idList})");
            }
            else
            {
                await _attributeProvider.SetFilterAsync("1=0");
            }
        }
        else
        {
            await _attributeProvider.SetFilterAsync(null);
        }
        await CarregarPaginaAsync();
    }

    private async Task AbrirEstatisticasColunaAsync(string col)
    {
        if (_attributeProvider == null) return;
        _colunaEstatisticas = col;
        _mostrarEstatisticas = true;
        _estatisticas = null;
        StateHasChanged();
        try
        {
            _estatisticas = await _attributeProvider.GetColumnStatisticsAsync(col);
        }
        catch (Exception ex)
        {
            _statusMessage = $"Estatísticas: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task ConfirmarExcluirColunaAsync(string col)
    {
        if (_attributeProvider == null) return;
        bool conf = await JSRuntime.InvokeAsync<bool>("confirm", $"Deseja excluir a coluna '{col}'?");
        if (!conf) return;
        try
        {
            _isLoading = true;
            await _attributeProvider.DropColumnAsync(col);
            await CarregarPaginaAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AbrirCalculadoraCampos()
    {
        var firstNonPk = _tableColumns.FirstOrDefault(c => !c.IsPrimaryKey);
        if (firstNonPk != null)
        {
            _calcColDestino = firstNonPk.Name;
            _calcCriarNovaCol = false;
        }
        else
        {
            _calcColDestino = "";
            _calcCriarNovaCol = true;
        }
        _calcNovaColNome = "NOVO_CAMPO";
        _calcExpressao = "$area";
        _calcPrevia = null;
        _calcErro = null;
        _mostrarModalCalc = true;
        StateHasChanged();

        _sampleGeom = null;
        if (_tableRows.Count > 0 && _attributeProvider != null)
        {
            try
            {
                _sampleGeom = await _attributeProvider.GetGeometryAsync(_tableRows[0].FID);
            }
            catch
            {
                _sampleGeom = null;
            }
        }
        AtualizarPreviaCalc();
        StateHasChanged();
    }

    private void InserirTokenCalculadora(string token)
    {
        _calcExpressao += " " + token + " ";
        AtualizarPreviaCalc();
    }

    private void AtualizarPreviaCalc()
    {
        if (string.IsNullOrWhiteSpace(_calcExpressao))
        {
            _calcPrevia = null;
            _calcErro = null;
            return;
        }
        try
        {
            var ast = ExpressionParser.Parse(_calcExpressao);
            var row = _tableRows.FirstOrDefault();
            var dict = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
            if (row != null)
            {
                for (int i = 0; i < _tableColumns.Count; i++)
                {
                    if (i < row.Values.Length) dict[_tableColumns[i].Name] = row.Values[i];
                }
            }
            var ctx = new FeatureEvaluationContext(row?.FID ?? 1, 1, dict, _sampleGeom);
            var res = ast.Evaluate(ctx);
            if (res != null)
            {
                int prevPrec = _calcCriarNovaCol ? _calcNovaColPrecisao : (_tableColumns.FirstOrDefault(c => c.Name == _calcColDestino)?.Precision ?? 4);
                bool isRealTarget = (_calcCriarNovaCol && _calcNovaColTipo == AttributeDataType.Real) || (_tableColumns.FirstOrDefault(c => c.Name == _calcColDestino)?.DataType == AttributeDataType.Real);
                if (isRealTarget && double.TryParse(res.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double num))
                {
                    _calcPrevia = num.ToString("F" + Math.Clamp(prevPrec, 0, 15), CultureInfo.InvariantCulture);
                }
                else
                {
                    _calcPrevia = string.Format(CultureInfo.InvariantCulture, "{0}", res);
                }
            }
            else
            {
                _calcPrevia = "NULL";
            }
            _calcErro = null;
        }
        catch (Exception ex)
        {
            _calcErro = ex.Message;
            _calcPrevia = null;
        }
    }

    private async Task ExecutarCalculadoraAsync()
    {
        if (_attributeProvider == null || string.IsNullOrWhiteSpace(_calcExpressao)) return;
        try
        {
            _isLoading = true;
            if (!_attributeProvider.IsEditing)
            {
                await _attributeProvider.BeginTransactionAsync();
            }
            string destCol = _calcCriarNovaCol ? _calcNovaColNome.Trim().ToUpperInvariant() : _calcColDestino;
            if (string.IsNullOrWhiteSpace(destCol))
            {
                _calcErro = "Selecione ou informe a coluna de destino.";
                return;
            }

            if (_calcCriarNovaCol)
            {
                if (destCol.Length > 10) destCol = destCol[..10];
                await _attributeProvider.AddColumnAsync(new AttributeColumnDefinition(destCol, _calcNovaColTipo, _calcNovaColTamanho, _calcNovaColPrecisao));
                _tableColumns = _attributeProvider.Columns;
            }

            int precisao = _calcCriarNovaCol ? _calcNovaColPrecisao : (_tableColumns.FirstOrDefault(c => c.Name == destCol)?.Precision ?? 4);
            var colDef = _tableColumns.FirstOrDefault(c => c.Name == destCol);
            bool isReal = (_calcCriarNovaCol && _calcNovaColTipo == AttributeDataType.Real) || (colDef?.DataType == AttributeDataType.Real);

            var ast = ExpressionParser.Parse(_calcExpressao);
            long rowCount = 0;
            await _attributeProvider.CalculateColumnAsync(destCol, (fid, attrs, geom) =>
            {
                long r = Interlocked.Increment(ref rowCount);
                var ctx = new FeatureEvaluationContext(fid, r, attrs, geom);
                var val = ast.Evaluate(ctx);
                if (isReal && val != null && double.TryParse(val.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double dVal))
                {
                    return Math.Round(dVal, Math.Clamp(precisao, 0, 15));
                }
                return val;
            }, _calcApenasSelecionados ? _selectedFids : null);

            _mostrarModalCalc = false;
            _statusMessage = $"Campo '{destCol}' calculado com sucesso ({_attributeProvider.TotalRowCount} registros). Clique em 'Salvar' para gravar no disco.";
            await CarregarPaginaAsync();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Erro no cálculo: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void AbrirAdicionarColuna()
    {
        _novaColNome = "";
        _novaColTipo = AttributeDataType.String;
        _novaColTamanho = 50;
        _novaColPrecisao = 0;
        _mostrarModalAddCol = true;
        StateHasChanged();
    }

    private async Task ExecutarAdicionarColunaAsync()
    {
        if (_attributeProvider == null || string.IsNullOrWhiteSpace(_novaColNome)) return;
        try
        {
            _isLoading = true;
            string name = _novaColNome.Trim().ToUpperInvariant();
            if (name.Length > 10) name = name[..10];
            await _attributeProvider.AddColumnAsync(new AttributeColumnDefinition(name, _novaColTipo, _novaColTamanho, _novaColPrecisao));
            _mostrarModalAddCol = false;
            _statusMessage = $"Coluna '{name}' criada com sucesso (Tipo: {_novaColTipo}, Tam: {_novaColTamanho}, Prec: {_novaColPrecisao}).";
            _tableColumns = _attributeProvider.Columns;
            await CarregarPaginaAsync();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Erro ao adicionar campo: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ExportarCsvAsync()
    {
        if (_attributeProvider == null) return;
        try
        {
            var sb = new StringBuilder();
            sb.AppendLine(string.Join(";", _tableColumns.Select(c => $"\"{c.Name}\"")));
            int total = (int)_attributeProvider.FilteredRowCount;
            int batch = 256;
            for (int i = 0; i < total; i += batch)
            {
                var rows = await _attributeProvider.GetRowsAsync(i, Math.Min(batch, total - i));
                foreach (var r in rows)
                {
                    sb.AppendLine(string.Join(";", r.Values.Select(v => $"\"{v?.ToString()?.Replace("\"", "\"\"") ?? ""}\"")));
                }
            }
            string csv = sb.ToString();
            string fileName = $"{_nomeCamadaAtiva}_atributos_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await JSRuntime.InvokeVoidAsync("geonexDownloadText", csv, fileName);
        }
        catch (Exception ex)
        {
            _statusMessage = $"Erro ao exportar CSV: {ex.Message}";
        }
    }

    private async Task TratarTecladoLocal(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            LimparSelecao();
        }
        else if (e.CtrlKey && e.Key.ToLower() == "e")
        {
            await AlternarModoEdicaoAsync();
        }
        else if (e.CtrlKey && e.Key.ToLower() == "s" && _attributeProvider?.IsEditing == true)
        {
            await SalvarEdicoesAsync();
        }
        else if (e.CtrlKey && e.Key.ToLower() == "z" && _attributeProvider?.IsEditing == true)
        {
            await DesfazerEdicaoAsync();
        }
        else if (e.CtrlKey && e.Key.ToLower() == "y" && _attributeProvider?.IsEditing == true)
        {
            await RefazerEdicaoAsync();
        }
        else if (e.CtrlKey && e.Key.ToLower() == "i")
        {
            await AbrirCalculadoraCampos();
        }
    }

    public void Dispose()
    {
        AttributeSession.OnCamadaAtivaAlterada -= TratarCamadaAlterada;
        AttributeSession.OnSelecaoAlteradaPeloMapa -= TratarSelecaoMapa;
        _attributeProvider?.Dispose();
    }
}
