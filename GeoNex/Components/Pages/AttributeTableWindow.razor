@page "/attributetable"
@using System.Globalization
@using System.Text
@using GeoNex.Services
@using GeoNex.Services.Attributes
@using GeoNex.Services.ExpressionEngine
@implements IDisposable
@inject AttributeTableSessionService AttributeSession
@inject MapRenderingService MapService
@inject ProjetoService ProjetoService
@inject RasterService RasterService
@inject IJSRuntime JSRuntime

<PageTitle>Tabela de Atributos — @(_nomeCamadaAtiva ?? "GeoNex")</PageTitle>

<div class="standalone-attribute-container" @onkeydown="TratarTecladoLocal">
    <!-- BARRA SUPERIOR DA WORKSTATION STANDALONE -->
    <header class="window-topbar">
        <div class="topbar-left">
            <svg class="topbar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18">
                <path d="M3.75 3v18h16.5V3H3.75zm0 5.25h16.5M3.75 13.5h16.5M9.75 3v18M15.75 3v18"/>
            </svg>
            <span class="topbar-title">TABELA DE ATRIBUTOS</span>
            
            <!-- SELETOR DE CAMADA ATIVA -->
            <div class="layer-selector-group">
                <select class="gis-select layer-select" value="@_nomeCamadaAtiva" @onchange="OnCamadaSelecionadaChanged">
                    @if (ObterListaCamadasVetoriais().Count == 0)
                    {
                        <option value="">Nenhuma camada vetorial carregada</option>
                    }
                    else
                    {
                        @foreach (var c in ObterListaCamadasVetoriais())
                        {
                            <option value="@c">@c</option>
                        }
                    }
                </select>
            </div>

            <!-- STATUS DE EDIÇÃO -->
            @if (_attributeProvider?.IsEditing == true)
            {
                <span class="status-pill editing">EDITANDO</span>
            }
            else
            {
                <span class="status-pill ready">SOMENTE LEITURA</span>
            }
        </div>

        <div class="topbar-right">
            <!-- MÉTRICAS DE REGISTROS -->
            <div class="metrics-pill">
                <span>Total: <strong>@(_attributeProvider?.TotalRowCount ?? 0)</strong></span>
                <span class="sep">|</span>
                <span>Filtrados: <strong>@(_attributeProvider?.FilteredRowCount ?? 0)</strong></span>
                <span class="sep">|</span>
                <span>Selecionados: <strong class="highlight">@_selectedFids.Count</strong></span>
            </div>
        </div>
    </header>

    <!-- TOOLBAR DA TABELA (PADRÃO QGIS / ARCGIS PRO) -->
    <div class="table-toolbar">
        <div class="toolbar-group">
            <button type="button" class="btn-gis-tool @(_attributeProvider?.IsEditing == true ? "is-editing" : "")"
                    title="Alternar Modo de Edição (Ctrl+E)"
                    @onclick="AlternarModoEdicaoAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15" height="15">
                    <path d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
                </svg>
                <span>@(_attributeProvider?.IsEditing == true ? "Editando" : "Editar")</span>
            </button>

            <button type="button" class="btn-gis-tool primary"
                    disabled="@(_attributeProvider?.IsEditing != true || !_attributeProvider.HasPendingModifications)"
                    title="Salvar Alterações (Ctrl+S)"
                    @onclick="SalvarEdicoesAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15" height="15">
                    <path d="M3 4.5A1.5 1.5 0 014.5 3h11.586a1.5 1.5 0 011.06.44l3.414 3.414a1.5 1.5 0 01.44 1.06V19.5a1.5 1.5 0 01-1.5 1.5h-15A1.5 1.5 0 013 19.5V4.5zm4.5 0v4.5h9V4.5h-9zm0 15h9v-6h-9v6z"/>
                </svg>
                <span>Salvar</span>
            </button>

            <button type="button" class="btn-gis-tool icon-only"
                    disabled="@(_attributeProvider?.IsEditing != true || !_txManager.CanUndo)"
                    title="Desfazer (Ctrl+Z)"
                    @onclick="DesfazerEdicaoAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15" height="15">
                    <path d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/>
                </svg>
            </button>

            <button type="button" class="btn-gis-tool icon-only"
                    disabled="@(_attributeProvider?.IsEditing != true || !_txManager.CanRedo)"
                    title="Refazer (Ctrl+Y)"
                    @onclick="RefazerEdicaoAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15" height="15">
                    <path d="M15 15l6-6m0 0l-6-6m6 6H9a6 6 0 000 12h3"/>
                </svg>
            </button>
        </div>

        <div class="toolbar-sep"></div>

        <div class="toolbar-group">
            <button type="button" class="btn-gis-tool icon-only"
                    title="Inverter Seleção"
                    @onclick="InverterSelecao">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15" height="15">
                    <path d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"/>
                </svg>
            </button>

            <button type="button" class="btn-gis-tool icon-only"
                    disabled="@(_selectedFids.Count == 0)"
                    title="Desmarcar Tudo (Esc)"
                    @onclick="LimparSelecao">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15" height="15">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="m4.93 4.93 14.14 14.14"/>
                </svg>
            </button>

            <button type="button" class="btn-gis-tool"
                    disabled="@(_selectedFids.Count == 0)"
                    title="Zoom para Feições Selecionadas no Mapa"
                    @onclick="ZoomParaSelecao">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15" height="15">
                    <circle cx="11" cy="11" r="8"/>
                    <path d="m21 21-4.35-4.35M11 8v6M8 11h6"/>
                </svg>
                <span>Zoom Seleção</span>
            </button>

            <button type="button" class="btn-gis-tool @(_filtroApenasSelecionados ? "active" : "")"
                    title="Filtrar apenas registros selecionados"
                    @onclick="AlternarFiltroApenasSelecionadosAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15" height="15">
                    <path d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>Selecionados</span>
            </button>
        </div>

        <div class="toolbar-sep"></div>

        <div class="toolbar-group">
            <button type="button" class="btn-gis-tool"
                    title="Calculadora de Campos (Ctrl+I)"
                    @onclick="AbrirCalculadoraCampos">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15" height="15">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <path d="M7 8h10M7 12h2m4 0h4M7 16h2m4 0h4"/>
                </svg>
                <span>Calculadora</span>
            </button>

            <button type="button" class="btn-gis-tool icon-only"
                    title="Adicionar Novo Campo"
                    @onclick="AbrirAdicionarColuna">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15" height="15">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
            </button>

            <button type="button" class="btn-gis-tool icon-only"
                    title="Exportar Tabela para CSV"
                    @onclick="ExportarCsvAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15" height="15">
                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/>
                </svg>
            </button>
        </div>

        <!-- BUSCA RÁPIDA -->
        <div class="toolbar-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <input type="text" placeholder="Filtrar registros..."
                   @bind="_searchQuery" @bind:event="oninput"
                   @onkeydown="@(async (e) => { if (e.Key == "Enter") await AplicarBuscaAsync(); })" />
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                <button type="button" class="btn-clear-search" @onclick="LimparBuscaAsync">✕</button>
            }
        </div>
    </div>

    <!-- CORPO DA TABELA VIRTUALIZADA COM LRU CACHE -->
    <div class="table-grid-area custom-scrollbar">
        @if (_isLoading)
        {
            <div class="table-loading-bar"><div class="loading-indeterminate"></div></div>
        }

        <table class="gis-grid">
            <thead>
                <tr>
                    <!-- PINNED SELECTION HEADER -->
                    <th class="th-pinned th-selection">
                        <input type="checkbox"
                               checked="@(_tableRows.Count > 0 && _selectedFids.Count >= _tableRows.Count)"
                               @onchange="AlternarSelecionarTudo" />
                    </th>

                    @foreach (var col in _tableColumns)
                    {
                        <th class="@(col.IsPrimaryKey ? "th-pinned th-fid" : "")" @onclick="() => OrdenarPorColunaAsync(col.Name)">
                            <div class="th-content">
                                <span class="th-type-tag">@(col.DataType switch { AttributeDataType.Integer or AttributeDataType.Int64 => "123", AttributeDataType.Real => "0.0", AttributeDataType.Date => "DATA", _ => "ABC" })</span>
                                <span class="th-name">@col.Name</span>
                                @if (_attributeProvider?.SortColumn == col.Name)
                                {
                                    <span class="th-sort-indicator">@(_attributeProvider.SortAscending ? "▲" : "▼")</span>
                                }
                                <button type="button" class="th-menu-btn" title="Estatísticas de @col.Name"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => AbrirEstatisticasColunaAsync(col.Name)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12">
                                        <path d="M3 13h4v8H3zM10 8h4v13h-4zM17 3h4v18h-4z"/>
                                    </svg>
                                </button>
                                @if (!col.IsPrimaryKey && _attributeProvider?.IsEditing == true)
                                {
                                    <button type="button" class="th-drop-btn" title="Excluir Coluna @col.Name"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => ConfirmarExcluirColunaAsync(col.Name)">
                                        ✕
                                    </button>
                                }
                            </div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int rIdx = 0; rIdx < _tableRows.Count; rIdx++)
                {
                    var row = _tableRows[rIdx];
                    long rowFid = row.FID;
                    bool isSel = _selectedFids.Contains(rowFid);

                    <tr class="@(isSel ? "row-selected" : "") @(row.State == RowState.Modified ? "row-dirty" : "")"
                        @onclick="() => ToggleSelecaoLinha(rowFid)"
                        @ondblclick="() => ZoomParaLinhaFid(rowFid)">
                        
                        <td class="td-pinned td-selection" @onclick:stopPropagation="true">
                            <input type="checkbox"
                                   checked="@isSel"
                                   @onchange="() => ToggleSelecaoLinha(rowFid)" />
                        </td>

                        @for (int cIdx = 0; cIdx < _tableColumns.Count; cIdx++)
                        {
                            var col = _tableColumns[cIdx];
                            object? cellVal = cIdx < row.Values.Length ? row.Values[cIdx] : null;

                            if (col.IsPrimaryKey)
                            {
                                <td class="td-pinned td-fid" @onclick:stopPropagation="true">
                                    <div class="fid-cell">
                                        <span>@rowFid</span>
                                        <button type="button" class="btn-micro" title="Centralizar no Mapa" @onclick:stopPropagation="true" @onclick="() => PanParaLinhaFid(rowFid)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="11" height="11"><circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3"/></svg>
                                        </button>
                                        <button type="button" class="btn-micro" title="Piscar Feição (Blink)" @onclick:stopPropagation="true" @onclick="() => BlinkLinhaFid(rowFid)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="11" height="11"><circle cx="12" cy="12" r="6"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2"/></svg>
                                        </button>
                                    </div>
                                </td>
                            }
                            else if (_attributeProvider?.IsEditing == true && !col.IsReadOnly)
                            {
                                <td class="cell-editable" @onclick:stopPropagation="true">
                                    <input class="cell-input"
                                           value="@(cellVal?.ToString() ?? "")"
                                           @onchange="@(async (e) => await AtualizarCelulaAsync(rowFid, col.Name, e.Value, cellVal))" />
                                </td>
                            }
                            else
                            {
                                <td @ondblclick="() => IniciarEdicaoCelula(rowFid, col.Name)" @ondblclick:stopPropagation="true">
                                    <span class="cell-text @(cellVal == null ? "null-value" : "")">
                                        @(cellVal?.ToString() ?? "NULL")
                                    </span>
                                </td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>

        @if (_tableRows.Count == 0 && !_isLoading)
        {
            <div class="empty-notice">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="32" height="32">
                    <circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/>
                </svg>
                <p>Nenhum registro encontrado para a camada ou filtro informado.</p>
            </div>
        }
    </div>

    <!-- GAVETA DE ESTATÍSTICAS -->
    @if (_mostrarEstatisticas && _estatisticas != null)
    {
        <aside class="stats-drawer">
            <div class="stats-header">
                <strong>ESTATÍSTICAS DA COLUNA: <span>@_colunaEstatisticas</span></strong>
                <button type="button" class="btn-close-stats" @onclick="() => _mostrarEstatisticas = false">✕</button>
            </div>
            <div class="stats-grid">
                <div class="stat-card"><small>CONTAGEM</small><strong>@_estatisticas.TotalCount</strong></div>
                <div class="stat-card"><small>NULOS</small><strong>@_estatisticas.NullCount</strong></div>
                <div class="stat-card"><small>DISTINTOS</small><strong>@_estatisticas.DistinctCount</strong></div>
                @if (_estatisticas.MinValue.HasValue)
                {
                    <div class="stat-card"><small>MÍNIMO</small><strong>@_estatisticas.MinValue.Value.ToString("N4")</strong></div>
                    <div class="stat-card"><small>MÁXIMO</small><strong>@_estatisticas.MaxValue.Value.ToString("N4")</strong></div>
                    <div class="stat-card"><small>SOMA</small><strong>@_estatisticas.SumValue.Value.ToString("N4")</strong></div>
                    <div class="stat-card"><small>MÉDIA</small><strong>@_estatisticas.MeanValue.Value.ToString("N4")</strong></div>
                    <div class="stat-card"><small>DESVIO PADRÃO</small><strong>@_estatisticas.StdDevValue.Value.ToString("N4")</strong></div>
                }
            </div>
        </aside>
    }

    <!-- FOOTER DA TABELA -->
    <footer class="window-footer">
        <div class="footer-left">
            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <span class="status-msg">@_statusMessage</span>
            }
        </div>

        <div class="footer-pagination">
            <button type="button" class="btn-page" disabled="@(_pageIndex <= 0)" @onclick="() => IrParaPagina(0)" title="Primeira Página">«</button>
            <button type="button" class="btn-page" disabled="@(_pageIndex <= 0)" @onclick="() => IrParaPagina(_pageIndex - 1)" title="Página Anterior">‹</button>
            <span class="page-indicator">Página <strong>@(_pageIndex + 1)</strong> de @Math.Max(1, _totalPages)</span>
            <button type="button" class="btn-page" disabled="@(_pageIndex >= _totalPages - 1)" @onclick="() => IrParaPagina(_pageIndex + 1)" title="Próxima Página">›</button>
            <button type="button" class="btn-page" disabled="@(_pageIndex >= _totalPages - 1)" @onclick="() => IrParaPagina(_totalPages - 1)" title="Última Página">»</button>
        </div>
    </footer>

<!-- MODAL CALCULADORA DE CAMPOS -->
@if (_mostrarModalCalc)
{
    <div class="modal-backdrop" @onclick="() => _mostrarModalCalc = false">
        <div class="modal-dialog calc-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Calculadora de Campos — @_nomeCamadaAtiva</h3>
                <button type="button" class="btn-close-modal" @onclick="() => _mostrarModalCalc = false">✕</button>
            </div>
            <div class="modal-body">
                <div class="calc-options">
                    <label><input type="radio" name="calcMode" checked="@(!_calcCriarNovaCol)" @onchange="() => _calcCriarNovaCol = false" /> Atualizar campo existente:</label>
                    <select class="gis-select" disabled="@_calcCriarNovaCol" @bind="_calcColDestino">
                        @foreach (var c in _tableColumns.Where(x => !x.IsPrimaryKey))
                        {
                            <option value="@c.Name">@c.Name (@c.DataType)</option>
                        }
                    </select>

                    <label><input type="radio" name="calcMode" checked="@_calcCriarNovaCol" @onchange="() => _calcCriarNovaCol = true" /> Criar novo campo:</label>
                    <div class="new-col-grid">
                        <div class="col-field">
                            <label class="field-sublabel">Nome:</label>
                            <input type="text" class="gis-input" placeholder="Ex: COORD_X" disabled="@(!_calcCriarNovaCol)" @bind="_calcNovaColNome" />
                        </div>
                        <div class="col-field">
                            <label class="field-sublabel">Tipo:</label>
                            <select class="gis-select" disabled="@(!_calcCriarNovaCol)" @bind="_calcNovaColTipo" @bind:after="OnTipoNovaColCalcChanged">
                                <option value="@AttributeDataType.Real">Número Decimal (Real)</option>
                                <option value="@AttributeDataType.Integer">Número Inteiro (Integer)</option>
                                <option value="@AttributeDataType.Int64">Inteiro Longo (Int64)</option>
                                <option value="@AttributeDataType.String">Texto (String)</option>
                                <option value="@AttributeDataType.Date">Data (Date)</option>
                            </select>
                        </div>
                        <div class="col-field">
                            <label class="field-sublabel">Comprimento:</label>
                            <input type="number" class="gis-input" min="1" max="254" disabled="@(!_calcCriarNovaCol)" @bind="_calcNovaColTamanho" title="Tamanho / largura total (máx 254)" />
                        </div>
                        <div class="col-field">
                            <label class="field-sublabel">Precisão:</label>
                            <input type="number" class="gis-input" min="0" max="15" disabled="@(!_calcCriarNovaCol || _calcNovaColTipo != AttributeDataType.Real)" @bind="_calcNovaColPrecisao" @bind:after="AtualizarPreviaCalc" title="Casas decimais (somente para Real)" />
                        </div>
                    </div>
                    <label class="calc-check" style="display:flex; align-items:center; gap:6px; margin-top:8px; font-size:12px; color:#cbd5e1;">
                        <input type="checkbox" @bind="_calcApenasSelecionados" disabled="@(_selectedFids.Count == 0)" />
                        Atualizar apenas as @_selectedFids.Count feição(ões) selecionada(s)
                    </label>
                </div>

                <div class="calc-editor-row">
                    <div class="calc-vars-col">
                        <small>GEOMETRIA ($)</small>
                        <div class="pill-group">
                            <button type="button" class="btn-pill geom-pill" @onclick='() => InserirTokenCalculadora("$area")' title="Área em m²">$area</button>
                            <button type="button" class="btn-pill geom-pill" @onclick='() => InserirTokenCalculadora("$area_ha")' title="Área em Hectares">$area_ha</button>
                            <button type="button" class="btn-pill geom-pill" @onclick='() => InserirTokenCalculadora("$perimeter")' title="Perímetro em metros">$perimeter</button>
                            <button type="button" class="btn-pill geom-pill" @onclick='() => InserirTokenCalculadora("$length")' title="Comprimento da linha">$length</button>
                            <button type="button" class="btn-pill geom-pill" @onclick='() => InserirTokenCalculadora("$x")' title="Coordenada X (ponto ou centroide)">$x</button>
                            <button type="button" class="btn-pill geom-pill" @onclick='() => InserirTokenCalculadora("$y")' title="Coordenada Y (ponto ou centroide)">$y</button>
                            <button type="button" class="btn-pill geom-pill" @onclick='() => InserirTokenCalculadora("$centroid_x")' title="Centroide X">$centroid_x</button>
                            <button type="button" class="btn-pill geom-pill" @onclick='() => InserirTokenCalculadora("$centroid_y")' title="Centroide Y">$centroid_y</button>
                            <button type="button" class="btn-pill geom-pill" @onclick='() => InserirTokenCalculadora("$geometry_type")' title="Tipo de Geometria">$geometry_type</button>
                            <button type="button" class="btn-pill geom-pill" @onclick='() => InserirTokenCalculadora("$num_points")' title="Número de Vértices">$num_points</button>
                            <button type="button" class="btn-pill geom-pill" @onclick='() => InserirTokenCalculadora("$id")' title="ID da Feição (FID)">$id</button>
                            <button type="button" class="btn-pill geom-pill" @onclick='() => InserirTokenCalculadora("$rownum")' title="Número da Linha">$rownum</button>
                        </div>

                        <small>OPERADORES</small>
                        <div class="pill-group">
                            <button type="button" class="btn-pill op-pill" @onclick='() => InserirTokenCalculadora("+")'>+</button>
                            <button type="button" class="btn-pill op-pill" @onclick='() => InserirTokenCalculadora("-")'>-</button>
                            <button type="button" class="btn-pill op-pill" @onclick='() => InserirTokenCalculadora("*")'>*</button>
                            <button type="button" class="btn-pill op-pill" @onclick='() => InserirTokenCalculadora("/")'>/</button>
                            <button type="button" class="btn-pill op-pill" @onclick='() => InserirTokenCalculadora("^")'>^</button>
                            <button type="button" class="btn-pill op-pill" @onclick='() => InserirTokenCalculadora("%")'>%</button>
                            <button type="button" class="btn-pill op-pill" @onclick='() => InserirTokenCalculadora("(")'> ( </button>
                            <button type="button" class="btn-pill op-pill" @onclick='() => InserirTokenCalculadora(")")'> ) </button>
                            <button type="button" class="btn-pill op-pill" @onclick='() => InserirTokenCalculadora("||")'>||</button>
                        </div>

                        <small>MATEMÁTICA</small>
                        <div class="pill-group">
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("round(")' title="Arredondar: round(valor, n)">round()</button>
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("floor(")' title="Arredondar para baixo">floor()</button>
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("ceil(")' title="Arredondar para cima">ceil()</button>
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("abs(")' title="Valor Absoluto">abs()</button>
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("sqrt(")' title="Raiz Quadrada">sqrt()</button>
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("clamp(")' title="Limitar valor entre min e max">clamp()</button>
                        </div>

                        <small>TEXTO & STRINGS</small>
                        <div class="pill-group">
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("concat(")' title="Concatenar strings: concat(a, b, ...)">concat()</button>
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("upper(")' title="Converter para Maiúsculas">upper()</button>
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("lower(")' title="Converter para Minúsculas">lower()</button>
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("trim(")' title="Remover Espaços">trim()</button>
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("substr(")' title="Sub-cadeia: substr(texto, inicio, tamanho)">substr()</button>
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("replace(")' title="Substituir texto">replace()</button>
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("lpad(")' title="Preencher com zeros: lpad(texto, tam, '0')">lpad()</button>
                        </div>

                        <small>LÓGICA & DATA</small>
                        <div class="pill-group">
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("if(")' title="Condicional: if(condicao, verdadeiro, falso)">if()</button>
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("coalesce(")' title="Retorna o primeiro valor não nulo">coalesce()</button>
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("now()")' title="Data e hora atual">now()</button>
                            <button type="button" class="btn-pill func-pill" @onclick='() => InserirTokenCalculadora("today()")' title="Data de hoje">today()</button>
                        </div>

                        <small>CAMPOS DA TABELA</small>
                        <div class="pill-group fields-group">
                            @foreach (var col in _tableColumns)
                            {
                                <button type="button" class="btn-pill field-pill" @onclick='() => InserirTokenCalculadora($"\"{col.Name}\"")' title="@col.DataType">@col.Name</button>
                            }
                        </div>
                    </div>

                    <div class="calc-main-col">
                        <label>Expressão de Cálculo:</label>
                        <textarea class="calc-textarea" @bind="_calcExpressao" @bind:event="oninput" @onkeyup="AtualizarPreviaCalc"></textarea>
                        
                        <div class="calc-preview">
                            <small>PRÉ-VISUALIZAÇÃO DO PRIMEIRO REGISTRO:</small>
                            <div class="preview-result @(_calcErro != null ? "error" : "")">
                                @(_calcErro != null ? _calcErro : (_calcPrevia ?? "—"))
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-modal secondary" @onclick="() => _mostrarModalCalc = false">Cancelar</button>
                <button type="button" class="btn-modal primary" disabled="@(_calcErro != null || string.IsNullOrWhiteSpace(_calcExpressao))" @onclick="ExecutarCalculadoraAsync">Calcular e Aplicar</button>
            </div>
        </div>
    </div>
}

<!-- MODAL ADICIONAR COLUNA -->
@if (_mostrarModalAddCol)
{
    <div class="modal-backdrop" @onclick="() => _mostrarModalAddCol = false">
        <div class="modal-dialog small-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Adicionar Novo Campo</h3>
                <button type="button" class="btn-close-modal" @onclick="() => _mostrarModalAddCol = false">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-field">
                    <label>Nome do Campo:</label>
                    <input type="text" class="gis-input" @bind="_novaColNome" placeholder="Ex: AREA_HA, COD_IMOVEL" />
                </div>
                <div class="form-field">
                    <label>Tipo de Dado:</label>
                    <select class="gis-select" @bind="_novaColTipo" @bind:after="OnTipoNovaColAddChanged">
                        <option value="@AttributeDataType.String">Texto (String)</option>
                        <option value="@AttributeDataType.Real">Número Decimal (Real)</option>
                        <option value="@AttributeDataType.Integer">Número Inteiro (Integer)</option>
                        <option value="@AttributeDataType.Int64">Número Inteiro Longo (Int64)</option>
