    [JSInvokable]
    public void OnLayoutChanged(List<ComposerItemModel> items, string? selectedId, bool canUndo, bool canRedo)
    {
        if (selectedId != null && selectedId != _itemSelecionado?.Id) { _activePanel = "item"; _panelOpen = true; }
        _itensDoCompositor = items.ToDictionary(i => i.Id);
        _itemSelecionado = selectedId != null && _itensDoCompositor.TryGetValue(selectedId, out var item) ? item : null;
        _canUndo = canUndo; _canRedo = canRedo;
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        _objRef = DotNetObjectReference.Create(this);
        AtualizarDimensoesPapel();
    }

    public async ValueTask DisposeAsync()
    {
        try { if (_isInitialized) await JSRuntime.InvokeVoidAsync("composerDispose"); }
        catch (JSDisconnectedException) { }
        finally { _objRef?.Dispose(); }
    }

    /* Removed Fechar() since we use OS window close */

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isInitialized)
        {
            _printContext = PrintMapContext.Capture(MapService);
            await JSRuntime.InvokeVoidAsync("composerInitV3", "paper-sheet", _objRef, MapService.LocalServerBaseUrl, _printContext);
            await JSRuntime.InvokeVoidAsync("import", "./js/composer_document.js");
            await JSRuntime.InvokeVoidAsync("import", "./js/composer_exchange.js");
            _isInitialized = true;
        }
        if (_pageChanged)
        {
            _pageChanged = false;
            await JSRuntime.InvokeVoidAsync("composerPageChanged");
        }
    }

    [JSInvokable]
    public async Task OnItemSelected(ComposerItemModel item)
    {
        _activePanel = "item";
        _itensDoCompositor[item.Id] = item;
        _itemSelecionado = item;
        if (item.Type == "Legend" && item.LegendItems.Count == 0)
        {
            item.LegendItems = GerarLegendaDinamica();
            await JSRuntime.InvokeVoidAsync("composerUpdateItemProperty", item.Id, "LegendItems", System.Text.Json.JsonSerializer.Serialize(item.LegendItems));
        }
        StateHasChanged();
    }

    private List<LegendItemModel> GerarLegendaDinamica()
    {
        var legend = new List<LegendItemModel>();
        foreach (var camadaNome in MapService.OrdemCamadas.AsEnumerable().Reverse())
        {
            if (MapService.CamadasInvisiveis.Contains(camadaNome)) continue;

            if (MapService.EstilosPorCamada.TryGetValue(camadaNome, out var estilo))
            {
                if (estilo.TipoSimbologia == "CATEGORIZADA")
                {
                    legend.Add(new LegendItemModel { Name = camadaNome, Color = "transparent", BorderColor = "transparent" });
                    foreach (var cat in estilo.CoresCategorizadas)
                    {
                        legend.Add(new LegendItemModel
                        {
                            Name = "  " + cat.Key,
                            Color = cat.Value,
                            BorderColor = estilo.CorBorda
                        });
                    }
                }
                else
                {
                    legend.Add(new LegendItemModel
                    {
                        Name = camadaNome,
                        Color = estilo.PreenchimentoTransparente ? "transparent" : estilo.CorPreenchimento,
                        BorderColor = estilo.BordaTransparente ? "transparent" : estilo.CorBorda
                    });
                }
            }
            else
            {
                legend.Add(new LegendItemModel { Name = camadaNome, Color = "#38bdf8", BorderColor = "#0ea5e9" });
            }
        }
        return legend;
    }

