    private async Task AbrirLayout(InputFileChangeEventArgs e)
    {
        if (_exportando || _importando) return;
        _importando = true; _mensagem = "Preparando importação local…";
        try
        {
            var extension = System.IO.Path.GetExtension(e.File.Name).ToLowerInvariant();
            string json, warning;
            if (extension is ".json" or ".html" or ".htm")
            {
                await using var stream = e.File.OpenReadStream(extension == ".json" ? 20_000_000 : 40_000_000);
                using var reader = new System.IO.StreamReader(stream);
                var text = await reader.ReadToEndAsync();
                if (extension == ".json") { json = text; warning = "Layout JSON aberto. Confira a revisão de impressão."; }
                else { var result = await JSRuntime.InvokeAsync<HtmlImportResult>("composerParseHTML", text); json = result.Json; warning = result.Warning; }
            }
            else if (extension is ".png" or ".jpg" or ".jpeg" or ".pdf")
            {
                await using var stream = e.File.OpenReadStream(LayoutReferenceImporter.MaxBytes);
                using var buffer = new System.IO.MemoryStream(); await stream.CopyToAsync(buffer);
                var result = await LayoutReferenceImporter.ReadAsync(buffer.ToArray(), extension == ".pdf", _importPage, _importOcr);
                json = await JSRuntime.InvokeAsync<string>("composerReferenceLayout", result, e.File.Name);
                warning = result.Warning + " Use Arquivo > Salvar modelo HTML para reutilizar.";
            }
            else throw new InvalidOperationException("Formato não suportado.");
            _mensagem = await JSRuntime.InvokeAsync<bool>("composerImportLayout", json) ? warning : "Importação cancelada. Composição preservada.";
        }
        catch (Exception error) when (error is JSException or System.IO.IOException or InvalidOperationException or ArgumentException or System.Runtime.InteropServices.COMException)
        { _mensagem = $"Não foi possível abrir: {error.Message.Split('\n')[0]}"; }
        finally { _filePickerKey++; _importando = false; }
    }
