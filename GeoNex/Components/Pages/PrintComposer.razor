    private async Task DefinirZoom(double novoZoom)
    {
        if (novoZoom < 0.2) novoZoom = 0.2;
        if (novoZoom > 5.0) novoZoom = 5.0;
        WorkspaceZoom = Math.Round(novoZoom, 2);
        await JSRuntime.InvokeVoidAsync("composerSetWorkspaceZoom", WorkspaceZoom);
    }

    [JSInvokable]
    public void OnItemMoved(ComposerItemModel item)
    {
        if (_itensDoCompositor.ContainsKey(item.Id))
        {
            var existing = _itensDoCompositor[item.Id];
            existing.X = Math.Round(item.X ?? 0, 1);
            existing.Y = Math.Round(item.Y ?? 0, 1);
            existing.Width = Math.Round(item.Width ?? 0, 1);
            existing.Height = Math.Round(item.Height ?? 0, 1);
        }

        if (_itemSelecionado != null && _itemSelecionado.Id == item.Id)
        {
            _itemSelecionado.X = Math.Round(item.X ?? 0, 1);
            _itemSelecionado.Y = Math.Round(item.Y ?? 0, 1);
            _itemSelecionado.Width = Math.Round(item.Width ?? 0, 1);
            _itemSelecionado.Height = Math.Round(item.Height ?? 0, 1);
            StateHasChanged();
        }
    }

