    [JSInvokable]
    public void OnPageRestored(double widthMm, double heightMm, double gridMm, double marginMm, bool snap)
    {
        TamanhoPagina = Math.Max(widthMm,heightMm) switch { 1189 => "A0", 841 => "A1", 594 => "A2", 420 => "A3", _ => "A4" };
        Orientacao = widthMm > heightMm ? "Landscape" : "Portrait";
        AtualizarDimensoesPapel(); _pageChanged = false;
        _gridMm = gridMm; _marginMm = marginMm; _guias = snap;
        StateHasChanged();
    }
