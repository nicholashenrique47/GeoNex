@page "/printcomposer"
@using GeoNex.Services
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject GeoNex.Services.MapRenderingService MapService

<div class="composer-overlay @(_exportando || _importando ? "is-exporting" : "")" aria-busy="@(_exportando || _importando)">
        <!-- BARRA SUPERIOR -->
        <header class="composer-header glass-panel">
            <div class="brand-group"><div><span class="brand-eyebrow">GEONEX / LAYOUT</span><h2>Compositor de impressão</h2></div></div>
            <nav class="composer-menubar" aria-label="Comandos do compositor" inert="@(_exportando || _importando ? "" : null)">
                <details class="composer-menu"><summary>Arquivo</summary><div class="composer-menu-panel">
                    <button @onclick="SalvarLayout">Salvar layout JSON <span>Editável</span></button>
                    <button @onclick="SalvarHTML">Salvar modelo HTML <span>Portável</span></button>
                    <hr />
                    <label class="menu-field">Página do PDF <input type="number" min="1" max="10000" class="gis-input" @bind="_importPage" /></label>
                    <label class="menu-check"><input type="checkbox" @bind="_importOcr" /> Reconstruir textos por OCR</label>
                    <label class="file-picker menu-import">Importar arquivo…<InputFile @key="_filePickerKey" OnChange="AbrirLayout" accept=".json,.html,.htm,.png,.jpg,.jpeg,.pdf" /></label>
                    <p>JSON / HTML / imagem / PDF. OCR local e aproximado; revise os textos.</p>
                </div></details>
                <details class="composer-menu"><summary>Editar</summary><div class="composer-menu-panel">
                    <button disabled="@(!_canUndo)" @onclick="Desfazer">Desfazer <span>Ctrl+Z</span></button>
                    <button disabled="@(!_canRedo)" @onclick="Refazer">Refazer <span>Ctrl+Y</span></button>
                    <hr />
                    <button disabled="@(_itemSelecionado == null)" @onclick="DuplicarSelecionado">Duplicar elemento</button>
                    <button disabled="@(_itemSelecionado == null || _itemSelecionado.Locked)" @onclick="ContextTrazerFrente">Trazer à frente</button>
                    <button disabled="@(_itemSelecionado == null || _itemSelecionado.Locked)" @onclick="ContextEnviarTras">Enviar ao fundo</button>
                    <button class="danger" disabled="@(_itemSelecionado == null || _itemSelecionado.Locked)" @onclick="ContextEliminar">Excluir elemento</button>
                </div></details>
                <details class="composer-menu"><summary>Exibir</summary><div class="composer-menu-panel">
                    <button @onclick="() => _panelOpen = !_panelOpen">@(_panelOpen ? "Ocultar propriedades" : "Mostrar propriedades")</button>
                    <button @onclick="AjustarPagina">Ajustar página à tela</button>
                    <button @onclick="() => DefinirZoom(1)">Zoom 100%</button>
                    <hr />
                    <label class="menu-check"><input type="checkbox" @bind="_guias" @bind:after="AtualizarGuias" /> Encaixar na grade do papel</label>
                    <button @onclick="RevisarImpressao">Revisar impressão</button>
                </div></details>
                <details class="composer-menu"><summary>Exportar</summary><div class="composer-menu-panel">
                    <label class="menu-field">Resolução <select class="gis-select" @bind="_exportDpi"><option value="96">96 DPI · tela</option><option value="150">150 DPI · equilibrado</option><option value="300">300 DPI · impressão</option></select></label>
                    <button @onclick="ExportarPNG">Imagem PNG</button>
                    <button @onclick="ExportarPDF">Documento PDF</button>
                    <button @onclick="SalvarHTML">Modelo HTML editável no GeoNex</button>
                    <p>O PDF é rasterizado. HTML preserva o modelo; mapas usam o projeto ao reabrir.</p>
                </div></details>
            </nav>
            <button class="tool-btn" disabled="@(_exportando || _importando)" @onclick="ExportarPDF">Exportar PDF</button>
        </header>
        <div class="composer-editbar composer-quickbar" inert="@(_exportando || _importando ? "" : null)">
            <button class="tool-btn" disabled="@(!_canUndo)" @onclick="Desfazer" title="Desfazer">↶</button>
            <button class="tool-btn" disabled="@(!_canRedo)" @onclick="Refazer" title="Refazer">↷</button>
            <span class="composer-selection-info">@(_itemSelecionado == null ? "Selecione um elemento para editar" : string.IsNullOrWhiteSpace(_itemSelecionado.Name) ? _itemSelecionado.Type : _itemSelecionado.Name)</span>
            <div class="composer-compact-zoom">
                <button class="zoom-btn" @onclick="() => DefinirZoom(WorkspaceZoom - .1)" aria-label="Diminuir zoom">−</button>
                <button class="zoom-btn" @onclick="() => DefinirZoom(1)" title="Restaurar 100%">@(Math.Round(WorkspaceZoom * 100))%</button>
                <button class="zoom-btn" @onclick="() => DefinirZoom(WorkspaceZoom + .1)" aria-label="Aumentar zoom">+</button>
                <button class="zoom-btn" @onclick="AjustarPagina">Ajustar</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_mensagem))
        {
            <div class="composer-status" role="status">@_mensagem</div>
        }
        <div class="composer-workspace" inert="@(_exportando || _importando ? "" : null)">
            
            <!-- TOOLBAR ESQUERDA (FERRAMENTAS) -->
            <aside class="composer-toolbar glass-panel" aria-label="Ferramentas de layout">
                <span class="tool-category">EDITAR</span>
                <div class="tool-group">
                    <button class="composer-tool @(_modoInteracaoMapa ? "" : "active")" title="Selecionar/Mover Item" @onclick="() => AlternarModoInteracao(false)">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z"></path><path d="M13 13l6 6"></path></svg>
                    <span>Selecionar</span></button>
                    <button class="composer-tool @(_modoInteracaoMapa ? "active" : "")" title="Mover Conteúdo do Item (Pan Mapa)" @onclick="() => AlternarModoInteracao(true)">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 9l-3 3 3 3M9 5l3-3 3 3M19 9l3 3-3 3M9 19l3 3 3-3M2 12h20M12 2v20"></path></svg>
                    <span>Mover mapa</span></button>
                </div>
                
                <div class="tool-divider"></div>
                <span class="tool-category">INSERIR</span>
                
                <div class="tool-group">
                    <button class="composer-tool" @onclick="AdicionarMapa" title="Adicionar Novo Mapa">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>
                    <span>Mapa</span></button>
                    <button class="composer-tool" @onclick="AdicionarTexto" title="Adicionar Rótulo (Texto)">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                    <span>Texto</span></button>
                    <button class="composer-tool" @onclick="AdicionarLegenda" title="Adicionar Legenda">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                    <span>Legenda</span></button>
                    <button class="composer-tool" @onclick="AdicionarNorte" title="Adicionar Seta de Norte">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 19 21 12 17 5 21 12 2"></polygon></svg>
                    <span>Norte</span></button>
                    <button class="composer-tool" @onclick="AdicionarEscala" title="Adicionar barra de escala vinculada a um mapa">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6" y2="10"></line><line x1="10" y1="6" x2="10" y2="10"></line><line x1="14" y1="6" x2="14" y2="10"></line><line x1="18" y1="6" x2="18" y2="10"></line></svg>
                    <span>Escala</span></button>
                    <button class="composer-tool" @onclick='() => AdicionarForma("Rectangle")' title="Adicionar retângulo"><span class="shape-icon">▭</span><span>Retângulo</span></button>
                    <button class="composer-tool" @onclick='() => AdicionarForma("Ellipse")' title="Adicionar elipse"><span class="shape-icon">○</span><span>Elipse</span></button>

                </div>
            </aside>

            <!-- ÁREA DO PAPEL (CANVAS) -->
            <main class="composer-canvas-area" id="composer-canvas-area">
                
                
                <div id="composer-paper-holder">
                <div class="paper-sheet shadow-2xl" id="paper-sheet" data-width-mm="@LarguraPapelMm" data-height-mm="@AlturaPapelMm" style="@EstiloPapel">
                    <!-- Elementos do Layout serão renderizados aqui pelo Javascript -->
                </div>
                </div>
            </main>

            <!-- PAINEL DIREITO (PROPRIEDADES) -->
            <aside class="composer-properties glass-panel custom-scrollbar @(!_panelOpen ? "panel-hidden" : "")">
                <nav class="property-tabs" aria-label="Painéis do compositor">
                    <button class="@(_activePanel == "page" ? "active" : "")" @onclick='() => _activePanel = "page"'>Página</button>
                    <button class="@(_activePanel == "layers" ? "active" : "")" @onclick='() => _activePanel = "layers"'>Itens <span>@_itensDoCompositor.Count</span></button>
                    <button class="@(_activePanel == "item" ? "active" : "")" @onclick='() => _activePanel = "item"'>Propriedades</button>
                    <button class="@(_activePanel == "review" ? "active" : "")" @onclick="RevisarImpressao">Revisão</button>
                </nav>
                <section hidden="@(_activePanel != "page")">
                <div class="props-header">
                    <h3>Propriedades da Página</h3>
                </div>
                
                <div class="props-content">
                    <div class="form-group-vertical">
                        <label class="gis-label">Tamanho da Página</label>
                        <select class="gis-select" @bind="TamanhoPagina" @bind:after="AtualizarDimensoesPapel">
                            <option value="A0">A0 (841 x 1189 mm)</option>
                            <option value="A1">A1 (594 x 841 mm)</option>
                            <option value="A2">A2 (420 x 594 mm)</option>
                            <option value="A3">A3 (297 x 420 mm)</option>
                            <option value="A4">A4 (210 x 297 mm)</option>
                        </select>
                    </div>

                    <div class="form-group-vertical" style="margin-top: 15px;">
                        <label class="gis-label">Orientação</label>
                        <select class="gis-select" @bind="Orientacao" @bind:after="AtualizarDimensoesPapel">
                            <option value="Landscape">Paisagem (Horizontal)</option>
                            <option value="Portrait">Retrato (Vertical)</option>
                        </select>
                    </div>
                    
                    <hr style="border: none; border-top: 1px solid rgba(255,255,255,0.05); margin: 20px 0;" />
                    
                    <div class="page-settings">
                        <label class="gis-label">Modelos de composição</label>
                        <div class="template-buttons"><button class="tool-btn" @onclick='() => AplicarModelo("technical")'>Técnico · legenda lateral</button><button class="tool-btn" @onclick='() => AplicarModelo("wide")'>Panorâmico · mapa amplo</button></div>
                        <label class="gis-label">Espaçamento da grade (mm)</label>
                        <input type="number" min="1" max="50" step="1" class="gis-input" @bind="_gridMm" @bind:after="ConfigurarGuias" />
                        <label class="gis-label">Margem de alinhamento (mm)</label>
                        <input type="number" min="0" max="50" step="1" class="gis-input" @bind="_marginMm" @bind:after="ConfigurarGuias" />
                        <p class="composer-hint">Guias não são impressas. A escala do mapa é mantida ao redimensionar o quadro. Imprima em tamanho real, sem ajustar à folha.</p>
                    </div>
                </div>
                </section>
                <section hidden="@(_activePanel != "layers")">
                    <div class="props-header">
                        <h3>Itens do layout</h3>
                    </div>
                    
                    <div class="items-list">
                        @if (_itensDoCompositor.Count == 0) { <p class="composer-hint">Adicione um mapa ou texto para começar.</p> }
                        @foreach (var item in _itensDoCompositor.Values.OrderByDescending(i => i.ZIndex))
                        {
                            <div class="item-layer @(item.Id == _itemSelecionado?.Id ? "active" : "")" @key="item.Id">
                                <button class="item-name" @onclick="() => SelecionarItem(item.Id)" title="@item.Type">@(!string.IsNullOrWhiteSpace(item.Name) ? item.Name : string.IsNullOrWhiteSpace(item.TextContent) ? item.Type : item.TextContent)</button>
                                <button class="zoom-btn" title="Mostrar/ocultar" @onclick='() => DefinirEstadoItem(item, "Visible", !item.Visible)'>@(item.Visible ? "◉" : "○")</button>
                                <button class="zoom-btn" title="Bloquear/desbloquear" @onclick='() => DefinirEstadoItem(item, "Locked", !item.Locked)'>@(item.Locked ? "🔒" : "🔓")</button>
                            </div>
                        }
                    </div>

                    <hr style="border: none; border-top: 1px solid rgba(255,255,255,0.05); margin: 20px 0;" />
                    
                </section>
                <section hidden="@(_activePanel != "item")">
                    <!-- Propriedades do Item Selecionado -->
                    <div class="props-header" style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                        <h3 style="margin-bottom: 0;">Propriedades do Item</h3>
                        @if (_itemSelecionado == null)
                        {
                            <span style="font-size: 0.75rem; color: #64748b; font-style: italic; display: block; margin-top: 5px; padding-bottom: 10px;">Selecione um item no papel...</span>
                        }
                    </div>

                    @if (_itemSelecionado != null)
                    {
                        <div class="props-content" style="padding: 0;">
                            <div class="selection-heading"><span class="selection-badge">@_itemSelecionado.Type</span><span>@(_itemSelecionado.Locked ? "Bloqueado" : "Selecionado")</span></div>
                            <label class="inspector-field inspector-name"><span>Nome no layout</span><input class="gis-input" maxlength="120" placeholder="Identifique este elemento" disabled="@_itemSelecionado.Locked" @bind="_itemSelecionado.Name" @bind:after='() => AtualizarPropriedadeItem("Name", _itemSelecionado.Name)' /></label>
                            <nav class="inspector-tabs" aria-label="Configuração do elemento">
                                <button class="@(_inspectorTab == "content" ? "active" : "")" @onclick='() => _inspectorTab = "content"'>Conteúdo</button>
                                <button class="@(_inspectorTab == "geometry" ? "active" : "")" @onclick='() => _inspectorTab = "geometry"'>Dimensões</button>
                                <button class="@(_inspectorTab == "style" ? "active" : "")" @onclick='() => _inspectorTab = "style"'>Visual</button>
                            </nav>
                            <fieldset disabled="@_itemSelecionado.Locked" style="border:0;padding:0;margin:0;min-width:0">
                            <!-- ACCORDION: PROPRIEDADES PRINCIPAIS -->
                            <section class="inspector-card" hidden="@(_inspectorTab != "content")">
                                <h4>Conteúdo do elemento</h4>
                                <div class="inspector-body">
                                    @if (_itemSelecionado.Type == "Picture")
                                    { <p class="composer-hint">Imagem de referência incorporada. Use a lista de itens para mostrar/ocultar o original, comparar com o OCR e desbloquear para redimensionar.</p> }
                                    else if (_itemSelecionado.Type == "Rectangle" || _itemSelecionado.Type == "Ellipse")
                                    { <p class="composer-hint">Use Dimensões para desenhar a forma e Visual para escolher preenchimento e contorno.</p> }
                                    else if (_itemSelecionado.Type == "Map")
                                    {
                                        <div class="form-group-horizontal">
                                            <label class="gis-label" style="width: 80px;">Escala 1:</label>
                                            <input type="number" class="gis-input" style="flex:1;" min="1" max="1000000000" step="100" list="print-scales" disabled="@(!_itemSelecionado.ScaleAvailable)" @bind="_itemSelecionado.MapScale" @bind:after="AplicarEscala" />
                                            <datalist id="print-scales">@foreach (var scale in new[] { 500,1000,2000,5000,10000,25000,50000,100000,250000,1000000 }) { <option value="@scale"></option> }</datalist>
                                        </div>
                                        <div class="form-group-horizontal" style="margin-top: 8px;">
                                            <label class="gis-label" style="width: 80px;">Rotação</label>
                                            <input type="number" class="gis-input" style="flex:1;" step="1" @bind="_itemSelecionado.MapRotation" @bind:after="AtualizarRotacaoMapa" />
                                            <span style="color: #94a3b8; font-size: 0.8rem; margin-left: 5px;">°</span>
                                        </div>
                                        <div class="form-group-horizontal" style="margin-top: 8px;">
                                            <label class="gis-label" style="width: 80px;">SRC</label>
                                            <select class="gis-select" style="flex:1;" disabled><option>@(_itemSelecionado.MapCrsName ?? _printContext?.CrsName ?? "SRC do projeto")</option></select>
                                        </div>
                                        <button class="tool-btn" @onclick="UsarVistaProjeto">Usar vista atual do projeto</button>
                                        <div class="map-tool-section">
                                            <h4>Escala e cobertura</h4>
                                            <div class="inspector-actions">
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("factor", .5)'>Aproximar 2×</button>
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("factor", 2)'>Afastar 2×</button>
                                            </div>
                                            <label class="inspector-field"><span>Fator do denominador · 0,1–10</span><input class="gis-input" type="number" min="0.1" max="10" step="0.1" @bind="_mapScaleFactor" /></label>
                                            <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("factor", _mapScaleFactor)'>Multiplicar escala</button>
                                            <p class="composer-hint">Fator menor que 1 aproxima; maior que 1 afasta.</p>
                                            @if (_itemSelecionado.ScaleAvailable)
                                            {
                                                <div class="map-coverage"><span>Cobertura no SRC</span><strong>@(((_itemSelecionado.Width ?? 0) * .0254 / 96 * (_itemSelecionado.MapScale ?? 0)).ToString("N1")) × @(((_itemSelecionado.Height ?? 0) * .0254 / 96 * (_itemSelecionado.MapScale ?? 0)).ToString("N1")) m</strong></div>
                                            }
                                            <label class="inspector-field"><span>Distância representada · m</span><input type="number" class="gis-input" min="0.01" max="1000000000" @bind="_mapCoverageMeters" /></label>
                                            <div class="inspector-actions">
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("width", _mapCoverageMeters)'>Na largura</button>
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("height", _mapCoverageMeters)'>Na altura</button>
                                            </div>
                                            <p class="composer-hint">Dimensões ao longo dos lados do quadro; preserva o centro e ajusta a escala.</p>
                                        </div>
                                        <div class="map-tool-section">
                                            <h4>Navegação por distância</h4>
                                            <label class="inspector-field"><span>Deslocar o centro · metros</span><input type="number" class="gis-input" min="0.01" max="10000000" @bind="_mapPanMeters" /></label>
                                            <div class="map-direction-pad">
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("nw", _mapPanMeters)'>↖ NO</button>
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("n", _mapPanMeters)'>↑ N</button>
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("ne", _mapPanMeters)'>↗ NE</button>
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("w", _mapPanMeters)'>← O</button>
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("e", _mapPanMeters)'>L →</button>
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("sw", _mapPanMeters)'>↙ SO</button>
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("s", _mapPanMeters)'>↓ S</button>
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("se", _mapPanMeters)'>↘ SE</button>
                                            </div>
                                            <p class="composer-hint">Direções de quadrícula, independentes da rotação. Diagonais percorrem a mesma distância total.</p>
                                        </div>
                                        <div class="map-tool-section">
                                            <h4>Orientação do conteúdo</h4>
                                            <div class="inspector-actions">
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("rotate", -90)'>-90°</button>
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("rotate", -15)'>-15°</button>
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("rotate", 15)'>+15°</button>
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("rotate", 90)'>+90°</button>
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("north")'>Norte para cima</button>
                                            </div>
                                            <p class="composer-hint">Gira o mapa dentro do quadro e atualiza o norte vinculado.</p>
                                        </div>
                                        <div class="map-tool-section">
                                            <h4>Comparar enquadramentos</h4>
                                            <label class="inspector-field"><span>Mapa de referência</span><select class="gis-select" @bind="_mapReferenceId">
                                                <option value="">Selecione outro mapa</option>
                                                @foreach (var reference in _itensDoCompositor.Values.Where(i => i.Type == "Map" && i.ScaleAvailable && i.Id != _itemSelecionado.Id))
                                                { <option value="@reference.Id">@(string.IsNullOrWhiteSpace(reference.Name) ? reference.TextContent : reference.Name)</option> }
                                            </select></label>
                                            <div class="inspector-actions">
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable || string.IsNullOrEmpty(_mapReferenceId))" @onclick='() => FerramentaMapa("scale")'>Igualar escala</button>
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable || string.IsNullOrEmpty(_mapReferenceId))" @onclick='() => FerramentaMapa("view")'>Copiar vista</button>
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable || string.IsNullOrEmpty(_mapReferenceId))" @onclick='() => FerramentaMapa("extent")'>Conter área</button>
                                            </div>
                                            <p class="composer-hint">Copiar vista transfere centro, escala e rotação. Conter área ajusta a escala ao tamanho deste quadro. Não cria sincronização contínua.</p>
                                        </div>
                                        <div class="map-tool-section">
                                            <h4>Vista de trabalho</h4>
                                            <div class="inspector-actions">
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("remember")'>Memorizar vista</button>
                                                <button class="tool-btn" disabled="@(!_itemSelecionado.ScaleAvailable)" @onclick='() => FerramentaMapa("restore")'>Restaurar vista</button>
                                            </div>
                                            <p class="composer-hint">Uma memória por mapa, somente nesta sessão. O layout salva a vista atual.</p>
                                            <label class="inspector-field"><span>Qualidade da prévia</span><select class="gis-select" @bind="_itemSelecionado.MapPreviewDpi" @bind:after='() => AtualizarPropriedadeItem("MapPreviewDpi", _itemSelecionado.MapPreviewDpi)'>
                                                <option value="0.5">Leve · 0,5×</option><option value="1">Equilibrada · 1×</option><option value="2">Detalhada · 2×</option>
                                            </select></label>
                                            <button class="tool-btn" @onclick='() => FerramentaMapa("refresh")'>Atualizar prévia</button>
                                            <p class="composer-hint">Qualidade da prévia não altera o DPI da exportação.</p>
                                        </div>
                                        <div class="map-tool-section">
                                            <h4>Grades do mapa</h4>
                                            <label class="inspector-field"><span>Grade selecionada · @_itemSelecionado.Grids.Count/8</span><select class="gis-select" value="@_gradeSelecionada?.Id" @onchange="e => _gridSelectedId = e.Value?.ToString() ?? string.Empty">
                                                @foreach (var grade in _itemSelecionado.Grids) { <option value="@grade.Id">@grade.Name @(grade.GridEnabled ? "" : "(oculta)")</option> }
                                            </select></label>
                                            <div class="inspector-actions">
                                                <button class="tool-btn" disabled="@(_itemSelecionado.Grids.Count >= 8)" @onclick='() => AcaoGrade("add")'>Adicionar</button>
                                                <button class="tool-btn" disabled="@(_gradeSelecionada == null || _itemSelecionado.Grids.Count >= 8)" @onclick='() => AcaoGrade("duplicate")'>Duplicar</button>
                                                <button class="tool-btn" disabled="@(_gradeSelecionada == null)" @onclick='() => AcaoGrade("remove")'>Remover</button>
                                                <button class="tool-btn" disabled="@(_gradeSelecionada == null || _itemSelecionado.Grids.IndexOf(_gradeSelecionada) <= 0)" @onclick='() => AcaoGrade("up")'>↑ Ordem</button>
                                                <button class="tool-btn" disabled="@(_gradeSelecionada == null || _itemSelecionado.Grids.IndexOf(_gradeSelecionada) >= _itemSelecionado.Grids.Count - 1)" @onclick='() => AcaoGrade("down")'>↓ Ordem</button>
                                            </div>
                                            <p class="composer-hint">A última grade da lista é desenhada por cima e tem prioridade nos rótulos.</p>
                                            @if (_gradeSelecionada != null) {
                                            <label class="inspector-field"><span>Nome da grade</span><input class="gis-input" maxlength="100" @bind="_gradeSelecionada.Name" @bind:after='() => AtualizarGrade("Name", _gradeSelecionada.Name)' /></label>
                                            <label class="inspector-field"><span><input type="checkbox" disabled="@(!_itemSelecionado.GridAvailable && !_gradeSelecionada.GridEnabled)" @bind="_gradeSelecionada.GridEnabled" @bind:after='() => AtualizarGrade("GridEnabled", _gradeSelecionada.GridEnabled)' /> Ativar grade cartográfica</span></label>
                                            @if (!_itemSelecionado.GridAvailable) { <p class="composer-hint">Use um SRC projetado e clique em Usar vista atual do projeto para obter a origem das coordenadas.</p> }
                                            <fieldset class="inspector-body" disabled="@(!_gradeSelecionada.GridEnabled)">
                                                <label class="inspector-field"><span>Representação</span><select class="gis-select" @bind="_gradeSelecionada.GridMode" @bind:after='() => AtualizarGrade("GridMode", _gradeSelecionada.GridMode)'><option value="lines">Linhas</option><option value="cross">Cruzes</option><option value="frame">Somente bordas/coordenadas</option></select></label>
                                                <label class="inspector-field"><span><input type="checkbox" @bind="_gradeSelecionada.GridAuto" @bind:after='() => AtualizarGrade("GridAuto", _gradeSelecionada.GridAuto)' /> Intervalo automático</span></label>
                                                <div class="inspector-grid">
                                                    <label class="inspector-field"><span>Intervalo X · unidade do SRC</span><input type="number" class="gis-input" min="0.000001" max="1000000000000" step="any" disabled="@_gradeSelecionada.GridAuto" @bind="_gradeSelecionada.GridIntervalX" @bind:after='() => AtualizarGrade("GridIntervalX", _gradeSelecionada.GridIntervalX)' /></label>
                                                    <label class="inspector-field"><span>Intervalo Y · unidade do SRC</span><input type="number" class="gis-input" min="0.000001" max="1000000000000" step="any" disabled="@_gradeSelecionada.GridAuto" @bind="_gradeSelecionada.GridIntervalY" @bind:after='() => AtualizarGrade("GridIntervalY", _gradeSelecionada.GridIntervalY)' /></label>
                                                    <label class="inspector-field"><span>Deslocamento X · SRC</span><input type="number" class="gis-input" min="-1000000000000" max="1000000000000" step="any" @bind="_gradeSelecionada.GridOffsetX" @bind:after='() => AtualizarGrade("GridOffsetX", _gradeSelecionada.GridOffsetX)' /></label>
                                                    <label class="inspector-field"><span>Deslocamento Y · SRC</span><input type="number" class="gis-input" min="-1000000000000" max="1000000000000" step="any" @bind="_gradeSelecionada.GridOffsetY" @bind:after='() => AtualizarGrade("GridOffsetY", _gradeSelecionada.GridOffsetY)' /></label>
                                                    <label class="inspector-field"><span>Fonte · px</span><input type="number" class="gis-input" min="8" max="24" step="any" @bind="_gradeSelecionada.GridFontSize" @bind:after='() => AtualizarGrade("GridFontSize", _gradeSelecionada.GridFontSize)' /></label>
                                                    <label class="inspector-field"><span>Casas decimais</span><input type="number" class="gis-input" min="0" max="6" step="1" @bind="_gradeSelecionada.GridPrecision" @bind:after='() => AtualizarGrade("GridPrecision", _gradeSelecionada.GridPrecision)' /></label>
                                                    <label class="inspector-field"><span>Linha · px</span><input type="number" class="gis-input" min="0.1" max="3" step="any" @bind="_gradeSelecionada.GridStroke" @bind:after='() => AtualizarGrade("GridStroke", _gradeSelecionada.GridStroke)' /></label>
                                                    <label class="inspector-field"><span>Marca interna · px</span><input type="number" class="gis-input" min="2" max="15" step="any" @bind="_gradeSelecionada.GridTickLength" @bind:after='() => AtualizarGrade("GridTickLength", _gradeSelecionada.GridTickLength)' /></label>
                                                </div>
                                                <label class="inspector-field"><span>Cor das linhas e marcas</span><input type="color" class="gis-input color-field" @bind="_gradeSelecionada.GridColor" @bind:after='() => AtualizarGrade("GridColor", _gradeSelecionada.GridColor)' /></label>
                                                <label class="inspector-field"><span><input type="checkbox" @bind="_gradeSelecionada.GridLabels" @bind:after='() => AtualizarGrade("GridLabels", _gradeSelecionada.GridLabels)' /> Desenhar coordenadas</span></label>
                                                <label class="inspector-field"><span><input type="checkbox" @bind="_gradeSelecionada.GridTicks" @bind:after='() => AtualizarGrade("GridTicks", _gradeSelecionada.GridTicks)' /> Marcas internas</span></label>
                                                <label class="inspector-field"><span><input type="checkbox" @bind="_gradeSelecionada.GridTop" @bind:after='() => AtualizarGrade("GridTop", _gradeSelecionada.GridTop)' /> Borda superior</span></label>
                                                <label class="inspector-field"><span><input type="checkbox" @bind="_gradeSelecionada.GridBottom" @bind:after='() => AtualizarGrade("GridBottom", _gradeSelecionada.GridBottom)' /> Borda inferior</span></label>
                                                <label class="inspector-field"><span><input type="checkbox" @bind="_gradeSelecionada.GridLeft" @bind:after='() => AtualizarGrade("GridLeft", _gradeSelecionada.GridLeft)' /> Borda esquerda</span></label>
                                                <label class="inspector-field"><span><input type="checkbox" @bind="_gradeSelecionada.GridRight" @bind:after='() => AtualizarGrade("GridRight", _gradeSelecionada.GridRight)' /> Borda direita</span></label>
                                            
                                                <h4>Desenhar coordenadas</h4>
                                                <label class="inspector-field"><span>Posição dos rótulos</span><select class="gis-select" @bind="_gradeSelecionada.GridLabelPosition" @bind:after='() => AtualizarGrade("GridLabelPosition", _gradeSelecionada.GridLabelPosition)'><option value="inside">Dentro do mapa</option><option value="outside">Fora do mapa</option></select></label>
                                                <label class="inspector-field"><span>Orientação</span><select class="gis-select" @bind="_gradeSelecionada.GridLabelOrientation" @bind:after='() => AtualizarGrade("GridLabelOrientation", _gradeSelecionada.GridLabelOrientation)'><option value="horizontal">Horizontal</option><option value="border">Acompanhar borda</option></select></label>
                                                <label class="inspector-field"><span>Formato</span><select class="gis-select" @bind="_gradeSelecionada.GridLabelFormat" @bind:after='() => AtualizarGrade("GridLabelFormat", _gradeSelecionada.GridLabelFormat)'><option value="axis">Eixo + número (X/Y)</option><option value="number">Somente número</option></select></label>
                                                <label class="inspector-field"><span>Coordenadas exibidas</span><select class="gis-select" @bind="_gradeSelecionada.GridLabelAxes" @bind:after='() => AtualizarGrade("GridLabelAxes", _gradeSelecionada.GridLabelAxes)'><option value="both">X e Y</option><option value="x">Somente X</option><option value="y">Somente Y</option></select></label>
                                                <label class="inspector-field"><span>Distância da borda · px</span><input type="number" class="gis-input" min="0" max="30" step="0.5" @bind="_gradeSelecionada.GridLabelDistance" @bind:after='() => AtualizarGrade("GridLabelDistance", _gradeSelecionada.GridLabelDistance)' /></label>
                                                <label class="inspector-field"><span>Cor das coordenadas</span><input type="color" class="gis-input color-field" @bind="_gradeSelecionada.GridLabelColor" @bind:after='() => AtualizarGrade("GridLabelColor", _gradeSelecionada.GridLabelColor)' /></label>
                                            </fieldset>
                                            }
                                            <p class="composer-hint">Coordenadas X/Y absolutas, em unidades do SRC do mapa. Colisões entre grades são omitidas. Reserve espaço no papel para coordenadas externas. Não é grade de latitude/longitude.</p>
                                            @if (!string.IsNullOrEmpty(_itemSelecionado.GridWarning)) { <p class="composer-hint" role="alert">@_itemSelecionado.GridWarning</p> }
                                        </div>
                                        <p class="composer-hint" role="status">@_mapToolMessage</p>
                                        <p class="composer-hint">@(_itemSelecionado.ScaleAvailable ? "Escala nas unidades da projeção. Não corrige distorções cartográficas do SRC." : "Para definir escala 1:N, use um SRC projetado no projeto (ex.: UTM) e atualize a vista.")</p>
                                    }
                                    else if (_itemSelecionado.Type == "Text")
                                    {
                                        <div class="form-group-vertical">
                                            <textarea class="gis-input custom-scrollbar" style="height: 100px; resize: vertical;" @bind="_itemSelecionado.TextContent" @bind:after='() => AtualizarPropriedadeItem("Text", _itemSelecionado.TextContent)'></textarea>
                                        </div>
                                        <button class="tool-btn" @onclick="InserirCreditos">Inserir campos de créditos</button>
                                    }
                                    else if (_itemSelecionado.Type == "Legend")
                                    {
                                        <button class="tool-btn" @onclick="RecarregarLegenda">Recarregar camadas do projeto</button>
                                        <div class="inspector-grid">
<label class="inspector-field"><span>Colunas</span><input type="number" class="gis-input" min="1" max="4" @bind="_itemSelecionado.LegendColumns" @bind:after='() => AtualizarPropriedadeItem("LegendColumns", _itemSelecionado.LegendColumns)' /></label>
<label class="inspector-field"><span>Texto · px</span><input type="number" class="gis-input" min="6" max="48" @bind="_itemSelecionado.LegendFontSize" @bind:after='() => AtualizarPropriedadeItem("LegendFontSize", _itemSelecionado.LegendFontSize)' /></label>
<label class="inspector-field"><span>Título · px</span><input type="number" class="gis-input" min="6" max="72" @bind="_itemSelecionado.LegendTitleSize" @bind:after='() => AtualizarPropriedadeItem("LegendTitleSize", _itemSelecionado.LegendTitleSize)' /></label>
<label class="inspector-field"><span>Entre linhas · px</span><input type="number" class="gis-input" min="0" max="30" @bind="_itemSelecionado.LegendRowGap" @bind:after='() => AtualizarPropriedadeItem("LegendRowGap", _itemSelecionado.LegendRowGap)' /></label>
<label class="inspector-field"><span>Entre colunas · px</span><input type="number" class="gis-input" min="0" max="50" @bind="_itemSelecionado.LegendColumnGap" @bind:after='() => AtualizarPropriedadeItem("LegendColumnGap", _itemSelecionado.LegendColumnGap)' /></label>
<label class="inspector-field"><span>Símbolo: largura · px</span><input type="number" class="gis-input" min="2" max="80" @bind="_itemSelecionado.LegendSymbolWidth" @bind:after='() => AtualizarPropriedadeItem("LegendSymbolWidth", _itemSelecionado.LegendSymbolWidth)' /></label>
<label class="inspector-field"><span>Símbolo: altura · px</span><input type="number" class="gis-input" min="2" max="80" @bind="_itemSelecionado.LegendSymbolHeight" @bind:after='() => AtualizarPropriedadeItem("LegendSymbolHeight", _itemSelecionado.LegendSymbolHeight)' /></label>
                                        </div>
                                        <label class="inspector-field"><span><input type="checkbox" @bind="_itemSelecionado.LegendHideTitle" @bind:after='() => AtualizarPropriedadeItem("LegendHideTitle", _itemSelecionado.LegendHideTitle)' /> Ocultar título</span></label>
                                        <div class="inspector-actions">
                                            <button class="tool-btn" @onclick='() => AcaoLegenda("show")'>Mostrar todos</button>
                                            <button class="tool-btn" @onclick='() => AcaoLegenda("hide")'>Ocultar todos</button>
                                            <button class="tool-btn" @onclick='() => AcaoLegenda("sort")'>Ordenar A–Z</button>
                                            <button class="tool-btn" @onclick='() => AcaoLegenda("reverse")'>Inverter ordem</button>
                                        </div>
                                        <div class="form-group-vertical">
                                            <label class="gis-label">Título da Legenda</label>
                                            <input type="text" class="gis-input" @bind="_itemSelecionado.TextContent" @bind:after='() => AtualizarPropriedadeItem("Text", _itemSelecionado.TextContent)' />
                                        </div>
                                        
                                        <div style="margin-top: 15px;">
                                            <label class="gis-label">Símbolos e ordem da legenda</label>
                                            <div style="background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.05); padding: 5px; max-height: 250px; overflow-y: auto; border-radius: 4px;">
                                                @if (_itemSelecionado.LegendItems != null)
                                                {
                                                    @foreach (var lItem in _itemSelecionado.LegendItems)
                                                    {
                                                        <div style="display: flex; align-items: center; gap: 5px; margin-bottom: 5px;">
                                                            <input type="checkbox" title="Visível" @bind="lItem.IsVisible" @bind:after="NotificarLegendaAlterada" />
                                                            <input type="color" title="Cor do símbolo" style="width:24px;min-width:24px;padding:0;border:0;" @bind="lItem.Color" @bind:after="NotificarLegendaAlterada" />
                                                            <input type="color" title="Contorno do símbolo" style="width:24px;min-width:24px;padding:0;border:0;" @bind="lItem.BorderColor" @bind:after="NotificarLegendaAlterada" />
                                                            <input type="text" class="gis-input" style="flex: 1; padding: 4px; font-size: 0.8rem;" @bind="lItem.Name" @bind:after="NotificarLegendaAlterada" />
                                                            <button class="legend-order-btn" title="Mover para cima" disabled="@(_itemSelecionado.LegendItems.IndexOf(lItem) == 0)" @onclick='() => AcaoLegenda("up", _itemSelecionado.LegendItems.IndexOf(lItem))'>↑</button>
                                                            <button class="legend-order-btn" title="Mover para baixo" disabled="@(_itemSelecionado.LegendItems.IndexOf(lItem) == _itemSelecionado.LegendItems.Count - 1)" @onclick='() => AcaoLegenda("down", _itemSelecionado.LegendItems.IndexOf(lItem))'>↓</button>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                    else if (_itemSelecionado.Type == "ScaleBar")
                                    {
                                        <label class="gis-label">Mapa vinculado</label>
                                        <select class="gis-select" @bind="_itemSelecionado.ScaleBarMapId" @bind:after='() => AtualizarPropriedadeItem("ScaleBarMapId", _itemSelecionado.ScaleBarMapId)'>
                                            <option value="">Escolha um mapa</option>
                                            @foreach (var map in _itensDoCompositor.Values.Where(i => i.Type == "Map" && i.ScaleAvailable))
                                            { <option value="@map.Id">@map.TextContent — 1:@Math.Round(map.MapScale ?? 0)</option> }
                                        </select>
                                        <label class="gis-label">Distância total (metros)</label>
                                        <input type="number" min="0.01" step="10" class="gis-input" @bind="_itemSelecionado.ScaleBarMeters" @bind:after='() => AtualizarPropriedadeItem("ScaleBarMeters", _itemSelecionado.ScaleBarMeters)' />
                                        <p class="composer-hint">A barra acompanha a escala do mapa; ajuste a distância para caber no quadro.</p>
                                    }
                                    else if (_itemSelecionado.Type == "Image")
                                    {
                                        <div class="form-group-horizontal" style="margin-bottom: 8px;">
                                            <label class="gis-label" style="width: 80px;">Estilo</label>
                                            <select class="gis-select" style="flex: 1;" @bind="_itemSelecionado.SvgStyle" @bind:after='() => AtualizarPropriedadeItem("SvgStyle", _itemSelecionado.SvgStyle)'>
                                                <option value="Estilo 1">Clássica</option>
                                                <option value="Estilo 2">Bússola</option>
                                                <option value="Estilo 3">Seta Simples</option>
                                                <option value="Estilo 4">Rosa dos Ventos (Profissional)</option>
                                                <option value="Estilo 5">Minimalista N</option>
                                            </select>
                                        </div>
                                        <div class="form-group-horizontal" style="margin-bottom: 8px;">
                                            <label class="gis-label" style="width: 80px;">Cor Fundo</label>
                                            <input type="color" class="gis-input" style="padding:0; height: 32px; flex:1;" @bind="_itemSelecionado.SvgFill" @bind:after='() => AtualizarPropriedadeItem("SvgFill", _itemSelecionado.SvgFill)' />
                                        </div>
                                        <div class="form-group-horizontal" style="margin-bottom: 8px;">
                                            <label class="gis-label" style="width: 80px;">Contorno</label>
                                            <input type="color" class="gis-input" style="padding:0; height: 32px; flex:1;" @bind="_itemSelecionado.SvgStroke" @bind:after='() => AtualizarPropriedadeItem("SvgStroke", _itemSelecionado.SvgStroke)' />
                                        </div>
                                        <div style="margin-top: 15px; display: flex; align-items: center; gap: 8px;">
                                            <input type="checkbox" id="sync_rot" @bind="_itemSelecionado.SyncWithMap" @bind:after="VerificarSincronizacaoNorte" />
                                            <label for="sync_rot" class="gis-label" style="margin:0;">Norte de quadrícula vinculado ao mapa</label>
                                        </div>
                                        <select class="gis-select" aria-label="Mapa vinculado ao norte" @bind="_itemSelecionado.LinkedMapId" @bind:after="VerificarSincronizacaoNorte">
                                            <option value="">Selecione o mapa</option>
                                            @foreach (var map in _itensDoCompositor.Values.Where(i => i.Type == "Map"))
                                            { <option value="@map.Id">@map.TextContent (@map.Id.Substring(Math.Max(0, map.Id.Length - 6)))</option> }
                                        </select>
                                    }
                                </div>
                            </section>


<section class="inspector-card" hidden="@(_inspectorTab != "geometry")">
    <h4>Enquadramento <span>mm</span></h4>
    <div class="inspector-body">
        <div class="inspector-grid"><label class="inspector-field"><span>X · mm</span><input type="number" class="gis-input" step="0.1"  @bind="_itemSelecionado.XMm" @bind:after='() => AtualizarPropriedadeItem("X", _itemSelecionado.X)' /></label>
<label class="inspector-field"><span>Y · mm</span><input type="number" class="gis-input" step="0.1"  @bind="_itemSelecionado.YMm" @bind:after='() => AtualizarPropriedadeItem("Y", _itemSelecionado.Y)' /></label>
<label class="inspector-field"><span>Largura · mm</span><input type="number" class="gis-input" step="0.1" min="0.3" @bind="_itemSelecionado.WidthMm" @bind:after='() => AtualizarPropriedadeItem("Width", _itemSelecionado.Width)' /></label>
<label class="inspector-field"><span>Altura · mm</span><input type="number" class="gis-input" step="0.1" min="0.3" @bind="_itemSelecionado.HeightMm" @bind:after='() => AtualizarPropriedadeItem("Height", _itemSelecionado.Height)' /></label></div>
        <label class="inspector-field"><span>Rotação do elemento · graus</span><input type="number" class="gis-input" min="-360" max="360" @bind="_itemSelecionado.Rotation" @bind:after='() => AtualizarPropriedadeItem("Rotation", _itemSelecionado.Rotation)' /></label>
        <div class="inspector-actions"><button class="tool-btn" @onclick="() => GirarElemento(-90)">↶ 90°</button><button class="tool-btn" @onclick="() => GirarElemento(90)">↷ 90°</button><button class="tool-btn" @onclick="ZerarRotacao">Zerar</button></div>
        <p class="composer-hint">Alinhar ao papel e às margens</p>
        <div class="composer-align">
            @foreach (var alignment in new[] { ("left", "Esquerda"), ("center", "Centro H"), ("right", "Direita"), ("top", "Topo"), ("middle", "Centro V"), ("bottom", "Base") })
            { <button class="tool-btn" @onclick="() => AlinharItem(alignment.Item1)">@alignment.Item2</button> }
        </div>
    </div>
</section>
<section class="inspector-card" hidden="@(_inspectorTab != "geometry")">
    <h4>Dimensionamento inteligente</h4>
    <div class="inspector-body">
        <p class="composer-hint">Preserva proporções. Encaixar centraliza e zera a rotação do elemento; a escala cartográfica permanece igual.</p>
        <div class="inspector-actions">
            <button class="tool-btn" @onclick='() => Dimensionar("fit")'>Caber nas margens</button>
            <button class="tool-btn" @onclick='() => Dimensionar("width")'>Pela largura</button>
            <button class="tool-btn" @onclick='() => Dimensionar("height")'>Pela altura</button>
        </div>
        <p class="composer-hint">Por largura/altura, a outra dimensão pode ultrapassar o papel.</p>
        <label class="inspector-field"><span>Tamanho relativo · %</span><input type="number" class="gis-input" min="10" max="400" @bind="_resizePercent" /></label>
        <button class="tool-btn" @onclick='() => Dimensionar("percent")'>Aplicar pelo centro</button>
        @if (!string.IsNullOrEmpty(_resizeMessage)) { <p class="composer-hint" role="status">@_resizeMessage</p> }
    </div>
</section>
<section class="inspector-card" hidden="@(_inspectorTab != "geometry")">
    <h4>Repetir em matriz</h4>
    <div class="inspector-body">
        <p class="composer-hint">Cria cópias independentes à direita e abaixo. A contagem inclui o original; vínculos de norte e escala continuam no mapa original.</p>
        <div class="inspector-grid">
            <label class="inspector-field"><span>Linhas · 1–5</span><input type="number" class="gis-input" min="1" max="5" @bind="_repeatRows" /></label>
            <label class="inspector-field"><span>Colunas · 1–5</span><input type="number" class="gis-input" min="1" max="5" @bind="_repeatColumns" /></label>
            <label class="inspector-field"><span>Intervalo X · mm</span><input type="number" class="gis-input" min="0" max="100" step="0.5" @bind="_repeatGapX" /></label>
            <label class="inspector-field"><span>Intervalo Y · mm</span><input type="number" class="gis-input" min="0" max="100" step="0.5" @bind="_repeatGapY" /></label>
        </div>
        <button class="tool-btn" @onclick="RepetirElemento">Criar matriz</button>
        <p class="composer-hint" role="status">@_repeatMessage</p>
        <p class="composer-hint">Pode ultrapassar a página. Confira a aba Revisão antes de exportar.</p>
    </div>
</section>
<div hidden="@(_inspectorTab != "style")">
    @if (_itemSelecionado.Type == "Text")
    {
        <section class="inspector-card">
            <h4>Tipografia avançada</h4>
