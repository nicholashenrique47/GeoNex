@code {
    /* Removed IsVisible and OnClose parameters as this is now a standalone page */

    private bool _isInitialized = false;
    private DotNetObjectReference<PrintComposer> _objRef;

    // Propriedades da Página
    public string TamanhoPagina { get; set; } = "A4";
    public string Orientacao { get; set; } = "Landscape";

    public int LarguraPapelPx { get; set; } = 1123;
    public int AlturaPapelPx { get; set; } = 794;
    
    private const double PixelsPerMm = 3.7795275591; // 96 DPI padrão da web
    
    // Modo de Interação: false = Selecionar/Mover, true = Mover Conteúdo (Pan)
    private bool _modoInteracaoMapa = false;

    // Zoom da Página (Workspace)
    public double WorkspaceZoom { get; set; } = 1.0;

    // Context Menu
    public bool ShowContextMenu { get; set; } = false;
    public double ContextMenuX { get; set; } = 0;
    public double ContextMenuY { get; set; } = 0;
    public string ContextMenuItemId { get; set; } = null;

    // Lista de todos os itens do papel
    private Dictionary<string, ComposerItemModel> _itensDoCompositor = new Dictionary<string, ComposerItemModel>();

    // Modelo de Item do Compositor
    public class ComposerItemModel
    {
        public string Id { get; set; }
        public string Type { get; set; }
        
        // --- Opções Gerais ---
        public double X { get; set; }
        public double Y { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
        public double Rotation { get; set; } = 0;
        public int ZIndex { get; set; } = 10;
        
        public bool HasBg { get; set; } = false;
        public string BgColor { get; set; } = "#ffffff";
        
        public bool HasBorder { get; set; } = false;
        public string BorderColor { get; set; } = "#000000";
        public int BorderWidth { get; set; } = 1;
        public string BorderStyle { get; set; } = "solid";
        public int BorderRadius { get; set; } = 0;
        
        public bool HasShadow { get; set; } = false;
        public string ShadowColor { get; set; } = "#000000";
        public int ShadowOffsetX { get; set; } = 5;
        public int ShadowOffsetY { get; set; } = 5;
        public int ShadowBlur { get; set; } = 10;
        
        public double Opacity { get; set; } = 1.0;
        public string BlendMode { get; set; } = "normal";

        // --- Texto / Rótulo ---
        public string TextContent { get; set; }
        public string TextColor { get; set; } = "#000000";
        public int FontSize { get; set; } = 14;
        public string FontFamily { get; set; } = "Arial";
        public string FontWeight { get; set; } = "normal";
        public string FontStyle { get; set; } = "normal";
        public string TextAlignH { get; set; } = "left";
        public string TextAlignV { get; set; } = "top";
        public int Padding { get; set; } = 0;

        // --- Mapa ---
        public double MapScale { get; set; } = 1000.0;
        public double MapRotation { get; set; } = 0;
        public bool MapDrawExtents { get; set; } = false;

        // Propriedades antigas (remover depois)
        public double MapZoom { get; set; } = 1.0;
    }

    private ComposerItemModel _itemSelecionado = null;

    protected override void OnInitialized()
    {
        _objRef = DotNetObjectReference.Create(this);
        AtualizarDimensoesPapel();
    }

    public void Dispose()
    {
        _objRef?.Dispose();
    }

    /* Removed Fechar() since we use OS window close */

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isInitialized)
        {
            await JSRuntime.InvokeVoidAsync("composerInitV3", "paper-sheet", _objRef, MapService.LocalServerBaseUrl);
            _isInitialized = true;
        }

    }

    [JSInvokable]
    public void OnItemSelected(ComposerItemModel item)
    {
        _itemSelecionado = item;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnItemDeselected()
    {
        _itemSelecionado = null;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnContextMenu(string itemId, double x, double y)
    {
        ContextMenuItemId = itemId;
        ContextMenuX = x;
        ContextMenuY = y;
        ShowContextMenu = true;
        
        // Se clicar com botão direito num item, também o seleciona
        if (!string.IsNullOrEmpty(itemId))
        {
            JSRuntime.InvokeVoidAsync("composerSelectItem", itemId);
        }
        
        StateHasChanged();
    }

    [JSInvokable]
    public void CloseContextMenu()
    {
        ShowContextMenu = false;
        StateHasChanged();
    }

    private void ContextPropriedades()
    {
        CloseContextMenu();
    }

    private async Task ContextTrazerFrente()
    {
        if (_itemSelecionado != null)
        {
            _itemSelecionado.ZIndex += 1;
            await AtualizarPropriedadeItem("ZIndex", _itemSelecionado.ZIndex);
        }
        CloseContextMenu();
    }

    private async Task ContextEnviarTras()
    {
        if (_itemSelecionado != null)
        {
            _itemSelecionado.ZIndex -= 1;
            if (_itemSelecionado.ZIndex < 0) _itemSelecionado.ZIndex = 0;
            await AtualizarPropriedadeItem("ZIndex", _itemSelecionado.ZIndex);
        }
        CloseContextMenu();
    }

    private async Task ContextEliminar()
    {
        if (_itemSelecionado != null)
        {
            await JSRuntime.InvokeVoidAsync("composerDeleteItem", _itemSelecionado.Id);
            _itemSelecionado = null;
        }
        CloseContextMenu();
    }

    [JSInvokable]
    public void OnWorkspaceZoomChanged(double newZoom)
    {
        WorkspaceZoom = newZoom;
        StateHasChanged();
    }

    private async Task DefinirZoom(double novoZoom)
    {
        if (novoZoom < 0.2) novoZoom = 0.2;
        if (novoZoom > 5.0) novoZoom = 5.0;
        WorkspaceZoom = Math.Round(novoZoom, 2);
        await JSRuntime.InvokeVoidAsync("composerSetWorkspaceZoom", WorkspaceZoom);
    }

    [JSInvokable]
    public void OnItemMoved(ComposerItemModel item)
    {
        if (_itemSelecionado != null && _itemSelecionado.Id == item.Id)
        {
            _itemSelecionado.X = Math.Round(item.X, 1);
            _itemSelecionado.Y = Math.Round(item.Y, 1);
            _itemSelecionado.Width = Math.Round(item.Width, 1);
            _itemSelecionado.Height = Math.Round(item.Height, 1);
            StateHasChanged();
        }
    }

    private async Task AtualizarPropriedadeItem(string propName, object valor)
    {
        if (_itemSelecionado != null)
        {
            await JSRuntime.InvokeVoidAsync("composerUpdateItemProperty", _itemSelecionado.Id, propName, valor);
        }
    }

    private void AtualizarDimensoesPapel()
    {
        double widthMm = 297;
        double heightMm = 210;

        switch (TamanhoPagina)
        {
            case "A0": widthMm = 1189; heightMm = 841; break;
            case "A1": widthMm = 841; heightMm = 594; break;
            case "A2": widthMm = 594; heightMm = 420; break;
            case "A3": widthMm = 420; heightMm = 297; break;
            case "A4": widthMm = 297; heightMm = 210; break;
        }

        if (Orientacao == "Portrait")
        {
            var temp = widthMm;
            widthMm = heightMm;
            heightMm = temp;
        }

        LarguraPapelPx = (int)Math.Round(widthMm * PixelsPerMm);
        AlturaPapelPx = (int)Math.Round(heightMm * PixelsPerMm);
    }

    private async Task AdicionarMapa()
    {
        await JSRuntime.InvokeVoidAsync("composerAddItemV3", "Map", "Mapa 1", 50, 50, 800, 500);
    }

    private async Task AdicionarTexto()
    {
        await JSRuntime.InvokeVoidAsync("composerAddItemV3", "Text", "Título Principal", 50, 20, 400, 60);
    }

    private async Task AdicionarLegenda()
    {
        await JSRuntime.InvokeVoidAsync("composerAddItemV3", "Legend", "Legenda", 50, 600, 250, 150);
    }

    private async Task AdicionarNorte()
    {
        await JSRuntime.InvokeVoidAsync("composerAddItemV3", "Image", "Seta de Norte", 1000, 50, 80, 80);
    }

    private async Task ExportarPNG()
    {
        await JSRuntime.InvokeVoidAsync("composerExportPNG", "mapa_exportado.png");
    }

    private async Task ExportarPDF()
    {
        await JSRuntime.InvokeVoidAsync("composerExportPDF", "mapa_exportado.pdf");
    }

    private async Task AlternarModoInteracao(bool ativarPanZoom)
    {
        _modoInteracaoMapa = ativarPanZoom;
        await JSRuntime.InvokeVoidAsync("composerSetMapInteractionModeV3", ativarPanZoom);
    }
}
