@page "/printcomposer"
@using GeoNex.Services
@using Microsoft.JSInterop
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject GeoNex.Services.MapRenderingService MapService

<div class="composer-overlay">
        <!-- BARRA SUPERIOR -->
        <header class="composer-header glass-panel">
            <div class="brand-group">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 10px; color: #38bdf8;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                <h2>Compositor de Impressão</h2>
            </div>
            
            <div class="composer-actions">
                <div class="zoom-controls" style="display:flex; align-items:center; background: rgba(0,0,0,0.2); border-radius: 4px; overflow: hidden; margin-right: 15px;">
                    <button class="zoom-btn" @onclick="() => DefinirZoom(WorkspaceZoom - 0.1)" title="Zoom Out">-</button>
                    <span class="zoom-level" style="font-size: 0.8rem; padding: 0 10px; min-width: 50px; text-align: center;">@(Math.Round(WorkspaceZoom * 100))%</span>
                    <button class="zoom-btn" @onclick="() => DefinirZoom(WorkspaceZoom + 0.1)" title="Zoom In">+</button>
                    <button class="zoom-btn" @onclick="() => DefinirZoom(1.0)" title="100%" style="border-left: 1px solid rgba(255,255,255,0.1); font-size: 0.75rem;">1:1</button>
                </div>

                <button class="tool-btn" @onclick="ExportarPNG" title="Exportar como Imagem (PNG 300 DPI)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    Exportar Imagem
                </button>
                <button class="tool-btn" @onclick="ExportarPDF" title="Exportar como Documento (PDF vetorial)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    Exportar PDF
                </button>
            </div>
        </header>

        <div class="composer-workspace">
            
            <!-- TOOLBAR ESQUERDA (FERRAMENTAS) -->
            <aside class="composer-toolbar glass-panel">
                <div class="tool-group">
                    <button class="composer-tool @(_modoInteracaoMapa ? "" : "active")" title="Selecionar/Mover Item" @onclick="() => AlternarModoInteracao(false)">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z"></path><path d="M13 13l6 6"></path></svg>
                    </button>
                    <button class="composer-tool @(_modoInteracaoMapa ? "active" : "")" title="Mover Conteúdo do Item (Pan Mapa)" @onclick="() => AlternarModoInteracao(true)">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 9l-3 3 3 3M9 5l3-3 3 3M19 9l3 3-3 3M9 19l3 3 3-3M2 12h20M12 2v20"></path></svg>
                    </button>
                </div>
                
                <div class="tool-divider"></div>
                
                <div class="tool-group">
                    <button class="composer-tool" @onclick="AdicionarMapa" title="Adicionar Novo Mapa">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>
                    </button>
                    <button class="composer-tool" @onclick="AdicionarTexto" title="Adicionar Rótulo (Texto)">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                    </button>
                    <button class="composer-tool" @onclick="AdicionarLegenda" title="Adicionar Legenda">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                    </button>
                    <button class="composer-tool" @onclick="AdicionarNorte" title="Adicionar Seta de Norte">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 19 21 12 17 5 21 12 2"></polygon></svg>
                    </button>
                    <button class="composer-tool" title="Adicionar Barra de Escala">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6" y2="10"></line><line x1="10" y1="6" x2="10" y2="10"></line><line x1="14" y1="6" x2="14" y2="10"></line><line x1="18" y1="6" x2="18" y2="10"></line></svg>
                    </button>
                    <button class="composer-tool" title="Adicionar Imagem">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    </button>
                </div>
            </aside>

            <!-- ÁREA DO PAPEL (CANVAS) -->
            <main class="composer-canvas-area" id="composer-canvas-area">
                <div class="canvas-ruler horizontal"></div>
                <div class="canvas-ruler vertical"></div>
                
                <div class="paper-sheet shadow-2xl" id="paper-sheet" style="width: @(LarguraPapelPx)px; height: @(AlturaPapelPx)px;">
                    <!-- Elementos do Layout serão renderizados aqui pelo Javascript -->
                </div>
            </main>

            <!-- PAINEL DIREITO (PROPRIEDADES) -->
            <aside class="composer-properties glass-panel custom-scrollbar">
                <div class="props-header">
                    <h3>Propriedades da Página</h3>
                </div>
                
                <div class="props-content">
                    <div class="form-group-vertical">
                        <label class="gis-label">Tamanho da Página</label>
                        <select class="gis-select" @bind="TamanhoPagina" @bind:after="AtualizarDimensoesPapel">
                            <option value="A0">A0 (841 x 1189 mm)</option>
                            <option value="A1">A1 (594 x 841 mm)</option>
                            <option value="A2">A2 (420 x 594 mm)</option>
                            <option value="A3">A3 (297 x 420 mm)</option>
                            <option value="A4">A4 (210 x 297 mm)</option>
                        </select>
                    </div>

                    <div class="form-group-vertical" style="margin-top: 15px;">
                        <label class="gis-label">Orientação</label>
                        <select class="gis-select" @bind="Orientacao" @bind:after="AtualizarDimensoesPapel">
                            <option value="Landscape">Paisagem (Horizontal)</option>
                            <option value="Portrait">Retrato (Vertical)</option>
                        </select>
                    </div>
                    
                    <hr style="border: none; border-top: 1px solid rgba(255,255,255,0.05); margin: 20px 0;" />
                    
                    <div class="props-header">
                        <h3>Itens do Layout</h3>
                    </div>
                    
                    <div class="items-list">
                        <div class="item-layer active">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon></svg>
                            Mapa 1
                        </div>
                        <div class="item-layer">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                            Título do Mapa
                        </div>
                        <div class="item-layer">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                            Legenda
                        </div>
                    </div>
                    
                    <hr style="border: none; border-top: 1px solid rgba(255,255,255,0.05); margin: 20px 0;" />
                    
                    <!-- Propriedades do Item Selecionado -->
                    <div class="props-header" style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                        <h3 style="margin-bottom: 0;">Propriedades do Item</h3>
                        @if (_itemSelecionado == null)
                        {
                            <span style="font-size: 0.75rem; color: #64748b; font-style: italic; display: block; margin-top: 5px; padding-bottom: 10px;">Selecione um item no papel...</span>
                        }
                    </div>

                    @if (_itemSelecionado != null)
                    {
                        <div class="props-content" style="padding: 0;">
                            <!-- ACCORDION: PROPRIEDADES PRINCIPAIS -->
                            <details class="gis-accordion" open>
                                <summary>Propriedades Principais</summary>
                                <div class="accordion-content">
                                    @if (_itemSelecionado.Type == "Map")
                                    {
                                        <div class="form-group-horizontal">
                                            <label class="gis-label" style="width: 80px;">Escala</label>
                                            <input type="number" class="gis-input" style="flex:1;" step="1" @bind="_itemSelecionado.MapScale" @bind:event="oninput" @onkeyup='@(e => AtualizarPropriedadeItem("MapScale", _itemSelecionado.MapScale))' @onchange='@(e => AtualizarPropriedadeItem("MapScale", _itemSelecionado.MapScale))' />
                                        </div>
                                        <div class="form-group-horizontal" style="margin-top: 8px;">
                                            <label class="gis-label" style="width: 80px;">Rotação</label>
                                            <input type="number" class="gis-input" style="flex:1;" step="1" @bind="_itemSelecionado.MapRotation" @bind:event="oninput" @onkeyup='@(e => AtualizarPropriedadeItem("MapRotation", _itemSelecionado.MapRotation))' @onchange='@(e => AtualizarPropriedadeItem("MapRotation", _itemSelecionado.MapRotation))' />
                                            <span style="color: #94a3b8; font-size: 0.8rem; margin-left: 5px;">°</span>
                                        </div>
                                        <div class="form-group-horizontal" style="margin-top: 8px;">
                                            <label class="gis-label" style="width: 80px;">SRC</label>
                                            <select class="gis-select" style="flex:1;" disabled><option>Use Project CRS</option></select>
                                        </div>
                                        <div style="margin-top: 15px; display: flex; align-items: center; gap: 8px;">
                                            <input type="checkbox" id="draw_extents" checked />
                                            <label for="draw_extents" class="gis-label" style="margin:0;">Desenhar itens da tela do mapa</label>
                                        </div>
                                    }
                                    else if (_itemSelecionado.Type == "Text" || _itemSelecionado.Type == "Legend")
                                    {
                                        <div class="form-group-vertical">
                                            <textarea class="gis-input custom-scrollbar" style="height: 100px; resize: vertical;" @bind="_itemSelecionado.TextContent" @bind:event="oninput" @onkeyup='@(e => AtualizarPropriedadeItem("Text", _itemSelecionado.TextContent))' @onchange='@(e => AtualizarPropriedadeItem("Text", _itemSelecionado.TextContent))'></textarea>
                                        </div>
                                        <div style="margin-top: 10px; display: flex; align-items: center; gap: 8px;">
                                            <input type="checkbox" id="render_html" />
                                            <label for="render_html" class="gis-label" style="margin:0;">Renderizar como HTML</label>
                                        </div>
                                        @if (_itemSelecionado.Type == "Text")
                                        {
                                            <div style="display: flex; gap: 5px; margin-top: 10px;">
                                                <button class="tool-btn" style="flex:1; justify-content: center; background: rgba(255,255,255,0.05); font-size: 0.75rem;">Inserir/Editar Expressão...</button>
                                                <button class="tool-btn" style="flex:1; justify-content: center; background: rgba(255,255,255,0.05); font-size: 0.75rem;">Texto Dinâmico ▼</button>
                                            </div>
                                        }
                                    }
                                </div>
                            </details>

                            <!-- ACCORDION: APARÊNCIA -->
                            <details class="gis-accordion" open>
                                <summary>Aparência</summary>
                                <div class="accordion-content">
                                    @if (_itemSelecionado.Type == "Text")
                                    {
                                        <div class="form-group-vertical" style="margin-bottom: 15px;">
                                            <label class="gis-label">Fonte</label>
                                            <div style="display: flex; gap: 5px;">
                                                <select class="gis-select" style="flex: 1;"><option>Arial</option><option>Inter</option><option>Times New Roman</option></select>
                                                <input type="number" class="gis-input" style="width: 50px;" @bind="_itemSelecionado.FontSize" @bind:event="oninput" @onkeyup='@(e => AtualizarPropriedadeItem("FontSize", _itemSelecionado.FontSize))' @onchange='@(e => AtualizarPropriedadeItem("FontSize", _itemSelecionado.FontSize))' />
                                                <input type="color" class="gis-input" style="padding:0; height: 32px; width: 32px;" @bind="_itemSelecionado.TextColor" @bind:event="oninput" @onchange='@(e => AtualizarPropriedadeItem("TextColor", _itemSelecionado.TextColor))' />
                                            </div>
                                        </div>
                                        
                                        <div class="form-group-horizontal" style="margin-bottom: 8px;">
                                            <label class="gis-label" style="width: 120px;">Margem horizontal</label>
                                            <input type="number" class="gis-input" style="flex:1;" value="0.00" step="0.1" />
                                            <span style="color: #94a3b8; font-size: 0.8rem; margin-left: 5px;">mm</span>
                                        </div>
                                        <div class="form-group-horizontal" style="margin-bottom: 15px;">
                                            <label class="gis-label" style="width: 120px;">Margem vertical</label>
                                            <input type="number" class="gis-input" style="flex:1;" value="0.00" step="0.1" />
                                            <span style="color: #94a3b8; font-size: 0.8rem; margin-left: 5px;">mm</span>
                                        </div>
                                        
                                        <div class="form-group-horizontal" style="margin-bottom: 8px;">
                                            <label class="gis-label" style="width: 120px;">Alinhamento horizontal</label>
                                            <select class="gis-select" style="flex: 1;" @bind="_itemSelecionado.TextAlignH" @bind:after='() => AtualizarPropriedadeItem("TextAlignH", _itemSelecionado.TextAlignH)'>
                                                <option value="left">Esquerda</option>
                                                <option value="center">Centro</option>
                                                <option value="right">Direita</option>
                                            </select>
                                        </div>
                                        <div class="form-group-horizontal">
                                            <label class="gis-label" style="width: 120px;">Alinhamento vertical</label>
                                            <select class="gis-select" style="flex: 1;" @bind="_itemSelecionado.TextAlignV" @bind:after='() => AtualizarPropriedadeItem("TextAlignV", _itemSelecionado.TextAlignV)'>
                                                <option value="top">Topo</option>
                                                <option value="center">Meio</option>
                                                <option value="bottom">Base</option>
                                            </select>
                                        </div>
                                    }
                                </div>
                            </details>

                            <!-- ACCORDION: POSIÇÃO E TAMANHO -->
                            <details class="gis-accordion">
                                <summary>Posição e Tamanho</summary>
                                <div class="accordion-content">
                                    <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                                        <div class="form-group-vertical" style="flex: 1;">
                                            <label class="gis-label">X</label>
                                            <input type="number" class="gis-input" @bind="_itemSelecionado.X" @bind:event="oninput" @onkeyup='@(e => AtualizarPropriedadeItem("X", _itemSelecionado.X))' @onchange='@(e => AtualizarPropriedadeItem("X", _itemSelecionado.X))' />
                                        </div>
                                        <div class="form-group-vertical" style="flex: 1;">
                                            <label class="gis-label">Y</label>
                                            <input type="number" class="gis-input" @bind="_itemSelecionado.Y" @bind:event="oninput" @onkeyup='@(e => AtualizarPropriedadeItem("Y", _itemSelecionado.Y))' @onchange='@(e => AtualizarPropriedadeItem("Y", _itemSelecionado.Y))' />
                                        </div>
                                    </div>
                                    <div style="display: flex; gap: 10px;">
                                        <div class="form-group-vertical" style="flex: 1;">
                                            <label class="gis-label">Largura</label>
                                            <input type="number" class="gis-input" @bind="_itemSelecionado.Width" @bind:event="oninput" @onkeyup='@(e => AtualizarPropriedadeItem("Width", _itemSelecionado.Width))' @onchange='@(e => AtualizarPropriedadeItem("Width", _itemSelecionado.Width))' />
                                        </div>
                                        <div class="form-group-vertical" style="flex: 1;">
                                            <label class="gis-label">Altura</label>
                                            <input type="number" class="gis-input" @bind="_itemSelecionado.Height" @bind:event="oninput" @onkeyup='@(e => AtualizarPropriedadeItem("Height", _itemSelecionado.Height))' @onchange='@(e => AtualizarPropriedadeItem("Height", _itemSelecionado.Height))' />
                                        </div>
                                    </div>
                                </div>
                            </details>
                            
                            <!-- ACCORDION: ROTAÇÃO -->
                            <details class="gis-accordion">
                                <summary>Rotação</summary>
                                <div class="accordion-content">
                                    <div class="form-group-horizontal">
                                        <label class="gis-label" style="width: 80px;">Rotação</label>
                                        <input type="number" class="gis-input" style="flex:1;" step="1" @bind="_itemSelecionado.Rotation" @bind:event="oninput" @onkeyup='@(e => AtualizarPropriedadeItem("Rotation", _itemSelecionado.Rotation))' @onchange='@(e => AtualizarPropriedadeItem("Rotation", _itemSelecionado.Rotation))' />
                                        <span style="color: #94a3b8; font-size: 0.8rem; margin-left: 5px;">°</span>
                                    </div>
                                </div>
                            </details>
                            
                            <!-- ACCORDION: MOLDURA -->
                            <details class="gis-accordion">
                                <summary>
                                    <input type="checkbox" style="margin-right: 8px;" @bind="_itemSelecionado.HasBorder" @bind:after='() => AtualizarPropriedadeItem("HasBorder", _itemSelecionado.HasBorder)' @onclick:stopPropagation="true" />
                                    Moldura
                                </summary>
                                <div class="accordion-content" style="@(!_itemSelecionado.HasBorder ? "opacity: 0.5; pointer-events: none;" : "")">
                                    <div class="form-group-horizontal" style="margin-bottom: 8px;">
                                        <label class="gis-label" style="width: 80px;">Cor</label>
                                        <input type="color" class="gis-input" style="padding:0; height: 32px; flex:1;" @bind="_itemSelecionado.BorderColor" @bind:event="oninput" @onchange='@(e => AtualizarPropriedadeItem("BorderColor", _itemSelecionado.BorderColor))' />
                                    </div>
                                    <div class="form-group-horizontal">
                                        <label class="gis-label" style="width: 80px;">Espessura</label>
                                        <input type="number" class="gis-input" style="flex: 1;" min="0" max="20" step="0.1" @bind="_itemSelecionado.BorderWidth" @bind:event="oninput" @onkeyup='@(e => AtualizarPropriedadeItem("BorderWidth", _itemSelecionado.BorderWidth))' @onchange='@(e => AtualizarPropriedadeItem("BorderWidth", _itemSelecionado.BorderWidth))' />
                                        <span style="color: #94a3b8; font-size: 0.8rem; margin-left: 5px;">mm</span>
                                    </div>
                                </div>
                            </details>
                            
                            <!-- ACCORDION: PLANO DE FUNDO -->
                            <details class="gis-accordion">
                                <summary>
                                    <input type="checkbox" style="margin-right: 8px;" @bind="_itemSelecionado.HasBg" @bind:after='() => AtualizarPropriedadeItem("HasBg", _itemSelecionado.HasBg)' @onclick:stopPropagation="true" />
                                    Plano de Fundo
                                </summary>
                                <div class="accordion-content" style="@(!_itemSelecionado.HasBg ? "opacity: 0.5; pointer-events: none;" : "")">
                                    <div class="form-group-horizontal" style="margin-bottom: 8px;">
                                        <label class="gis-label" style="width: 80px;">Cor</label>
                                        <input type="color" class="gis-input" style="padding:0; height: 32px; flex:1;" @bind="_itemSelecionado.BgColor" @bind:event="oninput" @onchange='@(e => AtualizarPropriedadeItem("BgColor", _itemSelecionado.BgColor))' />
                                    </div>
                                </div>
                            </details>
                            
                            <!-- ACCORDION: ID DO ITEM -->
                            <details class="gis-accordion">
                                <summary>ID do item</summary>
                                <div class="accordion-content">
                                    <input type="text" class="gis-input" @bind="_itemSelecionado.Id" disabled />
                                </div>
                            </details>
                            
                            <!-- ACCORDION: RENDERIZAÇÃO -->
                            <details class="gis-accordion">
                                <summary>Renderização</summary>
                                <div class="accordion-content">
                                    <div class="form-group-horizontal" style="margin-bottom: 8px;">
                                        <label class="gis-label" style="width: 80px;">Modo Mescl.</label>
                                        <select class="gis-select" style="flex:1;" disabled><option>Normal</option></select>
                                    </div>
                                    <div class="form-group-horizontal">
                                        <label class="gis-label" style="width: 80px;">Opacidade</label>
                                        <input type="range" min="0" max="1" step="0.1" style="flex:1;" value="1" disabled />
                                    </div>
                                </div>
                            </details>
                            
                            <!-- ACCORDION: VARIÁVEIS -->
                            <details class="gis-accordion">
                                <summary>Variáveis</summary>
                                <div class="accordion-content">
                                    <span style="font-size: 0.75rem; color: #94a3b8;">Nenhuma variável de projeto disponível.</span>
                                </div>
                            </details>
                        </div>
                    }
                </div>
            </aside>
            
        </div>
    </div>
    
    @if (ShowContextMenu)
    {
        <div class="context-menu" style="left: @(ContextMenuX.ToString(System.Globalization.CultureInfo.InvariantCulture))px; top: @(ContextMenuY.ToString(System.Globalization.CultureInfo.InvariantCulture))px;">
            @if (!string.IsNullOrEmpty(ContextMenuItemId))
            {
                <div class="context-menu-item" @onclick="ContextPropriedades">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                    Propriedades...
                </div>
                <div class="context-menu-divider"></div>
                <div class="context-menu-item" @onclick="ContextTrazerFrente">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;"><polyline points="18 15 12 9 6 15"></polyline></svg>
                    Trazer para a Frente
                </div>
                <div class="context-menu-item" @onclick="ContextEnviarTras">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    Enviar para Trás
                </div>
                <div class="context-menu-divider"></div>
                <div class="context-menu-item text-danger" @onclick="ContextEliminar">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    Eliminar Item
                </div>
            }
            else
            {
                <div class="context-menu-item" @onclick="() => { AdicionarMapa(); CloseContextMenu(); }">Adicionar Mapa</div>
                <div class="context-menu-item" @onclick="() => { AdicionarTexto(); CloseContextMenu(); }">Adicionar Texto</div>
                <div class="context-menu-item" @onclick="() => { AdicionarLegenda(); CloseContextMenu(); }">Adicionar Legenda</div>
            }
        </div>
    }

