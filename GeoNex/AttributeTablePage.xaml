<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GeoNex"
             xmlns:pages="clr-namespace:GeoNex.Components.Pages"
             xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Maui;assembly=Microsoft.AspNetCore.Components.WebView.Maui"
             x:Class="GeoNex.AttributeTablePage"
             Title="Tabela de Atributos - GeoNex"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0b131c">

    <blazor:BlazorWebView HostPage="wwwroot/index_table.html" HorizontalOptions="Fill" VerticalOptions="Fill">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type pages:AttributeTableWindow}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</ContentPage>
